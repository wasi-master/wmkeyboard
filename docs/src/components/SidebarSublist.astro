---
/**
 * Sidebar list, adapted from starlight-theme-black's version.
 *
 * Three things differ from the theme's original:
 *   - every group is a collapsible <details>, at any depth, so long sections
 *     (Reference, Tools) can be folded away. The theme only does this when you
 *     opt in, and even then the plain-label branch is what nested groups get.
 *   - nested groups are indented behind a guide line, so depth is visible.
 *   - badges render their text ("Full", "Python") instead of the theme's bare dot,
 *     which threw away the label.
 * Padding is tightened throughout — the original spends a lot of vertical space
 * on a sidebar this long.
 */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { Icon } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

type SidebarEntry = StarlightRouteData['sidebar'][number];

function containsCurrent(entries: SidebarEntry[]): boolean {
	return entries.some((entry) =>
		entry.type === 'link' ? entry.isCurrent : containsCurrent(entry.entries)
	);
}

/**
 * Groups autogenerated from a directory take the directory name verbatim, so
 * `reference/settings` shows up as "settings" next to a hand-written "Reference".
 * Same fix the breadcrumbs use, kept in step with them.
 */
const label = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

interface Props {
	sublist: StarlightRouteData['sidebar'];
	nested?: boolean;
}

const { sublist, nested } = Astro.props;
---

<ul class:list={{ 'top-level': !nested, nested }}>
	{
		sublist.map((entry) =>
			entry.type === 'link' ? (
				<li>
					<a
						href={entry.href}
						aria-current={entry.isCurrent && 'page'}
						class:list={['entry-link', entry.attrs.class]}
						{...entry.attrs}
					>
						<span class="entry-label">{entry.label}</span>
						{entry.badge && (
							<span class:list={['entry-badge', `variant-${entry.badge.variant}`]}>
								{entry.badge.text}
							</span>
						)}
					</a>
				</li>
			) : (
				<li>
					{/* Open when it holds the current page, or when the author didn't
					    mark the group collapsed in astro.config.mjs. */}
					<details open={containsCurrent(entry.entries) || !entry.collapsed}>
						<summary class="entry-title">
							<Icon name="right-caret" class="caret" size="0.85rem" />
							<span class="group-label">{label(entry.label)}</span>
							{entry.badge && (
								<span class:list={['entry-badge', `variant-${entry.badge.variant}`]}>
									{entry.badge.text}
								</span>
							)}
						</summary>
						<SidebarRestorePoint />
						<Astro.self sublist={entry.entries} nested />
					</details>
				</li>
			)
		)
	}
</ul>

<style>
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.075rem;
	}

	ul.top-level {
		padding-block: 0.5rem;
	}

	/* Indent guide for nested groups and their links. */
	ul.nested {
		margin-inline-start: 0.6rem;
		padding-inline-start: 0.5rem;
		border-inline-start: 1px solid var(--sl-color-gray-5, #2a2a2a);
	}

	.entry-title {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.4rem;
		border-radius: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		user-select: none;
		list-style: none;
	}

	.entry-title::-webkit-details-marker {
		display: none;
	}

	.entry-title:hover {
		color: var(--sl-color-white);
	}

	.group-label {
		flex: 1;
		min-width: 0;
	}

	.caret {
		flex-shrink: 0;
		transition: transform 0.15s ease-in-out;
	}

	details[open] > .entry-title > .caret {
		transform: rotateZ(90deg);
	}

	:global([dir='rtl']) .caret {
		transform: rotateZ(180deg);
	}

	.entry-link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		/* `width: fit-content` plus a fixed height is what made wrapped labels
		   overlap the row below in the theme's version. */
		width: 100%;
		min-height: 1.75rem;
		padding: 0.25rem 0.45rem;
		border-radius: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		font-weight: 450;
		line-height: 1.35;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.entry-label {
		flex: 1;
		min-width: 0;
	}

	.entry-link:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	.entry-link[aria-current='page'] {
		color: var(--sl-color-white);
		font-weight: 600;
		background-color: var(--sl-color-gray-6);
	}

	.entry-badge {
		flex-shrink: 0;
		padding: 0.05em 0.4em;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		color: var(--sl-color-accent-high);
		background-color: var(--sl-color-accent-low);
		font-size: 0.65rem;
		font-weight: 600;
		line-height: 1.5;
	}
</style>
