{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_tr_thumbkey",
    "name": "türkçe thumb-key",
    "langId": "tr",
    "version": 2,
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": "ö",
              "flick": {
                "left": "o",
                "up_left": "`",
                "up": "\\",
                "up_right": "/",
                "down_right": "p",
                "down": "q",
                "down_left": "("
              },
              "flickShift": {
                "up_left": "~",
                "up_right": "%"
              }
            },
            {
              "label": "g",
              "flick": {
                "left": "<",
                "up_left": "\"",
                "up": "^",
                "right": ">",
                "down": "ğ"
              }
            },
            {
              "label": "l",
              "flick": {
                "up_left": "=",
                "up_right": "+",
                "down_right": ")",
                "down_left": "n"
              }
            },
            {
              "label": "😊",
              "action": {
                "type": "emoji"
              },
              "flickActions": {
                "left": {
                  "action": {
                    "type": "language_switch"
                  }
                },
                "up": {
                  "action": {
                    "type": "tool",
                    "tool": "SETTINGS"
                  }
                },
                "right": {
                  "action": {
                    "type": "tool",
                    "tool": "ONE_HANDED"
                  }
                },
                "down": {
                  "action": {
                    "type": "switch_input_method"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "tool",
                    "tool": "VOICE"
                  }
                }
              }
            }
          ],
          [
            {
              "label": "y",
              "flick": {
                "left": "@",
                "up": "$",
                "up_right": "w",
                "right": "v",
                "down_right": "z",
                "down": "&",
                "down_left": "|"
              },
              "flickShift": {
                "left": "#",
                "up": "€"
              }
            },
            {
              "label": "m",
              "flick": {
                "left": "d",
                "up_left": "f",
                "up_right": "h",
                "right": "e",
                "down_right": "ç",
                "down_left": "c"
              }
            },
            {
              "label": "r",
              "flick": {
                "left": "ş",
                "up_left": "s",
                "right": "\t",
                "down_left": "t"
              },
              "flickActions": {
                "up": {
                  "action": {
                    "type": "shift"
                  }
                },
                "down": {
                  "action": {
                    "type": "shift_off"
                  }
                }
              },
              "flickReturn": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "CASE_UP"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "CASE_DOWN"
                  }
                }
              }
            },
            {
              "label": "123",
              "action": {
                "type": "symbols"
              },
              "flickActions": {
                "up_left": {
                  "action": {
                    "type": "edit",
                    "op": "SELECT_ALL"
                  }
                },
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "COPY"
                  }
                },
                "up_right": {
                  "action": {
                    "type": "edit",
                    "op": "CUT"
                  }
                },
                "down_right": {
                  "action": {
                    "type": "tool",
                    "tool": "REDO"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "PASTE"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "tool",
                    "tool": "UNDO"
                  }
                }
              },
              "flickReturn": {
                "up_left": {
                  "action": {
                    "type": "edit",
                    "op": "SELECT_LINE"
                  }
                },
                "down": {
                  "action": {
                    "type": "tool",
                    "tool": "CLIPBOARD"
                  }
                }
              }
            }
          ],
          [
            {
              "label": "a",
              "flick": {
                "up_left": "{",
                "up_right": "b",
                "down_right": "!",
                "down": ",",
                "down_left": "["
              },
              "flickShift": {
                "left": "https://"
              }
            },
            {
              "label": "k",
              "flick": {
                "left": "?",
                "up": "j",
                "up_right": "'",
                "right": "x",
                "down_right": "-",
                "down": ".",
                "down_left": "*"
              },
              "flickShift": {
                "down_right": "_"
              }
            },
            {
              "label": "i",
              "flick": {
                "left": "ı",
                "up_left": "ü",
                "up": "u",
                "up_right": "}",
                "down_right": "]",
                "down": ":",
                "down_left": ";"
              },
              "shiftLabel": "İ",
              "flickShift": {
                "right": ".com"
              }
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              },
              "flickActions": {
                "right": {
                  "action": {
                    "type": "edit",
                    "op": "DELETE_WORD_FORWARD"
                  }
                }
              }
            }
          ],
          [
            {
              "label": " ",
              "action": {
                "type": "space"
              },
              "flickActions": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "HOME"
                  }
                },
                "down_right": {
                  "action": {
                    "type": "edit",
                    "op": "WORD_RIGHT"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "END"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "edit",
                    "op": "WORD_LEFT"
                  }
                }
              },
              "flickReturn": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "DOC_START"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "DOC_END"
                  }
                }
              },
              "width": 3,
              "spaceCycle": [
                ", ",
                ". ",
                "? ",
                "! ",
                ": ",
                "; "
              ]
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              },
              "actionAlternates": [
                {
                  "action": {
                    "type": "newline"
                  },
                  "label": "↵"
                }
              ]
            }
          ]
        ],
        "bottomRowAsLaidOut": true
      },
      "symbols": {
        "rows": [
          [
            {
              "label": "1",
              "flick": {
                "down_left": "$"
              }
            },
            {
              "label": "2",
              "flick": {
                "left": "+",
                "up_left": "`",
                "up": "^",
                "up_right": "´",
                "right": "!",
                "down_right": "\\",
                "down_left": "/"
              }
            },
            {
              "label": "3",
              "flick": {
                "left": "?",
                "down_right": "€",
                "down": "=",
                "down_left": "£"
              }
            },
            {
              "label": "😊",
              "action": {
                "type": "emoji"
              },
              "flickActions": {
                "left": {
                  "action": {
                    "type": "language_switch"
                  }
                },
                "up": {
                  "action": {
                    "type": "tool",
                    "tool": "SETTINGS"
                  }
                },
                "right": {
                  "action": {
                    "type": "tool",
                    "tool": "ONE_HANDED"
                  }
                },
                "down": {
                  "action": {
                    "type": "switch_input_method"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "tool",
                    "tool": "VOICE"
                  }
                }
              }
            }
          ],
          [
            {
              "label": "4",
              "flick": {
                "left": "(",
                "up_left": "{",
                "up_right": "%",
                "down_right": "_",
                "down_left": "["
              }
            },
            {
              "label": "5"
            },
            {
              "label": "6",
              "flick": {
                "up_left": "|",
                "up_right": "}",
                "right": ")",
                "down_right": "]",
                "down_left": "@"
              }
            },
            {
              "label": "ABC",
              "action": {
                "type": "letters"
              },
              "flickActions": {
                "up_left": {
                  "action": {
                    "type": "edit",
                    "op": "SELECT_ALL"
                  }
                },
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "COPY"
                  }
                },
                "up_right": {
                  "action": {
                    "type": "edit",
                    "op": "CUT"
                  }
                },
                "down_right": {
                  "action": {
                    "type": "tool",
                    "tool": "REDO"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "PASTE"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "tool",
                    "tool": "UNDO"
                  }
                }
              },
              "flickReturn": {
                "up_left": {
                  "action": {
                    "type": "edit",
                    "op": "SELECT_LINE"
                  }
                },
                "down": {
                  "action": {
                    "type": "tool",
                    "tool": "CLIPBOARD"
                  }
                }
              }
            }
          ],
          [
            {
              "label": "7",
              "flick": {
                "up_left": "~",
                "down_right": ":",
                "down_left": "<"
              }
            },
            {
              "label": "8",
              "flick": {
                "left": ",",
                "up_left": "\"",
                "up_right": "'",
                "down_right": "-",
                "down": ".",
                "down_left": "*"
              }
            },
            {
              "label": "9",
              "flick": {
                "left": "#",
                "up": "&",
                "up_right": "°",
                "down_right": ">",
                "down_left": ";"
              }
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              },
              "flickActions": {
                "right": {
                  "action": {
                    "type": "edit",
                    "op": "DELETE_WORD_FORWARD"
                  }
                }
              }
            }
          ],
          [
            {
              "label": "0",
              "width": 2
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              },
              "flickActions": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "HOME"
                  }
                },
                "down_right": {
                  "action": {
                    "type": "edit",
                    "op": "WORD_RIGHT"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "END"
                  }
                },
                "down_left": {
                  "action": {
                    "type": "edit",
                    "op": "WORD_LEFT"
                  }
                }
              },
              "flickReturn": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "DOC_START"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "DOC_END"
                  }
                }
              },
              "spaceCycle": [
                ", ",
                ". ",
                "? ",
                "! ",
                ": ",
                "; "
              ]
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              },
              "actionAlternates": [
                {
                  "action": {
                    "type": "newline"
                  },
                  "label": "↵"
                }
              ]
            }
          ]
        ],
        "bottomRowAsLaidOut": true
      }
    }
  }
}
