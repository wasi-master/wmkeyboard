                "left": {
                  "action": {
                    "type": "language_switch"
                  }
                },
                "up": {
                  "action": {
                    "type": "tool",
                    "tool": "SETTINGS"
                  }
                },
                "right": {
                  "action": {
                    "type": "tool",
                    "tool": "ONE_HANDED"
                  }
                },
                "down": {
