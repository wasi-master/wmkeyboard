                "right": "も",
                "down": "み"
              },
              "shiftLabel": "「",
              "flickShift": {
                "left": "〔",
                "up": "〖",
                "right": "『",
                "down": "【"
              }
            },
            {
              "label": "は",
              "flick": {
                "left": "ふ",
                "up": "へ",
                "right": "ほ",
                "down": "ひ"
              },
              "shiftLabel": "・",
              "flickShift": {
                "down": "※"
              }
            },
            {
              "label": "さ",
              "flick": {
                "left": "す",
                "up": "せ",
                "right": "そ",
                "down": "し"
              },
              "shiftLabel": "」",
