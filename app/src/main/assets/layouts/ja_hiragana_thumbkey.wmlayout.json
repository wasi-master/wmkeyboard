                "up": {
                  "action": {
                    "type": "shift"
                  }
                },
                "down": {
                  "action": {
                    "type": "shift_off"
                  }
                }
              },
              "flickReturn": {
                "up": {
                  "action": {
                    "type": "edit",
                    "op": "CASE_UP"
                  }
                },
                "down": {
                  "action": {
                    "type": "edit",
                    "op": "CASE_DOWN"
                  }
