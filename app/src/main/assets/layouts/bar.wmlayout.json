{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_bar",
    "name": "Boarisch (Bavarian)",
    "langId": "bar",
    "version": 2,
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": "q"
            },
            {
              "label": "w"
            },
            {
              "label": "e",
              "longPress": [
                "é",
                "è",
                "ê",
                "ë",
                "ĕ",
                "ē"
              ]
            },
            {
              "label": "r"
            },
            {
              "label": "t"
            },
            {
              "label": "y"
            },
            {
              "label": "u",
              "longPress": [
                "ü",
                "ú",
                "û"
              ]
            },
            {
              "label": "i",
              "longPress": [
                "í",
                "î",
                "ì",
                "ï"
              ]
            },
            {
              "label": "o",
              "longPress": [
                "ö",
                "ò",
                "ó",
                "ô",
                "œ",
                "ŏ"
              ]
            },
            {
              "label": "p"
            }
          ],
          [
            {
              "label": "a",
              "longPress": [
                "ä",
                "å",
                "à",
                "ã",
                "á",
                "â",
                "ă",
                "æ"
              ]
            },
            {
              "label": "s",
              "longPress": [
                "ß"
              ]
            },
            {
              "label": "d"
            },
            {
              "label": "f"
            },
            {
              "label": "g"
            },
            {
              "label": "h"
            },
            {
              "label": "j"
            },
            {
              "label": "k"
            },
            {
              "label": "l"
            }
          ],
          [
            {
              "label": "⇧",
              "action": {
                "type": "shift"
              },
              "width": 1.5
            },
            {
              "label": "z"
            },
            {
              "label": "x"
            },
            {
              "label": "c"
            },
            {
              "label": "v"
            },
            {
              "label": "b"
            },
            {
              "label": "n",
              "longPress": [
                "ñ"
              ]
            },
            {
              "label": "m"
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              },
              "width": 1.5
            }
          ],
          [
            {
              "label": "?123",
              "action": {
                "type": "symbols"
              },
              "width": 1.5
            },
            {
              "label": ",",
              "longPress": [
                "!",
                "?"
              ],
              "role": "Comma"
            },
            {
              "label": "🌐",
              "action": {
                "type": "language_switch"
              }
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              },
              "width": 4
            },
            {
              "label": ".",
              "longPress": [
                "…",
                ",",
                "?",
                "!",
                ":",
                ";"
              ],
              "role": "Period"
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              },
              "width": 1.5
            }
          ]
        ]
      }
    }
  }
}
