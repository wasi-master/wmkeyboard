  "sequenceRules": [
    {
      "pattern": "´{acute_base}",
      "replace": "{acute:acute_base}",
      "undo": true
    },
    {
      "pattern": "`{grave_base}",
      "replace": "{grave:grave_base}",
      "undo": true
    },
    {
      "pattern": "^{circumflex_base}",
      "replace": "{circumflex:circumflex_base}",
      "undo": true
    },
    {
      "pattern": "~{tilde_base}",
      "replace": "{tilde:tilde_base}",
      "undo": true
    },
    {
      "pattern": "¨{diaeresis_base}",
      "replace": "{diaeresis:diaeresis_base}",
      "undo": true
    },
    {
      "pattern": "°{ring_base}",
      "replace": "{ring:ring_base}",
      "undo": true
    },
    {
      "pattern": "¸{cedilla_base}",
      "replace": "{cedilla:cedilla_base}",
      "undo": true
    },
    {
      "pattern": "ˇ{caron_base}",
      "replace": "{caron:caron_base}",
      "undo": true
    },
    {
      "pattern": "¯{macron_base}",
      "replace": "{macron:macron_base}",
      "undo": true
    }
  ]
