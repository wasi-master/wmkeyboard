<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only used by the optional network tools: weather (Open-Meteo),
         dictionary, translate, GIF/stickers (KLIPY/GIPHY), web/image
         search (Brave/Google). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read by the model downloaders to ask "is this connection metered?"
         before pulling hundreds of megabytes. Declared here rather than
         inherited from a dependency: the full flavour picks it up transitively
         from ML Kit, but the lite flavour ships without those libraries, so
         without this line ConnectivityManager.isActiveNetworkMetered throws a
         SecurityException on lite builds. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only used by the optional camera tool (photo into the chat). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only used by the optional voice input tool; audio goes to the
         device's speech recognizer while dictating, never stored. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only used by the optional contact-name suggestions setting; names
         are read into memory for the suggestion strip, never stored. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Only used by the optional calendar tool to list the day's events;
         read-only, never written, and only queried while the tool is open. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Only used by the optional "Add words to the system dictionary" setting.
         Since API 23 the provider grants the active IME access without a
         grantable permission, so this is a no-op on modern devices; declared
         for the older behaviour and documentation. Off by default. -->
    <uses-permission
        android:name="android.permission.READ_USER_DICTIONARY"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_USER_DICTIONARY"
        tools:ignore="ProtectedPermissions" />

    <!-- Only used by the optional "Show source app" clipboard setting; lets the
         keyboard note which app a clip was copied from. The user grants it
         explicitly in system Settings (Usage Access); off by default. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Save-to-gallery on API 24-28 only. From API 29 scoped storage lets an
         app write its own media without any permission, so this is capped. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Only used by the optional "User screenshots" clipboard setting. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Only used by the optional fingerprint lock in Privacy, which puts a
         BiometricPrompt in front of the settings screens and destructive
         actions the user picked. Install-time and non-dangerous: it asks the
         system to check a fingerprint, and never sees the biometric itself.
         Nothing requests it when the lock is off. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- The keyboard-mode editor lists installed apps (launcher activities)
         so a mode can be bound to specific apps; Android 11+ hides the app
         list without this. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Mail apps, for the bug-report and "report this generation" rows. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Play services, so the two features that need it can be left out on
             a device that does not have it: the document scanner is a Play
             services activity, and the Google Fonts choices come from the font
             provider below. Without these two lines package visibility hides
             both from PackageManager on API 30+, and a phone that has Play
             services reads as a phone that does not. Narrow entries by design;
             the app asks for no broad package query permission. -->
        <package android:name="com.google.android.gms" />
        <provider android:authorities="com.google.android.gms.fonts" />
    </queries>

    <!-- Cleartext HTTP is only for the AI tool's self-hosted providers
         (Ollama / LM Studio on a LAN address); every bundled cloud client
         is HTTPS. -->
    <!-- Backup is allowed here but does not happen unless the user turns it on
         under Settings → Privacy: WMBackupAgent writes nothing while that
         switch is off, and fullBackupOnly keeps the agent on the Auto Backup
         path so the rules files below still do the filtering. -->
    <!-- android:name is here only so the crash handler is installed before any
         other app code in the process — including the content-provider
         initialisers that run before the first activity. See WMApplication. -->
    <application
        android:name="com.wasimaster.wmkeyboard.app.WMApplication"
        android:allowBackup="true"
        android:backupAgent="com.wasimaster.wmkeyboard.app.WMBackupAgent"
        android:fullBackupOnly="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WMKeyboard">

        <!--
             Play-channel builds use the unbundled ML Kit artifacts (see
             :feature:ime), whose models Play services downloads on demand.
             This line asks Play to fetch the OCR and barcode models at
             install time instead, so the scanner tools work on first open.
             Harmless everywhere else: the bundled artifacts in sideload
             builds carry their models and nothing reads this entry, and lite
             builds ship no ML Kit at all.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />

        <!--
             singleTop so a second deep link reaches the running instance
             through onNewIntent instead of stacking another copy of the
             settings app on top of the first.
        -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                 Addon deep links: wmkeyboard://addons, wmkeyboard://repo?url=…
                 and wmkeyboard://addon?repo=…&id=…. A custom scheme rather than
                 https App Links — there is no domain to verify and no
                 assetlinks.json to host. Following one only ever navigates:
                 installing an addon, and adding a repository, stay explicit
                 taps on the screen it lands on. Parsed by AddonDeepLink.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wmkeyboard" android:host="addons" />
                <data android:scheme="wmkeyboard" android:host="repo" />
                <data android:scheme="wmkeyboard" android:host="addon" />
            </intent-filter>

            <!--
                 Settings deep links: wmkeyboard://settings/<route> for a
                 screen, wmkeyboard://setting/<name> for one row on whichever
                 screen holds it. Parsed by SettingsDeepLink against the
                 SettingsRoutes allowlist and the settings search index; a link
                 naming neither navigates nowhere.

                 Browsable, so a link in the documentation, a support reply or
                 a forum post opens the screen it names. Safe to be: following
                 one only ever *navigates*. It cannot flip a switch, press a
                 button or change a value — `?setting=` scrolls a row into view
                 and pulses it, and the user is the one who then touches it —
                 and the screens holding what the keyboard has learned stay
                 behind the fingerprint lock, which gates by route and so
                 treats a link exactly as it treats a tap.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wmkeyboard" android:host="settings" />
                <data android:scheme="wmkeyboard" android:host="setting" />
            </intent-filter>

            <!--
                 Long-press the launcher icon → straight into a settings screen.
                 Static shortcuts, so the platform publishes them at install
                 time and there is no ShortcutManager code to keep in step. The
                 shortcut intents are explicit (they name this class) and carry
                 the same wmkeyboard://settings links as the filter above. See
                 res/xml/shortcuts.xml and app/SettingsDeepLink.kt.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
             Where an opened .wmtheme.json / .wmlayout.json / .wmsettings.json /
             .wmconfig.json / .wmsnippets.json / .wmstickers / .wmicons lands:
             one confirm dialog, the import, a result. Deliberately not
             MainActivity — tapping a theme in a file manager should not drop
             anyone into the settings app.
        -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.ImportFileActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/import_file_label"
            android:theme="@style/Theme.WMKeyboard.Import">
            <!--
                 File associations for the keyboard's own export formats. Every one
                 of them is JSON or a ZIP, so filtering on MIME type would claim
                 every .json and every archive on the device; these match on the
                 file name instead, which is why the exports write compound
                 extensions (.wmtheme.json, never plain .json).

                 pathPattern has no backtracking, so ".*\\.wmtheme\\.json" alone
                 fails on a name that already contains a dot ("my.theme.wmtheme.json")
                 — hence one extra ".*\\." variant per additional dot. Path matching
                 is also only applied when an authority is declared, hence host="*",
                 which in turn rules out file:// URIs; nothing has sent those since
                 API 24. Two filters because an intent with no type only ever matches
                 a filter with no type.

                 Keep in step with WMFileTypes.EXTENSIONS.
            -->
            <intent-filter android:label="@string/import_file_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\.flex" />
                <data android:pathPattern=".*\\..*\\.flex" />
                <data android:pathPattern=".*\\..*\\..*\\.flex" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.flex" />
                <data android:pathPattern=".*\\.kmp" />
                <data android:pathPattern=".*\\..*\\.kmp" />
                <data android:pathPattern=".*\\..*\\..*\\.kmp" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.kmp" />
            </intent-filter>

            <intent-filter android:label="@string/import_file_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmtheme\\.json" />
                <data android:pathPattern=".*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmlayout\\.json" />
                <data android:pathPattern=".*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmsettings\\.json" />
                <data android:pathPattern=".*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmconfig\\.json" />
                <data android:pathPattern=".*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmconfig\\.enc" />
                <data android:pathPattern=".*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmstickers" />
                <data android:pathPattern=".*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmicons" />
                <data android:pathPattern=".*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmsnippets\\.json" />
                <data android:pathPattern=".*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.wmplugin" />
                <data android:pathPattern=".*\\.flex" />
                <data android:pathPattern=".*\\..*\\.flex" />
                <data android:pathPattern=".*\\..*\\..*\\.flex" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.flex" />
                <data android:pathPattern=".*\\.kmp" />
                <data android:pathPattern=".*\\..*\\.kmp" />
                <data android:pathPattern=".*\\..*\\..*\\.kmp" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.kmp" />
            </intent-filter>
        </activity>

        <!-- Invisible one-shot activity: the IME cannot show the runtime
             permission dialog itself, so the camera tool bounces through
             this to request android.permission.CAMERA.

             Every trampoline the IME launches carries taskAffinity="": the
             launch needs FLAG_ACTIVITY_NEW_TASK (a Service is starting it),
             and with the default affinity that flag *fronts the settings
             task* whenever one sits in recents — finishing the translucent
             trampoline then strands the user in the settings app instead of
             the field they were typing in. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.CameraPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Same trampoline pattern for the voice input tool's
             android.permission.RECORD_AUDIO. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Same trampoline pattern for save-to-gallery's
             android.permission.WRITE_EXTERNAL_STORAGE (API 24-28 only). -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.StoragePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Same trampoline pattern for the calendar tool's
             android.permission.READ_CALENDAR. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.CalendarPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Same trampoline pattern for the screenshot setting's
             android.permission.READ_MEDIA_IMAGES (or READ_EXTERNAL_STORAGE). -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.ImagesPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Notification access, usage access and the accessibility service are
             granted on a system Settings screen rather than through a permission
             dialog, so there is nothing to trampoline *through* — but the
             prominent disclosure still has to be shown before the user gets
             there, and the IME cannot host a dialog outside its own window.
             This activity shows it and then opens the right Settings page. See
             core/common SpecialAccess.kt. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.SpecialAccessActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Invisible trampoline that runs ML Kit's full-screen document
             scanner for the doc-scan tool; the IME commits the scanned
             pages once the target app gets focus back. No noHistory here —
             it would kill the scanner's activity result. singleTask keeps a
             double-tap from stacking two scanners; the result still arrives
             because this activity is the *caller*, not the callee. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.DocScanActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
             The crash report screen, shown instead of Android's "app has
             stopped" dialog in a build made with -Pwmkb.enableCrashScreen=true.
             A normal build never launches it.

             Its own process, because the one that crashed is killed a moment
             after this is started. Its own task affinity and excludeFromRecents,
             so it never lands on top of (or inside) the settings task. A
             platform theme rather than the app's, because the app's theme is one
             of the things that may have just crashed.
        -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.CrashReportActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- Serves copied clipboard images to target apps via commitContent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_file_paths" />
        </provider>

        <!--
             directBootAware: the keyboard has to run before the user has ever
             unlocked the phone — that is the screen where they type the PIN
             that does the unlocking, and the platform silently swaps in a
             different IME for any keyboard that cannot. In that window there is
             no credential-encrypted storage: no filesDir, no settings
             DataStore, no learned words. See
             com.wasimaster.wmkeyboard.core.directboot.DirectBoot for what the
             service reads instead, and DirectBootSettings for what it turns off
             until the unlock arrives.
        -->
        <service
            android:name="com.wasimaster.wmkeyboard.ime.WMKeyboardService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
             Carves the keyboard's own window out of TalkBack's touch handling
             so the keyboard's gestures (spacebar cursor slide, backspace word
             swipe, glide typing, handwriting) still work while a screen reader
             is running. Only an accessibility service may call
             setTouchExplorationPassthroughRegion, which is the only reason
             this exists — it subscribes to no events and cannot read window
             content. Off until the user enables it in Settings ›
             Accessibility, and inert unless the keyboard's screen-reader mode
             is set to pass-through. Runs in the app's main process, so the IME
             hands it the rectangle in-process via KeyboardPassthrough.
        -->
        <service
            android:name="com.wasimaster.wmkeyboard.core.accessibility.TouchPassthroughService"
            android:exported="true"
            android:label="@string/passthrough_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/passthrough_service" />
        </service>

        <!-- Notification listener with two jobs, both user-visible. The
             media-control tool needs it because the platform hands the active
             media session only to an enabled listener. One-time-code capture
             then reads posted notifications to offer the code on the
             suggestion strip, and only while its own setting is on
             (NotificationOtpCapture.isEnabled gates onNotificationPosted).
             The label must keep naming both, since this string is what the
             user reads in Settings › Notification access before granting.
             Never rename the component: the grant is stored against it. -->
        <service
            android:name="com.wasimaster.wmkeyboard.core.media.MediaNotificationListener"
            android:exported="false"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Catches the Dropbox and OneDrive sign-in redirect and finishes at
             once; the settings screen is what reacts. A custom scheme rather
             than an https App Link because there is no domain to verify and
             nothing to host. It carries only an authorization code, which is
             useless without the PKCE verifier that never left the device.
             singleTask so a redirect reaches the existing instance. -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.oauth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wmkeyboard" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Runs the automatic backup. Scheduled by AutoBackupScheduler, which
             names this class as a string because it lives in :app and the
             scheduler lives in :core:settings; AutoBackupSchedulerTest reads
             this file to check the two still agree. Not persisted across
             reboots, so the app needs no RECEIVE_BOOT_COMPLETED: whoever starts
             first afterwards schedules it again, and that is the keyboard. -->
        <service
            android:name="com.wasimaster.wmkeyboard.app.AutoBackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
