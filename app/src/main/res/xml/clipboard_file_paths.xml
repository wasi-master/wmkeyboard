<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path name="clipboard_images" path="clipboard/images/" />
    <files-path name="camera_captures" path="camera/" />
    <files-path name="doc_scans" path="docscan/" />
    <!-- The user's own sticker packs, committed straight from storage. -->
    <files-path name="sticker_packs" path="stickers/" />
    <!-- Picture snippets, committed straight from storage. -->
    <files-path name="snippet_images" path="snippets/images/" />
    <!-- Files a paired computer sent over KDE Connect, below Android 10 where
         they cannot go to Downloads without a storage permission. -->
    <files-path name="kde_received" path="kdeconnect/received/" />
    <!-- Downloaded GIFs/stickers/search images, committed via commitContent. -->
    <cache-path name="media_cache" path="media/" />
    <!-- Emoji mixes: images fetched from a source, and the pictures in an imported pack. -->
    <cache-path name="emoji_mix" path="emoji_mix/" />
    <files-path name="emoji_mix_packs" path="emoji_mix/" />
    <!-- A note shared as a .md or .txt file from the Notes screen. -->
    <!-- The Send files tool: field text saved as a file to upload, and copies made for sending. -->
    <cache-path name="send" path="send/" />
    <cache-path name="notes_share" path="notes/" />
    <!-- The AI chat's Photo button (#882): where the camera app writes the shot. -->
    <cache-path name="ai_chat_camera" path="ai_chat_camera/" />
    <!-- An AI chat answer shared as a Markdown file or a PDF. -->
    <cache-path name="ai_exports" path="ai_exports/" />
    <!-- The diagnostics report, shared out of the debug log screen. -->
    <cache-path name="diagnostics" path="diagnostics/" />
    <!-- The screen a feedback report is about, shared to Telegram (#1242). -->
    <cache-path name="feedback" path="feedback/" />
</paths>
