    <string name="send_keep_direct_title">Keep a direct link up</string>
    <string name="send_keep_direct_subtitle">After a transfer, stay on the other phone\'s Wi-Fi for the next one.</string>
    <string name="send_nearby_name_title">Device name</string>
    <string name="send_nearby_name_subtitle">What other devices see. Shared with the KDE Connect tool.</string>
