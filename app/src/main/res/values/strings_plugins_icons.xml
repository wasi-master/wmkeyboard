<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for two settings screens in :app: plugin management and the icon
  editor.

  Every key starts with plugins_ so this file can never collide with the other
  :app resource files; the icon editor's keys carry the extra plugins_icons_
  prefix.

  Not here: the permission lines a plugin declares (they live in :core:plugins
  and the screen resolves PluginPermission.labelRes), the icon slot and slot
  group names (:core:icons), and the Material Symbols names in the icon picker,
  which the app derives from the icon id.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================== -->
    <!-- Plugins: the master switch and what a plugin may reach.            -->
    <!-- ================================================================== -->

    <string name="plugins_allow_title">Allow plugins</string>
    <string name="plugins_allow_subtitle">A plugin is a small tool that other people write. It runs inside a sandbox on this keyboard. This setting is not the Plugins tool on the toolbar, which only sets where the panel appears.</string>

    <string name="plugins_auto_disable_title">Switch off a plugin that hangs</string>
    <string name="plugins_auto_disable_subtitle">Turn a plugin off after it stops responding twice</string>
    <string name="plugins_auto_disable_info">A plugin gets a short time to answer. When it runs past that, the keyboard abandons its thread and counts a strike. At two strikes the keyboard switches the plugin off, so that a broken script cannot keep freezing the panel. Turn this off if you write plugins, or if your device is slow enough to be the real cause, because the keyboard cannot tell a script that hangs from a device that was busy. The keyboard still counts the strikes and still shows them, so you keep the evidence and give up only the switching off. This setting is on by default.</string>

    <string name="plugins_facts_title">What a plugin can and cannot do</string>
    <!-- Six list rows. Each one has a tick or a cross beside it. -->
    <string name="plugins_fact_no_typing">It cannot see what you type</string>
    <string name="plugins_fact_risky_off">It cannot use the internet, your AI model, the text you write, your clipboard, your location or your files unless you turn that on for it</string>
    <string name="plugins_fact_field_tap">Even then, it reads the text you write or your clipboard only when you tap something in its panel, and never in password fields or incognito</string>
    <string name="plugins_fact_background">It runs only while its panel is open</string>
    <string name="plugins_fact_own_panel">It can draw its own panel and do its own maths</string>
    <string name="plugins_fact_own_storage">It can save its own data, if it tells you before you install it</string>
    <string name="plugins_fact_reminders">It can show a reminder at a time that you set in it, if it tells you before you install it</string>
    <!-- Insert is the button inside a plugin panel that sends a result to the text field. -->
    <string name="plugins_facts_info_v5">A plugin lists what it can do before you install it. Some things, like the internet or reading the text you write, stay off until you turn them on for that plugin, on its page. Nothing turns on by itself.</string>

    <!-- The global switch every risky plugin permission also needs. -->
    <string name="plugins_risky_title">Allow risky permissions</string>
    <string name="plugins_risky_subtitle">Let plugins use the internet, your AI model, the text you write, your clipboard, your location or files, when you turn that on for a plugin</string>
    <string name="plugins_risky_info">This switch is off by default. While it is off, no plugin can use any of these, even one you allowed. Turning it on allows nothing by itself: you still turn each permission on for each plugin, on that plugin\'s page.</string>
    <string name="plugins_risky_confirm_title">Allow risky permissions?</string>
    <string name="plugins_risky_confirm_body">Plugins are written by other people. A plugin you allow to use the internet can send what you give it to the websites it lists. One you allow to read the text you write can read it each time you tap something in its panel. Only allow plugins you trust.</string>
    <!-- Insert is the button inside a plugin panel that sends a result to the text field. -->

    <!-- ================================================================== -->
    <!-- Plugins: the installed list and how to add one.                    -->
    <!-- ================================================================== -->

    <string name="plugins_installed_title">Installed</string>
    <string name="plugins_installed_empty">No plugins are installed yet.</string>

    <!-- Group shown after an update removed plugins written in Lua. -->
    <string name="plugins_retired_title">Removed Lua plugins</string>
    <!-- %1$s is a comma-separated list of plugin names. -->
    <string name="plugins_retired_notice">Plugins are now written in Python, so these were removed: %1$s. Their saved data is kept below. Install the Python version of a plugin and it gets its data back.</string>
    <string name="plugins_retired_dismiss">Got it</string>
    <!-- Subtitle of a removed plugin's kept data. %1$d is kilobytes, %2$d is days left before it is deleted. -->
    <plurals name="plugins_parked_subtitle">
        <item quantity="one">%1$d KB kept, deleted in %2$d day</item>
        <item quantity="other">%1$d KB kept, deleted in %2$d days</item>
    </plurals>
    <!-- Content description of the delete button on a removed plugin's kept data. %1$s is the plugin name. -->
    <string name="plugins_parked_delete">Delete the data %1$s kept</string>
    <!-- Dialog title. %1$s is the plugin name. -->
    <string name="plugins_parked_delete_confirm_title">Delete the data %1$s kept?</string>
    <string name="plugins_parked_delete_confirm_body">This cannot be undone. Installing the plugin again will start it empty.</string>

    <!-- Row subtitle under a plugin name. %1$s is the version the plugin states. -->
    <string name="plugins_row_version">Version %1$s</string>
    <!-- %1$s is the version, %2$s is the author name. -->
    <string name="plugins_row_version_author">Version %1$s by %2$s</string>
    <!-- The plugin is installed but turned off. %1$s is the version. -->
    <string name="plugins_row_version_off">Version %1$s. Turned off</string>
    <!-- The plugin is installed but turned off. %1$s is the version, %2$s is the author name. -->
    <string name="plugins_row_version_author_off">Version %1$s by %2$s. Turned off</string>

    <string name="plugins_add_title">Add</string>
    <string name="plugins_install_file_title">Install from a file</string>
    <string name="plugins_install_file_subtitle">Select a .wmplugin file</string>
    <string name="plugins_install_repo_info">You can also install plugins from an add-on repository. Look under Add-ons.</string>

