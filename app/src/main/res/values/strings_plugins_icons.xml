    <!-- One plugin: what it may do, what it saved, and its log.            -->
    <!-- ================================================================== -->

    <string name="plugins_detail_missing">That plugin is not installed anymore.</string>
    <!-- Stands in for the description when the plugin gives none. -->
    <string name="plugins_detail_no_description">No description.</string>

    <string name="plugins_detail_enabled_title">Turned on</string>
    <string name="plugins_detail_enabled_subtitle">Show this plugin in the Plugins panel</string>
    <!-- Subtitle of the same row while the "Allow plugins" master switch is off, which stops every plugin from running. -->
    <string name="plugins_detail_subsystem_off_subtitle">No plugin runs while “Allow plugins” is off, under Tools then Plugins</string>
    <!-- Subtitle of the same row when the app turned the plugin off by itself. -->
    <string name="plugins_detail_stopped_subtitle">The app turned this plugin off because it stopped responding two times</string>

    <string name="plugins_permissions_title">What it can do</string>
    <string name="plugins_permissions_none">Nothing outside its own panel</string>
    <string name="plugins_permissions_info_v5">The plugin listed these when you installed it. The ones with a switch stay off until you turn them on, and a plugin cannot ask for anything else while it runs.</string>
    <!-- Shown under a risky permission's switch while the global switch is off. -->
    <string name="plugins_permission_risky_off_subtitle">Turn on “Allow risky permissions” under Tools then Plugins first</string>
    <!-- %1$s is the permission's line, for example "Connect to the internet". The title of the confirmation before turning it on. -->
    <string name="plugins_permission_grant_title">Allow “%1$s”?</string>
    <!-- The websites a plugin may connect to. -->
    <string name="plugins_hosts_title">Websites it can connect to</string>
    <!-- Shown once after an update that added permissions or websites. %1$s lists them. -->
    <string name="plugins_new_since_update">The last update added: %1$s. They are off until you turn them on.</string>
    <string name="plugins_settings_title">Settings</string>
    <string name="plugins_setting_default_reset">Use the default</string>
    <!-- A header over permissions the plugin cannot use until the user turns them on. -->
    <string name="plugins_install_risky_intro">If you turn them on later, it can also:</string>
    <!-- Heading over the buttons a plugin adds to the bar over selected text. -->
    <string name="plugins_actions_title">Selection actions</string>
    <string name="plugins_actions_info">Buttons this plugin adds to the bar over text you select. Tapping one hands the plugin that text, and it puts back what it made of it. Undo on the bar takes the change back.</string>
    <string name="plugins_actions_settings_link">Choose which ones the bar shows</string>
    <!-- Before installing: followed by a bulleted list of the plugin's selection actions. -->
    <string name="plugins_install_actions_intro">It adds these to the bar over text you select:</string>

    <string name="plugins_storage_title">Stored data</string>
    <!-- %1$d is the space the plugin uses, %2$d is the space it may use. Both are in kilobytes.
         "KB" is a unit symbol, not a countable noun: it does not inflect. -->
    <string name="plugins_storage_used_label" tools:ignore="PluralsCandidate">Uses %1$d KB of %2$d KB</string>
    <string name="plugins_storage_subtitle">Saved on your device only</string>
    <string name="plugins_storage_clear_action">Delete the stored data</string>

    <!-- The reminders a plugin set and the app has not shown yet. -->
    <string name="plugins_reminders_title">Reminders</string>
    <string name="plugins_reminders_info">The plugin gives the app a time and a line of text. At that time the app shows the text in a notification, with the name of the plugin as its title. The plugin does not run to do this. When you turn the plugin off, its reminders stop.</string>
    <string name="plugins_reminders_empty">No reminders are set.</string>
    <string name="plugins_reminders_cancel_all_action">Cancel all reminders</string>
    <!-- Shown when Android does not let the app post notifications. A tap asks for the permission. -->
    <string name="plugins_reminders_blocked_title">Notifications are off</string>
    <string name="plugins_reminders_blocked_subtitle">The app cannot show these reminders. Tap to let it post notifications.</string>

    <string name="plugins_log_title">Log</string>
    <string name="plugins_log_info">The log shows what the plugin printed, and its errors. This helps when you write a plugin.</string>
    <string name="plugins_log_clear_action">Delete the log</string>

    <!-- %1$s is the name of the plugin. -->
    <string name="plugins_uninstall_confirm_title">Uninstall %1$s?</string>
    <string name="plugins_uninstall_confirm_body">The app deletes its script and all the data it saved from your device.</string>

