    <!-- ================================================================== -->
    <!-- Icons: the screen that replaces one icon or a whole pack.          -->
    <!-- ================================================================== -->

    <string name="plugins_icons_intro_info">You can replace any keyboard icon with a different built-in icon or with a picture of your own, as an SVG or a PNG. The built-in set is Material Symbols from Google, outlined style. An icon that sets no colours of its own follows the theme and the accent colour of the tool — a PNG counts as one when every visible pixel is the same colour, which is what a glyph drawn on a transparent background looks like. An icon that sets its own colours keeps them.</string>

    <string name="plugins_icons_pack_title">Icon pack</string>
    <string name="plugins_icons_pack_builtin_name">Built-in icons</string>
    <string name="plugins_icons_pack_builtin_supporting">Material Symbols (outlined), the set that comes with WM Keyboard</string>

    <!-- Row subtitle: how many icons a pack holds. -->
