<?xml version="1.0" encoding="utf-8"?>
<!--
  Language settings: the add-language list, the per-language detail screen and
  the dictionary download rows inside it.

  Language names, layout names and script names are not here. They are proper
  nouns that come from :core:language and stay in their own spelling.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ===== The languages summary and the add-language list ===== -->

    <!-- One-line subtitle under a language that has a built-in dictionary.
         %1$s is the name of its script, for example "Latin". -->
    <string name="languages_row_subtitle_bundled"><xliff:g id="script" example="Latin">%1$s</xliff:g>, dictionary included</string>

    <!-- Summary under the Languages row when nothing is turned on. -->
    <string name="languages_summary_empty">No languages are on</string>

    <!-- Summary under the Languages row. %1$s is the first few language names,
         already joined with commas. %2$d is how many more are on. -->
    <plurals name="languages_summary_more">
        <item quantity="one"><xliff:g id="names" example="English, Bangla">%1$s</xliff:g> and %2$d more</item>
        <item quantity="other"><xliff:g id="names" example="English, Bangla">%1$s</xliff:g> and %2$d more</item>
    </plurals>

    <!-- Why the app offers a language: it is one of the device languages. -->
    <string name="languages_suggestion_reason_system">One of the languages on your device</string>
    <!-- Why the app offers a language. %1$s is a country name from the system. -->
    <string name="languages_suggestion_reason_region">Many people type this language in <xliff:g id="country" example="Bangladesh">%1$s</xliff:g></string>
    <!-- Why the app offers a language, when the country name is not known. -->
    <string name="languages_suggestion_reason_nearby">Many people near you type this language</string>

    <string name="languages_search_hint">Search languages</string>
    <string name="languages_suggested_title">Suggested for you</string>
    <string name="languages_suggested_info">These come from the language settings and the region of your device. The keyboard does not read what you type. Your data stays on your device.</string>
    <string name="languages_all_title">All languages</string>
    <!-- Shown at the end of a language row that is already turned on. -->
    <string name="languages_added_label">Added</string>
    <!-- Empty state of the language search. %1$s is what the user typed. -->
    <string name="languages_search_empty">No languages match “<xliff:g id="search_term" example="german">%1$s</xliff:g>”.</string>

    <!-- Shown when the list is capped; the search box is the way to the rest. -->
    <plurals name="languages_search_more_count">
        <item quantity="one">%1$d more language. Search to find it.</item>
        <item quantity="other">%1$d more languages. Search to find one.</item>
    </plurals>

    <!-- ===== One language: layouts, clusters, numerals ===== -->

    <string name="languages_layouts_title">Layouts</string>
    <string name="languages_layouts_info">Each card shows the keyboard as it looks with your theme and settings. Tap a card to turn that layout on or off. Scroll the row sideways to see all the layouts.</string>
    <string name="languages_layout_keep_one">At least one layout must stay on.</string>

    <!--
      The Keyman rules row. "Rules" is the word the Keyman project uses for the
      part that decides what a key types, so someone who knows the keyboard
      recognises it, and someone who does not gets told what it means in the
      subtitle rather than in a term they have to look up.
    -->
    <!--
      Names its layout because a language can offer several Keyman keyboards
      and their rows stack under one heading, where a bare "Typing rules"
      belongs to whichever toggle happens to sit above it.
    -->
    <string name="languages_keyman_rules_title_for">Typing rules for %1$s</string>
    <string name="languages_keyman_rules_missing">Not downloaded. Each key types the character printed on it.</string>
    <string name="languages_keyman_rules_installed">Downloaded, version %1$s. Press to remove.</string>
    <string name="languages_keyman_rules_installed_unknown">Downloaded. Press to remove.</string>
    <string name="languages_keyman_rules_checking">Checking keyman.com…</string>
    <string name="languages_keyman_rules_downloading">Downloading, %1$d%%</string>
    <string name="languages_keyman_rules_failed">Download failed. Press to try again.</string>

    <!-- Asked once, when a layout that needs rules is switched on. -->
    <string name="languages_keyman_prompt_title">Download typing rules for %1$s?</string>
    <string name="languages_keyman_prompt_body">This keyboard uses rules to decide what its keys type. Without them, each key types the character printed on it. The rules are a few kilobytes and come from keyman.com.</string>
    <string name="languages_keyman_prompt_download">Download</string>
    <string name="languages_keyman_prompt_later">Not now</string>

    <!--
      The way down to a language's converted Keyman layouts. Called "More
      layouts" and not "Keyman layouts" because the row has to mean something to
      someone who has never heard of the Keyman project; the description on the
      page itself is where that name is introduced.
    -->
    <string name="languages_more_layouts_title">More layouts</string>
    <plurals name="languages_more_layouts_subtitle">
        <item quantity="one">%1$d more layout from the Keyman project</item>
        <item quantity="other">%1$d more layouts from the Keyman project</item>
    </plurals>
    <string name="languages_more_layouts_body">These come from the Keyman project, an open collection of keyboards for languages that rarely get one. Many of them decide what a key types from rules rather than from the character printed on it, and those download a few kilobytes from keyman.com the first time you switch one on.</string>
    <string name="languages_more_layouts_count">+<xliff:g id="count" example="12">%1$d</xliff:g></string>
    <plurals name="languages_more_layouts_card_body">
        <item quantity="one">layout from the Keyman project</item>
        <item quantity="other">layouts from the Keyman project</item>
    </plurals>
    <string name="languages_more_layouts_search_hint">Search layouts</string>
    <string name="languages_more_layouts_search_empty">No layouts match “<xliff:g id="search_term" example="phonetic">%1$s</xliff:g>”.</string>
    <string name="languages_more_layouts_on_empty">None of these layouts is on. Tap a card to turn one on.</string>
    <string name="languages_more_layouts_filter_all">All</string>
    <string name="languages_more_layouts_filter_on">On</string>
    <string name="languages_keyman_card_rules_get">Get typing rules</string>
    <string name="languages_keyman_card_rules_retry">Download failed. Try again</string>
    <string name="languages_keyman_card_rules_retry_desc">Try again to download typing rules for <xliff:g id="layout" example="Khmer Angkor">%1$s</xliff:g></string>
    <string name="languages_keyman_card_rules_ready">Typing rules ready</string>
    <string name="languages_keyman_card_rules_download_desc">Download typing rules for <xliff:g id="layout" example="Khmer Angkor">%1$s</xliff:g></string>
    <string name="languages_keyman_card_rules_remove_desc">Remove typing rules for <xliff:g id="layout" example="Khmer Angkor">%1$s</xliff:g></string>
    <string name="languages_keyman_remove_title">Remove typing rules for <xliff:g id="layout" example="Khmer Angkor">%1$s</xliff:g>?</string>
    <string name="languages_keyman_remove_body">Until you download them again, each key of this layout types the character printed on it.</string>

    <string name="languages_clusters_title">Clusters</string>
    <string name="languages_conjunct_backspace_title">Conjunct-aware backspace</string>
    <!-- %1$s is a sample cluster of the script, for example "ক্ষ". -->
    <string name="languages_conjunct_backspace_subtitle">Delete a whole cluster like <xliff:g id="cluster" example="ক্ষ">%1$s</xliff:g> as one unit</string>
    <!-- Stands in for a sample cluster when the script has no sample to show. -->
    <string name="languages_conjunct_sample_fallback">a conjunct</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_conjunct_backspace_info">Backspace usually deletes one code point at a time. This sometimes leaves half-formed clusters on the screen. With this setting on, one press deletes the whole cluster while you type <xliff:g id="language" example="Bengali">%1$s</xliff:g>. Other languages keep their own setting.</string>

    <string name="languages_spelling_map_title">Spellings</string>
    <string name="languages_spelling_map_row_title">Use known spellings</string>
    <string name="languages_spelling_map_row_subtitle">Type "tmr" to get তোমার, and "table" to get টেবিল</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_spelling_map_info">Some words are not spelled the way they sound. "Table" is written টেবিল, not তাবলে, and people type "tmr" for তোমার with no vowels at all. This setting uses a list of those spellings while you type <xliff:g id="language" example="Bengali">%1$s</xliff:g>, so you get the word people write. Turn it off to get the letter-for-letter reading instead. Other languages keep their own setting.</string>
    <string name="languages_phonetic_siblings_row_title">Correct to dictionary words</string>
    <string name="languages_phonetic_siblings_row_subtitle">Type "asi" to get আছি instead of আসি</string>
    <string name="languages_phonetic_siblings_info">Romanized typing is loose, so when you press space the keyboard can replace what you typed with a dictionary word that sounds the same. "asi" becomes আছি, the word people usually mean. This happens even with autocorrect off, because it is part of how <xliff:g id="language" example="Bengali">%1$s</xliff:g> is typed. Turn it off to always get exactly what the typing rules spell. The dictionary words still show in the suggestion strip, so you can tap one. Known spellings have their own setting above.</string>

    <!-- Phonetic layouts (Avro): the corner hints that show what each roman key types. -->
    <string name="languages_translit_hints_title">Key hints</string>
    <string name="languages_translit_hints_row_title">Show the letter each key types</string>
    <string name="languages_translit_hints_row_subtitle">Put the <xliff:g id="language" example="Bengali">%1$s</xliff:g> a key is about to write in its corner</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_translit_hints_info">A phonetic layout types <xliff:g id="language" example="Bengali">%1$s</xliff:g> from roman keys, so the keys do not show what they write. This puts the answer in the corner of each key, and it follows the word you are typing: a k is ক at the start of a word, but after a consonant the same key joins to it. Shift changes the hints too, because a phonetic layout reads capitals as different letters. Choose how much of the joined letter to show. "Added" shows only the part the key writes. "Whole letter" repeats the consonant before it, so the hint is a shape that appears in real words.</string>
    <string name="languages_translit_hints_off_label">Off</string>
    <string name="languages_translit_hints_added_label">Added</string>
    <string name="languages_translit_hints_cluster_label">Whole letter</string>
    <!-- One line under each option in the key hints picker. -->
    <string name="languages_translit_hints_off_desc">The keys show only their roman letter</string>
    <string name="languages_translit_hints_added_desc">The corner shows only the part that the key writes</string>
    <string name="languages_translit_hints_cluster_desc">The corner repeats the consonant before it, so the hint is a shape from a real word</string>
    <!-- Phonetic layouts: the key map on the language's page, which roman keys type which letter. -->
    <string name="languages_keymap_title">Key map</string>
    <string name="languages_keymap_summary">Vowels, consonants, signs and the full guide</string>
    <string name="languages_keymap_vowels">Vowels</string>
    <string name="languages_keymap_vowels_note">The first letter is the vowel on its own. The second is the sign it becomes after a consonant.</string>
    <string name="languages_keymap_consonants">Consonants</string>
    <string name="languages_keymap_consonants_note">Two consonants in a row join into one letter. Type a vowel between them to keep them apart.</string>
    <string name="languages_keymap_consonants_note_guessed">Whether two consonants join is a guess from how the word is said. The suggestion strip offers the other reading.</string>
    <string name="languages_keymap_signs">Joins and signs</string>
    <string name="languages_keymap_after_consonant">After a consonant</string>
    <string name="languages_keymap_elsewhere">Anywhere else</string>
    <string name="languages_keymap_before_consonant">Before a consonant</string>
    <string name="languages_keymap_before_vowel">Before a vowel</string>
    <string name="languages_keymap_after_t">After t</string>
    <string name="languages_keymap_between_consonants">Between two consonants, keeps them apart</string>
    <string name="languages_phonetic_guide_title">Full guide</string>
    <string name="languages_phonetic_guide_subtitle">Every rule with examples, on the WM Keyboard website</string>
    <string name="languages_phonetic_guide_action">Open guide</string>

    <string name="languages_numerals_title">Numerals</string>
    <!-- Fancy Text: the styled-letters pseudo-language. -->
    <string name="languages_fancy_style_title">Style</string>
    <string name="languages_fancy_style_row_title">Fancy style</string>
    <string name="languages_fancy_style_row_subtitle">The lettering the fancy keyboard types. Also switchable from the strip over the keys.</string>
    <string name="languages_numeral_system_title">Numeral system</string>
    <!-- %1$s is the English name of the language, for example "Arabic". -->
    <string name="languages_numeral_system_subtitle">The digits that the number row and the keypad show while you type <xliff:g id="language" example="Arabic">%1$s</xliff:g></string>
    <!-- %1$s is the English name of the language. %2$s is the digits of that
         language, shown as a range, for example "٠-٩". -->
    <string name="languages_numeral_system_info">You select the digits for <xliff:g id="language" example="Arabic">%1$s</xliff:g>: its own digits, which are <xliff:g id="numeral_system" example="٠-٩">%2$s</xliff:g>, or 0-9. This applies to this language only. The keys always show the digits that you select. To set where the keyboard also types them, open Layout &amp; size, then Numerals.</string>

    <string name="languages_secondary_title">Also suggest from</string>
    <!-- %1$s is the English name of the language this screen is about. -->
    <string name="languages_phonetic_english_group">English words</string>
    <string name="languages_phonetic_english_title">Type English words as English</string>
    <string name="languages_phonetic_english_subtitle">On the phonetic layout, hello stays hello</string>
    <string name="languages_phonetic_english_info">With English picked above, the phonetic layout\'s strip already carries the word exactly as you typed it, in Latin letters, and leans English once the text around it is English.\n\nThis goes one step further: a word that reads as English and not as <xliff:g id="language" example="Bengali">%1$s</xliff:g> is written in English when you press space, and shows that way while you type it. Words both languages have follow the language of the words around them, and the word just before counts most: am after I is English, and the same letters on their own are not. A capital I on its own is always the English word. A capital letter anywhere after the first always means the phonetic layout.\n\nWhen the keyboard picks wrong, press backspace straight after the word to flip it to the other script, or tap the other one on the strip. It remembers, and after two flips it stops asking about that spelling.</string>
    <!-- Phonetic layouts (Avro, Hindi phonetic): a strip whose first two words stay in place. -->
    <string name="languages_phonetic_strip_title">Suggestion strip</string>
    <string name="languages_phonetic_strip_fixed_title">Keep the first two words in place</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_phonetic_strip_fixed_subtitle">What you typed first, the <xliff:g id="language" example="Bengali">%1$s</xliff:g> word next, then suggestions</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_phonetic_strip_fixed_info">Usually the first word on the strip is the word that the space bar will write, so the words move as you type.\n\nWith this on, the first two words always stay in the same place. On the left is what you typed, in English letters. Next to it is the <xliff:g id="language" example="Bengali">%1$s</xliff:g> that the phonetic rules make from it, letter for letter. The suggestions come after them. Tap the left word to write in English, or the word next to it to write the exact <xliff:g id="language" example="Bengali">%1$s</xliff:g> reading.\n\nThe space bar does not change: it writes the same word as before. That word shows in bold, and in the autocorrect word color if you set one. The strip does not put a word in the middle on this layout, so that the left word is always first.</string>
    <string name="languages_phonetic_strip_source_title">Suggestions after them</string>
    <string name="languages_phonetic_strip_source_subtitle">Which language fills the rest of the strip</string>
    <string name="languages_phonetic_strip_source_smart_label">Smart</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_phonetic_strip_source_native_label"><xliff:g id="language" example="Bengali">%1$s</xliff:g> only</string>
    <string name="languages_phonetic_strip_source_english_label">English only</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_phonetic_strip_source_smart_desc">Both languages. The language of the word and of the text around it comes first, and the best word of the other language gets the last place</string>
    <!-- %1$s is the English name of the language, for example "Bengali". -->
    <string name="languages_phonetic_strip_source_native_desc">Only <xliff:g id="language" example="Bengali">%1$s</xliff:g> words from the word list and the known spellings</string>
    <string name="languages_phonetic_strip_source_english_desc">Only English words that start with what you typed</string>
    <string name="languages_phonetic_english_switch_title">Switch on the suggestion strip</string>
    <string name="languages_phonetic_english_switch_subtitle">A small button beside the suggestions turns English words on and off as you type</string>
    <string name="languages_phonetic_english_switch_info">The button shows on this language\'s phonetic layout and is lit while English words are on. It is for the moment a word keeps coming out in the wrong script: tap it in the middle of the word and the word turns back before you press space.\n\nOff takes the button away and leaves the setting above exactly as you set it, so English words simply stay on. Shared by every language with a phonetic layout.</string>
    <string name="languages_secondary_info">The keyboard offers words from these languages while you type <xliff:g id="language" example="Bengali">%1$s</xliff:g>. Autocorrect never changes them.</string>
    <!-- Toast after adding a romanized language pairs it with a same-script
         language. %1$s and %2$s are English names of the two languages. -->
    <string name="languages_auto_pair_toast"><xliff:g id="language_one" example="Bangla (Romanized)">%1$s</xliff:g> and <xliff:g id="language_two" example="English">%2$s</xliff:g> now suggest each other\'s words. You can change this on each language\'s page.</string>

    <!-- ===== Dictionaries ===== -->

    <!-- Group on one language's screen: its word list, emoji keywords and
         word pairs, each with a checkbox, a Download or a Delete button. -->
    <string name="languages_dictionaries_title">Dictionaries</string>
    <string name="languages_dictionaries_info">Each item works offline after the download. The checkbox turns an item off and keeps the file. Delete removes the file from the device.</string>
    <!-- Button in the heading of the Dictionaries group. It downloads every
         item that is not on the device yet. %1$s is a size like "4.2 MB". -->
    <string name="languages_dictionaries_download_all_action">Download all (<xliff:g id="size" example="4.2 MB">%1$s</xliff:g>)</string>

    <string name="languages_words_title">Word list</string>
    <!-- The same row when one language has more than one list. %1$s tells them
         apart, for example "Brazil". -->
    <string name="languages_words_title_variant">Word list (<xliff:g id="variant" example="Brazil">%1$s</xliff:g>)</string>
    <!-- Under the word list of a language that ships one in the app. -->
    <string name="languages_words_builtin">Built-in list</string>
    <string name="languages_words_builtin_more">Built-in list. A bigger list is available.</string>
    <string name="languages_words_missing">For suggestions, autocorrect and glide typing</string>
    <!-- Dialog that opens from Download on the word list. -->
    <string name="languages_words_download_title">Download a word list</string>
    <string name="languages_words_download_variant_label">Variant</string>
    <!-- Heading over the choice between the AOSP list and the counted list. -->
    <string name="languages_words_download_source_label">Source</string>
    <!-- Tells one of a language's lists from its others, inside the row title.
         %1$s is the source ("AOSP"), %2$s the region ("Brazil"). -->
    <string name="languages_words_label_source_variant"><xliff:g id="source" example="AOSP">%1$s</xliff:g>, <xliff:g id="variant" example="Brazil">%2$s</xliff:g></string>
    <string name="languages_words_download_size_label">Size</string>
    <!-- Detail under one size in the dialog. %1$d is the most words the size
         keeps, %2$s about how much it downloads, like "1.4 MB". -->
    <plurals name="languages_words_download_size_detail">
        <item quantity="one">Up to %1$,d word, about <xliff:g id="size" example="1.4 MB">%2$s</xliff:g> to download</item>
        <item quantity="other">Up to %1$,d words, about <xliff:g id="size" example="1.4 MB">%2$s</xliff:g> to download</item>
    </plurals>
    <!-- Note at the bottom of the dialog. %1$s is a size like "1.1 MB". -->
    <string name="languages_words_download_pairs_note">The word pairs for next-word predictions download with it, about <xliff:g id="size" example="1.1 MB">%1$s</xliff:g>.</string>
    <!-- The same dialog, opened from the arrows on a word list that is already
         on the device, to swap it for a bigger or a smaller one. -->
    <string name="languages_words_resize_title">Change the size</string>
    <!-- The same, for a language with more than one list to pick from. -->
    <string name="languages_words_change_title">Change the word list</string>
    <string name="languages_words_resize_note">The list on your device stays in place until the new one has finished downloading, and is then replaced by it.</string>

    <!-- Emoji keywords row when the only keywords are ones the user imported. -->
    <string name="languages_emoji_keywords_imported">Your imported keywords</string>

    <!-- Row for the word-pair data (bigrams and trigrams) that next-word
         predictions read. -->
    <string name="languages_word_pairs_title">Word pairs</string>
    <!-- %1$s is a size like "1.1 MB". -->
    <string name="languages_word_pairs_download_size">Next-word predictions, <xliff:g id="size" example="1.1 MB">%1$s</xliff:g> to download</string>
    <!-- %1$s is the size on the device, like "3 MB". -->
    <string name="languages_word_pairs_downloaded">Next-word predictions, <xliff:g id="size" example="3 MB">%1$s</xliff:g></string>
    <string name="languages_word_pairs_failed">The download failed. Try again.</string>
    <string name="languages_word_pairs_delete_desc">Delete the word pairs</string>

    <!-- ===== Dictionary ===== -->

    <string name="languages_custom_dictionaries_title">Custom dictionaries</string>
    <string name="languages_custom_dictionaries_subtitle">Import your own word lists</string>

    <!-- State of a downloaded word list. %1$d is the number of words, %2$s its
         size on your device, for example "4 MB". -->
    <plurals name="languages_wordlist_downloaded">
        <item quantity="one">%1$,d word, <xliff:g id="size" example="4 MB">%2$s</xliff:g></item>
        <item quantity="other">%1$,d words, <xliff:g id="size" example="4 MB">%2$s</xliff:g></item>
    </plurals>
    <string name="languages_wordlist_preparing">Preparing the dictionary…</string>
    <!-- Size choice in the download menu. %1$s is the name of the size, %2$d is
         how many words that size keeps. -->
    <plurals name="languages_wordlist_size_option">
        <item quantity="one"><xliff:g id="size_name" example="Medium">%1$s</xliff:g>, up to %2$,d word</item>
        <item quantity="other"><xliff:g id="size_name" example="Medium">%1$s</xliff:g>, up to %2$,d words</item>
    </plurals>
    <!-- Progress under a running download. %1$s is how much has arrived. -->
    <string name="languages_wordlist_downloaded_bytes"><xliff:g id="size" example="2 MB">%1$s</xliff:g> downloaded</string>
    <string name="languages_wordlist_delete_desc">Delete the dictionary</string>
    <!-- The button beside Delete on a downloaded word list. Its icon is an up
         arrow when only bigger sizes are left, a down arrow when only smaller
         ones are, and both arrows in between. -->
    <string name="languages_wordlist_resize_desc">Change the word list size</string>
    <string name="languages_wordlist_change_desc">Change the word list</string>
    <string name="languages_wordlist_resize_bigger_desc">Download a bigger word list</string>
    <string name="languages_wordlist_resize_smaller_desc">Download a smaller word list</string>

    <!-- ===== Emoji keywords ===== -->

    <string name="languages_emoji_keywords_title">Emoji keywords</string>
    <!-- State of a downloaded keyword list. %1$d is the number of emoji, %2$s
         its size on your device, for example "120 KB". -->
    <plurals name="languages_emoji_dict_downloaded">
        <item quantity="one">%1$,d emoji, <xliff:g id="size" example="120 KB">%2$s</xliff:g></item>
        <item quantity="other">%1$,d emoji, <xliff:g id="size" example="120 KB">%2$s</xliff:g></item>
    </plurals>
    <!-- The same row before the download. %1$d is the number of emoji, %2$s the
         size of the download. -->
    <plurals name="languages_emoji_dict_download_size">
        <item quantity="one">%1$,d emoji, <xliff:g id="size" example="120 KB">%2$s</xliff:g> to download</item>
        <item quantity="other">%1$,d emoji, <xliff:g id="size" example="120 KB">%2$s</xliff:g> to download</item>
    </plurals>
    <string name="languages_emoji_dict_delete_desc">Delete the emoji keywords</string>

    <!-- ===== Shared download states ===== -->

    <string name="languages_download_queued">Waiting…</string>
    <string name="languages_cancel_download_desc">Cancel the download</string>
    <string name="languages_resume_action">Resume</string>

    <!-- ===== Chinese, Cantonese and Japanese options ===== -->

    <!-- Group heading. %1$s is the English name of the language. -->
    <string name="languages_cjk_options_title"><xliff:g id="language" example="Chinese">%1$s</xliff:g> options</string>
    <string name="languages_cjk_download_info">Download a bigger conversion dictionary. It holds many more characters and phrases than the built-in set. It works offline after the download.</string>
    <string name="languages_cjk_pack_unavailable">Not available yet, coming soon</string>

    <!-- A FlorisBoard language pack (.flex) holds the same code tables as the
         Cangjie and stroke packs above, as an SQLite database. Importing one
         fills those packs without a download. -->
    <string name="languages_cjk_flex_import_title">Import from FlorisBoard</string>
    <string name="languages_cjk_flex_import_subtitle">Read a FlorisBoard language pack (.flex). It can fill the Cangjie and stroke tables above.</string>
    <!-- %1$s is the name of the table inside the pack, such as "cangjie5".
         %2$d is how many characters the app read from it. Not a plural: the
         word "characters" agrees with a number that is always in the
         thousands. -->
    <string name="languages_cjk_flex_import_done" tools:ignore="PluralsCandidate">The app read <xliff:g id="table" example="cangjie5">%1$s</xliff:g> and added %2$d characters.</string>
    <!-- %1$s is the list of tables in the pack, such as "wubi, zhengma". -->
    <string name="languages_cjk_flex_import_unusable">This pack holds <xliff:g id="tables" example="wubi, zhengma">%1$s</xliff:g>. This keyboard types Cangjie and stroke, so there is nothing in it to use.</string>
    <string name="languages_cjk_flex_import_not_a_pack">That file is a FlorisBoard theme or keyboard extension, not a language pack. To import a theme, go to Themes.</string>
    <string name="languages_cjk_flex_import_unreadable">The app cannot read that file as a FlorisBoard language pack.</string>
    <!-- %1$d is the percentage that has arrived. -->
    <string name="languages_cjk_downloading_percent">Downloading… %1$d%%</string>
    <string name="languages_cjk_paused">Paused, press Resume to continue</string>
    <string name="languages_cjk_downloaded">Downloaded, works offline</string>
    <!-- %1$s is the name of the dictionary pack. -->
    <string name="languages_cjk_delete_desc">Delete <xliff:g id="pack" example="Pinyin">%1$s</xliff:g></string>

    <string name="languages_cjk_traditional_title">Traditional characters</string>
    <string name="languages_cjk_traditional_subtitle">The keyboard converts candidates to Traditional (繁體). It converts one character at a time, so a few forms that depend on context are wrong (发 → 發 / 髮).</string>
    <!-- Info text for the Traditional characters toggle. The Chinese characters
         are examples and stay as they are. 发 is the Simplified form, 發 means
         "to send" and 髮 means "hair". -->
    <string name="languages_cjk_traditional_info">The keyboard converts each candidate from Simplified (简体) to Traditional (繁體) before it shows the candidate. The conversion reads one character at a time. A few Simplified characters have more than one Traditional form, and the keyboard always writes the more common one. 发 becomes 發, which is correct in 發展 but wrong in 頭髮. Correct those words by hand.</string>
    <string name="languages_cjk_region_title">Regional wording</string>
    <string name="languages_cjk_region_info">Taiwan and Hong Kong often use different words for the same thing, not only different characters.</string>
    <string name="languages_cjk_region_generic_title">Standard</string>
    <string name="languages_cjk_region_generic_subtitle">Characters only, no changes to wording</string>
    <string name="languages_cjk_region_taiwan_title">Taiwan (臺灣)</string>
    <string name="languages_cjk_region_taiwan_subtitle" translatable="false">出租車 → 計程車, 光盤 → 光碟</string>
    <!-- Example word pairs. Chinese text, the same in every language. -->
    <string name="languages_cjk_region_hong_kong_title">Hong Kong (香港)</string>
    <string name="languages_cjk_region_hong_kong_subtitle">Character preferences of Hong Kong</string>

    <string name="languages_cjk_lazy_title">Lazy pronunciation (懶音)</string>
    <!-- Only "Match merged sounds" and "before" need translation. The rest is
         Jyutping spelling and stays as it is. -->
    <string name="languages_cjk_lazy_subtitle">Match merged sounds: n↔l, ng↔∅, gw→g before -o, -ng↔-n, -k↔-t…</string>
    <string name="languages_cjk_loose_marks_title">Match kana without marks</string>
    <!-- Only "also finds" needs translation. The rest is Japanese text and
         stays as it is. -->
    <string name="languages_cjk_loose_marks_subtitle">かつこう also finds 学校 (がっこう)</string>
    <!-- The kana are examples and stay as they are. -->
    <string name="languages_cjk_loose_marks_info">On the Flick and Kana JIS layouts, a small kana, a ゛ or a ゜ is an extra key. With this on, a plain kana also matches those forms: か finds が, つ finds っ and づ, は finds ば and ぱ, や finds ゃ. When two words are almost equally common, the one that you typed exactly comes first. A kana that you typed with a mark is not changed, and Romaji typing is not changed.</string>
    <string name="languages_cjk_full_width_space_title">Full-width space</string>
    <!-- 　 is the full-width space itself, drawn between the brackets, and stays
         as it is. -->
    <string name="languages_cjk_full_width_space_subtitle">The space bar types a full-width space [　]</string>
    <string name="languages_cjk_full_width_space_info">Japanese and Chinese text is spaced with the ideographic space (U+3000), which is as wide as one character. With this on, the space bar types it instead of the narrow space used between words in other languages. A space pressed while you are still typing a reading picks a candidate as before, and only a press with nothing waiting to convert types a space.</string>
    <string name="languages_cjk_fuzzy_title">Fuzzy Pinyin</string>
    <!-- Only "Match confusable sounds" needs translation. The rest is Pinyin
         spelling and stays as it is. -->
    <string name="languages_cjk_fuzzy_subtitle">Match confusable sounds: zh↔z, ch↔c, sh↔s, n↔l, an↔ang, in↔ing…</string>
    <string name="languages_cjk_fuzzy_pairs_info">Pick the sounds you want matched. Every one is on to start with. Switching a pair off makes your spelling of it exact again, which gives you back some precision: the ending pairs are a regional accent and cost you little, while n↔l affects every syllable that starts with either.</string>
    <!-- Subtitle under a fuzzy pair. "Initial" and "final" are the standard Pinyin terms for the start and end of a syllable. -->
    <string name="languages_cjk_fuzzy_pair_initial">Start of a syllable</string>
    <string name="languages_cjk_fuzzy_pair_final">End of a syllable</string>
    <string name="languages_cjk_fuzzy_pairs_reset_title">Match every pair again</string>
    <string name="languages_cjk_pinyin_group_title">Pinyin</string>
    <string name="languages_cjk_double_pinyin_title">Double Pinyin scheme</string>
    <string name="languages_cjk_double_pinyin_info">Double Pinyin: type each syllable with exactly two keys. It needs the Pinyin dictionary above.</string>

    <!-- Button that takes a language off the list. %1$s is its English name. -->
    <string name="languages_remove_action">Remove <xliff:g id="language" example="Bengali">%1$s</xliff:g></string>

    <!-- Dialog shown as the user adds a language. It offers the downloads that
         make the language work properly: the word list, the emoji keywords and
         the word-pair data predictions use. -->
    <string name="languages_data_download_title">Download language data?</string>
    <!-- %1$s is the language name, %2$s a data size like "4.2 MB". -->
    <string name="languages_data_download_body">The keyboard can download the data <xliff:g id="language" example="German">%1$s</xliff:g> needs to predict and correct well: a word list, emoji keywords and word-pair data, whichever of those exist. This uses about <xliff:g id="size" example="4.2 MB">%2$s</xliff:g> of data. You can also download them later from the language screen.</string>
    <string name="languages_data_download_dismiss_action">Not now</string>


    <!-- Dialog after the user removes a language that has downloaded files. -->
    <string name="languages_data_delete_title">Delete the downloaded files?</string>
    <!-- %1$s is the language name, %2$s a data size like "4.2 MB". -->
    <string name="languages_data_delete_body"><xliff:g id="language" example="German">%1$s</xliff:g> has a downloaded word list or emoji keywords. Delete them and get about <xliff:g id="size" example="4.2 MB">%2$s</xliff:g> of storage back?</string>
    <string name="languages_data_delete_dismiss_action">Keep them</string>

</resources>
