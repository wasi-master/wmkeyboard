<resources>
    <!-- Advanced › Floating button (#755): one button over other apps whose
         gestures and quick menu run whatever the user picks. It replaced the
         floating keyboard button (#374) and the floating AI button (#697). -->
    <string name="floating_button_title">Floating button</string>
    <string name="floating_button_subtitle">A button over other apps for the keyboard, voice typing, AI and any tool</string>
    <string name="floating_button_enable_title">Show the floating button</string>
    <string name="floating_button_enable_subtitle">A small round button floats over every app</string>
    <string name="floating_button_enable_info">A small round button floats over every app, with the keyboard open or closed. Tap it, double tap it or press and hold it, and it does what you set below: open the keyboard, even on a screen with no text field, start voice typing, ask the AI about the screen, or open any tool. Press and hold opens a quick menu of more actions round the button; slide onto one and let go to run it. Drag the button to move it, and it settles against the nearer side. Drag it onto the cross at the bottom of the screen to hide it until the keyboard next opens or closes. Needs Android\'s Display over other apps permission.</string>
    <string name="floating_button_screen_title">Let the button read the screen</string>
    <string name="floating_button_screenshot_title">Let the button take screenshots</string>
    <string name="floating_button_screenshot_subtitle">Screenshot needs the screenshot service on in Android\'s accessibility settings</string>
    <string name="floating_button_screen_subtitle">Ask AI can bring the text on screen with it, and Look up can find the word you tap, once the screen reading service is on</string>

    <string name="floating_button_preview_caption">Tap: %1$s · Hold: %2$s</string>
    <string name="floating_button_preview_off">Off. Turn the button on to see it over your apps.</string>

    <string name="floating_button_gestures_group">Gestures</string>
    <string name="floating_button_gestures_info">Each gesture runs one action. A tool that lives on the keyboard, such as voice typing or the clipboard, brings the keyboard up first when it is closed. With a double tap set, a single tap waits a moment to make sure no second tap is coming.</string>
    <string name="floating_button_tap_title">Tap</string>
    <string name="floating_button_double_tap_title">Double tap</string>
    <string name="floating_button_hold_title">Press and hold</string>
    <string name="floating_button_pick_title">%1$s does</string>

    <!-- The tap and double tap again, for while the keyboard is up (#626). -->
    <string name="floating_button_typing_group">While the keyboard is open</string>
    <string name="floating_button_typing_info">With the keyboard open, a tap and a double tap can do something else, such as leave the text field. Left at the same, they do what Tap and Double tap do. A double tap set only here keeps a tap with the keyboard closed from waiting.</string>
    <string name="floating_button_tap_typing_title">Tap while open</string>
    <string name="floating_button_double_tap_typing_title">Double tap while open</string>
    <string name="floating_button_same_as">Same as %1$s</string>
    <string name="floating_button_pick_same_subtitle">Does what it does with the keyboard closed</string>

    <string name="floating_button_menu_group">Quick menu</string>
    <string name="floating_button_menu_info">The quick menu fans out round the button, facing the middle of the screen. Opened by pressing and holding, slide your finger onto an action and let go to run it, or let go first and tap one. Tap anywhere else to close it. Drag the handles to reorder; the first action sits at one end of the fan.</string>
    <string name="floating_button_menu_unreached_title">No gesture opens the menu</string>
    <string name="floating_button_menu_unreached_subtitle">Tap to open it with press and hold</string>
    <string name="floating_button_menu_add_title">Add an action</string>
    <string name="floating_button_menu_add_subtitle">Up to %1$d actions</string>
    <string name="floating_button_menu_full_subtitle">The menu is full. Remove an action to add another.</string>
    <string name="floating_button_menu_empty">Nothing in the menu yet</string>
    <string name="floating_button_menu_add_pick_title">Add to the quick menu</string>
    <string name="floating_button_menu_labels_title">Show names</string>
    <string name="floating_button_menu_labels_subtitle">Each action\'s name under its icon. Off, only the one under your finger is named</string>
    <string name="floating_button_menu_reset_title">Reset the menu</string>
    <string name="floating_button_menu_reset_subtitle">Voice typing, Ask AI, clipboard, emoji and the keyboard</string>
