<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Tools screen: the list of every keyboard tool, with the on/off switch for each one. -->

    <!-- Field at the top of the Tools screen. It searches the names and the descriptions of the tools. -->
    <string name="tools_search_hint">Search tools</string>
    <!-- Heading over the tools that match what is typed in the search field. -->
    <string name="tools_search_results_title">Results</string>
    <!-- %1$s is the words the user typed in the search field. -->
    <string name="tools_search_empty">No tool matches \"<xliff:g id="query" example="emoji">%1$s</xliff:g>\".</string>

    <string name="tools_colored_icons_title">Colorful tool icons</string>
    <string name="tools_colored_icons_subtitle">Each tool gets its own accent color here and in the toolbox. Open a tool to change the color of that one icon.</string>
    <string name="tools_gradient_icons_title">Gradient tool colors</string>
    <string name="tools_gradient_icons_subtitle">Paint each tool with two colors, from the top left to the bottom right</string>
    <string name="tools_gradient_icons_info">Off, a tool is one flat color. On, every tool becomes a gradient that runs from its color at the top left to a second color at the bottom right. The second color is worked out from the first, so you need not pick one. To choose both, open the tool and set the start color and the end color.</string>
    <!-- Caption at the top of the Tools screen. The gear character marks a tool that has more settings. -->
    <string name="tools_intro_info">Tools are on the keyboard toolbar and in the toolbox. The grid button on the toolbar opens the toolbox. The switch turns a tool on. Press a row to open the settings of that tool. The ⚙ marks the tools that have options of their own.</string>
    <string name="tools_reset_colors_action">Reset custom colors</string>

    <!-- Group headings on the Tools screen, one for each kind of tool. -->
    <string name="tools_group_panels_title">Panels</string>
    <string name="tools_group_scanners_title">Scanners</string>
    <string name="tools_group_online_title">Online tools</string>
    <string name="tools_group_create_title">Create and convert</string>
    <string name="tools_group_modes_title">Keyboard modes</string>
    <string name="tools_group_cursor_title">Cursor</string>
    <string name="tools_group_quick_actions_title">Quick actions</string>
    <string name="tools_group_utilities_title">Utilities</string>
    <!-- Heading for the tools that are in no other group. -->
    <string name="tools_group_other_title">Other</string>

    <!-- Content description of the marker on a tool that has more than the on/off switch. -->
    <string name="tools_has_options_desc">This tool has more settings</string>

    <!-- Shown in place of the description when a tool cannot run until an API key is given. The switch is off and cannot be pressed. -->
    <string name="tools_needs_key_subtitle">Needs an API key. Press this row to add one.</string>
</resources>
