    <string name="tooldetail_todo_sync_group">Task app sync</string>
    <string name="tooldetail_todo_sync_title">Sync with a task app</string>
    <string name="tooldetail_todo_sync_subtitle">Keep the list the same as a task list in OpenTasks or Tasks.org. DAVx5 syncs that list with your CalDAV server.</string>
    <string name="tooldetail_todo_sync_info">WM Keyboard reads and writes the list through the task app on this phone. It never connects to your server itself; DAVx5 does that, on its own schedule.\n\nTasks you add here appear in the task app, and tasks you add there appear here. Ticks, edits and deletes go both ways. Steps stay steps. The to-do list has no reminders, so a reminder set in the task app stays there.\n\njtx Board is not supported. Its provider only answers sync adapters, and a change written that way never reaches the server.</string>
    <string name="tooldetail_todo_sync_none_subtitle">Install OpenTasks or Tasks.org, and add your CalDAV account to DAVx5, to sync. Until then the list stays on this phone.</string>
    <string name="tooldetail_todo_list_title">Task list</string>
    <string name="tooldetail_todo_list_none">None picked</string>
    <string name="tooldetail_todo_list_pick_title">Pick a task list</string>
    <!-- %1$s is a task app's name, for example "OpenTasks". -->
    <string name="tooldetail_todo_list_allow_action">Allow access to <xliff:g id="app" example="OpenTasks">%1$s</xliff:g></string>
    <string name="tooldetail_todo_list_empty">This app has no task lists yet. Add a CalDAV account in DAVx5 and tick its task lists.</string>
    <!-- %1$s is the list's name, %2$s the account it belongs to. -->
    <string name="tooldetail_todo_list_entry"><xliff:g id="list" example="Personal">%1$s</xliff:g> (<xliff:g id="account" example="me@example.com">%2$s</xliff:g>)</string>
    <string name="tooldetail_todo_sync_now_title">Sync now</string>
    <string name="tooldetail_todo_sync_now_button">Sync</string>
    <!-- %1$s is when the last sync finished. -->
    <string name="tooldetail_todo_sync_last">Last synced <xliff:g id="when" example="5 minutes ago">%1$s</xliff:g></string>
    <string name="tooldetail_todo_sync_never">Not synced yet</string>
    <!-- %1$d tasks came from the task app, %2$d went to it, %3$d were deleted there and here. -->
    <string name="tooldetail_todo_sync_done">Synced. <xliff:g id="in" example="2">%1$d</xliff:g> in, <xliff:g id="out" example="1">%2$d</xliff:g> out, <xliff:g id="removed" example="0">%3$d</xliff:g> removed.</string>
    <string name="tooldetail_todo_sync_no_list">The task list is gone. Pick another one.</string>
    <string name="tooldetail_todo_sync_no_permission">The task app\'s permission is off. Pick the list again to allow it.</string>
    <!-- %1$s is the error the task app gave. -->
    <string name="tooldetail_todo_sync_failed">The sync failed: <xliff:g id="error" example="database locked">%1$s</xliff:g></string>
