    <string name="tooldetail_todo_clear_title">Delete all tasks</string>
    <string name="tooldetail_todo_clear_subtitle">Every task and step on this phone. With sync on, the task app keeps its own tasks, and the next sync brings them back.</string>
    <string name="tooldetail_todo_clear_confirm">Delete every task? This cannot be undone. A backup that holds the To-do list section can bring them back.</string>
