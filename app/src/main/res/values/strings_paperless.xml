<resources>
    <!-- Tools › Document scanner › Paperless-ngx (#1198) -->
    <string name="paperless_group" translatable="false">Paperless-ngx</string>
    <string name="paperless_info">Send scans to your own Paperless-ngx server, with the tags, correspondent and document type you pick. Make a token in Paperless under My Profile, with the circular arrow next to API Auth Token. Scans wait on the phone until the server can be reached, then upload in the background. The token stays on this phone and out of backups.</string>
    <string name="paperless_url_title">Server address</string>
    <string name="paperless_url_hint">The address you open Paperless at, such as https://paperless.example.com</string>
    <string name="paperless_token_title">API token</string>
    <string name="paperless_token_hint">Paste the token from your profile in Paperless</string>
    <string name="paperless_check_title">Check the connection</string>
    <string name="paperless_check_subtitle">Fetches your tags, correspondents and document types</string>
    <string name="paperless_check_action">Check</string>
    <string name="paperless_check_ok">Connected: %1$d tags, %2$d correspondents, %3$d document types</string>
    <string name="paperless_check_refused">The server turned the token down (%1$d). Check the token, and that its user may add documents.</string>
    <string name="paperless_check_failed">Could not reach the server: %1$s</string>
    <string name="paperless_check_bad_url">That does not look like a web address</string>
    <string name="paperless_after_title">After a scan</string>
