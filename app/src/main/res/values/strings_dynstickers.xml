<!-- Emoji › Dynamic stickers: the words typed, drawn into sticker and meme templates. -->
<resources>
    <string name="dynsticker_screen_title">Dynamic stickers</string>
    <string name="dynsticker_row_subtitle">Your words drawn into sticker and meme templates</string>
    <string name="dynsticker_pack_screen_title">Template pack</string>
    <string name="dynsticker_builder_title">Sticker builder</string>

    <string name="dynsticker_enabled_title">Dynamic stickers</string>
    <string name="dynsticker_enabled_subtitle">A Text chip in the stickers panel, and stickers for what you type</string>
    <string name="dynsticker_enabled_info">Templates are drawn on your phone with the words you type: a decorated “Thank you”, a birthday banner, a meme with your caption. Nothing you type is sent anywhere to make them. The stickers panel gets a Text chip that fills every template with the words in its search box, and the row over the keys can offer the ones that suit your message.</string>
    <string name="dynsticker_new_template_title">Make a template</string>
    <string name="dynsticker_new_template_subtitle">Words, shapes, pictures and motion, in the builder</string>

    <string name="dynsticker_typing_title">While you type</string>
    <string name="dynsticker_in_tray_title">Offer them while typing</string>
    <string name="dynsticker_in_tray_subtitle">In the sticker row, in fields that take pictures</string>
    <string name="dynsticker_in_tray_info">When the whole message is short and a template suits it, the sticker row shows it drawn with your words. A tap sends it. Off, they are still in the stickers panel under Text.</string>
    <string name="dynsticker_match_phrase_title">Templates for the whole message</string>
    <string name="dynsticker_match_phrase_subtitle">A “Thank you” template when you type “thank you”</string>
    <string name="dynsticker_match_inside_title">Templates for part of it</string>
    <string name="dynsticker_match_inside_subtitle">The same template for “thank you so much”</string>
    <string name="dynsticker_match_feelings_title">Templates for what it means</string>
    <string name="dynsticker_match_feelings_subtitle">From the emoji and words in it: 😂, love, birthday</string>
    <string name="dynsticker_match_feelings_info">Templates carry the feelings and things they are about. An emoji in your message, or a word an emoji stands for, finds them.</string>
    <string name="dynsticker_generic_title">Templates for any words</string>
    <string name="dynsticker_generic_off">Never</string>
    <string name="dynsticker_generic_after">After a match</string>
    <string name="dynsticker_generic_always">Always</string>
    <string name="dynsticker_generic_info">Some templates suit any text. After a match fills the row with them only when something matched your message first; Always offers them for any short message; Never keeps them in the panel.</string>
    <string name="dynsticker_max_words_title">Longest message</string>
    <string name="dynsticker_max_words_info">A longer message gets no offer in the row. The panel takes any length.</string>
    <string name="dynsticker_max_in_tray_title">How many to offer</string>
    <string name="dynsticker_memes_in_tray_title">Memes in the row too</string>
    <string name="dynsticker_memes_in_tray_subtitle">Text-only memes; memes with a photo stay in the panel</string>
    <string name="dynsticker_animate_in_tray_title">Moving in the row</string>
    <string name="dynsticker_animate_in_tray_subtitle">Animated templates play in the row instead of showing a still</string>
    <string name="dynsticker_style_title">How the row looks</string>
    <string name="dynsticker_style_strip">On the strip</string>
    <string name="dynsticker_style_chip">A chip</string>
    <string name="dynsticker_style_tray">A row of their own</string>
    <string name="dynsticker_style_info">On the strip puts a few beside the words; a chip opens them with a tap; a row of their own shows them all over the keys.</string>
    <string name="dynsticker_order_title">Beside your own stickers</string>
    <string name="dynsticker_order_after">After them</string>
    <string name="dynsticker_order_first">First</string>
    <string name="dynsticker_order_only">Only when nothing else</string>
    <string name="dynsticker_order_info">When your own stickers or emoji mixes also match, dynamic stickers can follow them in the same row, come first, or wait until nothing else matches.</string>

    <string name="dynsticker_sending_title">Sending</string>
    <string name="dynsticker_send_animated_title">Send them moving</string>
    <string name="dynsticker_send_animated_subtitle">Animated stickers where the template moves</string>
    <string name="dynsticker_send_animated_info">Off sends every template as its still. Apps that take only still pictures get the still anyway.</string>
    <string name="dynsticker_panel_typed_title">Start the panel from your message</string>
    <string name="dynsticker_panel_typed_subtitle">With the search box empty, the Text grid uses what you have typed</string>
    <string name="dynsticker_font_override_title">One font for every template</string>
    <string name="dynsticker_font_override_subtitle">Instead of each template’s own</string>
    <string name="dynsticker_font_own">Each template’s own</string>
