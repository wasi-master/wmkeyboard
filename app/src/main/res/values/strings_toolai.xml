    <!-- Field labels. Anthropic, OpenAI and Gemini are product names. -->
    <string name="toolai_ai_anthropic_key_label">Anthropic API key</string>
    <string name="toolai_ai_openai_key_label">OpenAI API key</string>
    <string name="toolai_ai_gemini_key_label">Gemini API key</string>
    <!-- Helper text under an empty key field. Do not translate the web address. -->
    <string name="toolai_ai_anthropic_key_hint">Get the key from console.anthropic.com on the API keys page</string>
    <!-- Helper text under an empty key field. Do not translate the web address. -->
    <string name="toolai_ai_openai_key_hint">Get the key from platform.openai.com on the API keys page</string>
    <!-- Helper text under an empty key field. Do not translate the web address. -->
    <string name="toolai_ai_gemini_key_hint">Get a free key from aistudio.google.com</string>
    <!-- Field label. xAI is a product name. -->
    <string name="toolai_ai_xai_key_label">xAI API key</string>
    <!-- Helper text under an empty key field. Do not translate the web address. -->
    <string name="toolai_ai_xai_key_hint">Get the key from console.x.ai on the API keys page</string>
    <!-- Field label. DeepSeek is a product name. -->
    <string name="toolai_ai_deepseek_key_label">DeepSeek API key</string>
    <!-- Helper text under an empty key field. Do not translate the web address. -->
    <string name="toolai_ai_deepseek_key_hint">Get the key from platform.deepseek.com on the API keys page</string>

    <string name="toolai_ai_compatible_key_label">API key</string>
    <string name="toolai_ai_compatible_key_hint">Leave this blank if the service does not need a key</string>
    <string name="toolai_ai_compatible_url_label">Service address</string>
    <!-- Helper text under the address field. Do not translate the web addresses. -->
    <string name="toolai_ai_compatible_url_hint">For example https://openrouter.ai/api/v1. The app adds /chat/completions to the end.</string>
    <string name="toolai_ai_compatible_model_hint">Give the model name that the service uses</string>
    <!-- Caption below the fields of the other service. -->
    <string name="toolai_ai_compatible_info">Use this for a service that has the same request shape as OpenAI, for example OpenRouter, Groq, Together or Mistral. A plain HTTP address stays on your network, so keep the server on a network that you trust.</string>

    <string name="toolai_ai_model_label">Model</string>
    <!-- %1$s is the name of the model the app uses when the field is empty. Do not translate it. -->
    <string name="toolai_ai_model_hint">Leave this blank to use %1$s</string>
    <string name="toolai_ai_lm_studio_model_hint">Leave this blank to use the model that the server has loaded</string>

    <string name="toolai_ai_server_address_label">Server address</string>
    <!-- Helper text under the server address field. Do not translate the web address. -->
    <string name="toolai_ai_ollama_url_hint">For example http://192.168.0.10:11434. Use the network address of your computer.</string>
    <!-- Helper text under the server address field. Do not translate the web address or the name LM Studio. -->
    <string name="toolai_ai_lm_studio_url_hint">For example http://192.168.0.10:1234. Turn on the local server in LM Studio.</string>
    <!-- Caption below the self-hosted server fields. OLLAMA_HOST=0.0.0.0 is a
         command setting and must stay as it is. The quoted text is the name of
         a setting in LM Studio. -->
    <string name="toolai_ai_local_server_info">Start Ollama with OLLAMA_HOST=0.0.0.0 so your device can reach it. In LM Studio, turn on \"serve on local network\". The plain HTTP traffic stays on your network.</string>

    <string name="toolai_ai_output_title">Output</string>
    <string name="toolai_ai_max_tokens_title">Maximum response length</string>
    <string name="toolai_ai_max_tokens_subtitle">The limit in tokens. One token is about three quarters of a word. A reasoning model gets four times this limit, because its reasoning uses the same budget. Select the provider maximum for long text.</string>
    <!-- Chip that sends no limit, so the service applies its own. -->
    <string name="toolai_ai_max_tokens_provider_label">Provider maximum</string>
    <string name="toolai_ai_local_context_title">Context size</string>
    <string name="toolai_ai_local_context_subtitle">How much text the on-device model holds at one time, in tokens. This covers your text and the answer together. A larger size uses more memory and loads the model again.</string>
    <!-- Chip that leaves the context size to the model. -->
    <string name="toolai_ai_local_context_model_label">Model default</string>
    <string name="toolai_ai_translate_to_label">Target language for the Translate action</string>
    <!-- The three language names are examples. Keep them in English: the field takes an English language name. -->
    <string name="toolai_ai_translate_to_hint">For example English, Bengali, Japanese</string>
    <string name="toolai_ai_show_thinking_title">Show model reasoning</string>
    <!-- &lt;think&gt; is a tag the model writes around its own reasoning. Keep it as it is. -->
    <string name="toolai_ai_show_thinking_subtitle">The panel shows the &lt;think&gt; text of reasoning models instead of a progress bar</string>
    <string name="toolai_ai_model_picker_title">Model picker on the panel</string>
    <string name="toolai_ai_model_picker_subtitle">Change between the providers that you set up and the models that you download, on the keyboard</string>

    <string name="toolai_ai_diff_title">Show a changes view</string>
    <string name="toolai_ai_diff_subtitle">The panel gets a Changes button that marks what the model added and what it deleted</string>
    <string name="toolai_ai_diff_first_title">Open a result on the changes</string>
    <string name="toolai_ai_diff_first_subtitle">The panel starts on the changes instead of the plain result</string>

    <!--
      The chat screen: a full conversation with the model that the user set up
      in the AI tool, in the settings app rather than on the keyboard.
    -->
    <string name="toolai_ai_chat_group_title">Chat</string>
    <string name="toolai_ai_chat_nav_title">Chat with the model</string>
    <string name="toolai_ai_chat_nav_subtitle">Have a conversation with a model that you downloaded or set up</string>
    <string name="toolai_ai_chat_new">New chat</string>
    <string name="toolai_ai_chat_untitled">New chat</string>
    <string name="toolai_ai_chat_list_empty">No chats yet. Start one and it appears here.</string>
    <string name="toolai_ai_chat_empty_hint">Send a message to start the chat. The conversation stays on your device.</string>
    <string name="toolai_ai_chat_composer_hint">Message</string>
    <string name="toolai_ai_chat_send">Send</string>
    <string name="toolai_ai_chat_stop">Stop</string>
    <string name="toolai_ai_chat_stopped">Stopped</string>
    <string name="toolai_ai_chat_retry">Retry</string>
