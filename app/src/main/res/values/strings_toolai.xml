         Reporting a model answer. Play asks for a route like this on any
         surface that shows generated content, and the chat screen is the one
         place in the settings app that does. Mirrors the keyboard AI panel's
         ime_ai_report_action.
    -->
    <string name="toolai_ai_chat_report_action">Report</string>
    <!-- Progress caption while a reasoning model thinks before it answers. -->
    <string name="toolai_ai_chat_thinking">Reasoning…</string>
    <string name="toolai_ai_chat_delete_title">Delete this chat?</string>
    <!-- %1$s is the name of the conversation. -->
    <string name="toolai_ai_chat_delete_body">This deletes "%1$s". You cannot undo this.</string>
    <string name="toolai_ai_chat_no_backend_title">Nothing to chat with yet</string>
    <string name="toolai_ai_chat_no_backend_body">Download an on-device model or set up a provider in the AI tool settings.</string>
    <string name="toolai_ai_chat_setup_button">Open the AI tool settings</string>
    <string name="toolai_ai_chat_error_no_model">The selected model is not on your device any more. Pick another model.</string>
    <string name="toolai_ai_chat_error_generic">The model did not answer. Try again.</string>

    <string name="toolai_ai_history_group_title">History</string>
    <string name="toolai_ai_history_title">Keep a history of the results</string>
    <string name="toolai_ai_history_subtitle">The keyboard keeps what you send and what the model answers. The records stay on your device. Nothing is kept from a password field or in incognito.</string>
    <string name="toolai_ai_history_nav_title">History</string>
    <string name="toolai_ai_history_nav_subtitle">Read, copy and delete what the AI tool did</string>
    <string name="toolai_ai_history_max_title">Number of records to keep</string>
    <string name="toolai_ai_history_max_subtitle">The oldest record goes when the history is full</string>
    <string name="toolai_ai_history_search_label">Search the history</string>
    <string name="toolai_ai_history_all_actions">All</string>
    <string name="toolai_ai_history_empty">The history is empty. Run an AI action and it appears here.</string>
    <string name="toolai_ai_history_filter_empty">No record matches your search.</string>
    <string name="toolai_ai_history_off_body">The history is off. Turn it on to keep a record of what you send to the AI tool and what it answers. The records stay on your device, and you can delete them at any time.</string>
    <string name="toolai_ai_history_copy_input">Copy the input</string>
    <string name="toolai_ai_history_copy_output">Copy the answer</string>
    <string name="toolai_ai_history_clear_action">Delete all history</string>
    <!-- Dialog body. %1$d is the number of records that the app deletes. -->
    <plurals name="toolai_ai_history_clear_body">
        <item quantity="one">This deletes %1$d record. You cannot undo this.</item>
        <item quantity="other">This deletes %1$d records. You cannot undo this.</item>
    </plurals>

    <string name="toolai_ai_actions_group_title">Actions</string>
    <string name="toolai_ai_actions_title">Actions on the panel</string>
    <string name="toolai_ai_actions_subtitle">Add your own actions, change the prompts, and turn off the ones that you do not use</string>
    <string name="toolai_ai_actions_caption">These are the buttons on the AI panel. You can rename an action that comes with the keyboard, change its prompt, or turn it off. Turning an action off keeps it here, so you can turn it on again. Press Reset in an action to bring back the one that comes with the keyboard.</string>
    <string name="toolai_ai_actions_reorder_title">Order of the actions</string>
    <string name="toolai_ai_action_edit_desc">Edit this action</string>
    <string name="toolai_ai_action_new_title">New action</string>
    <!-- Summary of an action that asks the user for its prompt at every run. -->
    <string name="toolai_ai_action_ask_summary">You type the prompt at every run</string>
    <string name="toolai_ai_action_no_prompt_summary">No prompt yet</string>
    <!-- Name given to an action that the user saved without one. -->
    <string name="toolai_ai_action_default_name">New action</string>
    <!-- Caption at the top of an action that comes with the keyboard. %1$s is
         its name, for example Rewrite. -->
    <string name="toolai_ai_action_builtin_caption">This action comes with the keyboard. Your changes are kept separately, so Reset brings back %1$s.</string>
    <string name="toolai_ai_action_name_label">Name</string>
    <string name="toolai_ai_action_task_label">Prompt</string>
    <!-- Helper text under the prompt field. %1$s is the text {target}, which
         the app replaces with the target language. Do not translate it. -->
    <string name="toolai_ai_action_task_hint">Give the model the task only. The app adds the safety text and the output rules. Write %1$s where you want the target language.</string>
    <!-- Helper text under the prompt field when the user writes the whole prompt. -->
    <string name="toolai_ai_action_task_raw_hint">The app sends this text as it is. You write the safety text yourself.</string>

    <string name="toolai_ai_action_behaviour_title">Behaviour</string>
    <string name="toolai_ai_action_ask_title">Type the prompt at every run</string>
    <string name="toolai_ai_action_ask_subtitle">The keyboard asks you for the prompt instead of using a saved one</string>
    <string name="toolai_ai_action_prefill_title">Start from the saved prompt</string>
    <string name="toolai_ai_action_prefill_subtitle">The box opens with the prompt below already in it, so you change it instead of typing it again</string>
    <!-- Label of the prompt field for an action that asks at every run. -->
    <string name="toolai_ai_action_prefill_label">Prompt to start from</string>
    <!-- Helper text under that field. %1$s is the text {target}, which the app
         replaces with the target language. Do not translate it. -->
    <string name="toolai_ai_action_prefill_hint">The instruction box opens with this text. You can change it before each run. Write %1$s where you want the target language.</string>
    <string name="toolai_ai_action_empty_field_title">Works with an empty field</string>
    <string name="toolai_ai_action_empty_field_subtitle">With no text in the field, the action writes new text instead of changing text</string>
    <string name="toolai_ai_action_before_cursor_title">Read the text before the cursor</string>
    <string name="toolai_ai_action_before_cursor_subtitle">The action reads only the text in front of the cursor, not the whole field. Selected text always wins.</string>
    <string name="toolai_ai_action_append_title">Add the result to the end</string>
    <string name="toolai_ai_action_append_subtitle">Replace adds the result after your text instead of in place of it</string>
    <string name="toolai_ai_action_output_only_title">Answer with the text only</string>
    <string name="toolai_ai_action_output_only_subtitle">The model gives the result and nothing else. Turn this off for an action that explains something.</string>
    <string name="toolai_ai_action_raw_title">Write the whole prompt</string>
    <string name="toolai_ai_action_raw_subtitle">The app sends your text as it is. The safety text stops the model from reading the text of the field as commands, so turn this on only if you write that part yourself.</string>
    <string name="toolai_ai_action_preview_title">The prompt that the app sends</string>
    <string name="toolai_ai_action_reset_action">Reset</string>
    <string name="toolai_ai_action_delete_action">Delete</string>
    <!-- Caption at the foot of the AI screen when the model runs on the device. -->
    <string name="toolai_ai_on_device_info">On-device models run on your device. The text that you run an action on stays on your device. The context window of the model limits the response length.</string>
    <!-- Caption at the foot of the AI screen when the model runs on a server. -->
    <string name="toolai_ai_cloud_info">The app sends the text that you run an action on to the selected provider. This happens only when you press the action. The app keeps your keys on your device.</string>

    <!-- ================================================================== -->
    <!-- Keyword shortcut: the words that make a tool offer itself on the   -->
    <!-- suggestion strip.                                                  -->
    <!-- ================================================================== -->

    <string name="toolai_keyword_group_title">Keyword shortcut</string>
    <string name="toolai_keyword_field_label">Trigger words</string>
    <string name="toolai_keyword_empty_hint">This tool has no trigger words. It never offers itself.</string>
    <!-- %1$s is the name of the tool, for example Calculator. -->
    <string name="toolai_keyword_hint">Type one of these words alone. The suggestion strip then offers to open %1$s and deletes the word. Use commas to separate more than one word.</string>
    <!-- Typing and Smart chips are the names of two settings screens. -->
    <string name="toolai_keyword_off_info">The tool keywords are off. To turn them on, go to Typing, then Smart chips.</string>
    <string name="toolai_keyword_case_title">Match capitals</string>
    <string name="toolai_keyword_case_on_subtitle">The word must be typed with the same capitals</string>
    <string name="toolai_keyword_case_off_subtitle">Capitals are ignored</string>
    <string name="toolai_keyword_case_info">Off, a trigger word matches however you type it, so "wiki", "Wiki" and "WIKI" all offer the tool. On, only the spelling above matches. Use this for a short word that is also ordinary text, such as "AI", so the chip appears for the capitals and not for the letters inside a sentence.</string>

