    <!-- ================================================================== -->
    <!-- Typing test tool settings: the shape of a test run and the records. -->
    <!-- ================================================================== -->

    <string name="toolai_typing_default_test_title">Default test</string>
    <!-- The test runs for a set number of seconds. -->
    <string name="toolai_typing_mode_time_label">Timed</string>
    <!-- The test runs until you type a set number of words. -->
    <string name="toolai_typing_mode_words_label">Word count</string>
    <!-- The test runs to the end of a quotation. -->
    <string name="toolai_typing_mode_quote_label">Quote</string>

    <string name="toolai_typing_length_title">Length</string>
    <string name="toolai_typing_seconds_label">Seconds</string>
    <string name="toolai_typing_words_label">Words</string>
    <string name="toolai_typing_quote_info">Quote tests run to the end of the quotation.</string>

    <string name="toolai_typing_difficulty_title">Difficulty</string>
    <string name="toolai_typing_punctuation_title">Punctuation</string>
    <string name="toolai_typing_punctuation_subtitle">Capital letters, commas and full stops in the test text</string>
    <string name="toolai_typing_numbers_title">Numbers</string>
    <string name="toolai_typing_numbers_subtitle">The keyboard mixes numbers into the test words</string>
    <!-- Group for the two options that let the keyboard's own helpers take part in a run. -->
    <string name="toolai_typing_assist_title">Typing aids</string>
    <string name="toolai_typing_glide_title">Glide typing</string>
    <string name="toolai_typing_glide_subtitle">Swipe words during a test, to see how much faster gestures make you</string>
    <string name="toolai_typing_suggestions_title">Suggestions</string>
    <string name="toolai_typing_suggestions_subtitle">Show the suggestion strip during a test, in its usual row above the keys. Tapping a word finishes it</string>
    <string name="toolai_typing_language_info">The test runs in whichever language the keyboard is in. Switch languages from the panel or the spacebar. English and Bangla have their own word lists; any other language uses its downloaded or imported dictionary.</string>
    <!-- A personal-best row's title with its language, e.g. "30 seconds · বাংলা". -->
    <string name="toolai_typing_best_language_label">%1$s · %2$s</string>

    <string name="toolai_typing_records_title">Records</string>
    <string name="toolai_typing_tests_completed_title">Tests completed</string>
    <string name="toolai_typing_recent_average_title">Recent average</string>
    <!-- %1$d is how many past runs the average covers. -->
    <plurals name="toolai_typing_recent_average_subtitle">
        <item quantity="one">Across the last %1$d run</item>
        <item quantity="other">Across the last %1$d runs</item>
    </plurals>
    <!-- %1$d is a typing speed. wpm is short for words per minute: a unit
         abbreviation, not a countable noun, so it does not inflect. -->
    <string name="toolai_typing_wpm_value" tools:ignore="PluralsCandidate">%1$d wpm</string>
    <!-- Heading of one saved record. %1$s is how many seconds that test ran for. -->
    <string name="toolai_typing_best_seconds_label">%1$s seconds</string>
    <!-- Heading of one saved record. %1$s is how many words that test asked for. -->
    <string name="toolai_typing_best_words_label">%1$s words</string>
    <string name="toolai_typing_clear_records_title">Clear records</string>
    <string name="toolai_typing_clear_records_subtitle">Deletes every best score, the run history and the badges</string>

    <string name="toolai_typing_achievements_title">Achievements</string>
    <!-- The four badges the test hands out, each with the way to earn it. -->
    <string name="toolai_typing_achievement_wpm100_title">100 wpm club</string>
    <string name="toolai_typing_achievement_wpm100_subtitle">Finish a run at 100 words per minute or faster</string>
    <string name="toolai_typing_achievement_perfect_title">Flawless run</string>
    <string name="toolai_typing_achievement_perfect_subtitle">No wrong, extra or missed characters in a full run</string>
    <string name="toolai_typing_achievement_pangram_title">Quick brown fox</string>
    <string name="toolai_typing_achievement_pangram_subtitle">Finish a quote that uses every letter of the alphabet</string>
    <string name="toolai_typing_achievement_tests50_title">50 runs</string>
    <string name="toolai_typing_achievement_tests50_subtitle">Finish fifty typing tests</string>
    <!-- Screen reader state of one badge row. -->
    <string name="toolai_typing_achievement_unlocked_desc">Unlocked</string>
    <string name="toolai_typing_achievement_locked_desc">Locked</string>
    <string name="toolai_typing_info">The test runs on the keyboard. It measures the layout, the key sizes and the gestures that you type with. The text that you type during a test does not go to the text field. The scores stay on your device.</string>

