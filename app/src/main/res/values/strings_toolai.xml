    <!-- Marks the row that is selected now. A screen reader reads it. -->
    <string name="toolai_selected_desc">Selected</string>
    <string name="toolai_weekend_title">Weekend</string>
    <string name="toolai_weekend_subtitle">The weekday initials that the month grid tints</string>
    <string name="toolai_translate_into_title">Translate into</string>
    <string name="toolai_translate_into_subtitle">The keyboard detects the source language. You can also change this on the panel.</string>


    <string name="toolai_chats_group_title">Chats</string>
    <string name="toolai_keep_chats_title">Keep your conversations</string>
    <string name="toolai_keep_chats_subtitle">Save chats on this device so you can come back to them</string>
    <string name="toolai_keep_chats_info">A chat is a back and forth, so it holds more of what you wrote than a single AI action does. Turn this off and your conversations live only until you close the app, and what is already saved is deleted. Nothing is sent anywhere either way that you did not send by chatting.</string>
    <string name="toolai_delete_chats_title">Delete all chats</string>
    <string name="toolai_delete_chats_subtitle">Remove every saved conversation from this device</string>
    <string name="toolai_delete_chats_confirm">Every saved conversation is deleted from this device. This cannot be undone.</string>

    <string name="toolai_models_group_title">Downloading models</string>
    <string name="toolai_continue_context_title">How much the AI reads back</string>
    <string name="toolai_continue_context_subtitle">Characters before the cursor sent by a carry-on action</string>
    <string name="toolai_continue_context_info">Actions that carry on from what you wrote send the text before your cursor. More characters give the model more of your writing to follow, which helps in a long piece. It also costs more of your tokens and takes longer on every run. This only applies when you have not selected anything: a selection is always sent as it is.</string>
</resources>
