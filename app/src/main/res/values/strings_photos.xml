    <!-- Readability -->
    <string name="photo_readability_warn_title">The keys are difficult to read</string>
    <string name="photo_readability_warn_dark_body">This photo and the key text have almost the same brightness. A dark layer on the photo makes the keys easy to read.</string>
    <string name="photo_readability_warn_light_body">This photo and the key text have almost the same brightness. A light layer on the photo makes the keys easy to read.</string>
    <string name="photo_readability_fix_dark_action">Make the photo dark</string>
    <string name="photo_readability_fix_light_action">Make the photo light</string>
    <string name="photo_readability_busy_title">The photo has too much detail</string>
    <string name="photo_readability_busy_body">This photo has much detail where the keys are. Blur the photo to make the key text easy to read.</string>
    <string name="photo_readability_busy_action">Blur the photo</string>
    <string name="photo_readability_ok_body">The keys are easy to read on this photo.</string>

    <!-- Colors from a photo -->
    <string name="photo_seed_title">Match the colors to the photo</string>
    <string name="photo_seed_subtitle">Make the theme colors again from this photo</string>
    <string name="photo_seed_from_collection_action">Match the colors to this photo</string>
    <string name="photo_reveal_title">Show more of the photo</string>
    <string name="photo_reveal_body">The app made the keys and the tool circles see-through, so that more of the photo is visible. Change the key colors in this theme to adjust it.</string>
    <string name="photo_seed_keeps_image_body">The theme colors changed. The photo is still there, because the app kept the see-through board.</string>
    <string name="photo_seed_dialog_body">The app replaces each color of the theme. The background image, the gradients, the key shape and the corners do not change.</string>

    <!-- Rotation -->
