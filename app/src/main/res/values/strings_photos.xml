    <string name="photo_search_empty">There are no photos for <xliff:g id="query" example="mountains">%1$s</xliff:g>. Try a different word.</string>
    <string name="photo_idle_body">Type a subject, or select one of the chips above.</string>
    <string name="photo_need_key_title">Add a key for a photo service</string>
    <string name="photo_need_key_body">This app has no key for Unsplash or Pexels. Add your own key to search for photos.</string>
    <string name="photo_need_key_action">Add a key</string>
    <string name="photo_quota_title">There are no requests left</string>
    <!-- %1$s is a service name, such as Unsplash. -->
    <string name="photo_quota_body"><xliff:g id="service" example="Unsplash">%1$s</xliff:g> has no requests left in this hour. Add your own key to get more requests, or try again later.</string>
    <!-- %1$s is a service name. Shown when the other service continues to work. -->
    <string name="photo_quota_fallback_body"><xliff:g id="service" example="Unsplash">%1$s</xliff:g> has no requests left in this hour. These photos come from the other service.</string>
    <string name="photo_key_rejected_title">The service did not accept the key</string>
    <string name="photo_key_rejected_body">Examine the key, then try again.</string>

    <!-- Credit. Both services make it necessary to show the name of the
         photographer, with a link, where their photo is shown. -->
    <!-- %1$s is a photographer, %2$s a service such as Unsplash. -->
    <string name="photo_credit_line">Photo by <xliff:g id="photographer" example="Ana Silva">%1$s</xliff:g> on <xliff:g id="service" example="Unsplash">%2$s</xliff:g></string>
    <string name="photo_licence_body">Unsplash and Pexels supply the photos. Each photo keeps the name of its photographer.</string>
    <!-- %1$s is a description of the photo from the service, %2$s a photographer. -->
    <string name="photo_tile_desc"><xliff:g id="description" example="a misty forest">%1$s</xliff:g>, by <xliff:g id="photographer" example="Ana Silva">%2$s</xliff:g></string>
    <!-- Used when the service supplies no description of the photo. -->
    <string name="photo_tile_fallback_desc">Photo by <xliff:g id="photographer" example="Ana Silva">%1$s</xliff:g></string>

