<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tools → Gallery (#708) -->
    <string name="gallery_access_group">Access</string>
    <string name="gallery_access_title">Photos and videos</string>
    <string name="gallery_access_full">The keyboard can show all of your photos and videos.</string>
    <string name="gallery_access_partial">The keyboard can show only the photos you chose. Allow again to choose more.</string>
    <string name="gallery_access_none">Not allowed. The tool opens the system picker instead.</string>
    <string name="gallery_access_allow">Allow</string>
    <string name="gallery_access_change">Change</string>

    <string name="gallery_browse_group">Browsing</string>
    <string name="gallery_tap_title">Tap on a photo</string>
    <string name="gallery_tap_subtitle">The round check in the corner always picks.</string>
    <string name="gallery_tap_open">Open it full size</string>
    <string name="gallery_tap_select">Pick it</string>
    <string name="gallery_columns_title">Columns</string>
    <string name="gallery_columns_subtitle">Pinch the grid to change this too.</string>
    <string name="gallery_camera_tile_title">Camera tile</string>
    <string name="gallery_camera_tile_subtitle">A first square in the grid that opens the camera tool.</string>
    <string name="gallery_show_videos_title">Show videos</string>
    <string name="gallery_show_videos_subtitle">List videos beside the photos.</string>
    <string name="gallery_scrubber_title">Fast scroll by month</string>
    <string name="gallery_scrubber_subtitle">A handle on the right edge that jumps through the months.</string>
    <string name="gallery_start_expanded_title">Open at full height</string>
    <string name="gallery_start_expanded_subtitle">Off, the gallery opens at the keyboard\'s height and you drag it taller.</string>
    <string name="gallery_remember_album_title">Open the last album</string>
    <string name="gallery_remember_album_subtitle">Off, the gallery always opens on Recents.</string>
    <string name="gallery_folders_title">Folders</string>
    <string name="gallery_folders_subtitle">Untick a folder to leave its photos out of the gallery, Recents included</string>
    <string name="gallery_folders_all">All shown</string>
    <plurals name="gallery_folders_hidden">
        <item quantity="one">%d hidden</item>
        <item quantity="other">%d hidden</item>
    </plurals>
    <string name="gallery_folders_search">Search folders</string>
    <string name="gallery_folders_none">No folders with photos the keyboard can see. Allow photo access first.</string>
    <string name="gallery_folders_row">%1$s (%2$d)</string>
    <string name="gallery_haptics_title">Vibrate on each pick</string>
    <string name="gallery_haptics_subtitle">A short tick under the finger when you pick or drop a photo.</string>

    <string name="gallery_send_group">Sending</string>
    <string name="gallery_quality_title">Picture size</string>
    <string name="gallery_quality_subtitle">The chip in the send bar changes it for one send. Videos go at their own size.</string>
    <string name="gallery_quality_original">Original</string>
    <string name="gallery_quality_hd">HD, 2560 px</string>
    <string name="gallery_quality_standard">Standard, 1280 px</string>
    <string name="gallery_quality_small">Small, 800 px</string>
    <string name="gallery_max_selection_title">Pick up to</string>
    <string name="gallery_max_selection_subtitle">How many photos and videos go in one send.</string>
    <string name="gallery_caption_title">Caption</string>
    <string name="gallery_caption_subtitle">Where the text you type in the send bar goes.</string>
    <string name="gallery_caption_after">After the pictures</string>
    <string name="gallery_caption_before">Before the pictures</string>
    <string name="gallery_caption_off">No caption box</string>
    <string name="gallery_fallback_title">When the app does not take pictures</string>
    <string name="gallery_fallback_subtitle">Some text boxes do not accept pictures or videos from a keyboard.</string>
    <string name="gallery_fallback_share">Share them to that app</string>
    <string name="gallery_fallback_clipboard">Copy them to the clipboard</string>
    <string name="gallery_fallback_ask">Ask each time</string>
    <string name="gallery_close_after_send_title">Close after sending</string>
    <string name="gallery_close_after_send_subtitle">Give the keys back once everything is on its way.</string>
    <string name="gallery_save_edited_title">Keep edited photos</string>
    <string name="gallery_save_edited_subtitle">Save a copy of each photo you edit to your gallery.</string>

    <string name="gallery_privacy_group">Privacy</string>
    <string name="gallery_strip_location_title">Remove the location</string>
    <string name="gallery_strip_location_subtitle">The app you send to gets no GPS position from the photo or the video.</string>
    <string name="gallery_strip_all_title">Remove the camera details</string>
    <string name="gallery_strip_all_subtitle">Also remove the camera model, the serial numbers, the owner and the time taken.</string>
    <string name="gallery_random_names_title">Random file names</string>
    <string name="gallery_random_names_subtitle">Send copies under a random name, not the photo\'s own.</string>
    <string name="gallery_history_title">Remember what you sent</string>
    <string name="gallery_history_subtitle">Fills the Sent album and marks photos you sent before. Incognito keeps nothing.</string>
    <string name="gallery_history_clear_title">Clear the sent list</string>
    <string name="gallery_history_clear_subtitle">Empties the Sent album. Your photos stay where they are.</string>
    <string name="gallery_history_clear_confirm">Clear the list of what you sent from the keyboard?</string>
    <string name="gallery_immich_group">Immich</string>
    <string name="gallery_immich_info">Browse your own Immich server in the gallery: its timeline and albums come after the phone's, and a picture from it is sent like one of yours. In Immich, make an API key under Account settings › API keys. Give it asset.read, asset.view, asset.download, album.read, timeline.read and user.read; add asset.upload to upload phone pictures from the send menu. The key stays on this phone and out of backups.</string>
    <string name="gallery_immich_url_title">Server address</string>
    <string name="gallery_immich_url_hint">The address you open Immich at, such as https://photos.example.com</string>
    <string name="gallery_immich_key_title">API key</string>
    <string name="gallery_immich_key_hint">Paste the key Immich showed when you made it</string>
    <string name="gallery_immich_check_title">Check the connection</string>
    <string name="gallery_immich_check_subtitle">Asks the server who the key belongs to</string>
    <string name="gallery_immich_check_action">Check</string>
    <string name="gallery_immich_check_ok">Connected as %1$s</string>
    <string name="gallery_immich_check_refused">The server turned the key down (%1$d). Check the key and its permissions.</string>
    <string name="gallery_immich_check_failed">Could not reach the server: %1$s</string>
    <string name="gallery_immich_check_bad_url">That does not look like a web address</string>
</resources>
