    <string name="backup_auto_webdav_url_label">Server address</string>
    <string name="backup_auto_webdav_url_hint">The full address of the folder to write into, for example https://cloud.example.com/remote.php/dav/files/me/backups</string>
    <string name="backup_auto_webdav_user_label">User name</string>
    <string name="backup_auto_webdav_password_label">Password</string>
    <string name="backup_auto_webdav_password_hint">If your server can make app passwords, use one here instead of your account password.</string>
    <string name="backup_auto_webdav_needs_https">This address is not https. The app sends your user name and password with every upload, and on a plain http address anyone on the network can read them, so the app does not use it.</string>

    <string name="backup_auto_drive_title">Google Drive</string>
    <string name="backup_auto_drive_checking">Checking…</string>
    <string name="backup_auto_drive_authorized">The app can write to its folder in your Drive.</string>
    <string name="backup_auto_drive_not_authorized">The app needs your permission first.</string>
    <string name="backup_auto_drive_authorize">Allow access to Drive</string>
    <string name="backup_auto_drive_info">The app writes to a hidden folder of its own in your Drive. It cannot see your other files, and the folder does not show up beside your documents. To take this permission back, go to your Google account and open the list of apps with account access. Your Drive app can also show this folder: choose the folder in "Folder" above instead if you want to see the files.</string>

