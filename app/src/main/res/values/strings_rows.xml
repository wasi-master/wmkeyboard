    <!-- ===================================================================
         Reorder dialog: drag rows into the order the user wants.
         =================================================================== -->

    <string name="rows_reorder_caption">Drag the handles to change the order. The item at the top of the list comes first.</string>
    <!-- Position of a row in the list. %1$d is the number, counted from 1. -->
    <string name="rows_reorder_position_label">%1$d.</string>
    <!-- Screen reader label for the drag handle. %1$s is the name of the row. -->
    <string name="rows_reorder_handle_desc">Reorder %1$s</string>
    <!-- Screen reader label for the bin that removes a row from the list.
         %1$s is the name of the row. -->
    <string name="rows_reorder_remove_desc">Remove %1$s</string>
    <string name="rows_reorder_empty_subtitle">Select two or more items above to set an order</string>

    <string name="rows_reset_order_title">Reset row order</string>

    <!-- The row that appears while text is selected (see Advanced ->
         Selection macros). Its subtitle says "Suggestion strip" when the
         feature is on but drawing over the strip, where this row is unused. -->
    <string name="rows_bar_macros_title">Selection actions</string>
    <string name="rows_bar_macros_strip_subtitle">On the suggestion strip</string>
    <string name="rows_bar_stickers_title">Sticker suggestions</string>
    <!-- Status under the sticker row in the row order list. The row is only there while something typed matches a sticker. -->
    <string name="rows_bar_stickers_subtitle">Shows when what you type matches one of your stickers</string>
    <string name="rows_bar_stickers_button_subtitle">Opens from the sticker chip on the suggestion strip</string>

</resources>
