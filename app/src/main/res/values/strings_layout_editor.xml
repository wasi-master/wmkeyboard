    <!-- Reset dialog for a built-in layout the user changed. %1$s is the layout name. -->
    <string name="layout_editor_reset_confirm_title">Reset <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g>?</string>
    <string name="layout_editor_reset_confirm_body">The app discards your changes to this built-in layout. The original grid comes back. Nothing else changes.</string>
    <!-- Delete dialog for a layout the user made. %1$s is the layout name. -->
    <string name="layout_editor_delete_confirm_title">Delete <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g>?</string>
    <string name="layout_editor_delete_confirm_body">The app deletes this layout. If the layout is on under Languages, the app turns it off and the keyboard goes back to QWERTY.</string>

