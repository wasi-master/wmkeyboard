    <!-- Button descriptions for a screen reader. %1$s is the layout name. -->
    <string name="layout_editor_export_desc">Export <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g></string>
    <string name="layout_editor_duplicate_desc">Duplicate <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g></string>
    <string name="layout_editor_reset_desc">Reset <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g></string>
    <string name="layout_editor_delete_desc">Delete <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g></string>

    <!-- Import dialog. %1$s is the name of the layout inside the file. -->
    <string name="layout_editor_import_confirm_title">Import <xliff:g id="layout_name" example="Probhat">%1$s</xliff:g>?</string>
    <string name="layout_editor_import_confirm_body">The app adds the layout to your layouts, but it does not turn it on. Turn it on under Languages when you are ready to type with it.</string>
    <string name="layout_editor_import_changes_title">Changed during the import:</string>
    <!-- One line in the list of changes the app made to the file. %1$s is the line. -->
