    <!-- What one feature sends with a request. Shown in the request sheet. -->
    <string name="netlog_sent_translate">The text in the translate panel and the two languages.</string>
    <string name="netlog_sent_deepl_write">The text you asked DeepL Write to improve, and your DeepL key.</string>
    <string name="netlog_sent_languagetool">The text in the field the grammar tool checked, its language, and your LanguageTool username and key if you set them.</string>
    <string name="netlog_sent_gif">Your search words and the content filter, or nothing for the trending list.</string>
    <string name="netlog_sent_sticker">Your search words and the content filter, or nothing for the trending list.</string>
    <string name="netlog_sent_image_gen">Your prompt in English with the style\'s words, the picture size, the seed and how many pictures, to the image service you picked. Then the pictures are fetched back.</string>
    <string name="netlog_sent_emoji_mix">The two emoji of the mix, as its address names them. It goes only to a source you added.</string>
    <string name="netlog_sent_web_search">The search you submitted.</string>
    <string name="netlog_sent_image_search">The search you submitted.</string>
    <string name="netlog_sent_photo_search">The photo you pressed Search on.</string>
    <string name="netlog_sent_ocr_online">The photo you scanned, to read the text in it.</string>
    <string name="netlog_sent_ai">The text you ran the action on, and the action\'s instructions.</string>
    <string name="netlog_sent_ai_chat">The conversation so far, and your new message.</string>
    <string name="netlog_sent_ai_mcp">The name of a tool and the values the model wrote for it, sent to the server you added. Also the request for the list of tools when you connect.</string>
    <string name="netlog_sent_ai_tools">A search the model wrote, or the address of a page it asked to read. Web searches go to the same service as the search tool; questions about the keyboard go to its documentation site.</string>
    <string name="netlog_sent_transcription">The recording of one phrase, the model name, and the language unless you turned that off.</string>
    <string name="netlog_sent_music_clip">The clip the microphone recorded when you pressed Listen, about ten seconds, and your key for the service. Nothing else about you.</string>
    <string name="netlog_sent_music_metadata">The title and artist of a song already recognised, to fetch its cover and a store link. Never the clip.</string>
    <string name="netlog_sent_speed_test">Random test data, downloaded from and uploaded to the server you picked to measure the line. Nothing of yours.</string>
    <string name="netlog_sent_wikipedia">Your search words or the title of the article.</string>
    <string name="netlog_sent_notes">The address of the page you shared to Save to notes. Nothing of yours goes with it.</string>
    <string name="netlog_sent_dictionary">One word: your selection, or the word at the cursor.</string>
    <string name="netlog_sent_vocabulary">The word on the card, or the name of a word pack.</string>
    <string name="netlog_sent_synonyms">One word: the word you held on the suggestion strip.</string>
    <string name="netlog_sent_weather">The saved location, or the place name you searched.</string>
    <string name="netlog_sent_location">The position at the precision you chose, to get its address. Never sent unless you located yourself or saved a place.</string>
    <string name="netlog_sent_currency">Nothing about you. The keyboard downloads the whole rate table and converts on your device.</string>
    <string name="netlog_sent_photos">Your search words and filters, or the name of the photo to download.</string>
    <string name="netlog_sent_link_preview">A request for the page you copied or scanned. Nothing else.</string>
    <string name="netlog_sent_media_images">A request for one preview picture. Nothing about you.</string>
    <string name="netlog_sent_download">The name of the file. Nothing about you.</string>
    <string name="netlog_sent_addons">The name of the file in the repository. Nothing about you.</string>
    <string name="netlog_sent_keyman">The name of the Keyman keyboard.</string>
    <string name="netlog_sent_signal_stickers">The pack\'s id. No Signal account takes part.</string>
    <string name="netlog_sent_telegram_stickers">Your bot token and the name of the sticker set. No Telegram account takes part.</string>
    <string name="netlog_sent_rboard_themes">A request for the list of theme packs, and for the pack you picked. Nothing about you.</string>
    <string name="netlog_sent_link_import">A request for the link you shared, and your access token when the link needs one.</string>
    <string name="netlog_sent_backup">Your settings file, encrypted when you set a password, to the destination you selected.</string>
    <string name="netlog_sent_updates">The app\'s version. Nothing about you.</string>
    <string name="netlog_sent_home_assistant">The commands you give and the states it shows, to your own Home Assistant server and nowhere else.</string>
    <string name="netlog_sent_smartthings">The commands you give and the states it shows, to Samsung\'s SmartThings cloud with your key; the device list is asked for every few seconds while the panel is open.</string>
    <string name="netlog_sent_hue">The commands you give and the states it shows, to the Hue bridge on your own network and nowhere else.</string>
    <string name="netlog_sent_openhab">The commands you give and the states it shows, to your own openHAB server and nowhere else.</string>
    <string name="netlog_sent_tuya">The commands you give and the states it shows, to the Tuya data centre your project lives in, signed with your project\'s Access ID and Secret; the device list is asked for every 30 seconds while the panel is open.</string>
    <string name="netlog_sent_paperless">Your API token, to your own Paperless-ngx server, with each scan you send to it and the title, tags, correspondent and document type picked for it; the server\'s lists of those when the scan card or the settings page asks. Uploads can run in the background when a network is back.</string>
    <string name="netlog_sent_plugins">Whatever a plugin you allowed to use the internet sends, only to the websites it lists, only while its panel is open, and never while data saving is on. The path names which plugin asked.</string>
    <string name="netlog_sent_invites">To your own Mobilizon instance: your email and password once when you sign in from settings, then the account\'s token, your profiles and groups when you pick who posts, and the event you publish with its title, description, times and place. To your own Pretix server: your API token, and the event with its title, description, times, place, one free ticket and the number of places. Only when you press Sign in, Check or Publish.</string>
    <string name="netlog_sent_immich">Your API key, to your own Immich server, with the albums and pictures you open in the gallery; a picture\'s original when you send or edit it, and the phone pictures you upload, as they are.</string>
    <string name="netlog_sent_switchbot">The commands you give and the states it shows, to SwitchBot\'s cloud, signed with your token and secret key; each device\'s status is asked for once a minute while the panel is open.</string>
    <string name="netlog_sent_send">A file you chose, encrypted on the phone before it leaves, to the Send instance you picked; and a link you opened, to fetch and decrypt its file. The server never sees the key, which stays in the link.</string>
    <string name="netlog_sent_kde_connect">What you use the tool for, to a computer you paired on your own network.</string>
    <string name="netlog_sent_other">A request the log could not put under a feature.</string>
    <string name="netlog_source_supporters">Supporters list</string>
    <string name="netlog_sent_supporters">Nothing when it asks for the public list. After a tip through Google Play, the name and message you typed and the purchase receipt, so the server can check the tip with Google and list you. Nothing at all for an anonymous tip.</string>
</resources>
