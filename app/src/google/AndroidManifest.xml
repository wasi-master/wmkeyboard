<?xml version="1.0" encoding="utf-8"?>
<!--
    Additions for every build with Google's SDKs, which is every build but
    F-Droid's (app/build.gradle.kts adds this file when wmkb.enableFdroid is
    off).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gemini Nano through AICore: ML Kit's GenAI AARs say minSdk 26, and
         GeminiNano checks the version before it calls them. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />

    <!-- WMFullApplication starts WorkManager on first use (ML Kit's ink model
         downloads), so its androidx.startup initializer is taken out of every
         process start, the keyboard's included. -->
    <application
        android:name="com.wasimaster.wmkeyboard.app.WMFullApplication"
        tools:replace="android:name">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- ML Kit initialises itself from this provider, which Android skips
             for a process started on the lock screen and installs late, after
             unlock. By then the keyboard has often initialised ML Kit by hand
             (MlKitInit.ensure), and the provider's strict init threw "MlKitContext
             is already initialized" and took the whole process down (Telegram
             6320, 0.6.4 crash on a TECNO CM6). The application does it instead;
             see WMFullApplication.onCreate. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- ML Kit's usage reports travel through Firebase datatransport, whose
             only backend (CCT, Google's logging endpoint) registers itself
             here. Without it, datatransport drops each event before storing
             it ("Transport backend 'cct' is not registered") and deletes any
             an older install queued. The calls themselves are rewritten to a
             no-op at build time too; see MlKitTelemetry in :core:intelligence. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

</manifest>
