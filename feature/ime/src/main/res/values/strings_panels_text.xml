    <!-- Wikipedia tool panel: search, article summary, links and full text. -->
    <string name="ime_wiki_tab_summary_label">Summary</string>
    <string name="ime_wiki_tab_links_label">Links</string>
    <string name="ime_wiki_tab_full_label">Full article</string>
    <string name="ime_wiki_search_hint">Search Wikipedia…</string>
    <!-- Shown in the search bar while the key rows type into it. -->
    <string name="ime_wiki_search_active_hint">Search Wikipedia. Press enter to search</string>
    <!-- %1$s is the Wikipedia language code, for example "en". -->
    <string name="ime_wiki_idle_info">Search for a subject on <xliff:g id="language_code" example="en">%1$s</xliff:g>.wikipedia.org. Read the summary, open the links, and insert text or the address of the article.</string>
    <string name="ime_wiki_no_summary_empty">This article has no summary.</string>
    <string name="ime_wiki_links_empty">This article has no links to other articles.</string>
    <!-- %1$s is what the user searched for. -->
    <string name="ime_wiki_no_results_empty">The search found nothing for “<xliff:g id="query" example="Bangla">%1$s</xliff:g>”.</string>
    <string name="ime_wiki_links_progress">Loading links…</string>
    <string name="ime_wiki_full_progress">Loading the full article…</string>
    <string name="ime_wiki_back_desc">Back to the results</string>
    <string name="ime_wiki_insert_summary_action">Insert summary</string>
    <string name="ime_wiki_insert_link_action">Insert link</string>
    <string name="ime_wiki_insert_title_action">Insert title</string>
    <!-- Inserts the link of one article from the list of links. -->
    <string name="ime_wiki_insert_action">Insert</string>
    <string name="ime_wiki_full_error">The app cannot load the text of the article.</string>

    <!-- Dictionary tool panel: English word lookup. -->
    <string name="ime_dict_search_hint">Look up a word…</string>
    <!-- Shown in the search bar while the key rows type into it. -->
    <string name="ime_dict_search_active_hint">Type a word…</string>
    <string name="ime_dict_idle_info">Look up an English word. Press the search bar and type. You can also put the cursor on a word before you open the tool.</string>
    <string name="ime_dict_synonyms_label">Synonyms</string>
    <string name="ime_dict_antonyms_label">Antonyms</string>
    <!-- %1$s is the word the user asked for. -->
    <string name="ime_dict_lookup_progress">Looking up “<xliff:g id="word" example="keyboard">%1$s</xliff:g>”…</string>
    <string name="ime_dict_lookup_desc">Look up the word</string>
    <string name="ime_dict_play_desc">Play the pronunciation</string>
    <!-- Inserts the headword at the cursor. -->
    <string name="ime_dict_insert_action">Insert</string>
    <string name="ime_dict_error">The app cannot reach the dictionary. Check your network and try again.</string>
    <!-- %1$s is the word the user asked for. -->
    <string name="ime_dict_not_found_empty">No entry for “<xliff:g id="word" example="keyboard">%1$s</xliff:g>”. Check the spelling, or try the base form of the word.</string>

