    <!-- Bubble level tool panel. -->
    <string name="ime_level_no_sensor_empty">Your device has no accelerometer.</string>

    <!-- Moon phase tool panel. -->
    <!-- %1$d is the lit part of the moon in percent, %2$d the day of the 30 day cycle. -->
    <!-- The first number is followed by the percent sign and the second is a position in a cycle
         ("day 7 of 30"), not a count of days: neither field inflects a noun. -->
    <string name="ime_moon_detail_info" tools:ignore="PluralsCandidate">%1$d%% illuminated · day %2$d of 30</string>
    <!-- %1$s is a date. -->
    <string name="ime_moon_full_info">Full moon: %1$s</string>
    <!-- %1$s is a date. -->
    <string name="ime_moon_new_info">New moon: %1$s</string>

