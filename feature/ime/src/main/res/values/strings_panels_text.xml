    <!-- Chip for the symbols the user selected most recently. -->
    <string name="ime_symbols_recents_label">Recents</string>

    <!-- Calculator tool panel. -->
    <!-- Short for degrees. It names the unit the trigonometry keys work in. -->
    <string name="ime_calc_degrees_label">deg</string>
