    <!-- Password and passphrase generator tool panel. -->
    <string name="ime_password_length_label">Length</string>
    <string name="ime_password_words_label">Words</string>
    <!-- Leaves out characters that look the same, such as 0 and O. -->
    <string name="ime_password_exclude_ambiguous_label">No look-alike characters</string>
    <!-- %1$s is the separator character, or "None". -->
    <string name="ime_password_separator_label">Separator: %1$s</string>
    <string name="ime_password_capitalize_label">Capital letters</string>
    <string name="ime_password_add_digit_label">Add a digit</string>
    <!-- %1$d is how many bits of entropy the password has. -->
    <!-- "bits" is the unit of an approximate measurement, not a count of things: no plural. -->
    <string name="ime_password_entropy_info" tools:ignore="PluralsCandidate">≈%1$d bits of entropy</string>
    <string name="ime_password_regenerate_desc">Generate again</string>
    <!-- Inserts the generated password at the cursor. -->
    <string name="ime_password_insert_action">Insert</string>
    <string name="ime_password_copied_toast">Copied to the clipboard</string>
    <!-- Easter egg: a rare extra caption under the entropy line. The quoted words are the
         famous xkcd 936 example passphrase, left untranslated on purpose — it is a citation. -->
    <string name="ime_password_egg_info">"correct horse battery staple" (xkcd 936 says length beats symbols)</string>

    <!-- QR code generator tool panel. -->
    <string name="ime_qr_content_hint">Type the QR code text on the keys below…</string>
    <!-- %1$d is how many characters the user typed, %2$s the error correction level (L, M, Q or H). -->
    <plurals name="ime_qr_meta_info">
        <item quantity="one">%1$d character · error correction <xliff:g id="level" example="M">%2$s</xliff:g></item>
        <item quantity="other">%1$d characters · error correction <xliff:g id="level" example="M">%2$s</xliff:g></item>
    </plurals>
    <string name="ime_qr_image_desc">QR code</string>
    <string name="ime_qr_send_action">Send as an image</string>
    <string name="ime_qr_empty">Type on the keys below to make a QR code.</string>
    <!-- %1$d is how many characters the user typed. -->
    <plurals name="ime_qr_too_long_error">
        <item quantity="one">The text is too long for one QR code. It has %1$d character.</item>
        <item quantity="other">The text is too long for one QR code. It has %1$d characters.</item>
    </plurals>

    <!-- QR code scanner result card. -->
    <!-- Easter egg: shown when a scanned code turns out to be the famous Rick Astley video. -->
    <string name="ime_qr_rickroll_info">🎵 Rickroll detected. Never gonna scan you up.</string>

    <!-- Typing speed tool panel: the run and the results. -->
    <string name="ime_typing_new_best_label">New best</string>
    <!-- Caption under the seconds that are left in a timed run. -->
    <string name="ime_typing_time_left_label">left</string>
    <!-- Caption under the count of words that are typed. -->
    <string name="ime_typing_words_left_label">words</string>
    <!-- Short for words per minute. It sits after a number. -->
    <string name="ime_typing_wpm_label">wpm</string>
    <!-- Short for accuracy. It sits after a number and there is little room. -->
    <string name="ime_typing_accuracy_short_label">acc</string>
    <string name="ime_typing_accuracy_label">accuracy</string>
    <!-- Speed before the mistakes are subtracted. -->
    <string name="ime_typing_raw_label">raw</string>
    <string name="ime_typing_consistency_label">consistency</string>
    <string name="ime_typing_time_label">time</string>
    <string name="ime_typing_mode_time_label">Time</string>
    <string name="ime_typing_mode_words_label">Words</string>
    <string name="ime_typing_mode_quote_label">Quote</string>
    <string name="ime_typing_punctuation_label">Punctuation</string>
    <string name="ime_typing_numbers_label">Numbers</string>
    <!-- Config chips: allow glide gestures / show word suggestions during a run. -->
    <string name="ime_typing_glide_label">Glide</string>
    <string name="ime_typing_suggestions_label">Suggestions</string>
    <!-- Content description of the chip that opens the language list; its label is the language's own name. -->
    <string name="ime_typing_language_desc">Test language</string>
    <!-- Shown in place of the prompt when the language has no word list to deal one from. %1$s is the language's name. -->
    <string name="ime_typing_no_words_info">No word list for %1$s yet. Download or import one under Languages in Settings, or pick another language.</string>
    <!-- Shown in place of the prompt on a layout (Pinyin, kana) that converts what is typed, which the test cannot score. -->
    <string name="ime_typing_converts_info">The test cannot score a layout that converts what you type. Pick another language.</string>
    <!-- The results screen's config label with its language, e.g. "30s · বাংলা". -->
    <string name="ime_typing_config_language_label">%1$s · %2$s</string>
    <!-- %1$d is the best speed in words per minute for the current settings. -->
    <string name="ime_typing_best_info">best %1$d</string>
    <!-- The four counts are, in order: correct, wrong, extra and missed characters. -->
    <!-- Four separate counts in one line, and each number is followed by an adjective, not by the
         noun it counts: one <plurals> cannot agree with four quantities, so no plural. -->
    <string name="ime_typing_char_counts_info" tools:ignore="PluralsCandidate">%1$d correct · %2$d wrong · %3$d extra · %4$d missed</string>
    <!-- %1$d is how many past runs the graph below shows. -->
    <plurals name="ime_typing_history_count">
        <item quantity="one">The last %1$d run</item>
        <item quantity="other">The last %1$d runs</item>
    </plurals>
    <!-- Starts one more run with the same settings. -->
    <string name="ime_typing_again_action">Again</string>
    <string name="ime_typing_insert_score_action">Insert score</string>
    <!-- Heading of the achievements row on the results screen. -->
    <string name="ime_typing_achievements_label">Achievements</string>
    <!-- Badge on an achievement that this run unlocked. -->
    <string name="ime_typing_achievement_new_label">New</string>
    <!-- Achievement names. Each is a short badge on the results screen. -->
    <string name="ime_typing_achievement_wpm100_label">100 wpm club</string>
    <!-- Unlocked by a run with no wrong, extra or missed characters. -->
    <string name="ime_typing_achievement_perfect_label">Flawless run</string>
    <!-- Unlocked by finishing a quote that uses every letter of the alphabet. -->
    <string name="ime_typing_achievement_pangram_label">Quick brown fox</string>
    <!-- Unlocked by finishing 50 runs. -->
    <string name="ime_typing_achievement_tests50_label">50 runs</string>

