<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Text scanner (OCR) panel: camera viewfinder, capture, recognized words. -->
    <string name="ime_scanner_ocr_hint">Put the text in the frame, then press the shutter</string>
    <!-- Over a copied picture that the OCR panel reads in place of the camera. -->
    <string name="ime_scanner_ocr_image_hint">Press the button to read this picture</string>
    <string name="ime_scanner_ocr_image_error">The keyboard cannot open this picture.</string>
    <string name="ime_scanner_ocr_permission_body">The text scanner needs the camera to read printed text. Your device does all of the recognition.</string>
    <!-- Content description of the frozen photo while the text is recognized. -->
    <string name="ime_scanner_ocr_capture_desc">The photo of the captured text</string>
    <string name="ime_scanner_ocr_reading_progress">Reading the text…</string>
    <!-- Shown above the word chips when the photo held no readable text. -->
    <string name="ime_scanner_ocr_no_text_label">No text found</string>
    <!--
      Count of the recognized words that the user selected.
      %1$d is the number of selected words, %2$d is the number of words found.
      The plural form follows %2$d, the total.
    -->
    <plurals name="ime_scanner_ocr_word_count">
        <item quantity="one">%1$d/%2$d word</item>
        <item quantity="other">%1$d/%2$d words</item>
    </plurals>
    <string name="ime_scanner_ocr_close_desc">Close the text scanner</string>
    <!-- Companion of common_select_all on the same button. -->
    <string name="ime_scanner_ocr_deselect_all_desc">Deselect all</string>
    <string name="ime_scanner_ocr_empty">The scanner found no text. Hold the camera closer, add more light, then try again.</string>
    <!-- Shown above the result instead of ime_scanner_ocr_no_text_label when
         text recognition itself failed, as opposed to finding no text. -->
    <string name="ime_scanner_ocr_failed_label">Could not read</string>
    <string name="ime_scanner_ocr_online_unset">No online text reader is on. Add a vision model or a Rens server on the settings page of Scan text.</string>
    <string name="ime_scanner_ocr_online_error">The online text reader did not answer, or answered with an error. Check its address (and for a vision model, the model and the key) on the settings page of Scan text.</string>
    <string name="ime_scanner_ocr_read_error">Text recognition stopped with an error, so the scanner could not read this photo. Try again.</string>
    <string name="ime_scanner_ocr_model_downloading">Google Play services is downloading the text reader for this script. Try again in a minute.</string>
    <!-- Language chip on the viewfinder. %1$s is the name of a language. -->
    <string name="ime_scanner_ocr_language_desc">Text language: <xliff:g id="language" example="Bangla">%1$s</xliff:g>. Tap to change.</string>
    <!-- Tesseract reads a language only after its data is on the phone.
         %1$s is the name of a language, %2$s the download size, for example "2.4 MB". -->
    <string name="ime_scanner_library_body">The scanner needs a one-time download of its reading library, <xliff:g id="size" example="16 MB">%1$s</xliff:g>.</string>
    <string name="ime_scanner_library_downloading">Downloading the scanner\'s reading library…</string>
    <string name="ime_scanner_library_failed">The reading library did not download. Check the connection and try again.</string>
    <string name="ime_scanner_library_import">This offline build cannot download the scanner library. Get it and import it in Settings › Privacy › Feature libraries.</string>
    <string name="ime_scanner_library_consent">Feature library downloads are off. Turn them on in Settings › Privacy › Feature libraries, then try again.</string>
    <!-- In a build without ML Kit or Tesseract (F-Droid's), for a language PaddleOCR cannot read either. %1$s is the language's name. -->
    <string name="ime_scanner_ocr_no_reader_body">Nothing on this phone reads <xliff:g id="language" example="Bangla">%1$s</xliff:g> text in this build. Set Text recognition to Online model in the tool\'s settings to read it online.</string>
    <string name="ime_scanner_ocr_import">This offline build cannot download text recognition data. Get the file and import it in Settings › Tools › Text scan › Language data.</string>
    <string name="ime_scanner_ocr_need_pack_body">To read <xliff:g id="language" example="Bangla">%1$s</xliff:g> text, the scanner needs a one-time download of <xliff:g id="size" example="0.9 MB">%2$s</xliff:g>.</string>
    <!-- %1$s is the name of a language. -->
    <string name="ime_scanner_ocr_downloading_progress">Downloading the <xliff:g id="language" example="Bangla">%1$s</xliff:g> text data…</string>
    <!-- %1$s is how much has arrived, %2$s the whole size, for example "1.2 MB of 2.4 MB". -->
    <string name="ime_scanner_ocr_download_of_total_progress"><xliff:g id="downloaded" example="1.2 MB">%1$s</xliff:g> of <xliff:g id="total" example="2.4 MB">%2$s</xliff:g></string>

    <!-- QR code and barcode scanner panel. -->
    <string name="ime_scanner_qr_hint">Point the camera at a QR code or a barcode</string>
