    <string name="ime_scanner_format_generic">Barcode</string>

    <!-- Document scanner trampoline (DocScanActivity). -->
    <!-- The built-in document scanner (PageScanActivity), used where Google's is missing. -->
    <plurals name="ime_docscan_pages_shared">
        <item quantity="one">The app did not take the last page here, so it opens in the app\'s share screen</item>
        <item quantity="other">The app did not take <xliff:g id="count" example="3">%d</xliff:g> pages here, so they open together in the app\'s share screen</item>
    </plurals>
