    <string name="ime_scanner_qr_zoom_label">%1$.1fx</string>
    <string name="ime_scanner_qr_link_progress">Loading the link…</string>
    <!-- Opens the scanned link in the browser. -->
    <string name="ime_scanner_qr_open_action">Open</string>
    <string name="ime_scanner_qr_close_desc">Close the scanner</string>

    <!-- Controls that both scanner panels share. -->
    <string name="ime_scanner_torch_desc">Torch</string>
    <string name="ime_scanner_scan_again_action">Scan again</string>
