    <string name="ime_scanner_format_qr_code">QR code</string>
    <string name="ime_scanner_format_aztec" translatable="false">Aztec</string>
    <string name="ime_scanner_format_codabar" translatable="false">Codabar</string>
    <string name="ime_scanner_format_code_39" translatable="false">Code 39</string>
    <string name="ime_scanner_format_code_93" translatable="false">Code 93</string>
    <string name="ime_scanner_format_code_128" translatable="false">Code 128</string>
    <string name="ime_scanner_format_data_matrix" translatable="false">Data Matrix</string>
    <string name="ime_scanner_format_ean_8" translatable="false">EAN-8</string>
    <string name="ime_scanner_format_ean_13" translatable="false">EAN-13</string>
    <string name="ime_scanner_format_itf" translatable="false">ITF</string>
