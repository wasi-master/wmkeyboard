<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- To-do list tool panel (#920): tasks, their steps, and the box the keys type into. -->
    <string name="ime_todo_unavailable">Your to-do list opens once the phone has been unlocked.</string>
    <plurals name="ime_todo_left_count">
        <item quantity="one">%1$d to do</item>
        <item quantity="other">%1$d to do</item>
    </plurals>
    <string name="ime_todo_all_done">All done</string>
    <string name="ime_todo_repeat_off">Repeat: off</string>
    <string name="ime_todo_repeat_30_min">Repeat: every 30 minutes</string>
    <string name="ime_todo_repeat_hour">Repeat: every hour</string>
    <string name="ime_todo_repeat_day">Repeat: every day</string>
    <string name="ime_todo_repeat_week">Repeat: every week</string>
    <string name="ime_todo_repeat_month">Repeat: every month</string>
    <string name="ime_todo_repeat_year">Repeat: every year</string>
    <string name="ime_todo_chip_done_desc">Done</string>
    <string name="ime_todo_chip_snooze_desc">Remind me in an hour</string>
    <string name="ime_todo_chip_close_desc">Close</string>
    <string name="ime_todo_add_action">Add a task</string>
    <!-- The floating pill along the bottom of the list; a tap starts a new task. -->
    <string name="ime_todo_add_hint">Add a task…</string>
    <!-- The small-caps label over the carousel of tasks that are overdue or due today. -->
    <string name="ime_todo_due_section">Due</string>
    <!-- A chip that leaves finished tasks out of the list while it is selected. -->
    <string name="ime_todo_hide_done_label">Hide done</string>
    <string name="ime_todo_clear_done_action">Clear done</string>
    <string name="ime_todo_settings_desc">To-do list settings</string>
    <string name="ime_todo_sync_desc">Sync with the task app now</string>
    <string name="ime_todo_sync_failed_desc">The last sync with the task app failed. Try again</string>
    <string name="ime_todo_new_hint">A new task</string>
    <string name="ime_todo_step_hint">A new step</string>
    <string name="ime_todo_edit_hint">The task\'s words</string>
    <string name="ime_todo_done_action">Done</string>
    <string name="ime_todo_new_info">Enter adds the task and leaves the box open for the next one.</string>
    <!-- %1$s is the task the step goes under. -->
    <string name="ime_todo_step_info">A step of <xliff:g id="task" example="Plan the trip">%1$s</xliff:g>. Enter adds it and leaves the box open for the next one.</string>
    <string name="ime_todo_delete_action">Delete</string>
    <!-- Quick due dates on a task being edited (#995). The task reminds at that time. -->
    <string name="ime_todo_due_later">Later today</string>
    <string name="ime_todo_due_evening">This evening</string>
    <string name="ime_todo_due_tomorrow">Tomorrow</string>
    <string name="ime_todo_due_next_week">Next week</string>
    <string name="ime_todo_due_none">No date</string>
    <!-- Types the task's words into the text field the keyboard is typing into. -->
    <string name="ime_todo_insert_action">Type it</string>
    <string name="ime_todo_add_step_action">Add a step</string>
    <!-- How many of a task's steps are ticked: "2/5". -->
    <string name="ime_todo_progress_label"><xliff:g id="done" example="2">%1$d</xliff:g>/<xliff:g id="total" example="5">%2$d</xliff:g></string>
    <!-- The same beside a task card's progress ring: "2 of 5". -->
    <string name="ime_todo_progress_of"><xliff:g id="done" example="2">%1$d</xliff:g> of <xliff:g id="total" example="5">%2$d</xliff:g></string>
    <!-- TalkBack, on a task's box. %1$s is the task. -->
    <string name="ime_todo_tick_desc">Done: <xliff:g id="task" example="Buy milk">%1$s</xliff:g></string>
    <!-- TalkBack names the long press with this. -->
    <string name="ime_todo_edit_desc">Edit</string>
    <!-- %1$s is a date, or a date and a time. -->
    <string name="ime_todo_due_label">Due <xliff:g id="when" example="24 Oct, 09:00">%1$s</xliff:g></string>
    <string name="ime_todo_overdue_label">Overdue since <xliff:g id="when" example="24 Oct, 09:00">%1$s</xliff:g></string>
    <string name="ime_todo_empty">Nothing to do</string>
    <string name="ime_todo_empty_hidden">Nothing left to do</string>
    <string name="ime_todo_empty_hint">Tap a task to see its steps. Press and hold one to edit it, give it a date or delete it.</string>
    <string name="ime_todo_undo_deleted">Task deleted</string>
    <plurals name="ime_todo_undo_cleared">
        <item quantity="one">%1$d finished task cleared</item>
        <item quantity="other">%1$d finished tasks cleared</item>
    </plurals>
</resources>
