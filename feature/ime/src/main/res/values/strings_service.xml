    <!-- Grammar panel: the offline grammar strip above the key rows. -->
    <string name="ime_grammar_title">Grammar</string>
    <!-- The panel's title while a LanguageTool server checks the text. %1$s is the server's name, "LanguageTool" unless the user named it. -->
