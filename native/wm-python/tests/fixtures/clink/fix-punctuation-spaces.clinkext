{"id":"custom-fix-punctuation-spaces","name":"Fix Punctuation Spaces","icon":"keyboard.badge.ellipsis","summary":"Turns accidental word.period/comma.word into spaces","source":"def transform(text):\n    out = []\n    n = len(text)\n    for i, ch in enumerate(text):\n        if ch in '.,' and i > 0 and i + 1 < n and text[i - 1].isalpha() and text[i + 1].isalpha():\n            out.append(' ')\n        else:\n            out.append(ch)\n    return ''.join(out)","input":"before","replacesInput":true,"enabled":true}
