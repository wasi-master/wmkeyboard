{"id":"custom-fix-period-spaces","name":"Fix Period Spaces","icon":"text.badge.checkmark","summary":"Turns accidental word.period.word into spaces","source":"def transform(text):\n    out = []\n    n = len(text)\n    for i, ch in enumerate(text):\n        if ch == '.' and i > 0 and i + 1 < n and text[i - 1].isalpha() and text[i + 1].isalpha():\n            out.append(' ')\n        else:\n            out.append(ch)\n    return ''.join(out)","input":"before","replacesInput":true,"enabled":true}
