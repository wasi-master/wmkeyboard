<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings owned by :core:plugins.

  This module parses, installs and runs plugins, which are written in Python. None of it has a Context:
  the manifest reader and the runtime are plain classes that unit tests drive
  directly, so every line the user reads leaves the module as a string resource
  id (see PluginText) and the screen that shows it resolves the words.

  Referenced from another module as
  com.wasimaster.wmkeyboard.plugins.R.string.core_plugins_… - the R classes are
  non-transitive, so the import has to name this module.

  Not here on purpose: the `wm.*` and `ui.*` API names, the error text a script
  gets back from wm.storage, and the messages the Python interpreter itself
  writes. A script reads those, not a person, and translating them would
  break every plugin that checks them.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================== -->
    <!-- What a plugin may do. One line per permission, shown in the list   -->
    <!-- the user reads before install and again in the plugin's settings.  -->
    <!-- ================================================================== -->

    <string name="core_plugins_permission_storage_label">Save data on your device</string>
    <!-- The plugin can ask the app to show a notification at a time it sets,
         for example when a task on a to-do list is due. -->
    <string name="core_plugins_permission_reminders_label">Show reminders at times that you set in it</string>
    <!-- The plugin adds buttons to the bar that appears over selected text.
         It sees the selected text only when the user taps one of them. -->
    <string name="core_plugins_permission_selection_label">Change text you select, when you tap one of its actions</string>
    <!-- API 5 permissions. The ones with a _warning string are off until the
         user turns them on in the plugin's settings, after reading the warning. -->
    <string name="core_plugins_permission_network_label">Connect to the internet, to the websites it lists</string>
    <string name="core_plugins_permission_network_warning">This plugin can send data to the websites it lists, and those websites can see your IP address. Anything you give the plugin, it can send there.</string>
    <!-- AI: the AI model the user set up in the keyboard's settings. -->
    <string name="core_plugins_permission_ai_label">Ask the AI model you set up in the keyboard</string>
    <string name="core_plugins_permission_ai_warning">This plugin can send text to the AI model you set up. If that model runs online, the text leaves your phone and the provider\'s terms apply.</string>
    <!-- The text field is the box in another app that the user is typing into. -->
    <string name="core_plugins_permission_field_read_label">Read the text around the cursor and the text you selected, when you tap something in its panel</string>
    <string name="core_plugins_permission_field_read_warning">This plugin can read what you are writing in the app you are typing in, each time you tap something in its panel. It never can in password fields or in incognito.</string>
    <string name="core_plugins_permission_field_write_label">Type, replace and delete text in the field you are typing in</string>
    <string name="core_plugins_permission_clipboard_read_label">Read the clipboard, when you tap something in its panel</string>
    <string name="core_plugins_permission_clipboard_read_warning">This plugin can read what you copied, each time you tap something in its panel. It never sees clips marked private.</string>
    <string name="core_plugins_permission_clipboard_write_label">Copy text to the clipboard</string>
    <string name="core_plugins_permission_location_label">Find out where your phone is</string>
    <string name="core_plugins_permission_location_warning">This plugin can find out where your phone is while its panel is open.</string>
    <string name="core_plugins_permission_files_label">Open files you pick and save files where you choose</string>
    <string name="core_plugins_permission_files_warning">This plugin can read every file you pick for it, and can ask to save files.</string>
    <string name="core_plugins_permission_sensors_label">Read motion and light sensors while its panel is open</string>
    <string name="core_plugins_permission_scan_label">Open the keyboard\'s QR code and text scanners</string>
    <string name="core_plugins_permission_device_label">Vibrate, turn on the flashlight and read text aloud</string>
    <string name="core_plugins_permission_share_label">Share text and open links, after you confirm</string>
    <string name="core_plugins_permission_notifications_label">Show notifications</string>
    <!-- Shown under the permission list when a plugin can both read something
         of the user's and send data away. %1$s is a list of websites. -->
    <string name="core_plugins_permission_combination_warning">This plugin can read text or files you give it and send them to %1$s.</string>
    <!-- Shown under the permission list when a plugin can both read something
         of the user's and ask the AI model. -->
    <string name="core_plugins_permission_combination_ai_warning">This plugin can read text you give it and send it to your AI model.</string>

    <!-- ================================================================== -->
    <!-- Install refused: the manifest. Each of these replaces the install,  -->
    <!-- so it has to say what is wrong with the plugin file.               -->
    <!-- ================================================================== -->

    <string name="core_plugins_reject_newer_version">This plugin needs a newer version of WM Keyboard.</string>
    <string name="core_plugins_reject_bad_id">This plugin has an id that is not valid. An id is 3 to 64 characters long. An id can contain lowercase letters, numbers, dots, dashes and underscores.</string>
    <string name="core_plugins_reject_no_name">This plugin does not have a name.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_no_version">“%1$s” does not say which version it is.</string>
    <!-- %1$s is the permission the manifest asked for. %2$s is the name of the plugin. -->
    <!-- %1$s is the name of the plugin. Lua and Python are programming languages. -->
    <string name="core_plugins_reject_lua">“%1$s” is written in Lua, which WM Keyboard no longer runs. Look for its Python version.</string>
    <string name="core_plugins_reject_unknown_language">“%1$s” is written in a language this version of WM Keyboard cannot run. Plugins are written in Python.</string>
    <!-- %1$s is the name of the plugin. An action is a button on the bar over selected text. -->
    <string name="core_plugins_reject_actions_need_selection">“%1$s” adds actions for selected text but does not ask permission to change it.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_selection_without_actions">“%1$s” asks to change text you select but does not add any actions.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_nothing_to_show">“%1$s” has no panel and no actions, so there is nothing for it to do.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_too_many_actions">“%1$s” adds more than 16 actions.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_bad_action_id">“%1$s” has an action whose id is missing, repeated, or not valid. An action id is up to 32 lowercase letters, numbers, dashes and underscores.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_action_no_name">“%1$s” has an action without a name.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_action_input">“%1$s” has an action that asks for text this version of WM Keyboard cannot give it.</string>
    <!-- %1$s is the permission. %2$s is the name of the plugin. -->
    <string name="core_plugins_reject_permission_needs_api_5">“%2$s” asks for “%1$s”, which only plugins written for API 5 can use.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_network_without_hosts">“%1$s” asks to connect to the internet but does not list any websites.</string>
    <!-- %1$s is the website as the plugin wrote it. %2$s is the name of the plugin. -->
    <string name="core_plugins_reject_bad_host">“%2$s” lists a website this version of WM Keyboard cannot allow: “%1$s”. Websites are names like api.example.com or *.example.com.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_bad_setting">“%1$s” has a setting that is missing its key or label, repeats a key, or has a type this version cannot draw.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_bad_tool">“%1$s” has a tool keyword that is not valid. A keyword is up to 16 lowercase letters and numbers.</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_bad_locale">“%1$s” has a translation file the keyboard cannot read: %2$s. Each file under locales/ must be a language tag such as bn.json or pt-BR.json, holding a JSON object of text, at most 64 KB.</string>
    <string name="core_plugins_reject_bad_module">“%1$s” has a file this version of WM Keyboard cannot load.</string>
    <!-- %1$s is the name of the plugin. %2$d is the size limit in kilobytes. -->
    <string name="core_plugins_reject_archive_too_large" tools:ignore="PluralsCandidate">“%1$s” is larger than %2$d KB.</string>
    <string name="core_plugins_reject_unknown_permission">This version of WM Keyboard does not know the permission “%1$s”. The app cannot tell you what “%2$s” is allowed to do.</string>

    <!-- ================================================================== -->
    <!-- Install refused: the script inside the plugin file.                -->
    <!-- ================================================================== -->

    <!-- %1$s is the name of the plugin. %2$s is the file name the plugin asked for. -->
    <string name="core_plugins_reject_missing_script">“%1$s” does not have its script file (%2$s).</string>
    <!-- %1$s is the name of the plugin. -->
    <string name="core_plugins_reject_empty_script">“%1$s” has an empty script.</string>
    <!-- %1$s is the name of the plugin. %2$d is the size limit in kilobytes.
         Not a plural: "KB" is a unit symbol, not a countable noun, and it does
         not inflect. -->
    <string name="core_plugins_reject_script_too_large" tools:ignore="PluralsCandidate">“%1$s” has a script larger than %2$d KB.</string>
    <!-- %1$s is the name of the plugin. UTF-8 is the text format the file must use. -->
    <string name="core_plugins_reject_bad_encoding">“%1$s” has a script that is not valid UTF-8 text.</string>

    <!-- ================================================================== -->
    <!-- The plugin panel: a plugin that cannot start, or a script that      -->
    <!-- failed. The panel stays open and the user can try again.           -->
    <!-- ================================================================== -->

    <string name="core_plugins_error_not_installed">That plugin is not installed.</string>
    <string name="core_plugins_error_turned_off">That plugin is turned off.</string>
    <string name="core_plugins_error_script_missing">The script for that plugin is missing.</string>
    <!-- render() is the name of the function a plugin script must write. It stays in English. -->
    <string name="core_plugins_error_no_render">This plugin has no render() function.</string>
    <string name="core_plugins_error_script_failed">The script failed.</string>
    <!-- transform() is the name of the function a plugin writes for its selection actions. It stays in English. -->
    <string name="core_plugins_error_no_transform">This plugin has no transform() function.</string>
    <string name="core_plugins_error_action_missing">That plugin no longer has that action.</string>
    <!-- A plugin asked for something its permission covers, but the user has
         not turned that permission on. %1$s is the permission's line. -->
    <string name="core_plugins_error_needs_grant">This plugin needs a permission you have not turned on: %1$s</string>
    <!-- Errors a plugin's script receives, also shown in the panel. -->
    <string name="core_plugins_error_risky_off">Risky permissions are turned off for all plugins.</string>
    <string name="core_plugins_error_protected_field">Plugins cannot read or change password fields, or text in incognito.</string>
    <string name="core_plugins_error_data_saver">Data saver is on, so plugins cannot use the internet.</string>
    <!-- %1$s is a website. -->
    <string name="core_plugins_error_host_not_listed">This plugin is not allowed to connect to %1$s.</string>

    <!-- ================================================================== -->
    <!-- The plugin panel: the session is over. The panel goes back to the  -->
    <!-- plugin list and shows one of these as the reason.                  -->
    <!-- ================================================================== -->

    <string name="core_plugins_stopped_instructions">This plugin did too much work at one time. The app stopped it.</string>
    <string name="core_plugins_stopped_deadline">This plugin took too long. The app stopped it.</string>
    <string name="core_plugins_stopped_cancelled">The app stopped this plugin.</string>
    <string name="core_plugins_stopped_recursion">This plugin called itself too many times. The app stopped it.</string>
    <!-- The script built a list or a piece of text larger than plugins may hold. -->
    <string name="core_plugins_stopped_memory">This plugin tried to hold too much data. The app stopped it.</string>
    <!-- Shown while the part of the app that runs plugins is downloaded on demand. -->
    <string name="core_plugins_error_not_ready">Plugins are still downloading. Try again in a moment.</string>
    <string name="core_plugins_stopped_unexpected">This plugin stopped unexpectedly.</string>
    <string name="core_plugins_stopped_not_responding">This plugin stopped responding. The app closed it.</string>
    <string name="core_plugins_stopped_not_responding_disabled">This plugin stopped responding again. The app turned it off.</string>

    <!-- ================================================================== -->
    <!-- The plugin panel: what the app had to drop from the screen the     -->
    <!-- plugin asked for. The panel draws the rest and shows these below   -->
    <!-- it, so the user knows the panel is not the whole plugin.           -->
    <!-- ================================================================== -->

    <string name="core_plugins_ui_repair_not_a_widget">A widget list contained something that is not a widget.</string>
    <string name="core_plugins_ui_repair_too_deep">Some widgets were nested too deeply to draw.</string>
    <!-- %1$d is the largest number of widgets one screen can have. -->
    <string name="core_plugins_ui_repair_too_many_widgets" tools:ignore="PluralsCandidate">This plugin asked for more than %1$d widgets. The app dropped the rest.</string>
    <string name="core_plugins_ui_repair_no_type">A widget did not say what kind it is.</string>
    <!-- %1$s is the name of the widget type, which the plugin author wrote. -->
    <string name="core_plugins_ui_repair_unknown_type">This build does not know the widget type “%1$s”.</string>
    <string name="core_plugins_ui_repair_tabs_no_pages">A tab strip had no pages.</string>
    <!-- %1$d is the largest number of tabs one tab strip can have. -->
    <string name="core_plugins_ui_repair_too_many_tabs" tools:ignore="PluralsCandidate">Only the first %1$d tabs are shown.</string>
    <string name="core_plugins_ui_repair_text_budget">This plugin asked to draw too much text. The app left some out.</string>
    <string name="core_plugins_ui_repair_text_shortened">Some text was too long to draw. The app shortened it.</string>
    <string name="core_plugins_ui_repair_bad_image">An image could not be drawn. Images come from the plugin\'s own files, https addresses, or bytes.</string>
    <!-- %1$d is the largest number of options. -->
    <string name="core_plugins_ui_repair_too_many_options" tools:ignore="PluralsCandidate">Only the first %1$d options are shown.</string>
    <!-- %1$d is the largest number. -->
    <string name="core_plugins_ui_repair_too_many_series" tools:ignore="PluralsCandidate">A chart had too many lines. Only the first %1$d are drawn.</string>
    <!-- %1$d is the largest number. -->
    <string name="core_plugins_ui_repair_too_many_points" tools:ignore="PluralsCandidate">A chart had too many points. Only the first %1$d are drawn.</string>
    <!-- %1$d is the largest number. -->
    <string name="core_plugins_ui_repair_too_many_shapes" tools:ignore="PluralsCandidate">A drawing had too many shapes. Only the first %1$d are drawn.</string>
    <string name="core_plugins_ui_repair_bad_shape">A drawing had a shape the app cannot draw.</string>

    <!-- The name of a tab the plugin gave no title. %1$d is its position,
         counted from 1. -->
    <string name="core_plugins_ui_tab_default_title">Tab %1$d</string>
    <!-- The button under a plugin's result that types the result into the text the user is writing. -->
    <string name="core_plugins_ui_insert_action">Insert</string>

    <!-- ================================================================== -->
    <!-- The date widget a plugin can draw: a day, an optional time, and     -->
    <!-- buttons that move them.                                            -->
    <!-- ================================================================== -->

    <!-- Shown where the date goes when the plugin has none yet. -->
    <string name="core_plugins_ui_date_none">No date</string>
    <string name="core_plugins_ui_date_set">Set date</string>
    <string name="core_plugins_ui_date_today">Today</string>
    <string name="core_plugins_ui_date_clear">Clear</string>
    <!-- Read aloud for the arrow buttons either side of the date. -->
    <string name="core_plugins_ui_date_previous_day">Previous day</string>
    <string name="core_plugins_ui_date_next_day">Next day</string>
    <!-- Read aloud for the arrow buttons either side of the time. %1$d is a
         number of minutes. Not a plural: "min" is a unit symbol. -->
    <string name="core_plugins_ui_date_earlier" tools:ignore="PluralsCandidate">%1$d min earlier</string>
    <string name="core_plugins_ui_date_later" tools:ignore="PluralsCandidate">%1$d min later</string>
    <!-- Short buttons that move the time one hour. "h" is the unit symbol for hours. -->
    <string name="core_plugins_ui_date_hour_earlier">−1 h</string>
    <string name="core_plugins_ui_date_hour_later">+1 h</string>
    <!-- The button on a plugin panel that goes back to the page before. -->
    <string name="core_plugins_ui_back">Back</string>
    <!-- Shown in an empty list when the plugin gave no text of its own. -->
    <string name="core_plugins_ui_list_empty">Nothing here yet</string>
    <!-- The button that turns on a permission a plugin needs, shown in its panel. -->
    <string name="core_plugins_ui_allow">Allow</string>
    <!-- Shown in a plugin's panel header while it can use the internet or read the field. -->
    <string name="core_plugins_ui_access_mark">This plugin can use the internet or read text</string>

    <!-- ================================================================== -->
    <!-- Reminders a plugin set, shown by the app in the notification shade. -->
    <!-- ================================================================== -->

    <!-- The name of the notification channel, in Android's settings for this app. -->
    <string name="core_plugins_reminders_channel_title">Plugin reminders</string>
    <string name="core_plugins_reminders_channel_body">Reminders that a plugin asked the app to show, at times that you set in the plugin. The title of each one is the name of the plugin.</string>

</resources>
