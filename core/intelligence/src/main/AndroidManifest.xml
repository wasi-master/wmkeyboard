<?xml version="1.0" encoding="utf-8"?>
<!--
     Compute = NPU for on-device AI (#804): the QNN stub talks to the DSP
     through libcdsprpc.so, and an app targeting API 31 or later only sees a
     vendor library it declares. Not required, so a phone without it installs
     the app and just has no NPU (NpuRuntime fails to load the stub), as does
     F-Droid's build, which carries no runtime for it.

     On a Dimensity, LiteRT's MediaTek dispatch library opens the phone's
     NeuroPilot adapter, and on a Tensor its Google Tensor one opens the TPU
     driver: the same rule, so those are declared too, every name LiteRT's own
     runtime AARs list. The dispatch library tries the adapters in turn and
     takes the first the phone has; the APU and DSP libraries are what the
     adapter itself may open from the app's namespace.

     Compute = GPU for GGUF models: libwmllama_opencl.so links to the vendor's
     libOpenCL.so the same way. A phone without one fails that load, and
     LlamaNative loads a CPU build instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuron_sys_util.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuronusdk_adapter.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuronusdk_adapter.9.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuronusdk_adapter.10.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuron_adapter_mgvi.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareutils_v2.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareutils.mtk.so"
            android:required="false" />
        <uses-native-library
