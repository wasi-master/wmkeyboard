<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written for WM Keyboard's tests in the CLDR keyboard3 format. -->
<keyboard3 xmlns="https://schemas.unicode.org/cldr/45/keyboard3" locale="pcm" conformsTo="45">
    <info name="Hardware only" />
    <keys>
        <import base="cldr" path="45/keys-Zyyy-punctuation.xml" />
        <import base="cldr" path="99/keys-Zzzz-unknown.xml" />
        <key id="odot" output="ọ" />
        <key id="Odot" output="Ọ" />
        <key id="naira" output="₦" />
        <key id="acute" output="\m{acute}" />
    </keys>
    <layers formId="iso">
        <layer modifiers="none">
            <row keys="grave 1 2 3 4 5 6 7 8 9 0 hyphen equal" />
            <row keys="q w e r t y u i o p open-square close-square" />
            <row keys="a s d f g h j k l odot apos hash" />
            <row keys="acute z x c v b n m comma period slash" />
            <row keys="space" />
        </layer>
        <layer modifiers="shift">
            <row keys="grave bang at hash dollar percent caret amp asterisk open-paren close-paren underscore plus" />
            <row keys="Q W E R T Y U I O P open-curly close-curly" />
            <row keys="A S D F G H J K L Odot double-quote tilde" />
            <row keys="acute Z X C V B N M open-angle close-angle question" />
            <row keys="space" />
        </layer>
        <layer modifiers="altR">
            <row keys="gap gap gap gap naira" />
            <row keys="space" />
        </layer>
        <layer modifiers="caps">
            <row keys="Q W E R T Y U I O P" />
        </layer>
    </layers>
    <transforms type="simple">
        <transformGroup>
            <transform from="\m{acute}([aeiou])" to="$1\u{0301}" />
        </transformGroup>
    </transforms>
</keyboard3>
