    <string name="core_tools_provider_tool_voice">ভয়েস টাইপিং</string>
    <string name="core_tools_provider_transcription_server">ট্রান্সক্রিপশন সার্ভার</string>
    <string name="core_tools_provider_transcription_server_desc">একটি সার্ভার যা ওপেনএআই-এর অডিও ট্রান্সক্রিপশন এপিআই ব্যবহার করে: স্পিচস, হুইস্পার.সিপিপি সার্ভার, লোকালএআই, গ্রোক বা ওপেনএআই। আপনি কথা বলা বন্ধ করলে প্রতিটি ক্লিপ এতে পাঠানো হয়।</string>
    <string name="core_tools_provider_translate_server">আপনার অনুবাদ সার্ভার</string>
    <string name="core_tools_provider_translate_server_desc">একটি সার্ভার যা OpenAI চ্যাট অনুরোধের উত্তর দেয়: llama.cpp, Ollama, LM Studio, vLLM বা একটি গেটওয়ে।</string>
    <string name="core_tools_provider_translite_desc">একটি ট্রান্সলাইট সার্ভার: গুগল ট্রান্সলেটের একটি ফ্রি ফ্রন্ট এন্ড।</string>
    <string name="core_tools_provider_tuya">স্মার্ট লাইফ / তুয়া</string>
    <string name="core_tools_provider_tuya_desc">আপনার অ্যাপ অ্যাকাউন্টের সাথে লিঙ্ক করা একটি ফ্রি তুয়া ডেভেলপার প্রজেক্টের মাধ্যমে স্মার্ট লাইফ এবং তুয়া স্মার্ট ডিভাইস, রুম এবং দৃশ্য। প্যানেল খোলা থাকা অবস্থায় স্ট্যাটাস রিফ্রেশ হয়।</string>
