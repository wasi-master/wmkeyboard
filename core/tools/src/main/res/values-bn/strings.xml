    <string name="core_tools_provider_acrcloud_desc">একটি মিউজিক রিকগনিশন পরিষেবা যার দুই সপ্তাহের ট্রায়াল আছে, তারপর পেইড প্ল্যান। console.acrcloud.com থেকে একটি প্রজেক্টের হোস্ট, অ্যাক্সেস কী এবং অ্যাক্সেস সিক্রেট প্রয়োজন। প্রতিটি ক্লিপ ACRCloud-এ পাঠানো হয়।</string>
    <string name="core_tools_provider_ai_horde_desc">স্বেচ্ছাসেবকদের কম্পিউটারে বিনামূল্যে স্টেবল ডিফিউশন। কোনো কি (key) ছাড়াই কাজ করে তবে কিউতে অপেক্ষা করতে হয়; aihorde.net থেকে একটি ফ্রি কি আপনাকে কিউতে এগিয়ে দেবে।</string>
    <string name="core_tools_provider_anthropic_desc">আপনার নিজস্ব কী ব্যবহার করে অ্যানথ্রপিকের এপিআই-এর মাধ্যমে ক্লড মডেল।</string>
    <string name="core_tools_provider_asr4all_desc">ফোনে ইংরেজি ডিক্টেশন, আপনি কথা বলার সাথে সাথে শব্দগুলো প্রদর্শিত হবে।</string>
    <string name="core_tools_provider_audd_desc">কয়েক সেকেন্ডের শব্দ থেকে বেশিরভাগ প্রকাশিত গান শনাক্ত করে। dashboard.audd.io থেকে একটি টোকেন প্রয়োজন; কয়েকশ শনাক্তকরণ বিনামূল্যে, এরপর চার্জ প্রযোজ্য। প্রতিটি ক্লিপ AudD-তে পাঠানো হয়।</string>
    <string name="core_tools_provider_audiotag_desc">একটি ছোট শনাক্তকরণ পরিষেবা, audiotag.info থেকে একটি কী সহ ব্যক্তিগত ব্যবহারের জন্য বিনামূল্যে, এবং অন্যদের চেয়ে ধীর: এটি কয়েক সেকেন্ড পরে উত্তর দেয়। প্রতিটি ক্লিপ অডিওট্যাগে পাঠানো হয়।</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge বা SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">আপনার নিজস্ব স্টেবল ডিফিউশন ওয়েব ইউআই, যা --api দিয়ে শুরু হয়েছে। এর ঠিকানা দিন, যেমন http://192.168.1.10:7860।</string>
    <string name="core_tools_provider_bergamot">ডিভাইসে (ফায়ারফক্স অনুবাদ)</string>
    <string name="core_tools_provider_bergamot_desc">Mozilla-এর Bergamot ইঞ্জিন এবং Firefox Translations মডেল ব্যবহার করে ফোনে অনুবাদ করে। এটি ফ্রি সফটওয়্যার, কোনো Google পরিষেবা নেই এবং আপনার টেক্সট ফোনেই থাকে। প্রতিটি অনুবাদের দিকের জন্য (ফরাসি থেকে ইংরেজি, ইংরেজি থেকে ফরাসি) ১৪ থেকে ৩৭ মেগাবাইটের আলাদা ডাউনলোড প্রয়োজন। Android ৯ বা তার পরবর্তী সংস্করণের ৬৪-বিট ফোন প্রয়োজন।</string>
    <string name="core_tools_provider_bfl">ব্ল্যাক ফরেস্ট ল্যাবস (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">যাঁরা তৈরি করেছেন তাঁদের কাছ থেকে FLUX মডেল। bfl.ai থেকে একটি কি (key) প্রয়োজন।</string>
    <string name="core_tools_provider_brave">ব্রেভ সার্চ</string>
    <string name="core_tools_provider_brave_answers">ব্রেভ অ্যানসারস</string>
    <string name="core_tools_provider_brave_answers_desc">ব্রেভ (Brave) ওয়েব অনুসন্ধানের ওপর ভিত্তি করে উত্তর। অ্যানসারস (Answers) প্ল্যানসহ একটি কি (key) প্রয়োজন। খালি রাখা হলে, ওয়েব অনুসন্ধানের জন্য আপনার টাইপ করা ব্রেভ সার্চ কি (key) ব্যবহার করার চেষ্টা করা হবে।</string>
    <string name="core_tools_provider_brave_desc">ওয়েব এবং ইমেজ সার্চ। একটি ব্রেভ সার্চ এপিআই কি প্রয়োজন, যদি না এই বিল্ডে একটি থাকে।</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">Cloudflare-এ FLUX এবং Stable Diffusion, বিনামূল্যে দৈনিক ব্যবহারের সুযোগসহ। একটি এপিআই টোকেন এবং আপনার অ্যাকাউন্ট আইডি প্রয়োজন।</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflare-এর স্পিড টেস্ট সার্ভার, এর ডেটা সেন্টারগুলোর মধ্যে নিকটতম। কোনো অ্যাকাউন্টের প্রয়োজন নেই এবং কার্ডকে জানায় আপনি কোন নেটওয়ার্কে আছেন এবং কোন শহর উত্তর দিয়েছে।</string>
    <string name="core_tools_provider_coinbase_desc">কয়েনবেস থেকে মুদ্রা এবং কয়েন। কোনো কি (key) নেই।</string>
    <string name="core_tools_provider_coingecko_desc">CoinGecko থেকে কয়েনের দাম। কোনো কি (key) নেই।</string>
    <string name="core_tools_provider_comfyui_desc">আপনার নিজস্ব ComfyUI সার্ভার। একটি সাধারণ টেক্সট-টু-ইমেজ ওয়ার্কফ্লো এবং আপনার নাম দেওয়া চেকপয়েন্ট বা এর কাছে থাকা প্রথম চেকপয়েন্ট দিয়ে ছবি আঁকে।</string>
    <string name="core_tools_provider_commons_desc">উইকিমিডিয়া কমন্স বা আপনার নিজের মিডিয়াউইকি থেকে ফ্রি জিআইএফ (GIF) এবং ছবি। কোনো কী (key) প্রয়োজন নেই। জিআইএফগুলো মূলত শিক্ষামূলক।</string>
    <string name="core_tools_provider_currency_api_desc">অধিকাংশ মুদ্রা এবং অনেক কয়েনের জন্য ডেটা উন্মুক্ত। কোনো কী (key) প্রয়োজন নেই।</string>
    <string name="core_tools_provider_deepl_desc">আপনার DeepL API কী, অথবা এটি যোগ করে এমন একটি প্রক্সির ঠিকানা প্রয়োজন।</string>
    <string name="core_tools_provider_deepseek_desc">আপনার নিজস্ব কী (key) ব্যবহার করে DeepSeek-এর API-এর মাধ্যমে DeepSeek মডেল।</string>
    <string name="core_tools_provider_er_api_desc">অধিকাংশ মুদ্রার দৈনিক হার। কোনো কী নেই।</string>
    <string name="core_tools_provider_fal_desc">দ্রুত হোস্ট করা মডেল: FLUX, Recraft, Ideogram, Qwen Image এবং আরও অনেক কিছু। মডেলের fal আইডি উল্লেখ করুন; খালি থাকলে FLUX Schnell ব্যবহৃত হবে।</string>
    <string name="core_tools_provider_frankfurter_desc">প্রধান মুদ্রাগুলোর জন্য ইউরোপীয় কেন্দ্রীয় ব্যাংকের হার। ফ্রি সফটওয়্যার, কোনো কী প্রয়োজন নেই।</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">গুগলের এপিআই-এর মাধ্যমে জেমিনি মডেল, এআই স্টুডিও থেকে আপনার নিজস্ব কী ব্যবহার করে।</string>
    <string name="core_tools_provider_gemini_image">Gemini ইমেজ</string>
    <string name="core_tools_provider_gemini_image_desc">গুগলের ন্যানো ব্যানানা ইমেজ মডেল। একটি ফাঁকা কি এআই টুলের জেমিনি কি ব্যবহার করে।</string>
    <string name="core_tools_provider_gifcities_desc">ইন্টারনেট আর্কাইভ থেকে পুরনো জিওসিটিজ (GeoCities) জিআইএফ (GIF)। কোনো কি (key) নেই। ফলাফলগুলোর কোনো কন্টেন্ট রেটিং নেই।</string>
    <string name="core_tools_provider_giphy_desc">জিআইএফ এবং স্টিকার। সর্বদা নিজস্ব ট্যাবে থাকে: জিআইপিএইচওয়াই অ্যাপগুলোকে এর ফলাফল অন্যদের সাথে মেশাতে দেয় না।</string>
    <string name="core_tools_provider_google_home">গুগল হোম</string>
    <string name="core_tools_provider_google_home_desc">প্লে সার্ভিসের মাধ্যমে আপনার গুগল হোমের ডিভাইসগুলো। একবারে একটি হোম; আপনি গুগলের নিজস্ব স্ক্রিন থেকে বেছে নিতে পারেন কোনটি ব্যবহার করবেন।</string>
    <string name="core_tools_provider_google_translate">গুগল অনুবাদ</string>
    <string name="core_tools_provider_google_translate_desc">গুগলের ফ্রি এন্ডপয়েন্ট, অথবা আপনি কি যোগ করলে ক্লাউড ট্রান্সলেশন।</string>
    <string name="core_tools_provider_harper_desc">কীবোর্ডে বিল্ট-ইন গ্রামার ইঞ্জিন। শুধুমাত্র ইংরেজি, এবং আপনার টাইপ করা কোনো কিছুই ফোন থেকে বাইরে যায় না।</string>
    <string name="core_tools_provider_home_assistant_desc">আপনার নিজস্ব হোম অ্যাসিস্ট্যান্ট সার্ভার। অ্যাসিস্টের সাথে সব ধরণের জিনিস, সরাসরি।</string>
    <string name="core_tools_provider_hue">ফিলিপস হিউ ব্রিজ</string>
    <string name="core_tools_provider_hue_desc">আপনার ওয়াই-ফাইয়ের হিউ (Hue) ব্রিজ থেকে সরাসরি লাইট, রুম, দৃশ্য এবং সেন্সর। কোনো কিছুই বাড়ির বাইরে যায় না।</string>
    <string name="core_tools_provider_hugging_face_desc">Hugging Face-এর নিজস্ব ইনফারেন্স সার্ভারে থাকা মডেল, বিনামূল্যে মাসিক ব্যবহারের সুবিধা সহ। ইনফারেন্স প্রোভাইডার অনুমতির একটি অ্যাক্সেস টোকেন প্রয়োজন।</string>
    <string name="core_tools_provider_klipy_desc">GIF এবং স্টিকার। একটি KLIPY API কী প্রয়োজন, যদি না এই বিল্ডে একটি থাকে।</string>
    <string name="core_tools_provider_languagetool_desc">৩০টিরও বেশি ভাষায় ব্যাকরণ, বানান এবং শৈলী। আপনার টেক্সট চেক করার জন্য একটি LanguageTool সার্ভারে পাঠানো হয়: আপনি নিজের সার্ভার না দিলে api.languagetool.org-এর পাবলিক সার্ভার ব্যবহার করা হয়।</string>
    <string name="core_tools_provider_librespeed_desc">একটি LibreSpeed সার্ভার: যেটি আপনি নিজে চালান, অথবা পাবলিক লিস্ট থেকে স্বেচ্ছাসেবকদের কোনো সার্ভার, যা রো-এর নিজস্ব স্ক্রিনে শহর অনুযায়ী বেছে নেওয়া হয়।</string>
    <string name="core_tools_provider_libretranslate_desc">একটি LibreTranslate সার্ভার: আপনার নিজস্ব বা একটি পাবলিক সার্ভার। পাবলিক সার্ভারের জন্য সাধারণত একটি কী প্রয়োজন হয়।</string>
    <string name="core_tools_provider_lingva_desc">একটি Lingva সার্ভার: গুগল ট্রান্সলেটের একটি ফ্রি ফ্রন্ট এন্ড।</string>
    <string name="core_tools_provider_lm_studio_desc">আপনার কম্পিউটারে LM Studio দ্বারা পরিবেশিত মডেল। প্রতিটি কম্পিউটারের জন্য একটি যোগ করুন।</string>
    <string name="core_tools_provider_mlkit">ডিভাইসে</string>
    <string name="core_tools_provider_mlkit_desc">এমএল কিট (ML Kit)-এর মাধ্যমে ফোনে অনুবাদ করে। আপনার টেক্সট ফোনেই থাকে। প্রতিটি ভাষার জন্য প্রথমে একটি মডেল ডাউনলোড করতে হবে।</string>
    <string name="core_tools_provider_mode_fallback">একবারে একটি</string>
    <string name="core_tools_provider_mode_fallback_desc">প্রথম প্রোভাইডারকে জিজ্ঞাসা করুন। যদি এটি ব্যর্থ হয় বা কোনো ফলাফল না থাকে, তবে পরেরটিকে জিজ্ঞাসা করুন।</string>
    <string name="core_tools_provider_mode_mix">মিশ্র</string>
    <string name="core_tools_provider_mode_mix_desc">সব প্রোভাইডারকে একই সময়ে জিজ্ঞাসা করুন এবং তাদের ফলাফল একটি গ্রিডে মিশ্রিত করুন।</string>
    <string name="core_tools_provider_mode_pick">প্যানেলে নির্বাচন করুন</string>
    <string name="core_tools_provider_mode_pick_desc">প্যানেলটি চালু থাকা প্রোভাইডারদের দেখায়। সেখান থেকে একটি বেছে নিন, এবং শুধুমাত্র সেটিকেই জিজ্ঞাসা করা হবে।</string>
    <string name="core_tools_provider_mode_tabs">ট্যাব</string>
    <string name="core_tools_provider_mode_tabs_desc">প্রতিটি প্রোভাইডার তার নিজস্ব চিপ পায়। ফলাফল দেখতে একটি চিপ ট্যাপ করুন।</string>
    <string name="core_tools_provider_moonshine_desc">ফোনে চলে এমন একটি ছোট, দ্রুত ইংরেজি মডেল।</string>
    <string name="core_tools_provider_mozhi_desc">একটি মোঝি সার্ভার: গুগল, ডিপএল, ডাকডাকগো, ইয়ানডেক্স এবং রিভার্সোর জন্য একটি ফ্রি ফ্রন্ট এন্ড। ইঞ্জিন নির্বাচন করুন। ডিপএল এবং রিভার্সোর জন্য একটি সোর্স ল্যাঙ্গুয়েজ প্রয়োজন।</string>
    <string name="core_tools_provider_music_server">আপনার নিজস্ব রিকগনিশন সার্ভার</string>
    <string name="core_tools_provider_music_server_desc">আপনার চালানো একটি সার্ভার যা AudD-এর মতো উত্তর দেয়: ক্লিপটি একটি ফাইল হিসেবে পোস্ট করা হয় এবং গানটি JSON হিসেবে ফিরে আসে। এর পেছনে Panako বা Olaf-এর মতো ফিঙ্গারপ্রিন্টার ব্যবহার করুন।</string>
    <string name="core_tools_provider_nllb">ডিভাইসে (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">CTranslate2-এ মেটার NLLB-200 মডেল ব্যবহার করে ফোনে অনুবাদ করে: ২০০টি ভাষা, যেকোনো দুটির মধ্যে, যে জোড়াগুলো অন্য ইঞ্জিন করতে পারে না। ৬৩০ এমবি-র একটি ডাউনলোড, এবং একটি বাক্য অনুবাদ করতে কয়েক সেকেন্ড সময় লাগে। আপনার টেক্সট ফোনেই থাকে। মডেলটি শুধুমাত্র অ-বাণিজ্যিক ব্যবহারের জন্য লাইসেন্সপ্রাপ্ত (CC BY-NC 4.0)। ৬ জিবি বা তার বেশি মেমরিযুক্ত ৬৪-বিট ফোন প্রয়োজন।</string>
    <string name="core_tools_provider_none_on">কোনো প্রোভাইডার চালু নেই। এই টুলের সেটিংসে গিয়ে একটি চালু করুন।</string>
    <string name="core_tools_provider_offline_gifs">অফলাইন জিআইএফ প্যাক</string>
    <string name="core_tools_provider_offline_gifs_desc">আপনার ইমপোর্ট করা জিআইএফ প্যাক। এগুলো ইন্টারনেট সংযোগ ছাড়াই কাজ করে।</string>
    <string name="core_tools_provider_ollama_desc">আপনার কম্পিউটার বা নেটওয়ার্কে চলমান ওলামা (Ollama) সার্ভারের মডেল। প্রতিটি সার্ভারের জন্য একটি করে যোগ করুন।</string>
    <string name="core_tools_provider_omnilingual_desc">১,৬০০টি ভাষার জন্য মেটার একটি মডেল, যার মধ্যে শত শত ভাষাতে অন্য কোনো ভয়েস টাইপিংয়ের সুবিধা নেই। প্রতিটি বাক্যাংশ বলার পর বিরতিতে এটি কার্যকর হয়।</string>
    <string name="core_tools_provider_on_device_ai">আপনার ডিভাইসে</string>
    <string name="core_tools_provider_on_device_ai_desc">এই ফোনে একটি মডেল ডাউনলোড করা হয়েছে। আপনার লেখা কোনো কিছুই এখান থেকে বাইরে যাবে না। এআই পৃষ্ঠায় গিয়ে মডেলটি বেছে নিন এবং ডাউনলোড করুন।</string>
    <string name="core_tools_provider_on_device_image">এই ফোনে</string>
    <string name="core_tools_provider_on_device_image_desc">এই ফোনে ডাউনলোড করা একটি মডেল, অথবা আপনার আমদানি করা একটি মডেল। আপনি যা টাইপ করেন তার কিছুই বাইরে যায় না। জেনারেটরের স্ক্রিনে মডেলটি নির্বাচন করুন।</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-সামঞ্জস্যপূর্ণ পরিষেবা</string>
    <string name="core_tools_provider_openai_compatible_desc">OpenAI-এর চ্যাট এপিআই ব্যবহার করে এমন অন্য যেকোনো পরিষেবা: OpenRouter, Groq, Mistral, Together, অথবা আপনার নিজস্ব গেটওয়ে। ভার্সন পর্যন্ত ঠিকানাটি দিন, যেমন https://openrouter.ai/api/v1।</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-সামঞ্জস্যপূর্ণ ছবি</string>
    <string name="core_tools_provider_openai_compatible_image_desc">OpenAI-এর ইমেজ API ব্যবহার করে এমন অন্য যেকোনো পরিষেবা: LocalAI, DeepInfra, Nebius, অথবা আপনার নিজস্ব গেটওয়ে। ভার্সন পর্যন্ত ঠিকানাটি দিন, যেমন https://api.deepinfra.com/v1/openai।</string>
    <string name="core_tools_provider_openai_desc">আপনার নিজস্ব কী ব্যবহার করে OpenAI-এর API-এর মাধ্যমে GPT মডেল।</string>
    <string name="core_tools_provider_openai_image">OpenAI ইমেজ</string>
    <string name="core_tools_provider_openai_image_desc">GPT ইমেজ, যা স্বচ্ছ ব্যাকগ্রাউন্ডে স্টিকার আঁকে। প্রতি ছবির জন্য মূল্য পরিশোধ করতে হয়। একটি খালি কি (key) এআই টুল থেকে OpenAI কি ব্যবহার করে।</string>
    <string name="core_tools_provider_openhab_desc">একটি openHAB সার্ভার: এর আইটেমগুলো, সরাসরি, সেমান্টিক মডেল থেকে রুমসহ।</string>
    <string name="core_tools_provider_parakeet_desc">একটি বড় মডেল যা ফোনে চলে এবং ২৫টি ইউরোপীয় ভাষা বোঝে।</string>
    <string name="core_tools_provider_pexels_desc">Pexels থেকে ছবি। একটি API কী প্রয়োজন, যদি না এই বিল্ডে একটি থাকে।</string>
    <string name="core_tools_provider_pollinations_desc">বিনামূল্যে, কোনো কি (key) বা অ্যাকাউন্ট ছাড়াই: প্রম্পটটি Pollinations-এ পাঠানো হয়, যা মডেলটি নির্বাচন করে। enter.pollinations.ai থেকে একটি কি (key) এর নতুন API খোলে এবং আপনাকে একটি মডেলের নাম দেওয়ার সুযোগ দেয়।</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (অফিসিয়াল নয়, RapidAPI-এর মাধ্যমে)</string>
    <string name="core_tools_provider_rapid_shazam_desc">র‍্যাপিড এপিআই-তে একটি অনানুষ্ঠানিক তালিকার মাধ্যমে শ্যাজামের ক্যাটালগ, যেখানে একটি র‍্যাপিড এপিআই কী ব্যবহার করা হয়। এটি কোনো অ্যাপল পরিষেবা নয়: তালিকাটি কোনো নোটিশ ছাড়াই পরিবর্তন হতে পারে বা বন্ধ হয়ে যেতে পারে। প্রতিটি ক্লিপ র‍্যাপিড এপিআই-তে পাঠানো হয়।</string>
    <string name="core_tools_provider_recraft_desc">ইলাস্ট্রেশন, আইকন এবং ভেক্টর-স্টাইল আর্ট। recraft.ai থেকে একটি কী প্রয়োজন।</string>
    <string name="core_tools_provider_rens_desc">একটি Rens সার্ভার: গুগল লেন্সের একটি ফ্রি ফ্রন্ট এন্ড। এটি আপনার জন্য ছবির টেক্সট পড়ে দেয়, বেশিরভাগ স্ক্রিপ্টের ক্ষেত্রেই।</string>
    <string name="core_tools_provider_rens_translate_desc">একটি রেন্স (Rens) সার্ভার: গুগল লেন্সের একটি ফ্রি ফ্রন্ট এন্ড। এটি অনুবাদ করা টেক্সটসহ ছবি ফেরত দেয়।</string>
    <string name="core_tools_provider_replicate_desc">হাজার হাজার হোস্ট করা মডেল। যেকোনো টেক্সট-টু-ইমেজ মডেলকে মালিক/নাম হিসেবে উল্লেখ করুন; খালি থাকলে FLUX Schnell ব্যবহার হবে।</string>
    <string name="core_tools_provider_same_kind_fallback">ব্যাকআপ হিসেবে</string>
    <string name="core_tools_provider_same_kind_fallback_desc">একই ধরনের প্রোভাইডাররা একসাথে কাজ করে। প্রথমে প্রথমটিকে জিজ্ঞাসা করা হয়, এবং শুধুমাত্র ব্যর্থ হলে পরেরটিকে জিজ্ঞাসা করা হয়, উদাহরণস্বরূপ যখন কোনো কি-এর কোটা শেষ হয়ে যায়।</string>
    <string name="core_tools_provider_same_kind_separate">আলাদাভাবে</string>
    <string name="core_tools_provider_same_kind_separate_desc">প্রতিটি নিজস্ব প্রোভাইডার: নিজস্ব চিপ, প্যানেলে নিজস্ব পছন্দ, মিশ্র গ্রিডে নিজস্ব অংশ।</string>
    <string name="core_tools_provider_searxng_desc">একটি SearXNG ইনস্ট্যান্স যা JSON ফলাফল অনুমোদন করে। বেশিরভাগ পাবলিক ইনস্ট্যান্স তা করে না।</string>
    <string name="core_tools_provider_sherpa_desc">বাংলাসহ ১৩টি ভাষার জন্য স্ট্রিমিং মডেল, যা ফোনে আপনার কথা বলার সাথে সাথে টাইপ করে।</string>
    <string name="core_tools_provider_simplytranslate_desc">একটি SimplyTranslate সার্ভার: গুগল এবং অন্যান্য ইঞ্জিনের জন্য একটি ফ্রি ফ্রন্ট এন্ড।</string>
    <string name="core_tools_provider_smartthings_desc">স্যামসাং ক্লাউডের মাধ্যমে আপনার স্মার্টথিংস ডিভাইস, রুম এবং সিন। প্যানেল খোলা থাকাকালীন অবস্থা রিফ্রেশ হয়।</string>
    <string name="core_tools_provider_stability_desc">Stable Diffusion-এর নির্মাতাদের থেকে স্টেবেল ইমেজ কোর, আল্ট্রা এবং স্টেবেল ডিফিউশন ৩.৫। ক্রেডিট দিয়ে মূল্য পরিশোধ করতে হবে; platform.stability.ai থেকে একটি কি (key)-এর প্রয়োজন।</string>
    <string name="core_tools_provider_sticker_packs_desc">এই ফোনে আপনার স্টিকার প্যাকগুলি।</string>
    <string name="core_tools_provider_switchbot_desc">আপনার সুইচবট ডিভাইস, ইনফ্রারেড রিমোট এবং সিনগুলো, সুইচবটের অ্যাপ থেকে টোকেন ব্যবহার করে তাদের ক্লাউডের মাধ্যমে। প্যানেল খোলা থাকা অবস্থায় প্রতি মিনিটে স্ট্যাটাস রিফ্রেশ হয়।</string>
    <string name="core_tools_provider_system_recognizer">ফোনের রিকগনাইজার</string>
    <string name="core_tools_provider_system_recognizer_desc">ফোনের সাথে আসা স্পিচ রিকগনাইজার, সাধারণত গুগলের। আপনি কথা বলার সাথে সাথে শব্দগুলো প্রদর্শিত হয়।</string>
    <string name="core_tools_provider_tavily_desc">সংক্ষিপ্ত উত্তরসহ ওয়েব অনুসন্ধান। আপনার Tavily কি প্রয়োজন।</string>
    <string name="core_tools_provider_together_desc">Together-এর সার্ভারে FLUX এবং অন্যান্য ওপেন মডেল।</string>
