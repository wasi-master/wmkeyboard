    <string name="core_tools_provider_languagetool_desc">支持 30 多种语言的语法、拼写和风格检查。您的文本会被发送到 LanguageTool 服务器进行检查：除非您输入了自己的服务器地址，否则将使用 api.languagetool.org 上的公共服务器。</string>
    <string name="core_tools_provider_librespeed_desc">LibreSpeed 服务器：您可以自行运行，也可以从公共列表中选择志愿者提供的服务器，并在该行的屏幕上按城市筛选。</string>
    <string name="core_tools_provider_libretranslate_desc">LibreTranslate 服务器：您自己的服务器或公共服务器。公共服务器通常需要密钥。</string>
    <string name="core_tools_provider_lingva_desc">Lingva 服务器：Google 翻译的免费前端。</string>
    <string name="core_tools_provider_lm_studio_desc">由您计算机上的 LM Studio 提供的模型。请为每台计算机添加一个。</string>
    <string name="core_tools_provider_mlkit">设备端</string>
    <string name="core_tools_provider_mlkit_desc">使用 ML Kit 在手机上进行翻译。您的文本将保留在手机上。每种语言都需要先下载模型。</string>
    <string name="core_tools_provider_mode_fallback">一次一个</string>
    <string name="core_tools_provider_mode_fallback_desc">询问第一个提供程序。如果失败或没有结果，则询问下一个。</string>
    <string name="core_tools_provider_mode_mix">混合</string>
    <string name="core_tools_provider_mode_mix_desc">同时询问所有提供程序，并将结果混合在一个网格中。</string>
    <string name="core_tools_provider_mode_pick">在面板中选择</string>
    <string name="core_tools_provider_mode_pick_desc">面板显示已启用的提供程序。在此处选择一个，系统将仅查询该提供程序。</string>
    <string name="core_tools_provider_mode_tabs">标签页</string>
    <string name="core_tools_provider_mode_tabs_desc">每个提供程序都有自己的标签。点击标签即可查看其结果。</string>
    <string name="core_tools_provider_moonshine_desc">一个在手机上运行的小型、快速的英语模型。</string>
    <string name="core_tools_provider_mozhi_desc">Mozhi 服务器：Google、DeepL、DuckDuckGo、Yandex 和 Reverso 的免费前端。请选择引擎。DeepL 和 Reverso 需要源语言。</string>
    <string name="core_tools_provider_music_server">您自己的识别服务器</string>
    <string name="core_tools_provider_music_server_desc">一个由您运行的服务器，其响应方式类似于 AudD：将音频片段作为文件发布，并以 JSON 格式返回歌曲信息。在其后端配置如 Panako 或 Olaf 等指纹识别工具。</string>
    <string name="core_tools_provider_nllb">设备端 (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">使用 Meta 的 NLLB-200 模型在 CTranslate2 上进行手机端翻译：支持 200 种语言，可在任意两种语言间互译，适用于其他引擎无法处理的语言对。下载一次需 630 MB，翻译一个句子只需几秒钟。您的文本将保留在手机上。该模型仅限非商业用途（CC BY-NC 4.0）。需要 64 位手机且内存至少 6 GB。</string>
    <string name="core_tools_provider_none_on">没有开启的服务提供商。请在此工具的设置中开启一个。</string>
    <string name="core_tools_provider_offline_gifs">离线 GIF 包</string>
    <string name="core_tools_provider_offline_gifs_desc">您导入的 GIF 包。它们可以在离线状态下使用。</string>
    <string name="core_tools_provider_ollama_desc">在您电脑或网络上运行的 Ollama 服务器上的模型。请为每个服务器添加一个配置。</string>
    <string name="core_tools_provider_omnilingual_desc">Meta 为 1,600 种语言提供的单一模型，其中数百种语言在手机上没有其他语音输入方式。每个短语在暂停后到达。</string>
    <string name="core_tools_provider_on_device_ai">在您的设备上</string>
    <string name="core_tools_provider_on_device_ai_desc">下载到此手机的模型。您输入的所有内容都不会离开手机。请在 AI 页面选择并下载模型。</string>
    <string name="core_tools_provider_on_device_image">在本机</string>
    <string name="core_tools_provider_on_device_image_desc">下载到此手机的模型，或您导入的模型。您输入的内容不会离开设备。请在生成器屏幕上选择模型。</string>
    <string name="core_tools_provider_openai_compatible">兼容 OpenAI 的服务</string>
    <string name="core_tools_provider_openai_compatible_desc">任何其他使用 OpenAI 聊天 API 的服务：如 OpenRouter、Groq、Mistral、Together 或您自己的网关。请输入完整地址（包含版本号），例如 https://openrouter.ai/api/v1。</string>
    <string name="core_tools_provider_openai_compatible_image">兼容 OpenAI 的图像</string>
    <string name="core_tools_provider_openai_compatible_image_desc">任何其他使用 OpenAI 图像 API 的服务：LocalAI、DeepInfra、Nebius 或您自己的网关。请提供到版本号为止的地址，例如 https://api.deepinfra.com/v1/openai。</string>
    <string name="core_tools_provider_openai_desc">通过 OpenAI API 使用 GPT 模型，需使用您自己的密钥。</string>
    <string name="core_tools_provider_openai_image">OpenAI 图像</string>
    <string name="core_tools_provider_openai_image_desc">GPT 图像，在透明背景上绘制贴纸。按图片付费。留空则使用 AI 工具中的 OpenAI 密钥。</string>
    <string name="core_tools_provider_openhab_desc">一个 openHAB 服务器：其实时项目，以及来自语义模型的房间。</string>
    <string name="core_tools_provider_parakeet_desc">一款在手机上运行并能理解 25 种欧洲语言的大型模型。</string>
    <string name="core_tools_provider_pexels_desc">来自 Pexels 的照片。需要 API 密钥，除非此版本已内置。</string>
    <string name="core_tools_provider_pollinations_desc">免费，无需密钥和账户：提示词将发送至 Pollinations，由其选择模型。使用 enter.pollinations.ai 的密钥可开启其更新的 API，并允许您指定模型名称。</string>
    <string name="core_tools_provider_rapid_shazam">Shazam（非官方，通过 RapidAPI）</string>
    <string name="core_tools_provider_rapid_shazam_desc">通过RapidAPI上非官方的列表提供的Shazam目录，需配合RapidAPI密钥使用。此服务并非来自Apple：该列表可能会随时更改或停止服务，恕不另行通知。每个音频剪辑都会发送至RapidAPI。</string>
    <string name="core_tools_provider_recraft_desc">插图、图标和矢量风格艺术。需要来自 recraft.ai 的密钥。</string>
    <string name="core_tools_provider_rens_desc">Rens 服务器：Google Lens 的免费前端。它可以为您读取照片中的文字，支持大多数脚本。</string>
    <string name="core_tools_provider_rens_translate_desc">Rens 服务器：Google Lens 的免费前端。它将返回翻译好文本的照片。</string>
    <string name="core_tools_provider_replicate_desc">数千个托管模型。以 owner/name 格式命名任何文本转图像模型；留空则使用 FLUX Schnell。</string>
    <string name="core_tools_provider_same_kind_fallback">作为备份</string>
    <string name="core_tools_provider_same_kind_fallback_desc">同类提供程序作为一个整体运作。系统会先询问第一个，仅在其失败时（例如密钥配额用尽）才会询问下一个。</string>
    <string name="core_tools_provider_same_kind_separate">分别</string>
    <string name="core_tools_provider_same_kind_separate_desc">每一个都是独立的提供程序：拥有自己的芯片、在面板中有自己的选项、在混合网格中占有自己的份额。</string>
    <string name="core_tools_provider_searxng_desc">支持 JSON 结果的 SearXNG 实例。大多数公共实例不支持此功能。</string>
    <string name="core_tools_provider_sherpa_desc">支持 13 种语言（包括孟加拉语）的流式模型，可在手机上实现边说边打字。</string>
    <string name="core_tools_provider_simplytranslate_desc">SimplyTranslate 服务器：Google 及其他搜索引擎的免费前端。</string>
    <string name="core_tools_provider_smartthings_desc">通过三星云访问您的 SmartThings 设备、房间和场景。面板打开时状态会刷新。</string>
    <string name="core_tools_provider_stability_desc">来自 Stable Diffusion 制作方的 Stable Image Core、Ultra 和 Stable Diffusion 3.5。使用积分付费；需要从 platform.stability.ai 获取密钥。</string>
    <string name="core_tools_provider_sticker_packs_desc">您手机上的贴纸包。</string>
    <string name="core_tools_provider_switchbot_desc">通过 SwitchBot 应用中的令牌，经由 SwitchBot 云端控制您的 SwitchBot 设备、红外遥控器和场景。面板打开时，状态每分钟刷新一次。</string>
    <string name="core_tools_provider_system_recognizer">手机识别器</string>
    <string name="core_tools_provider_system_recognizer_desc">手机自带的语音识别器，通常是 Google 的。说话时文字会自动出现。</string>
    <string name="core_tools_provider_tavily_desc">提供简短回答的网络搜索。需要您的 Tavily 密钥。</string>
