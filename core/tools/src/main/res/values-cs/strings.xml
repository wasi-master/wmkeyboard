    <string name="core_tools_provider_transcription_server">Přepisovací server</string>
    <string name="core_tools_provider_transcription_server_desc">Server, který komunikuje s rozhraním API pro přepisy zvuku od OpenAI: speaches, server whisper.cpp, LocalAI, Groq nebo OpenAI. Každý klip je do něj odeslán poté, co přestanete mluvit.</string>
    <string name="core_tools_provider_translate_server">Váš překladový server</string>
    <string name="core_tools_provider_translate_server_desc">Server, který odpovídá na požadavky chatu OpenAI: llama.cpp, Ollama, LM Studio, vLLM nebo brána.</string>
    <string name="core_tools_provider_translite_desc">Server Translite: bezplatné rozhraní pro Překladač Google.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Zařízení, místnosti a scény Smart Life a Tuya Smart prostřednictvím bezplatného vývojářského projektu Tuya propojeného s vaším účtem aplikace. Stavy se obnovují, zatímco je panel otevřený.</string>
    <string name="core_tools_provider_unsplash_desc">Fotografie z Unsplash. Vyžaduje klíč API, pokud jej tato verze již neobsahuje.</string>
    <string name="core_tools_provider_vision_ocr">Váš model vidění</string>
    <string name="core_tools_provider_vision_ocr_desc">Model, který čte obrázky prostřednictvím serveru, který odpovídá na požadavky chatu OpenAI. Vyžaduje adresu a název modelu.</string>
    <string name="core_tools_provider_whisper_desc">Modely Whisper od OpenAI běžící v telefonu. Mnoho jazyků; model si stáhněte na stránce Hlasové psaní.</string>
    <string name="core_tools_provider_whistle_desc">Malý, rychlý model, který běží v telefonu. Stáhněte si jej na stránce Hlasové psaní.</string>
    <string name="core_tools_provider_xai_desc">Modely Grok prostřednictvím API xAI s vaším vlastním klíčem.</string>
