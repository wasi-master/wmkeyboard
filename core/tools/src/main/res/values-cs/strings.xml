    <string name="core_tools_provider_acrcloud_desc">Služba pro rozpoznávání hudby s dvoutýdenní zkušební verzí, poté placené tarify. Vyžaduje hostitele, přístupový klíč a přístupové tajemství projektu z console.acrcloud.com. Každý klip je odeslán do ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Bezplatné Stable Diffusion na počítačích dobrovolníků. Funguje bez klíče, ale čeká se ve frontě; bezplatný klíč z aihorde.net vás posune vpřed.</string>
    <string name="core_tools_provider_anthropic_desc">Modely Claude prostřednictvím API společnosti Anthropic s vaším vlastním klíčem.</string>
    <string name="core_tools_provider_asr4all_desc">Anglické diktování v telefonu, slova se objevují, jak mluvíte.</string>
    <string name="core_tools_provider_audd_desc">Rozpozná většinu vydané hudby z několika sekund zvuku. Vyžaduje token z dashboard.audd.io; několik stovek rozpoznání je zdarma, poté je služba placená. Každý klip je odeslán do AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Malá rozpoznávací služba, zdarma pro osobní použití s klíčem z audiotag.info, pomalejší než ostatní: odpovídá po několika sekundách. Každý klip je odeslán do AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge nebo SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Vaše vlastní webové rozhraní Stable Diffusion, spuštěné s --api. Zadejte jeho adresu, například http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">V zařízení (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Překládá v telefonu pomocí enginu Mozilla Bergamot a modelů Firefox Translations. Svobodný software, žádné služby Google a váš text zůstává v telefonu. Každý směr (francouzština do angličtiny, angličtina do francouzštiny) vyžaduje vlastní stažení o velikosti 14 až 37 MB. Vyžaduje 64bitový telefon s Androidem 9 nebo novějším.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Modely FLUX od jejich tvůrců. Vyžaduje klíč z bfl.ai.</string>
    <string name="core_tools_provider_brave">Vyhledávání Brave</string>
    <string name="core_tools_provider_brave_answers">Odpovědi Brave</string>
    <string name="core_tools_provider_brave_answers_desc">Odpovědi založené na webovém vyhledávání Brave. Vyžaduje klíč s tarifem Answers. Pokud jej necháte prázdný, zkusí se použít klíč Brave Search, který jste zadali pro webové vyhledávání.</string>
    <string name="core_tools_provider_brave_desc">Vyhledávání na webu a obrázků. Vyžaduje klíč Brave Search API, pokud jej tato verze již nemá.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX a Stable Diffusion na Cloudflare s bezplatným denním limitem. Vyžaduje API token a ID vašeho účtu.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Testovací servery rychlosti Cloudflare, nejbližší z jejich datových center. Nevyžaduje účet a kartě sdělí, v jaké síti se nacházíte a které město odpovědělo.</string>
    <string name="core_tools_provider_coinbase_desc">Měny a mince z Coinbase. Bez klíče.</string>
    <string name="core_tools_provider_coingecko_desc">Ceny mincí z CoinGecko. Bez klíče.</string>
    <string name="core_tools_provider_comfyui_desc">Váš vlastní server ComfyUI. Vytváří obrázky pomocí pracovního postupu převodu textu na obrázek a zadaného kontrolního bodu nebo toho prvního, který je k dispozici.</string>
    <string name="core_tools_provider_commons_desc">GIFy a fotky zdarma z Wikimedia Commons nebo z vlastní MediaWiki. Bez klíče. GIFy jsou většinou naučné.</string>
    <string name="core_tools_provider_currency_api_desc">Otevřená data pro většinu měn a mnoho mincí. Bez klíče.</string>
    <string name="core_tools_provider_deepl_desc">Vyžaduje váš klíč DeepL API nebo adresu proxy serveru, který jej přidá.</string>
    <string name="core_tools_provider_deepseek_desc">Modely DeepSeek prostřednictvím API společnosti DeepSeek s vaším vlastním klíčem.</string>
    <string name="core_tools_provider_er_api_desc">Denní kurzy pro většinu měn. Bez klíče.</string>
    <string name="core_tools_provider_fal_desc">Rychlé hostované modely: FLUX, Recraft, Ideogram, Qwen Image a další. Uveďte fal ID modelu; pokud je prázdné, použije se FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Kurzy Evropské centrální banky pro hlavní měny. Svobodný software, bez klíče.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modely Gemini prostřednictvím API od Googlu s vaším vlastním klíčem z AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Obrázky Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modely obrázků Nano Banana od Googlu. Prázdný klíč použije klíč Gemini z nástroje AI.</string>
    <string name="core_tools_provider_gifcities_desc">Staré GIFy z GeoCities z Internet Archive. Žádný klíč. Výsledky nemají hodnocení obsahu.</string>
    <string name="core_tools_provider_giphy_desc">GIFy a nálepky. Vždy na vlastní kartě: GIPHY neumožňuje aplikacím míchat své výsledky s ostatními.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Zařízení ve vaší aplikaci Google Home prostřednictvím služeb Play. Vždy jedna domácnost; kterou si vyberete na vlastní obrazovce Googlu.</string>
    <string name="core_tools_provider_google_translate">Google Překladač</string>
    <string name="core_tools_provider_google_translate_desc">Bezplatný koncový bod Google nebo Cloud Translation při přidání klíče.</string>
    <string name="core_tools_provider_harper_desc">Gramatický modul vestavěný v klávesnici. Pouze angličtina a nic, co napíšete, neopustí telefon.</string>
    <string name="core_tools_provider_home_assistant_desc">Váš vlastní server Home Assistant. Všechno možné, živě, s funkcí Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue bridge</string>
    <string name="core_tools_provider_hue_desc">Světla, místnosti, scény a senzory přímo z Hue bridge na vaší Wi-Fi. Nic neopouští dům.</string>
    <string name="core_tools_provider_hugging_face_desc">Modely na vlastních inferenčních serverech Hugging Face s bezplatným měsíčním limitem. Vyžaduje přístupový token s oprávněním Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIFy a nálepky. Vyžaduje klíč KLIPY API, pokud ho tato verze již neobsahuje.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatika, pravopis a styl ve více než 30 jazycích. Váš text je odeslán na server LanguageTool ke kontrole: na veřejný server api.languagetool.org, pokud nezadáte vlastní.</string>
    <string name="core_tools_provider_librespeed_desc">Server LibreSpeed: ten, který provozujete sami, nebo jeden ze serverů dobrovolníků z veřejného seznamu, vybraný podle města na obrazovce řádku.</string>
    <string name="core_tools_provider_libretranslate_desc">Server LibreTranslate: váš vlastní nebo veřejný. Veřejné servery obvykle vyžadují klíč.</string>
    <string name="core_tools_provider_lingva_desc">Server Lingva: bezplatné rozhraní pro Google Překladač.</string>
    <string name="core_tools_provider_lm_studio_desc">Modely obsluhované LM Studio ve vašem počítači. Přidejte jeden pro každý počítač.</string>
    <string name="core_tools_provider_mlkit">V zařízení</string>
    <string name="core_tools_provider_mlkit_desc">Překládá v telefonu pomocí ML Kit. Váš text zůstává v telefonu. Každý jazyk vyžaduje nejprve stažení modelu.</string>
    <string name="core_tools_provider_mode_fallback">Jeden po druhém</string>
    <string name="core_tools_provider_mode_fallback_desc">Dotázat se prvního poskytovatele. Pokud selže nebo nemá výsledky, dotázat se dalšího.</string>
    <string name="core_tools_provider_mode_mix">Smíšené</string>
    <string name="core_tools_provider_mode_mix_desc">Zeptejte se všech poskytovatelů najednou a smíchejte jejich výsledky do jedné mřížky.</string>
    <string name="core_tools_provider_mode_pick">Vyberte v panelu</string>
    <string name="core_tools_provider_mode_pick_desc">Panel zobrazuje poskytovatele, kteří jsou zapnutí. Vyberte jednoho a dotázán bude pouze ten.</string>
    <string name="core_tools_provider_mode_tabs">Karty</string>
    <string name="core_tools_provider_mode_tabs_desc">Každý poskytovatel má svůj vlastní čip. Klepnutím na čip zobrazíte jeho výsledky.</string>
    <string name="core_tools_provider_moonshine_desc">Malý, rychlý anglický model, který běží v telefonu.</string>
    <string name="core_tools_provider_mozhi_desc">Server Mozhi: bezplatné rozhraní pro Google, DeepL, DuckDuckGo, Yandex a Reverso. Zvolte si vyhledávač. DeepL a Reverso vyžadují zdrojový jazyk.</string>
    <string name="core_tools_provider_music_server">Váš vlastní rozpoznávací server</string>
    <string name="core_tools_provider_music_server_desc">Server, který provozujete a který odpovídá jako AudD: klip je odeslán jako soubor a skladba se vrátí jako JSON. Za něj umístěte otiskovač, jako je Panako nebo Olaf.</string>
    <string name="core_tools_provider_nllb">V zařízení (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Překládá v telefonu pomocí modelu NLLB-200 od Mety na CTranslate2: 200 jazyků mezi sebou pro páry, které jiné enginy nezvládnou. Jedno stažení o velikosti 630 MB, překlad věty trvá pár sekund. Váš text zůstává v telefonu. Model je licencován pouze pro nekomerční použití (CC BY-NC 4.0). Vyžaduje 64bitový telefon se 6 GB paměti nebo více.</string>
    <string name="core_tools_provider_none_on">Není zapnutý žádný poskytovatel. Zapněte jej v nastavení tohoto nástroje.</string>
    <string name="core_tools_provider_offline_gifs">Offline balíčky GIFů</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF balíčky, které jste importovali. Fungují bez připojení.</string>
    <string name="core_tools_provider_ollama_desc">Modely na serveru Ollama, který provozujete na svém počítači nebo v síti. Přidejte jeden pro každý server.</string>
    <string name="core_tools_provider_omnilingual_desc">Jeden model od společnosti Meta pro 1 600 jazyků, stovky z nich bez jiného hlasového psaní, přímo v telefonu. Každá fráze dorazí po pauze za ní.</string>
    <string name="core_tools_provider_on_device_ai">Ve vašem zařízení</string>
    <string name="core_tools_provider_on_device_ai_desc">Model stažený do tohoto telefonu. Nic, co napíšete, jej neopustí. Vyberte a stáhněte model na stránce AI.</string>
    <string name="core_tools_provider_on_device_image">V tomto telefonu</string>
    <string name="core_tools_provider_on_device_image_desc">Model stažený do tohoto telefonu nebo model, který jste importovali. Nic, co napíšete, jej neopustí. Model vyberte na obrazovce generátoru.</string>
    <string name="core_tools_provider_openai_compatible">Služba kompatibilní s OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Jakákoli jiná služba s chatovacím API OpenAI: OpenRouter, Groq, Mistral, Together nebo vaše vlastní brána. Zadejte adresu až po verzi, například https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Obrázky kompatibilní s OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Jakákoliv jiná služba kompatibilní s obrazovým rozhraním API od OpenAI: LocalAI, DeepInfra, Nebius nebo vlastní brána. Zadejte adresu včetně verze, například https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modely GPT prostřednictvím API OpenAI s vaším vlastním klíčem.</string>
    <string name="core_tools_provider_openai_image">Obrázky OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT obrázek, který kreslí nálepky na průhledném pozadí. Platí se za obrázek. Prázdný klíč použije OpenAI klíč z nástroje AI.</string>
    <string name="core_tools_provider_openhab_desc">Server openHAB: jeho položky, živě, s místnostmi ze sémantického modelu.</string>
    <string name="core_tools_provider_parakeet_desc">Velký model, který běží v telefonu a rozumí 25 evropským jazykům.</string>
    <string name="core_tools_provider_pexels_desc">Fotografie z Pexels. Vyžaduje klíč API, pokud jej tato verze již neobsahuje.</string>
    <string name="core_tools_provider_pollinations_desc">Zdarma, bez klíče a bez účtu: dotaz je odeslán do Pollinations, které vybere model. Klíč z enter.pollinations.ai otevře novější API a umožní vám pojmenovat model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neoficiální, přes RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Katalog Shazam prostřednictvím neoficiálního výpisu na RapidAPI pomocí klíče RapidAPI. Nejedná se o službu od Applu: výpis se může bez upozornění změnit nebo přestat fungovat. Každý klip je odeslán do RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrace, ikony a vektorové umění. Vyžaduje klíč z recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Server Rens: bezplatné rozhraní pro Google Lens. Přečte pro vás text na fotografii ve většině písem.</string>
    <string name="core_tools_provider_rens_translate_desc">Server Rens: bezplatné rozhraní pro Google Lens. Vrátí fotografii s přeloženým textem.</string>
    <string name="core_tools_provider_replicate_desc">Tisíce hostovaných modelů. Uveďte libovolný model typu text-to-image jako vlastník/název; pokud nevyplníte, použije se FLUX Schnell.</string>
    <string name="core_tools_provider_same_kind_fallback">Jako zálohy</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Poskytovatelé stejného druhu fungují jako jeden. První je dotázán a další pouze tehdy, když selže, například když klíči dojde kvóta.</string>
    <string name="core_tools_provider_same_kind_separate">Odděleně</string>
    <string name="core_tools_provider_same_kind_separate_desc">Každý z nich je vlastním poskytovatelem: má vlastní čip, vlastní volbu v panelu, vlastní podíl ve smíšené mřížce.</string>
    <string name="core_tools_provider_searxng_desc">Instance SearXNG, která umožňuje výsledky ve formátu JSON. Většina veřejných instancí to neumožňuje.</string>
    <string name="core_tools_provider_sherpa_desc">Streamovací modely pro 13 jazyků, včetně bengálštiny, které píší, jak mluvíte, přímo v telefonu.</string>
    <string name="core_tools_provider_simplytranslate_desc">Server SimplyTranslate: bezplatné uživatelské rozhraní pro Google a další vyhledávače.</string>
    <string name="core_tools_provider_smartthings_desc">Vaše zařízení, místnosti a scény SmartThings prostřednictvím cloudu Samsung. Stavy se aktualizují, zatímco je panel otevřený.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra a Stable Diffusion 3.5 od tvůrců Stable Diffusion. Placeno v kreditech; vyžaduje klíč z platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Vaše balíčky nálepek v tomto telefonu.</string>
    <string name="core_tools_provider_switchbot_desc">Vaše zařízení SwitchBot, infračervené ovladače a scény prostřednictvím cloudu SwitchBot s tokenem z jeho aplikace. Stavy se obnovují jednou za minutu, zatímco je panel otevřený.</string>
    <string name="core_tools_provider_system_recognizer">Rozpoznávač telefonu</string>
    <string name="core_tools_provider_system_recognizer_desc">Rozpoznávání řeči, které je součástí telefonu, obvykle od Googlu. Slova se objevují, jak mluvíte.</string>
    <string name="core_tools_provider_tavily_desc">Vyhledávání na webu se stručnou odpovědí. Vyžaduje váš klíč Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX a další otevřené modely na serverech Together.</string>
