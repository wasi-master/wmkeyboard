    <string name="core_tools_synonym_source_dictionary_api">Free Dictionary API</string>
    <string name="core_tools_synonym_source_dictionary_api_desc">Онлайн. Источник, который использует инструмент \"Словарь\".</string>
    <string name="core_tools_synonym_source_similar_words">Похожие слова</string>
    <string name="core_tools_synonym_source_similar_words_desc">Онлайн, через Datamuse. Слова с похожим значением для слов, у которых нет синонимов.</string>
