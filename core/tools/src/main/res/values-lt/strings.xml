    <string name="core_tools_provider_transcription_server">Transkripcijos serveris</string>
    <string name="core_tools_provider_transcription_server_desc">Serveris, palaikantis „OpenAI“ garso transkripcijos API: „speaches“, „whisper.cpp“ serverį, „LocalAI“, „Groq“ arba „OpenAI“. Kiekvienas įrašas siunčiamas į jį, kai nustojate kalbėti.</string>
    <string name="core_tools_provider_translate_server">Jūsų vertimo serveris</string>
    <string name="core_tools_provider_translate_server_desc">Serveris, atsakantis į „OpenAI“ pokalbių užklausas: „llama.cpp“, „Ollama“, „LM Studio“, „vLLM“ arba šliuzas.</string>
    <string name="core_tools_provider_translite_desc">„Translite“ serveris: nemokama „Google Translate“ sąsaja.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">„Smart Life“ ir „Tuya Smart“ įrenginiai, kambariai ir scenos per nemokamą „Tuya“ kūrėjo projektą, susietą su jūsų programos paskyra. Būsenos atnaujinamos, kol skydelis atidarytas.</string>
    <string name="core_tools_provider_unsplash_desc">Nuotraukos iš „Unsplash“. Reikalingas API raktas, nebent ši versija jį jau turi.</string>
    <string name="core_tools_provider_vision_ocr">Jūsų regėjimo modelis</string>
    <string name="core_tools_provider_vision_ocr_desc">Modelis, kuris nuskaito vaizdus per serverį, atsakantį į „OpenAI“ pokalbių užklausas. Reikalingas adresas ir modelio pavadinimas.</string>
    <string name="core_tools_provider_whisper_desc">„OpenAI“ „Whisper“ modeliai, veikiantys telefone. Daug kalbų; atsisiųskite modelį balso įvedimo puslapyje.</string>
    <string name="core_tools_provider_whistle_desc">Mažas, greitas modelis, veikiantis telefone. Atsisiųskite jį balso įvedimo puslapyje.</string>
    <string name="core_tools_provider_xai_desc">„Grok“ modeliai per xAI API, naudojant jūsų raktą.</string>
