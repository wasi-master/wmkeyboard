    <string name="core_tools_provider_acrcloud_desc">שירות לזיהוי מוזיקה עם תקופת ניסיון של שבועיים, ולאחריה מנויים בתשלום. דורש מהמארח, מפתח גישה וסוד גישה עבור פרויקט מ-console.acrcloud.com. כל קטע נשלח ל-ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion חינמי על מחשבי מתנדבים. עובד ללא מפתח אך דורש המתנה בתור; מפתח חינמי מ-aihorde.net יקדם אותך בתור.</string>
    <string name="core_tools_provider_anthropic_desc">מודלי Claude דרך ה-API של Anthropic, עם מפתח משלך.</string>
    <string name="core_tools_provider_asr4all_desc">הכתבה באנגלית בטלפון, עם מילים שמופיעות בזמן שאתה מדבר.</string>
    <string name="core_tools_provider_audd_desc">מזהה את רוב המוזיקה שיצאה לאור תוך כמה שניות של צליל. דורש אסימון מ-dashboard.audd.io; כמה מאות זיהויים הם בחינם, לאחר מכן זה בתשלום. כל קטע נשלח ל-AudD.</string>
    <string name="core_tools_provider_audiotag_desc">שירות זיהוי קטן, חינמי לשימוש אישי עם מפתח מ-audiotag.info, ואיטי יותר מהאחרים: הוא עונה לאחר מספר שניות. כל קטע נשלח ל-AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge או SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">ממשק ה-Web UI של Stable Diffusion שלך, שהופעל עם --api. ספק את הכתובת שלו, כגון http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">על המכשיר (תרגומים של Firefox)</string>
    <string name="core_tools_provider_bergamot_desc">מתרגם בטלפון באמצעות המנוע Bergamot של מוזילה ומודלי התרגום של פיירפוקס. תוכנה חופשית, ללא שירותי גוגל, והטקסט שלך נשאר בטלפון. כל כיוון (צרפתית לאנגלית, אנגלית לצרפתית) הוא הורדה נפרדת של 14 עד 37 מ\"ב. דורש טלפון 64-ביט עם אנדרואיד 9 ומעלה.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">מודלי FLUX מהאנשים שיצרו אותם. דורש מפתח מ-bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">תשובות המבוססות על חיפוש אינטרנט של Brave. דורש מפתח עם תוכנית Answers. אם יישאר ריק, ינוסה מפתח ה-Brave Search שהקלדת עבור חיפוש באינטרנט.</string>
    <string name="core_tools_provider_brave_desc">חיפוש אינטרנט ותמונות. דורש מפתח API של Brave Search, אלא אם כן לגרסה זו יש אחד.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX ו-Stable Diffusion ב-Cloudflare, עם מכסה יומית בחינם. דורש אסימון API ומזהה חשבון.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">שרתי בדיקת המהירות של Cloudflare, הקרובים ביותר למרכזי הנתונים שלה. אין צורך בחשבון, והוא מדווח לכרטיס באיזו רשת אתה נמצא ואיזו עיר השיבה.</string>
    <string name="core_tools_provider_coinbase_desc">מטבעות ואסימונים מ-Coinbase. ללא מפתח.</string>
    <string name="core_tools_provider_coingecko_desc">מחירי מטבעות מ-CoinGecko. ללא מפתח.</string>
    <string name="core_tools_provider_comfyui_desc">שרת ה-ComfyUI שלך. מצייר עם זרימת עבודה פשוטה של טקסט לתמונה ונקודת הביקורת שציינת, או הראשונה שיש לו.</string>
    <string name="core_tools_provider_commons_desc">קבצי GIF ותמונות בחינם מ-Wikimedia Commons, או מה-MediaWiki שלך. ללא מפתח. קבצי ה-GIF הם בעיקר לימודיים.</string>
    <string name="core_tools_provider_currency_api_desc">נתונים פתוחים עבור רוב המטבעות ומטבעות קריפטו רבים. ללא מפתח.</string>
    <string name="core_tools_provider_deepl_desc">זקוק למפתח ה-API של DeepL שלך, או לכתובת של פרוקסי שמוסיף אחד.</string>
    <string name="core_tools_provider_deepseek_desc">מודלי DeepSeek דרך ה-API של DeepSeek, עם מפתח משלך.</string>
    <string name="core_tools_provider_er_api_desc">שערים יומיים עבור רוב המטבעות. ללא מפתח.</string>
    <string name="core_tools_provider_fal_desc">מודלים מאוחסנים מהירים: FLUX, Recraft, Ideogram, Qwen Image ועוד. ציין את מזהה ה-fal של המודל; FLUX Schnell אם נשאר ריק.</string>
    <string name="core_tools_provider_frankfurter_desc">שערי המטבעות של הבנק המרכזי האירופי. תוכנה חופשית, ללא מפתח.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">מודלי Gemini דרך ה-API של גוגל, עם מפתח משלך מ-AI Studio.</string>
    <string name="core_tools_provider_gemini_image">תמונות Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">מודלי התמונה Nano Banana של Google. מפתח ריק משתמש במפתח Gemini מכלי ה-AI.</string>
    <string name="core_tools_provider_gifcities_desc">קבצי GIF ישנים מ-GeoCities מתוך ה-Internet Archive. ללא מפתח. לתוצאות אין דירוג תוכן.</string>
    <string name="core_tools_provider_giphy_desc">GIFים ומדבקות. תמיד בלשונית נפרדת: GIPHY לא מאפשרת לאפליקציות לערבב את התוצאות שלה עם אחרות.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">המכשירים ב-Google Home שלך, דרך שירותי Play. בית אחד בכל פעם; אתה בוחר איזה במסך של גוגל עצמה.</string>
    <string name="core_tools_provider_google_translate">Google Translate</string>
    <string name="core_tools_provider_google_translate_desc">נקודת הקצה החינמית של Google, או Cloud Translation בעת הוספת מפתח.</string>
    <string name="core_tools_provider_harper_desc">מנוע הדקדוק המובנה במקלדת. אנגלית בלבד, ושום דבר שאתה מקליד לא עוזב את הטלפון.</string>
    <string name="core_tools_provider_home_assistant_desc">שרת ה-Home Assistant הפרטי שלך. כל סוג של דבר, בשידור חי, עם Assist.</string>
    <string name="core_tools_provider_hue">גשר Philips Hue</string>
    <string name="core_tools_provider_hue_desc">אורות, חדרים, סצנות וחיישנים ישירות מגשר Hue ב-Wi-Fi שלך. שום דבר לא עוזב את הבית.</string>
    <string name="core_tools_provider_hugging_face_desc">מודלים בשרתי ההסקה של Hugging Face, עם מכסה חודשית חינמית. דורש אסימון גישה עם הרשאת Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIFים ומדבקות. דורש מפתח API של KLIPY, אלא אם כן לגרסה זו יש אחד.</string>
    <string name="core_tools_provider_languagetool_desc">דקדוק, איות וסגנון ביותר מ-30 שפות. הטקסט שלך נשלח לשרת LanguageTool לבדיקה: השרת הציבורי בכתובת api.languagetool.org אלא אם תזין שרת משלך.</string>
    <string name="core_tools_provider_librespeed_desc">שרת LibreSpeed: שרת שאתה מריץ בעצמך, או אחד מהשרתים של המתנדבים מהרשימה הציבורית, שנבחר לפי עיר במסך השורה.</string>
    <string name="core_tools_provider_libretranslate_desc">שרת LibreTranslate: משלך או ציבורי. שרתים ציבוריים בדרך כלל דורשים מפתח.</string>
    <string name="core_tools_provider_lingva_desc">שרת Lingva: ממשק חופשי ל-Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">מודלים המוגשים על ידי LM Studio במחשב שלך. הוסף אחד עבור כל מחשב.</string>
    <string name="core_tools_provider_mlkit">על המכשיר</string>
    <string name="core_tools_provider_mlkit_desc">מתרגם בטלפון באמצעות ML Kit. הטקסט שלך נשאר בטלפון. כל שפה דורשת הורדת מודל תחילה.</string>
    <string name="core_tools_provider_mode_fallback">אחד בכל פעם</string>
    <string name="core_tools_provider_mode_fallback_desc">שאל את הספק הראשון. אם הוא נכשל או שאין לו תוצאות, שאל את הבא בתור.</string>
    <string name="core_tools_provider_mode_mix">מעורב</string>
    <string name="core_tools_provider_mode_mix_desc">שאל את כל הספקים בו-זמנית וערבב את התוצאות שלהם ברשת אחת.</string>
    <string name="core_tools_provider_mode_pick">בחר בלוח</string>
    <string name="core_tools_provider_mode_pick_desc">הלוח מציג את הספקים הפעילים. בחר אחד מהם, ורק הוא יישאל.</string>
    <string name="core_tools_provider_mode_tabs">כרטיסיות</string>
    <string name="core_tools_provider_mode_tabs_desc">לכל ספק יש שבב משלו. הקש על שבב כדי לראות את התוצאות שלו.</string>
    <string name="core_tools_provider_moonshine_desc">מודל אנגלית קטן ומהיר שרץ על הטלפון.</string>
    <string name="core_tools_provider_mozhi_desc">שרת Mozhi: ממשק חינמי ל-Google, DeepL, DuckDuckGo, Yandex ו-Reverso. בחר את המנוע. DeepL ו-Reverso דורשים שפת מקור.</string>
    <string name="core_tools_provider_music_server">שרת זיהוי משלך</string>
    <string name="core_tools_provider_music_server_desc">שרת שאתה מריץ שמגיב כמו AudD: הקטע מועלה כקובץ והשיר חוזר בפורמט JSON. הצב מאחוריו כלי לזיהוי טביעת אצבע קולית כמו Panako או Olaf.</string>
    <string name="core_tools_provider_nllb">על המכשיר (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">מתרגם בטלפון באמצעות המודל NLLB-200 של Meta על גבי CTranslate2: 200 שפות, בין כל שתיים מהן, עבור זוגות שמנועים אחרים אינם יכולים לבצע. הורדה אחת של 630 MB, ומשפט לוקח כמה שניות. הטקסט שלך נשאר בטלפון. המודל מורשה לשימוש לא מסחרי בלבד (CC BY-NC 4.0). דורש טלפון 64-ביט עם 6 GB זיכרון או יותר.</string>
    <string name="core_tools_provider_none_on">אף ספק אינו פעיל. הפעל אחד בהגדרות הכלי הזה.</string>
    <string name="core_tools_provider_offline_gifs">חבילות GIF לא מקוונות</string>
    <string name="core_tools_provider_offline_gifs_desc">חבילות GIF שייבאת. הן עובדות ללא חיבור לאינטרנט.</string>
    <string name="core_tools_provider_ollama_desc">מודלים בשרת Ollama שאתה מריץ, במחשב שלך או ברשת שלך. הוסף אחד עבור כל שרת.</string>
    <string name="core_tools_provider_omnilingual_desc">המודל האחד של Meta ל-1,600 שפות, מאות מהן ללא הקלדה קולית אחרת, בטלפון. כל משפט מגיע בהפסקה שלאחריו.</string>
    <string name="core_tools_provider_on_device_ai">במכשיר שלך</string>
    <string name="core_tools_provider_on_device_ai_desc">מודל שהורד לטלפון זה. שום דבר שאתה כותב לא עוזב אותו. בחר והורד את המודל בדף ה-AI.</string>
    <string name="core_tools_provider_on_device_image">בטלפון זה</string>
    <string name="core_tools_provider_on_device_image_desc">מודל שהורד לטלפון זה, או מודל שייבאת. שום דבר שאתה מקליד לא עוזב אותו. בחר את המודל במסך המחולל.</string>
    <string name="core_tools_provider_openai_compatible">שירות תואם OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">כל שירות אחר עם ה-API לצ\'אט של OpenAI: OpenRouter, Groq, Mistral, Together, או שער משלך. ציין את הכתובת עד לרמת הגרסה, לדוגמה https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">תמונות תואמות OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">כל שירות אחר עם ממשק ה-API לתמונות של OpenAI: LocalAI, DeepInfra, Nebius, או שער משלך. ספק את הכתובת עד לגרסה, כגון https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">מודלי GPT דרך ה-API של OpenAI, עם מפתח משלך.</string>
    <string name="core_tools_provider_openai_image">תמונות OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">תמונת GPT, המציירת מדבקות על רקע שקוף. בתשלום לכל תמונה. מפתח ריק משתמש במפתח OpenAI מכלי ה-AI.</string>
    <string name="core_tools_provider_openhab_desc">שרת openHAB: הפריטים שלו, בשידור חי, עם חדרים מהמודל הסמנטי.</string>
    <string name="core_tools_provider_parakeet_desc">מודל גדול שרץ על הטלפון ומבין 25 שפות אירופאיות.</string>
    <string name="core_tools_provider_pexels_desc">תמונות מ-Pexels. דורש מפתח API, אלא אם כן לגרסה זו יש אחד.</string>
    <string name="core_tools_provider_pollinations_desc">חינם, ללא מפתח וללא חשבון: הבקשה נשלחת ל-Pollinations, שבוחרת את המודל. מפתח מ-enter.pollinations.ai פותח את ה-API החדש יותר שלה ומאפשר לך לתת שם למודל.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (לא רשמי, דרך RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">הקטלוג של Shazam דרך רישום לא רשמי ב-RapidAPI, עם מפתח RapidAPI. זהו אינו שירות של Apple: הרישום עשוי להשתנות או להיפסק ללא הודעה מוקדמת. כל קטע נשלח ל-RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">איורים, סמלים ואמנות בסגנון וקטורי. דורש מפתח מ-recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">שרת Rens: ממשק קדמי חינמי ל-Google Lens. הוא קורא עבורך את הטקסט בתמונה, ברוב הכתבים.</string>
    <string name="core_tools_provider_rens_translate_desc">שרת Rens: ממשק קדמי חינמי ל-Google Lens. הוא מחזיר את התמונה עם הטקסט שבה מתורגם.</string>
    <string name="core_tools_provider_replicate_desc">אלפי מודלים מאוחסנים. תן שם לכל מודל טקסט-לתמונה כ-owner/name; FLUX Schnell כאשר ריק.</string>
    <string name="core_tools_provider_same_kind_fallback">כגיבויים</string>
    <string name="core_tools_provider_same_kind_fallback_desc">ספקים מאותו סוג פועלים כאחד. הראשון נשאל, והבא אחריו רק כאשר הוא נכשל, למשל כאשר למפתח נגמרה המכסה.</string>
    <string name="core_tools_provider_same_kind_separate">בנפרד</string>
    <string name="core_tools_provider_same_kind_separate_desc">כל אחד הוא ספק בפני עצמו: שבב משלו, בחירה משלו בלוח, וחלק משלו ברשת מעורבת.</string>
    <string name="core_tools_provider_searxng_desc">מופע SearXNG המאפשר תוצאות JSON. רוב המופעים הציבוריים אינם מאפשרים זאת.</string>
    <string name="core_tools_provider_sherpa_desc">מודלים להזרמה עבור 13 שפות, ביניהן בנגלית, שמקלידים בזמן שאתה מדבר, בטלפון.</string>
    <string name="core_tools_provider_simplytranslate_desc">שרת SimplyTranslate: ממשק קדמי חינמי ל-Google ומנועים אחרים.</string>
    <string name="core_tools_provider_smartthings_desc">התקני ה-SmartThings, החדרים והתרחישים שלך, דרך הענן של סמסונג. המצבים מתרעננים בזמן שהלוח פתוח.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra ו-Stable Diffusion 3.5 מבית היוצרים של Stable Diffusion. התשלום מתבצע בקרדיטים; נדרש מפתח מ-platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">חבילות המדבקות שלך בטלפון זה.</string>
    <string name="core_tools_provider_switchbot_desc">התקני ה-SwitchBot, שלטי האינפרא-אדום והתרחישים שלך, דרך הענן של SwitchBot עם האסימון מהאפליקציה שלהם. המצבים מתרעננים פעם בדקה בזמן שהלוח פתוח.</string>
    <string name="core_tools_provider_system_recognizer">מזהה של הטלפון</string>
    <string name="core_tools_provider_system_recognizer_desc">מזהה הדיבור שמגיע עם הטלפון, בדרך כלל של גוגל. מילים מופיעות בזמן שאתה מדבר.</string>
    <string name="core_tools_provider_tavily_desc">חיפוש באינטרנט עם תשובה קצרה. דורש את מפתח ה-Tavily שלך.</string>
    <string name="core_tools_provider_together_desc">FLUX ומודלים פתוחים אחרים בשרתים של Together.</string>
    <string name="core_tools_provider_tool_ai">בינה מלאכותית</string>
    <string name="core_tools_provider_tool_currency_crypto">מחירי מטבעות</string>
    <string name="core_tools_provider_tool_currency_fiat">שערי מטבע</string>
    <string name="core_tools_provider_tool_dictionary">מילון</string>
    <string name="core_tools_provider_tool_gif">GIFים</string>
    <string name="core_tools_provider_tool_grammar">בדיקת דקדוק</string>
    <string name="core_tools_provider_tool_image_gen">מחולל מדבקות</string>
    <string name="core_tools_provider_tool_music">מזהי שירים</string>
    <string name="core_tools_provider_tool_ocr">קרא טקסט באופן מקוון</string>
    <string name="core_tools_provider_tool_photo_translate">תרגם תמונות</string>
    <string name="core_tools_provider_tool_photos">תמונות רקע</string>
    <string name="core_tools_provider_tool_search">חיפוש באינטרנט ובתמונות</string>
    <string name="core_tools_provider_tool_smart_home">בית חכם</string>
    <string name="core_tools_provider_tool_speed_test">שרתי בדיקת מהירות</string>
    <string name="core_tools_provider_tool_sticker">מדבקות</string>
    <string name="core_tools_provider_tool_synonyms">מילים נרדפות</string>
    <string name="core_tools_provider_tool_translate">תרגם</string>
    <string name="core_tools_provider_tool_vocab">אוצר מילים</string>
    <string name="core_tools_provider_tool_voice">הקלדה קולית</string>
    <string name="core_tools_provider_transcription_server">שרת תמלול</string>
    <string name="core_tools_provider_transcription_server_desc">שרת שמדבר ב-API של תמלול אודיו של OpenAI: speaches, השרת של whisper.cpp, LocalAI, Groq או OpenAI. כל קטע נשלח אליו כשאתה מפסיק לדבר.</string>
    <string name="core_tools_provider_translate_server">שרת התרגום שלך</string>
    <string name="core_tools_provider_translate_server_desc">שרת שעונה לבקשות צ\'אט של OpenAI: llama.cpp, Ollama, LM Studio, vLLM או שער (gateway).</string>
    <string name="core_tools_provider_translite_desc">שרת Translite: ממשק קדמי חינמי ל-Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">מכשירי Smart Life ו-Tuya Smart, חדרים וסצנות, דרך פרויקט מפתחים חינמי של Tuya המקושר לחשבון האפליקציה שלך. המצבים מתרעננים בזמן שהלוח פתוח.</string>
    <string name="core_tools_provider_unsplash_desc">תמונות מ-Unsplash. דורש מפתח API, אלא אם כן לגרסה זו יש אחד.</string>
    <string name="core_tools_provider_vision_ocr">מודל הראייה שלך</string>
    <string name="core_tools_provider_vision_ocr_desc">מודל שקורא תמונות, דרך שרת שעונה לבקשות צ\'אט של OpenAI. דורש את הכתובת ושם המודל.</string>
    <string name="core_tools_provider_whisper_desc">מודלי ה-Whisper של OpenAI, מורצים על גבי הטלפון. שפות רבות; ניתן להוריד מודל בדף הקלדה קולית.</string>
    <string name="core_tools_provider_whistle_desc">מודל קטן ומהיר שרץ על הטלפון. הורד אותו בדף הקלדה קולית.</string>
    <string name="core_tools_provider_xai_desc">מודלי Grok דרך ה-API של xAI, עם מפתח משלך.</string>
    <string name="core_tools_provider_xai_image">Grok Imagine</string>
    <string name="core_tools_provider_xai_image_desc">מודל התמונות של xAI. מקש ריק משתמש במפתח ה-xAI מכלי ה-AI.</string>
