    <string name="core_tools_dictionary_source_offline_bengali">Wiktionary Bengali–Inggris</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">Di perangkat ini, setelah diunduh. Kata-kata bahasa Bengali dengan arti bahasa Inggris dan cara pengucapannya.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, luring</string>
