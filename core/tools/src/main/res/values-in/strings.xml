    <string name="core_tools_provider_translate_server">Server terjemahan Anda</string>
    <string name="core_tools_provider_translate_server_desc">Server yang menjawab permintaan obrolan OpenAI: llama.cpp, Ollama, LM Studio, vLLM, atau gateway.</string>
    <string name="core_tools_provider_translite_desc">Server Translite: antarmuka gratis untuk Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Perangkat, ruangan, dan skenario Smart Life dan Tuya Smart, melalui proyek pengembang Tuya gratis yang ditautkan ke akun aplikasi Anda. Status diperbarui saat panel terbuka.</string>
    <string name="core_tools_provider_unsplash_desc">Foto dari Unsplash. Memerlukan kunci API, kecuali jika build ini sudah memilikinya.</string>
    <string name="core_tools_provider_vision_ocr">Model visi Anda</string>
    <string name="core_tools_provider_vision_ocr_desc">Model yang membaca gambar, melalui server yang menjawab permintaan obrolan OpenAI. Memerlukan alamat dan nama model.</string>
    <string name="core_tools_provider_whisper_desc">Model Whisper OpenAI, dijalankan di ponsel. Banyak bahasa; unduh model di halaman pengetikan Suara.</string>
    <string name="core_tools_provider_whistle_desc">Model kecil dan cepat yang berjalan di ponsel. Unduh di halaman pengetikan Suara.</string>
