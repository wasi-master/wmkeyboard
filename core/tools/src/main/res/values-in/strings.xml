    <string name="core_tools_provider_acrcloud_desc">Layanan pengenalan musik dengan uji coba dua minggu, kemudian paket berbayar. Memerlukan host, kunci akses, dan rahasia akses proyek dari console.acrcloud.com. Setiap klip dikirim ke ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion gratis di komputer sukarelawan. Berfungsi tanpa kunci tetapi menunggu dalam antrean; kunci gratis dari aihorde.net akan memajukan posisi Anda.</string>
    <string name="core_tools_provider_anthropic_desc">Model Claude melalui API Anthropic, dengan kunci Anda sendiri.</string>
    <string name="core_tools_provider_asr4all_desc">Dikte bahasa Inggris di ponsel, dengan kata-kata yang muncul saat Anda berbicara.</string>
    <string name="core_tools_provider_audd_desc">Mengenali sebagian besar musik yang dirilis dari beberapa detik suara. Memerlukan token dari dashboard.audd.io; beberapa ratus pengenalan gratis, setelah itu berbayar. Setiap klip dikirim ke AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Layanan pengenalan kecil, gratis untuk penggunaan pribadi dengan kunci dari audiotag.info, dan lebih lambat dari yang lain: merespons setelah beberapa detik. Setiap klip dikirim ke AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge, atau SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">UI web Stable Diffusion Anda sendiri, dimulai dengan --api. Masukkan alamatnya, seperti http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Di perangkat (Terjemahan Firefox)</string>
    <string name="core_tools_provider_bergamot_desc">Menerjemahkan di ponsel dengan mesin Bergamot Mozilla dan model Terjemahan Firefox. Perangkat lunak gratis, tanpa layanan Google, dan teks Anda tetap ada di ponsel. Setiap arah (Prancis ke Inggris, Inggris ke Prancis) adalah unduhan tersendiri sebesar 14 hingga 37 MB. Memerlukan ponsel 64-bit dengan Android 9 atau lebih baru.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Model FLUX dari pembuatnya. Memerlukan kunci dari bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Jawaban Brave</string>
    <string name="core_tools_provider_brave_answers_desc">Jawaban yang didasarkan pada pencarian web Brave. Memerlukan kunci dengan paket Jawaban. Jika dikosongkan, kunci Pencarian Brave yang Anda ketik untuk pencarian web akan dicoba.</string>
    <string name="core_tools_provider_brave_desc">Pencarian web dan gambar. Memerlukan kunci API Brave Search, kecuali build ini memilikinya.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX dan Stable Diffusion di Cloudflare, dengan kuota harian gratis. Memerlukan token API dan id akun Anda.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Server uji kecepatan Cloudflare, yang terdekat dari pusat datanya. Tidak memerlukan akun, dan memberi tahu kartu jaringan mana yang Anda gunakan dan kota mana yang merespons.</string>
    <string name="core_tools_provider_coinbase_desc">Mata uang dan koin dari Coinbase. Tanpa kunci.</string>
    <string name="core_tools_provider_coingecko_desc">Harga koin dari CoinGecko. Tanpa kunci.</string>
    <string name="core_tools_provider_comfyui_desc">Server ComfyUI Anda sendiri. Menggambar dengan alur kerja teks-ke-gambar biasa dan checkpoint yang Anda beri nama, atau yang pertama yang dimilikinya.</string>
    <string name="core_tools_provider_commons_desc">GIF dan foto gratis dari Wikimedia Commons, atau dari MediaWiki Anda sendiri. Tanpa kunci. GIF tersebut sebagian besar bersifat edukatif.</string>
    <string name="core_tools_provider_currency_api_desc">Buka data untuk sebagian besar mata uang dan banyak koin. Tanpa kunci.</string>
    <string name="core_tools_provider_deepl_desc">Memerlukan kunci API DeepL Anda, atau alamat proxy yang menambahkannya.</string>
    <string name="core_tools_provider_deepseek_desc">Model DeepSeek melalui API DeepSeek, dengan kunci Anda sendiri.</string>
    <string name="core_tools_provider_er_api_desc">Kurs harian untuk sebagian besar mata uang. Tanpa kunci.</string>
    <string name="core_tools_provider_fal_desc">Model yang dihosting dengan cepat: FLUX, Recraft, Ideogram, Qwen Image, dan lainnya. Sebutkan fal id model; FLUX Schnell jika dikosongkan.</string>
    <string name="core_tools_provider_frankfurter_desc">Kurs Bank Sentral Eropa untuk mata uang utama. Perangkat lunak gratis, tanpa kunci.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Model Gemini melalui API Google, dengan kunci Anda sendiri dari AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gambar Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Model gambar Nano Banana Google. Kunci kosong menggunakan kunci Gemini dari alat AI.</string>
    <string name="core_tools_provider_gifcities_desc">GIF GeoCities lama dari Internet Archive. Tanpa kunci. Hasilnya tidak memiliki peringkat konten.</string>
    <string name="core_tools_provider_giphy_desc">GIF dan stiker. Selalu di tabnya sendiri: GIPHY tidak mengizinkan aplikasi mencampur hasilnya dengan yang lain.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Perangkat di Google Home Anda, melalui layanan Play. Satu rumah dalam satu waktu; Anda memilih yang mana di layar Google sendiri.</string>
    <string name="core_tools_provider_google_translate">Google Terjemahan</string>
    <string name="core_tools_provider_google_translate_desc">Titik akhir gratis dari Google, atau Cloud Translation jika Anda menambahkan kunci.</string>
    <string name="core_tools_provider_harper_desc">Mesin tata bahasa yang terpasang di papan ketik. Hanya bahasa Inggris, dan tidak ada yang Anda ketik meninggalkan ponsel.</string>
    <string name="core_tools_provider_home_assistant_desc">Server Home Assistant Anda sendiri. Segala jenis hal, secara langsung, dengan Assist.</string>
    <string name="core_tools_provider_hue">Jembatan Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Lampu, ruangan, pemandangan, dan sensor langsung dari jembatan Hue di Wi-Fi Anda. Tidak ada data yang keluar dari rumah.</string>
    <string name="core_tools_provider_hugging_face_desc">Model di server inferensi milik Hugging Face, dengan kuota bulanan gratis. Memerlukan token akses dengan izin Penyedia Inferensi.</string>
    <string name="core_tools_provider_klipy_desc">GIF dan stiker. Memerlukan kunci API KLIPY, kecuali build ini sudah memilikinya.</string>
    <string name="core_tools_provider_languagetool_desc">Tata bahasa, ejaan, dan gaya dalam lebih dari 30 bahasa. Teks Anda dikirim ke server LanguageTool untuk diperiksa: server publik di api.languagetool.org kecuali jika Anda memasukkan server Anda sendiri.</string>
    <string name="core_tools_provider_librespeed_desc">Server LibreSpeed: server yang Anda jalankan sendiri, atau salah satu server sukarelawan dari daftar publik, yang dipilih berdasarkan kota di layar baris itu sendiri.</string>
    <string name="core_tools_provider_libretranslate_desc">Server LibreTranslate: milik Anda sendiri atau publik. Server publik biasanya memerlukan kunci.</string>
    <string name="core_tools_provider_lingva_desc">Server Lingva: antarmuka gratis untuk Google Terjemahan.</string>
    <string name="core_tools_provider_lm_studio_desc">Model yang disajikan oleh LM Studio di komputer Anda. Tambahkan satu untuk setiap komputer.</string>
    <string name="core_tools_provider_mlkit">Di perangkat</string>
    <string name="core_tools_provider_mlkit_desc">Menerjemahkan di ponsel dengan ML Kit. Teks Anda tetap ada di ponsel. Setiap bahasa perlu mengunduh model terlebih dahulu.</string>
    <string name="core_tools_provider_mode_fallback">Satu per satu</string>
    <string name="core_tools_provider_mode_fallback_desc">Tanyakan kepada penyedia pertama. Jika gagal atau tidak ada hasil, tanyakan kepada penyedia berikutnya.</string>
    <string name="core_tools_provider_mode_mix">Campuran</string>
    <string name="core_tools_provider_mode_mix_desc">Tanyakan semua penyedia pada saat yang sama dan campur hasil mereka dalam satu kisi.</string>
    <string name="core_tools_provider_mode_pick">Pilih di panel</string>
    <string name="core_tools_provider_mode_pick_desc">Panel menampilkan penyedia yang aktif. Pilih salah satu di sana, dan hanya penyedia itu yang akan diminta.</string>
    <string name="core_tools_provider_mode_tabs">Tab</string>
    <string name="core_tools_provider_mode_tabs_desc">Setiap penyedia mendapatkan chip-nya sendiri. Ketuk chip untuk melihat hasilnya.</string>
    <string name="core_tools_provider_moonshine_desc">Model bahasa Inggris yang kecil dan cepat yang berjalan di ponsel.</string>
    <string name="core_tools_provider_mozhi_desc">Server Mozhi: antarmuka gratis untuk Google, DeepL, DuckDuckGo, Yandex, dan Reverso. Pilih mesinnya. DeepL dan Reverso memerlukan bahasa sumber.</string>
    <string name="core_tools_provider_music_server">Server pengenalan Anda sendiri</string>
    <string name="core_tools_provider_music_server_desc">Server yang Anda jalankan yang merespons seperti AudD: klip diposting sebagai file dan lagu dikembalikan sebagai JSON. Letakkan fingerprinter seperti Panako atau Olaf di belakangnya.</string>
    <string name="core_tools_provider_nllb">Di perangkat (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Menerjemahkan di ponsel dengan model NLLB-200 Meta pada CTranslate2: 200 bahasa, di antara keduanya, untuk pasangan bahasa yang tidak dapat dilakukan mesin lain. Sekali unduh sebesar 630 MB, dan satu kalimat memerlukan beberapa detik. Teks Anda tetap di ponsel. Model ini dilisensikan hanya untuk penggunaan non-komersial (CC BY-NC 4.0). Memerlukan ponsel 64-bit dengan memori 6 GB atau lebih.</string>
    <string name="core_tools_provider_none_on">Tidak ada penyedia yang aktif. Aktifkan salah satu di pengaturan alat ini.</string>
    <string name="core_tools_provider_offline_gifs">Paket GIF offline</string>
    <string name="core_tools_provider_offline_gifs_desc">Paket GIF yang Anda impor. Berfungsi tanpa koneksi.</string>
    <string name="core_tools_provider_ollama_desc">Model di server Ollama yang Anda jalankan, di komputer atau jaringan Anda. Tambahkan satu untuk setiap server.</string>
    <string name="core_tools_provider_omnilingual_desc">Satu model Meta untuk 1.600 bahasa, ratusan di antaranya tidak memiliki pengetikan suara lain, di ponsel. Setiap frasa tiba setelah jeda.</string>
    <string name="core_tools_provider_on_device_ai">Di perangkat Anda</string>
    <string name="core_tools_provider_on_device_ai_desc">Model yang diunduh ke ponsel ini. Tidak ada yang Anda tulis yang akan keluar dari perangkat. Pilih dan unduh model di halaman AI.</string>
    <string name="core_tools_provider_on_device_image">Di ponsel ini</string>
    <string name="core_tools_provider_on_device_image_desc">Model yang diunduh ke ponsel ini, atau yang Anda impor. Tidak ada yang Anda ketik yang keluar dari sini. Pilih model di layar generator.</string>
    <string name="core_tools_provider_openai_compatible">Layanan yang kompatibel dengan OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Layanan lain apa pun dengan API obrolan OpenAI: OpenRouter, Groq, Mistral, Together, atau gateway Anda sendiri. Berikan alamat hingga versinya, seperti https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Gambar yang kompatibel dengan OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Layanan lain apa pun dengan API gambar OpenAI: LocalAI, DeepInfra, Nebius, atau gateway milik Anda sendiri. Berikan alamat hingga versinya, seperti https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Model GPT melalui API OpenAI, dengan kunci Anda sendiri.</string>
    <string name="core_tools_provider_openai_image">Gambar OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, yang menggambar stiker pada latar belakang transparan. Berbayar per gambar. Kunci kosong menggunakan kunci OpenAI dari alat AI.</string>
    <string name="core_tools_provider_openhab_desc">Server openHAB: item-itemnya, secara langsung, dengan ruangan dari model semantik.</string>
    <string name="core_tools_provider_parakeet_desc">Model besar yang berjalan di ponsel dan memahami 25 bahasa Eropa.</string>
    <string name="core_tools_provider_pexels_desc">Foto dari Pexels. Memerlukan kunci API, kecuali jika versi build ini sudah memilikinya.</string>
    <string name="core_tools_provider_pollinations_desc">Gratis, tanpa kunci dan tanpa akun: prompt dikirim ke Pollinations, yang memilih modelnya. Kunci dari enter.pollinations.ai membuka API yang lebih baru dan memungkinkan Anda memberi nama model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (tidak resmi, melalui RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Katalog Shazam melalui daftar tidak resmi di RapidAPI, dengan kunci RapidAPI. Bukan layanan Apple: daftar dapat berubah atau berhenti tanpa pemberitahuan. Setiap klip dikirim ke RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrasi, ikon, dan seni bergaya vektor. Memerlukan kunci dari recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Server Rens: antarmuka gratis untuk Google Lens. Server ini membaca teks dalam foto untuk Anda, dalam sebagian besar aksara.</string>
    <string name="core_tools_provider_rens_translate_desc">Server Rens: antarmuka gratis untuk Google Lens. Memberikan foto kembali dengan teks yang diterjemahkan.</string>
    <string name="core_tools_provider_replicate_desc">Ribuan model yang dihosting. Beri nama model teks-ke-gambar apa pun sebagai pemilik/nama; FLUX Schnell jika kosong.</string>
    <string name="core_tools_provider_same_kind_fallback">Sebagai cadangan</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Penyedia dengan jenis yang sama bertindak sebagai satu kesatuan. Yang pertama diminta, dan yang berikutnya hanya jika yang pertama gagal, misalnya saat kuota kunci habis.</string>
    <string name="core_tools_provider_same_kind_separate">Secara terpisah</string>
    <string name="core_tools_provider_same_kind_separate_desc">Masing-masing adalah penyedianya sendiri: chip-nya sendiri, pilihannya sendiri di panel, bagiannya sendiri dari kisi campuran.</string>
    <string name="core_tools_provider_searxng_desc">Instans SearXNG yang mengizinkan hasil JSON. Sebagian besar instans publik tidak mengizinkannya.</string>
    <string name="core_tools_provider_sherpa_desc">Model streaming untuk 13 bahasa, termasuk bahasa Bengali, yang mengetik saat Anda berbicara, di ponsel.</string>
    <string name="core_tools_provider_simplytranslate_desc">Server SimplyTranslate: antarmuka gratis untuk Google dan mesin lainnya.</string>
    <string name="core_tools_provider_smartthings_desc">Perangkat, ruangan, dan adegan SmartThings Anda, melalui cloud Samsung. Status diperbarui saat panel terbuka.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra, dan Stable Diffusion 3.5 dari pembuat Stable Diffusion. Dibayar dengan kredit; memerlukan kunci dari platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Paket stiker Anda di ponsel ini.</string>
    <string name="core_tools_provider_switchbot_desc">Perangkat SwitchBot, remote inframerah, dan skenario Anda, melalui cloud SwitchBot dengan token dari aplikasinya. Status diperbarui sekali semenit saat panel terbuka.</string>
    <string name="core_tools_provider_system_recognizer">Pengenal ponsel</string>
    <string name="core_tools_provider_system_recognizer_desc">Pengenal ucapan yang disertakan dengan ponsel, biasanya milik Google. Kata-kata akan muncul saat Anda berbicara.</string>
    <string name="core_tools_provider_tavily_desc">Pencarian web dengan jawaban singkat. Memerlukan kunci Tavily Anda.</string>
    <string name="core_tools_provider_together_desc">FLUX dan model terbuka lainnya di server Together.</string>
