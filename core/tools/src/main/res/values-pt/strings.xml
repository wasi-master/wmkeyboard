    <string name="core_tools_provider_translate_server">Seu servidor de tradução</string>
    <string name="core_tools_provider_translate_server_desc">Um servidor que responde a solicitações de chat da OpenAI: llama.cpp, Ollama, LM Studio, vLLM ou um gateway.</string>
    <string name="core_tools_provider_translite_desc">Um servidor Translite: um front-end gratuito para o Google Tradutor.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Dispositivos, cômodos e cenas do Smart Life e Tuya Smart, através de um projeto de desenvolvedor Tuya gratuito vinculado à sua conta do aplicativo. Os estados são atualizados enquanto o painel está aberto.</string>
    <string name="core_tools_provider_unsplash_desc">Fotos do Unsplash. Requer uma chave de API, a menos que esta versão já possua uma.</string>
    <string name="core_tools_provider_vision_ocr">Seu modelo de visão</string>
    <string name="core_tools_provider_vision_ocr_desc">Um modelo que lê imagens, através de um servidor que responde a solicitações de chat da OpenAI. Precisa do endereço e do nome do modelo.</string>
    <string name="core_tools_provider_whisper_desc">Modelos Whisper da OpenAI, executados no telefone. Muitos idiomas; baixe um modelo na página de digitação por voz.</string>
    <string name="core_tools_provider_whistle_desc">Um modelo pequeno e rápido que roda no telefone. Baixe-o na página de digitação por voz.</string>
