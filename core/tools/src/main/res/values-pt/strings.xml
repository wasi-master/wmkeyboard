    <string name="core_tools_provider_acrcloud_desc">Um serviço de reconhecimento de música com um período experimental de duas semanas, seguido de planos pagos. Requer o host, a chave de acesso e o segredo de acesso de um projeto em console.acrcloud.com. Cada clipe é enviado para a ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion gratuito em computadores de voluntários. Funciona sem chave, mas aguarda numa fila; uma chave gratuita de aihorde.net fá-lo subir na fila.</string>
    <string name="core_tools_provider_anthropic_desc">Modelos Claude através da API da Anthropic, com sua própria chave.</string>
    <string name="core_tools_provider_asr4all_desc">Ditado em inglês no telefone, com palavras aparecendo conforme você fala.</string>
    <string name="core_tools_provider_audd_desc">Reconhece a maioria das músicas lançadas a partir de alguns segundos de som. Requer um token do dashboard.audd.io; algumas centenas de reconhecimentos são gratuitos, depois é pago. Cada clipe é enviado para o AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Um pequeno serviço de reconhecimento, gratuito para uso pessoal com uma chave de audiotag.info, e mais lento que os outros: ele responde após alguns segundos. Cada clipe é enviado para o AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge ou SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Sua própria interface web do Stable Diffusion, iniciada com --api. Forneça seu endereço, como http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">No dispositivo (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Traduz diretamente no telemóvel com o motor Bergamot da Mozilla e os modelos do Firefox Translations. Software gratuito, sem serviços Google e o seu texto permanece no dispositivo. Cada direção (francês para inglês, inglês para francês) requer uma transferência separada de 14 a 37 MB. Requer um telemóvel de 64 bits com Android 9 ou superior.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Os modelos FLUX dos criadores originais. Requer uma chave de bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Respostas baseadas em uma pesquisa na web do Brave. Requer uma chave com o plano Answers. Se deixado em branco, a chave do Brave Search que você digitou para pesquisa na web será tentada.</string>
    <string name="core_tools_provider_brave_desc">Pesquisa na web e de imagens. Requer uma chave de API do Brave Search, a menos que esta versão já possua uma.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX e Stable Diffusion na Cloudflare, com uma quota diária gratuita. Requer um token de API e o seu ID de conta.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Servidores de teste de velocidade da Cloudflare, o mais próximo dos seus centros de dados. Não requer conta e indica ao cartão em que rede você está e qual cidade respondeu.</string>
    <string name="core_tools_provider_coinbase_desc">Moedas e criptomoedas da Coinbase. Sem chave.</string>
    <string name="core_tools_provider_coingecko_desc">Preços de moedas do CoinGecko. Sem chave.</string>
    <string name="core_tools_provider_comfyui_desc">Seu próprio servidor ComfyUI. Desenha com um fluxo de trabalho de texto para imagem simples e o checkpoint que você nomear, ou o primeiro que ele tiver.</string>
    <string name="core_tools_provider_commons_desc">GIFs e fotos gratuitos do Wikimedia Commons, ou do seu próprio MediaWiki. Sem chave. Os GIFs são principalmente educacionais.</string>
    <string name="core_tools_provider_currency_api_desc">Dados abertos para a maioria das moedas e muitas criptomoedas. Sem chave.</string>
    <string name="core_tools_provider_deepl_desc">Requer sua chave de API do DeepL ou o endereço de um proxy que adicione uma.</string>
    <string name="core_tools_provider_deepseek_desc">Modelos DeepSeek através da API do DeepSeek, com a sua própria chave.</string>
    <string name="core_tools_provider_er_api_desc">Taxas diárias para a maioria das moedas. Sem chave.</string>
    <string name="core_tools_provider_fal_desc">Modelos hospedados rápidos: FLUX, Recraft, Ideogram, Qwen Image e mais. Nomeie o fal id do modelo; FLUX Schnell quando vazio.</string>
    <string name="core_tools_provider_frankfurter_desc">Taxas do Banco Central Europeu para as principais moedas. Software livre, sem chave.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modelos Gemini através da API do Google, com sua própria chave do AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Imagens Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modelos de imagem Nano Banana do Google. Uma chave em branco usa a chave Gemini da ferramenta de IA.</string>
    <string name="core_tools_provider_gifcities_desc">GIFs antigos do GeoCities do Internet Archive. Sem chave. Os resultados não têm classificação de conteúdo.</string>
    <string name="core_tools_provider_giphy_desc">GIFs e figurinhas. Sempre em sua própria aba: o GIPHY não permite que aplicativos misturem seus resultados com outros.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Os dispositivos em sua Google Home, através dos serviços do Play. Uma casa por vez; você escolhe qual na própria tela do Google.</string>
    <string name="core_tools_provider_google_translate">Google Tradutor</string>
    <string name="core_tools_provider_google_translate_desc">Endpoint gratuito do Google, ou Cloud Translation quando você adiciona uma chave.</string>
    <string name="core_tools_provider_harper_desc">O motor gramatical integrado no teclado. Apenas em inglês, e nada do que escreve sai do telemóvel.</string>
    <string name="core_tools_provider_home_assistant_desc">O seu próprio servidor Home Assistant. Todos os tipos de coisas, ao vivo, com o Assist.</string>
    <string name="core_tools_provider_hue">Ponte Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Luzes, cômodos, cenas e sensores diretamente de uma ponte Hue no seu Wi-Fi. Nada sai de casa.</string>
    <string name="core_tools_provider_hugging_face_desc">Modelos nos servidores de inferência do Hugging Face, com uma franquia mensal gratuita. Requer um token de acesso com permissão de Provedores de Inferência.</string>
    <string name="core_tools_provider_klipy_desc">GIFs e figurinhas. Requer uma chave de API KLIPY, a menos que esta versão já possua uma.</string>
    <string name="core_tools_provider_languagetool_desc">Gramática, ortografia e estilo em mais de 30 idiomas. O seu texto é enviado para um servidor LanguageTool para ser verificado: o público em api.languagetool.org, a menos que introduza o seu próprio.</string>
    <string name="core_tools_provider_librespeed_desc">Um servidor LibreSpeed: um que você mesmo executa, ou um dos servidores de voluntários da lista pública, escolhido por cidade na própria tela da linha.</string>
    <string name="core_tools_provider_libretranslate_desc">Um servidor LibreTranslate: o seu próprio ou um público. Servidores públicos geralmente precisam de uma chave.</string>
    <string name="core_tools_provider_lingva_desc">Um servidor Lingva: uma interface gratuita para o Google Tradutor.</string>
    <string name="core_tools_provider_lm_studio_desc">Modelos servidos pelo LM Studio no seu computador. Adicione um para cada computador.</string>
    <string name="core_tools_provider_mlkit">No dispositivo</string>
    <string name="core_tools_provider_mlkit_desc">Traduz no telefone com o ML Kit. Seu texto permanece no telefone. Cada idioma precisa primeiro do download de um modelo.</string>
    <string name="core_tools_provider_mode_fallback">Um de cada vez</string>
    <string name="core_tools_provider_mode_fallback_desc">Consultar o primeiro provedor. Se falhar ou não obtiver resultados, consultar o seguinte.</string>
    <string name="core_tools_provider_mode_mix">Misto</string>
    <string name="core_tools_provider_mode_mix_desc">Consultar todos os provedores ao mesmo tempo e misturar seus resultados em uma grade.</string>
    <string name="core_tools_provider_mode_pick">Escolher no painel</string>
    <string name="core_tools_provider_mode_pick_desc">O painel mostra os provedores que estão ativos. Escolha um lá, e apenas esse será consultado.</string>
    <string name="core_tools_provider_mode_tabs">Guias</string>
    <string name="core_tools_provider_mode_tabs_desc">Cada provedor recebe seu próprio guia. Toque em uma guia para ver os resultados.</string>
    <string name="core_tools_provider_moonshine_desc">Um modelo de inglês pequeno e rápido que roda no telefone.</string>
    <string name="core_tools_provider_mozhi_desc">Um servidor Mozhi: um front-end gratuito para Google, DeepL, DuckDuckGo, Yandex e Reverso. Escolha o mecanismo. DeepL e Reverso precisam de um idioma de origem.</string>
    <string name="core_tools_provider_music_server">Seu próprio servidor de reconhecimento</string>
    <string name="core_tools_provider_music_server_desc">Um servidor que você executa e que responde como o AudD: o clipe é postado como um arquivo e a música retorna como JSON. Coloque um identificador de áudio como Panako ou Olaf por trás dele.</string>
    <string name="core_tools_provider_nllb">No dispositivo (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Traduz no telemóvel com o modelo NLLB-200 da Meta no CTranslate2: 200 idiomas, entre quaisquer dois deles, para os pares que os outros motores não conseguem fazer. Uma transferência de 630 MB, e uma frase demora alguns segundos. O seu texto permanece no telemóvel. O modelo está licenciado apenas para uso não comercial (CC BY-NC 4.0). Requer um telemóvel de 64 bits com 6 GB de memória ou mais.</string>
    <string name="core_tools_provider_none_on">Nenhum provedor está ativado. Ative um nas configurações desta ferramenta.</string>
    <string name="core_tools_provider_offline_gifs">Pacotes de GIF offline</string>
    <string name="core_tools_provider_offline_gifs_desc">Pacotes de GIF que você importou. Eles funcionam sem conexão.</string>
    <string name="core_tools_provider_ollama_desc">Modelos em um servidor Ollama que você executa, no seu computador ou na sua rede. Adicione um para cada servidor.</string>
    <string name="core_tools_provider_omnilingual_desc">O modelo único da Meta para 1.600 idiomas, centenas deles sem outra digitação por voz, no telefone. Cada frase chega na pausa após ela.</string>
    <string name="core_tools_provider_on_device_ai">No seu dispositivo</string>
    <string name="core_tools_provider_on_device_ai_desc">Um modelo baixado para este telefone. Nada do que você escreve sai dele. Escolha e baixe o modelo na página de IA.</string>
    <string name="core_tools_provider_on_device_image">Neste telefone</string>
    <string name="core_tools_provider_on_device_image_desc">Um modelo baixado para este telefone, ou um que você importou. Nada do que você digita sai dele. Escolha o modelo na tela do gerador.</string>
    <string name="core_tools_provider_openai_compatible">Serviço compatível com OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Qualquer outro serviço com a API de chat da OpenAI: OpenRouter, Groq, Mistral, Together ou um gateway próprio. Indique o endereço até à versão, como https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Imagens compatíveis com OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Qualquer outro serviço com a API de imagem da OpenAI: LocalAI, DeepInfra, Nebius ou um gateway próprio. Forneça o endereço até a versão, como https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modelos GPT através da API da OpenAI, com sua própria chave.</string>
    <string name="core_tools_provider_openai_image">Imagens OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, que desenha adesivos em um fundo transparente. Pago por imagem. Uma chave em branco usa a chave OpenAI da ferramenta de IA.</string>
    <string name="core_tools_provider_openhab_desc">Um servidor openHAB: seus itens, ao vivo, com salas do modelo semântico.</string>
    <string name="core_tools_provider_parakeet_desc">Um modelo grande que roda no telefone e entende 25 idiomas europeus.</string>
    <string name="core_tools_provider_pexels_desc">Fotos do Pexels. Requer uma chave de API, a menos que esta compilação tenha uma.</string>
    <string name="core_tools_provider_pollinations_desc">Gratuito, sem chave e sem conta: o prompt é enviado para Pollinations, que escolhe o modelo. Uma chave de enter.pollinations.ai abre sua API mais recente e permite que você nomeie um modelo.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (não oficial, via RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Catálogo do Shazam por meio de uma listagem não oficial no RapidAPI, com uma chave RapidAPI. Não é um serviço da Apple: a listagem pode mudar ou parar sem aviso prévio. Cada clipe é enviado para o RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrações, ícones e arte em estilo vetorial. Requer uma chave do recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Um servidor Rens: um front-end gratuito para o Google Lens. Ele lê o texto em uma foto para você, na maioria dos scripts.</string>
    <string name="core_tools_provider_rens_translate_desc">Um servidor Rens: um front-end gratuito para o Google Lens. Ele devolve a foto com o texto traduzido.</string>
    <string name="core_tools_provider_replicate_desc">Milhares de modelos hospedados. Nomeie qualquer modelo de texto para imagem como proprietário/nome; FLUX Schnell quando vazio.</string>
    <string name="core_tools_provider_same_kind_fallback">Como backups</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Provedores do mesmo tipo agem como um só. O primeiro é consultado, e o próximo apenas quando ele falha, por exemplo, quando uma chave esgota a cota.</string>
    <string name="core_tools_provider_same_kind_separate">Separadamente</string>
    <string name="core_tools_provider_same_kind_separate_desc">Cada um é seu próprio provedor: seu próprio chip, sua própria escolha no painel, sua própria parte de uma grade mista.</string>
    <string name="core_tools_provider_searxng_desc">Uma instância SearXNG que permite resultados em JSON. A maioria das instâncias públicas não permite.</string>
    <string name="core_tools_provider_sherpa_desc">Modelos de streaming para 13 idiomas, incluindo o bengali, que digitam enquanto você fala, no telefone.</string>
    <string name="core_tools_provider_simplytranslate_desc">Um servidor SimplyTranslate: um front-end gratuito para o Google e outros motores.</string>
    <string name="core_tools_provider_smartthings_desc">Seus dispositivos, cômodos e cenas do SmartThings, através da nuvem da Samsung. Os estados são atualizados enquanto o painel está aberto.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra e Stable Diffusion 3.5 dos criadores do Stable Diffusion. Pago em créditos; requer uma chave de platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Seus pacotes de figurinhas neste celular.</string>
    <string name="core_tools_provider_switchbot_desc">Seus dispositivos SwitchBot, controles remotos infravermelhos e cenas, através da nuvem do SwitchBot com o token do aplicativo. Os estados são atualizados uma vez por minuto enquanto o painel estiver aberto.</string>
    <string name="core_tools_provider_system_recognizer">Reconhecedor do telefone</string>
    <string name="core_tools_provider_system_recognizer_desc">O reconhecedor de voz que vem com o telefone, geralmente o do Google. As palavras aparecem conforme você fala.</string>
    <string name="core_tools_provider_tavily_desc">Pesquisa na web com uma resposta curta. Requer sua chave Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX e outros modelos abertos nos servidores da Together.</string>
