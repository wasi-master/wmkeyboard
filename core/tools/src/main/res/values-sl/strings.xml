    <string name="core_tools_provider_acrcloud_desc">Storitev za prepoznavanje glasbe z dvotedenskim preizkusom, nato plačljivi paketi. Potrebuje gostitelja, dostopni ključ in dostopno skrivnost projekta s console.acrcloud.com. Vsak posnetek se pošlje v ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Brezplačni Stable Diffusion na računalnikih prostovoljcev. Deluje brez ključa, vendar čaka v čakalni vrsti; brezplačen ključ s spletnega mesta aihorde.net vas premakne naprej.</string>
    <string name="core_tools_provider_anthropic_desc">Modeli Claude prek API-ja Anthropic z vašim lastnim ključem.</string>
    <string name="core_tools_provider_asr4all_desc">Narekovanje v angleščini na telefonu, z besedami, ki se pojavijo med govorjenjem.</string>
    <string name="core_tools_provider_audd_desc">Prepozna večino izdane glasbe po nekaj sekundah zvoka. Zahteva žeton z dashboard.audd.io; nekaj sto prepoznav je brezplačnih, nato je plačljivo. Vsak posnetek se pošlje na AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Majhna storitev prepoznavanja, brezplačna za osebno uporabo s ključem z audiotag.info, počasnejša od ostalih: odgovori po nekaj sekundah. Vsak posnetek je poslan v AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge ali SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Vaš lasten spletni vmesnik Stable Diffusion, zagnan z --api. Navedite njegov naslov, na primer http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">V napravi (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Prevaja v telefonu z Mozillinim pogonom Bergamot in modeli Firefox Translations. Brezplačna programska oprema, brez Googlovih storitev in vaše besedilo ostane v telefonu. Vsaka smer (francoščina v angleščino, angleščina v francoščino) zahteva svoj prenos od 14 do 37 MB. Potrebuje 64-bitni telefon s sistemom Android 9 ali novejšim.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Modeli FLUX od ljudi, ki so jih ustvarili. Potrebuje ključ od bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Odgovori, ki temeljijo na spletnem iskanju Brave. Potrebuje ključ z načrtom Answers. Če ostane prazno, se poskusi uporabiti ključ Brave Search, ki ste ga vnesli za spletno iskanje.</string>
    <string name="core_tools_provider_brave_desc">Spletno iskanje in iskanje slik. Zahteva ključ API za Brave Search, razen če ga ta različica že ima.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX in Stable Diffusion na Cloudflare, z brezplačno dnevno kvoto. Potrebuje žeton API in vaš ID računa.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflarejevi strežniki za merjenje hitrosti, najbližji od njihovih podatkovnih centrov. Ne potrebuje računa in kartici sporoči, v katerem omrežju ste in katero mesto se je odzvalo.</string>
    <string name="core_tools_provider_coinbase_desc">Valute in kovanci iz Coinbase. Brez ključa.</string>
    <string name="core_tools_provider_coingecko_desc">Cene kovancev iz CoinGecko. Brez ključa.</string>
    <string name="core_tools_provider_comfyui_desc">Vaš lasten strežnik ComfyUI. Riše s preprostim potekom dela besedilo-v-sliko in kontrolno točko, ki jo poimenujete, ali prvo, ki jo ima.</string>
    <string name="core_tools_provider_commons_desc">Brezplačni GIF-i in fotografije iz Wikimedia Commons ali iz vašega lastnega MediaWiki. Brez ključa. GIF-i so večinoma izobraževalni.</string>
    <string name="core_tools_provider_currency_api_desc">Odprti podatki za večino valut in številne kovance. Brez ključa.</string>
    <string name="core_tools_provider_deepl_desc">Potrebuje vaš ključ API DeepL ali naslov posrednika, ki ga doda.</string>
    <string name="core_tools_provider_deepseek_desc">Modeli DeepSeek prek API-ja DeepSeek z vašim lastnim ključem.</string>
    <string name="core_tools_provider_er_api_desc">Dnevni tečaji za večino valut. Brez ključa.</string>
    <string name="core_tools_provider_fal_desc">Hitri gostujoči modeli: FLUX, Recraft, Ideogram, Qwen Image in drugi. Vnesite fal ID modela; če pustite prazno, se uporabi FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Tečaji Evropske centralne banke za glavne valute. Prosta programska oprema, brez ključa.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modeli Gemini prek Googlovega API-ja z vašim lastnim ključem iz AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Slike Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Googlovi slikovni modeli Nano Banana. Prazen ključ uporabi ključ Gemini iz orodja AI.</string>
    <string name="core_tools_provider_gifcities_desc">Stari GIF-i GeoCities iz Internetnega arhiva. Brez ključa. Rezultati nimajo ocene vsebine.</string>
    <string name="core_tools_provider_giphy_desc">GIF-i in nalepke. Vedno na svojem zavihku: GIPHY ne dovoli aplikacijam, da mešajo njegove rezultate z drugimi.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Naprave v vašem sistemu Google Home prek storitev Play. En dom naenkrat; izberete ga na Googlovem lastnem zaslonu.</string>
    <string name="core_tools_provider_google_translate">Google Prevajalnik</string>
    <string name="core_tools_provider_google_translate_desc">Googlova brezplačna končna točka ali Cloud Translation, ko dodate ključ.</string>
    <string name="core_tools_provider_harper_desc">Slovnični pogon, vgrajen v tipkovnico. Samo za angleščino, nič, kar natipkate, ne zapusti telefona.</string>
    <string name="core_tools_provider_home_assistant_desc">Vaš lasten strežnik Home Assistant. Vse vrste stvari, v živo, s pomočjo Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue most</string>
    <string name="core_tools_provider_hue_desc">Luči, sobe, prizori in senzorji neposredno iz mostu Hue v vašem omrežju Wi-Fi. Nič ne zapusti hiše.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeli na lastnih strežnikih za sklepanje Hugging Face z brezplačno mesečno kvoto. Potrebuje žeton za dostop z dovoljenjem za ponudnike sklepanja.</string>
    <string name="core_tools_provider_klipy_desc">GIF-i in nalepke. Potrebuje ključ API KLIPY, razen če ga ta različica že ima.</string>
    <string name="core_tools_provider_languagetool_desc">Slovnica, črkovanje in slog v več kot 30 jezikih. Vaše besedilo se pošlje na strežnik LanguageTool v preverjanje: na javni strežnik api.languagetool.org, razen če vnesete svojega.</string>
    <string name="core_tools_provider_librespeed_desc">Strežnik LibreSpeed: takšen, ki ga zaženete sami, ali eden od prostovoljskih strežnikov s javnega seznama, izbran po mestu na zaslonu same vrstice.</string>
    <string name="core_tools_provider_libretranslate_desc">Strežnik LibreTranslate: vaš lasten ali javni. Javni strežniki običajno potrebujejo ključ.</string>
    <string name="core_tools_provider_lingva_desc">Strežnik Lingva: brezplačen vmesnik za Google Prevajalnik.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeli, ki jih v vašem računalniku gosti LM Studio. Dodajte enega za vsak računalnik.</string>
    <string name="core_tools_provider_mlkit">V napravi</string>
    <string name="core_tools_provider_mlkit_desc">Prevaja v telefonu z ML Kit. Vaše besedilo ostane v telefonu. Za vsak jezik je treba najprej prenesti model.</string>
    <string name="core_tools_provider_mode_fallback">En po en</string>
    <string name="core_tools_provider_mode_fallback_desc">Vprašaj prvega ponudnika. Če ne uspe ali nima rezultatov, vprašaj naslednjega.</string>
    <string name="core_tools_provider_mode_mix">Mešano</string>
    <string name="core_tools_provider_mode_mix_desc">Povprašaj vse ponudnike hkrati in združi njihove rezultate v eni mreži.</string>
    <string name="core_tools_provider_mode_pick">Izberite na plošči</string>
    <string name="core_tools_provider_mode_pick_desc">Podokno prikazuje ponudnike, ki so vklopljeni. Izberite enega in poizvedovano bo le po njem.</string>
    <string name="core_tools_provider_mode_tabs">Zavihki</string>
    <string name="core_tools_provider_mode_tabs_desc">Vsak ponudnik dobi svoj zavihek. Tapnite zavihek za ogled rezultatov.</string>
    <string name="core_tools_provider_moonshine_desc">Majhen, hiter angleški model, ki se izvaja na telefonu.</string>
    <string name="core_tools_provider_mozhi_desc">Strežnik Mozhi: brezplačen vmesnik za Google, DeepL, DuckDuckGo, Yandex in Reverso. Izberite pogon. DeepL in Reverso potrebujeta izvorni jezik.</string>
    <string name="core_tools_provider_music_server">Vaš lasten strežnik za prepoznavanje</string>
    <string name="core_tools_provider_music_server_desc">Strežnik, ki ga zaženete in se odziva kot AudD: posnetek je objavljen kot datoteka, skladba pa se vrne v formatu JSON. Za njim namestite prstni odtis, kot sta Panako ali Olaf.</string>
    <string name="core_tools_provider_nllb">V napravi (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Prevaaja v telefonu z Metinim modelom NLLB-200 na CTranslate2: 200 jezikov, med katerimikoli dvema, za pare, ki jih drugi mehanizmi ne zmorejo. Prenos v velikosti 630 MB, stavek pa se prevede v nekaj sekundah. Vaše besedilo ostane v telefonu. Model je licenciran samo za nekomercialno uporabo (CC BY-NC 4.0). Potrebuje 64-bitni telefon s 6 GB pomnilnika ali več.</string>
    <string name="core_tools_provider_none_on">Noben ponudnik ni vklopljen. Vklopite ga v nastavitvah tega orodja.</string>
    <string name="core_tools_provider_offline_gifs">Paketi GIF brez povezave</string>
    <string name="core_tools_provider_offline_gifs_desc">Paketi GIF, ki ste jih uvozili. Delujejo brez povezave.</string>
    <string name="core_tools_provider_ollama_desc">Modeli na strežniku Ollama, ki ga poganjate na svojem računalniku ali v svojem omrežju. Dodajte enega za vsak strežnik.</string>
    <string name="core_tools_provider_omnilingual_desc">Metin model za 1600 jezikov, od katerih jih stotine nima druge možnosti glasovnega tipkanja na telefonu. Vsaka besedna zveza pride po premoru za njo.</string>
    <string name="core_tools_provider_on_device_ai">V vaši napravi</string>
    <string name="core_tools_provider_on_device_ai_desc">Model, prenesen v ta telefon. Nič, kar napišete, ga ne zapusti. Izberite in prenesite model na strani AI.</string>
    <string name="core_tools_provider_on_device_image">V tem telefonu</string>
    <string name="core_tools_provider_on_device_image_desc">Model, prenesen v ta telefon, ali uvožen model. Ničesar, kar vtipkate, ne zapusti telefona. Izberite model na zaslonu generatorja.</string>
    <string name="core_tools_provider_openai_compatible">Storitev, združljiva z OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Katera koli druga storitev s klepetalnim API-jem OpenAI: OpenRouter, Groq, Mistral, Together ali vaš lastni prehod. Vnesite naslov do različice, na primer https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Slike, združljive z OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Katera koli druga storitev s slikovnim API-jem OpenAI: LocalAI, DeepInfra, Nebius ali vaš lastni prehod. Navedite naslov do različice, na primer https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modeli GPT prek API-ja OpenAI z vašim lastnim ključem.</string>
    <string name="core_tools_provider_openai_image">Slike OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">Slika GPT, ki riše nalepke na prozorno ozadje. Plačljivo na sliko. Prazen ključ uporablja ključ OpenAI iz orodja za umetno inteligenco.</string>
    <string name="core_tools_provider_openhab_desc">Strežnik openHAB: njegovi elementi, v živo, s prostori iz semantičnega modela.</string>
    <string name="core_tools_provider_parakeet_desc">Velik model, ki deluje v telefonu in razume 25 evropskih jezikov.</string>
    <string name="core_tools_provider_pexels_desc">Fotografije s Pexels. Potrebuje ključ API, razen če ga ta različica že ima.</string>
    <string name="core_tools_provider_pollinations_desc">Brezplačno, brez ključa in brez računa: poziv je poslan v Pollinations, ki izbere model. Ključ z enter.pollinations.ai odklene novejši API in vam omogoči poimenovanje modela.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neuradno, prek RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazamov katalog prek neuradnega seznama na RapidAPI s ključem RapidAPI. Ni Applova storitev: seznam se lahko spremeni ali preneha delovati brez predhodnega obvestila. Vsak posnetek se pošlje na RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustracije, ikone in vektorska umetnost. Potrebuje ključ od recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Strežnik Rens: brezplačen vmesnik za Google Lens. Za vas prebere besedilo na fotografiji v večini pisav.</string>
    <string name="core_tools_provider_rens_translate_desc">Strežnik Rens: brezplačen vmesnik za Google Lens. Vrne fotografijo s prevedenim besedilom.</string>
    <string name="core_tools_provider_replicate_desc">Na tisoče gostovanih modelov. Imenujte kateri koli model za pretvorbo besedila v sliko kot lastnik/ime; FLUX Schnell, če ostane prazno.</string>
    <string name="core_tools_provider_same_kind_fallback">Kot varnostne kopije</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Ponudniki iste vrste delujejo kot eden. Najprej se povpraša prvega, nato naslednjega le, če prvi ne uspe, na primer ko ključu zmanjka kvote.</string>
    <string name="core_tools_provider_same_kind_separate">Ločeno</string>
    <string name="core_tools_provider_same_kind_separate_desc">Vsak je svoj ponudnik: svoj čip, svoja izbira na plošči, svoj delež v mešani mreži.</string>
    <string name="core_tools_provider_searxng_desc">Instanca SearXNG, ki omogoča rezultate JSON. Večina javnih instanc tega ne omogoča.</string>
    <string name="core_tools_provider_sherpa_desc">Pretočni modeli za 13 jezikov, med njimi tudi bengalščina, ki tipkajo sproti, ko govorite v telefon.</string>
    <string name="core_tools_provider_simplytranslate_desc">Strežnik SimplyTranslate: brezplačen vmesnik za Google in druge iskalnike.</string>
    <string name="core_tools_provider_smartthings_desc">Vaše naprave, sobe in prizori SmartThings prek Samsungovega oblaka. Stanja se osvežijo, medtem ko je plošča odprta.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra in Stable Diffusion 3.5 ustvarjalcev Stable Diffusion. Plačljivo s krediti; potrebuje ključ s platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Vaši paketi nalepk v tem telefonu.</string>
    <string name="core_tools_provider_switchbot_desc">Vaše naprave SwitchBot, infrardeči daljinski upravljalniki in prizori prek oblaka SwitchBot s žetonom iz njihove aplikacije. Stanja se osvežijo enkrat na minuto, ko je plošča odprta.</string>
    <string name="core_tools_provider_system_recognizer">Prepoznavalnik telefona</string>
    <string name="core_tools_provider_system_recognizer_desc">Prepoznavalnik govora, ki je priložen telefonu, običajno Googlov. Besede se prikažejo, ko govorite.</string>
    <string name="core_tools_provider_tavily_desc">Spletno iskanje s kratkim odgovorom. Potrebuje vaš ključ Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX in drugi odprti modeli na strežnikih Together.</string>
