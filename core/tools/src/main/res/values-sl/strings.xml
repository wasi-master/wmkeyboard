    <string name="core_tools_provider_transcription_server">Strežnik za prepisovanje</string>
    <string name="core_tools_provider_transcription_server_desc">Strežnik, ki govori OpenAI-jev API za prepisovanje zvoka: speaches, strežnik whisper.cpp, LocalAI, Groq ali OpenAI. Vsak posnetek mu je poslan, ko prenehate govoriti.</string>
    <string name="core_tools_provider_translate_server">Vaš strežnik za prevajanje</string>
    <string name="core_tools_provider_translate_server_desc">Strežnik, ki odgovarja na zahteve klepeta OpenAI: llama.cpp, Ollama, LM Studio, vLLM ali prehod.</string>
    <string name="core_tools_provider_translite_desc">Strežnik Translite: brezplačen vmesnik za Google Prevajalnik.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Naprave, sobe in prizori Smart Life in Tuya Smart prek brezplačnega razvijalskega projekta Tuya, povezanega z vašim računom aplikacije. Stanja se osvežijo, ko je plošča odprta.</string>
    <string name="core_tools_provider_unsplash_desc">Fotografije iz Unsplash. Potrebuje ključ API, razen če ga ta različica že ima.</string>
    <string name="core_tools_provider_vision_ocr">Vaš vizualni model</string>
    <string name="core_tools_provider_vision_ocr_desc">Model, ki bere slike prek strežnika, ki odgovarja na zahteve OpenAI klepeta. Potrebuje naslov in ime modela.</string>
    <string name="core_tools_provider_whisper_desc">OpenAI modeli Whisper, ki se izvajajo na telefonu. Veliko jezikov; prenesite model na strani Glasovno tipkanje.</string>
    <string name="core_tools_provider_whistle_desc">Majhen, hiter model, ki deluje v telefonu. Prenesite ga na strani za glasovno tipkanje.</string>
    <string name="core_tools_provider_xai_desc">Modeli Grok prek vmesnika xAI API z vašim lastnim ključem.</string>
    <string name="core_tools_provider_xai_image">Grok Imagine</string>
    <string name="core_tools_provider_xai_image_desc">Model slik xAI. Prazen ključ uporabi ključ xAI iz orodja AI.</string>
