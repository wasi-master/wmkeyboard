    <string name="core_tools_provider_acrcloud_desc">Un serviciu de recunoaștere muzicală cu o perioadă de probă de două săptămâni, apoi planuri plătite. Necesită gazda, cheia de acces și secretul de acces al unui proiect de pe console.acrcloud.com. Fiecare clip este trimis către ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion gratuit pe computerele voluntarilor. Funcționează fără cheie, dar așteaptă la coadă; o cheie gratuită de la aihorde.net te ajută să avansezi.</string>
    <string name="core_tools_provider_anthropic_desc">Modele Claude prin API-ul Anthropic, cu propria ta cheie.</string>
    <string name="core_tools_provider_asr4all_desc">Dictare în engleză pe telefon, cu cuvinte care apar pe măsură ce vorbiți.</string>
    <string name="core_tools_provider_audd_desc">Recunoaște majoritatea muzicii lansate după câteva secunde de sunet. Este necesar un token de pe dashboard.audd.io; câteva sute de recunoașteri sunt gratuite, apoi este cu plată. Fiecare clip este trimis către AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Un mic serviciu de recunoaștere, gratuit pentru uz personal cu o cheie de la audiotag.info, și mai lent decât celelalte: răspunde după câteva secunde. Fiecare clip este trimis către AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge sau SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Propria interfață web Stable Diffusion, pornită cu --api. Introduceți adresa acesteia, de exemplu http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Pe dispozitiv (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Traduce pe telefon folosind motorul Bergamot de la Mozilla și modelele Firefox Translations. Software liber, fără servicii Google, iar textul tău rămâne pe telefon. Fiecare direcție (franceză în engleză, engleză în franceză) reprezintă o descărcare proprie între 14 și 37 MB. Necesită un telefon pe 64 de biți cu Android 9 sau versiuni ulterioare.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Modelele FLUX de la cei care le-au creat. Necesită o cheie de la bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Răspunsuri bazate pe o căutare web Brave. Necesită o cheie cu planul Answers. Dacă este lăsat necompletat, se va încerca utilizarea cheii Brave Search pe care ați introdus-o pentru căutarea web.</string>
    <string name="core_tools_provider_brave_desc">Căutare web și imagini. Necesită o cheie API Brave Search, cu excepția cazului în care această versiune are una.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX și Stable Diffusion pe Cloudflare, cu o alocație zilnică gratuită. Necesită un token API și ID-ul contului tău.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Serverele de testare a vitezei Cloudflare, cele mai apropiate centre de date. Nu necesită cont și indică cardului rețeaua pe care te afli și orașul care a răspuns.</string>
    <string name="core_tools_provider_coinbase_desc">Valute și monede de la Coinbase. Fără cheie.</string>
    <string name="core_tools_provider_coingecko_desc">Prețurile monedelor de la CoinGecko. Fără cheie.</string>
    <string name="core_tools_provider_comfyui_desc">Propriul tău server ComfyUI. Desenează cu un flux de lucru simplu text-către-imagine și punctul de control pe care îl numești sau primul pe care îl are.</string>
    <string name="core_tools_provider_commons_desc">GIF-uri și fotografii gratuite de la Wikimedia Commons sau de pe propriul tău MediaWiki. Fără cheie. GIF-urile sunt în mare parte educaționale.</string>
    <string name="core_tools_provider_currency_api_desc">Date deschise pentru majoritatea monedelor și multe criptomonede. Fără cheie.</string>
    <string name="core_tools_provider_deepl_desc">Necesită cheia API DeepL sau adresa unui proxy care adaugă una.</string>
    <string name="core_tools_provider_deepseek_desc">Modele DeepSeek prin API-ul DeepSeek, cu propria ta cheie.</string>
    <string name="core_tools_provider_er_api_desc">Cursuri zilnice pentru majoritatea monedelor. Fără cheie.</string>
    <string name="core_tools_provider_fal_desc">Modele găzduite rapid: FLUX, Recraft, Ideogram, Qwen Image și altele. Introduceți ID-ul fal al modelului; FLUX Schnell dacă este lăsat gol.</string>
    <string name="core_tools_provider_frankfurter_desc">Ratele Băncii Centrale Europene pentru principalele valute. Software gratuit, fără cheie.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modele Gemini prin API-ul Google, cu propria cheie din AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Imagini Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modelele de imagine Nano Banana de la Google. O tastă goală utilizează cheia Gemini din instrumentul AI.</string>
    <string name="core_tools_provider_gifcities_desc">GIF-uri vechi GeoCities din Internet Archive. Fără cheie. Rezultatele nu au un rating de conținut.</string>
    <string name="core_tools_provider_giphy_desc">GIF-uri și stickere. Întotdeauna în propria filă: GIPHY nu permite aplicațiilor să amestece rezultatele sale cu ale altora.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Dispozitivele din Google Home, prin serviciile Play. O singură casă pe rând; o alegi pe cea dorită din ecranul Google.</string>
    <string name="core_tools_provider_google_translate">Google Translate</string>
    <string name="core_tools_provider_google_translate_desc">Endpoint-ul gratuit Google sau Cloud Translation când adaugi o cheie.</string>
    <string name="core_tools_provider_harper_desc">Motorul de gramatică integrat în tastatură. Doar pentru limba engleză; nimic din ceea ce scrii nu părăsește telefonul.</string>
    <string name="core_tools_provider_home_assistant_desc">Propriul tău server Home Assistant. Orice fel de lucru, în direct, cu Assist.</string>
    <string name="core_tools_provider_hue">Bridge Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Lumini, camere, scene și senzori direct de la un bridge Hue din rețeaua ta Wi-Fi. Nimic nu părăsește casa.</string>
    <string name="core_tools_provider_hugging_face_desc">Modele pe serverele de inferență proprii Hugging Face, cu o alocație lunară gratuită. Necesită un token de acces cu permisiunea Furnizori de inferență.</string>
    <string name="core_tools_provider_klipy_desc">GIF-uri și stickere. Necesită o cheie API KLIPY, cu excepția cazului în care această versiune are una.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatică, ortografie și stil în mai mult de 30 de limbi. Textul tău este trimis către un server LanguageTool pentru a fi verificat: cel public la adresa api.languagetool.org, cu excepția cazului în care introduci unul propriu.</string>
    <string name="core_tools_provider_librespeed_desc">Un server LibreSpeed: unul pe care îl rulezi singur sau unul dintre serverele voluntarilor din lista publică, ales după oraș pe ecranul propriu al rândului.</string>
    <string name="core_tools_provider_libretranslate_desc">Un server LibreTranslate: propriul server sau unul public. Serverele publice necesită de obicei o cheie.</string>
    <string name="core_tools_provider_lingva_desc">Un server Lingva: o interfață gratuită pentru Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">Modele servite de LM Studio pe computerul tău. Adaugă unul pentru fiecare computer.</string>
    <string name="core_tools_provider_mlkit">Pe dispozitiv</string>
    <string name="core_tools_provider_mlkit_desc">Traduce pe telefon cu ML Kit. Textul tău rămâne pe telefon. Fiecare limbă necesită mai întâi descărcarea unui model.</string>
    <string name="core_tools_provider_mode_fallback">Pe rând</string>
    <string name="core_tools_provider_mode_fallback_desc">Întreabă primul furnizor. Dacă eșuează sau nu are rezultate, întreabă-l pe următorul.</string>
    <string name="core_tools_provider_mode_mix">Mixt</string>
    <string name="core_tools_provider_mode_mix_desc">Interoghează toți furnizorii în același timp și combină rezultatele într-o singură grilă.</string>
    <string name="core_tools_provider_mode_pick">Alege din panou</string>
    <string name="core_tools_provider_mode_pick_desc">Panoul arată furnizorii care sunt porniți. Alege unul de acolo și doar acela va fi întrebat.</string>
    <string name="core_tools_provider_mode_tabs">Taburi</string>
    <string name="core_tools_provider_mode_tabs_desc">Fiecare furnizor primește propriul cip. Atinge un cip pentru a vedea rezultatele sale.</string>
    <string name="core_tools_provider_moonshine_desc">Un model de engleză mic și rapid care rulează pe telefon.</string>
    <string name="core_tools_provider_mozhi_desc">Un server Mozhi: un front-end gratuit pentru Google, DeepL, DuckDuckGo, Yandex și Reverso. Alege motorul. DeepL și Reverso necesită o limbă sursă.</string>
    <string name="core_tools_provider_music_server">Propriul tău server de recunoaștere</string>
    <string name="core_tools_provider_music_server_desc">Un server pe care îl rulezi și care răspunde ca AudD: clipul este postat ca fișier, iar melodia revine sub formă de JSON. Pune un sistem de amprentare digitală precum Panako sau Olaf în spate.</string>
    <string name="core_tools_provider_nllb">Pe dispozitiv (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Traduce pe telefon cu modelul NLLB-200 de la Meta pe CTranslate2: 200 de limbi, între oricare două dintre ele, pentru perechile pe care celelalte motoare nu le pot face. O descărcare de 630 MB, iar o propoziție durează câteva secunde. Textul dvs. rămâne pe telefon. Modelul este licențiat doar pentru uz necomercial (CC BY-NC 4.0). Necesită un telefon pe 64 de biți cu 6 GB de memorie sau mai mult.</string>
    <string name="core_tools_provider_none_on">Niciun furnizor nu este activat. Activează unul din setările acestui instrument.</string>
    <string name="core_tools_provider_offline_gifs">Pachete GIF offline</string>
    <string name="core_tools_provider_offline_gifs_desc">Pachete GIF pe care le-ai importat. Funcționează fără conexiune.</string>
    <string name="core_tools_provider_ollama_desc">Modele pe un server Ollama pe care îl rulați, pe computerul sau rețeaua dumneavoastră. Adăugați unul pentru fiecare server.</string>
    <string name="core_tools_provider_omnilingual_desc">Modelul unic de la Meta pentru 1.600 de limbi, sute dintre ele fără altă metodă de scriere vocală, pe telefon. Fiecare frază ajunge la pauza de după ea.</string>
    <string name="core_tools_provider_on_device_ai">Pe dispozitivul tău</string>
    <string name="core_tools_provider_on_device_ai_desc">Un model descărcat pe acest telefon. Nimic din ce scrii nu părăsește dispozitivul. Alege și descarcă modelul din pagina AI.</string>
    <string name="core_tools_provider_on_device_image">Pe acest telefon</string>
    <string name="core_tools_provider_on_device_image_desc">Un model descărcat pe acest telefon sau unul pe care l-ai importat. Nimic din ce tastezi nu părăsește dispozitivul. Alege modelul de pe ecranul generatorului.</string>
    <string name="core_tools_provider_openai_compatible">Serviciu compatibil cu OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Orice alt serviciu cu API-ul de chat OpenAI: OpenRouter, Groq, Mistral, Together sau propriul tău gateway. Introdu adresa până la versiune, de exemplu https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Imagini compatibile cu OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Orice alt serviciu cu API-ul de imagini OpenAI: LocalAI, DeepInfra, Nebius sau un gateway propriu. Introdu adresa până la versiune, cum ar fi https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modele GPT prin API-ul OpenAI, cu propria cheie.</string>
    <string name="core_tools_provider_openai_image">Imagini OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, care desenează stickere pe un fundal transparent. Plătit per imagine. O cheie goală utilizează cheia OpenAI din instrumentul AI.</string>
    <string name="core_tools_provider_openhab_desc">Un server openHAB: elementele sale, în timp real, cu camere din modelul semantic.</string>
    <string name="core_tools_provider_parakeet_desc">Un model mare care rulează pe telefon și înțelege 25 de limbi europene.</string>
    <string name="core_tools_provider_pexels_desc">Fotografii de pe Pexels. Necesită o cheie API, cu excepția cazului în care această versiune are deja una.</string>
    <string name="core_tools_provider_pollinations_desc">Gratuit, fără cheie și fără cont: promptul este trimis către Pollinations, care alege modelul. O cheie de la enter.pollinations.ai deschide API-ul său mai nou și îți permite să numești un model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neoficial, prin RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Catalogul Shazam printr-o listare neoficială pe RapidAPI, cu o cheie RapidAPI. Nu este un serviciu Apple: listarea se poate schimba sau opri fără notificare. Fiecare clip este trimis către RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrații, pictograme și artă în stil vectorial. Necesită o cheie de la recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Un server Rens: o interfață gratuită pentru Google Lens. Citește textul dintr-o fotografie pentru tine, în majoritatea scripturilor.</string>
    <string name="core_tools_provider_rens_translate_desc">Un server Rens: o interfață gratuită pentru Google Lens. Returnează fotografia cu textul tradus.</string>
    <string name="core_tools_provider_replicate_desc">Mii de modele găzduite. Numește orice model text-to-image ca proprietar/nume; FLUX Schnell când este gol.</string>
    <string name="core_tools_provider_same_kind_fallback">Ca backup</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Furnizorii de același tip acționează ca unul singur. Primul este interogat, iar următorul doar când acesta eșuează, de exemplu când o cheie depășește cota.</string>
    <string name="core_tools_provider_same_kind_separate">Separat</string>
    <string name="core_tools_provider_same_kind_separate_desc">Fiecare este propriul său furnizor: propriul cip, propria alegere în panou, propria parte dintr-o grilă mixtă.</string>
    <string name="core_tools_provider_searxng_desc">O instanță SearXNG care permite rezultate JSON. Majoritatea instanțelor publice nu permit acest lucru.</string>
    <string name="core_tools_provider_sherpa_desc">Modele de streaming pentru 13 limbi, printre care și bengaleza, care scriu în timp ce vorbești, la telefon.</string>
    <string name="core_tools_provider_simplytranslate_desc">Un server SimplyTranslate: o interfață gratuită pentru Google și alte motoare de căutare.</string>
    <string name="core_tools_provider_smartthings_desc">Dispozitivele, camerele și scenele tale SmartThings, prin cloud-ul Samsung. Stările se actualizează în timp ce panoul este deschis.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra și Stable Diffusion 3.5 de la creatorii Stable Diffusion. Plătit în credite; necesită o cheie de la platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Pachetele tale de stickere de pe acest telefon.</string>
    <string name="core_tools_provider_switchbot_desc">Dispozitivele tale SwitchBot, telecomenzi infraroșu și scene, prin cloud-ul SwitchBot cu token-ul din aplicația sa. Stările se actualizează o dată pe minut cât timp panoul este deschis.</string>
    <string name="core_tools_provider_system_recognizer">Recunoașterea telefonului</string>
    <string name="core_tools_provider_system_recognizer_desc">Recunoașterea vocală care vine cu telefonul, de obicei cea de la Google. Cuvintele apar pe măsură ce vorbești.</string>
    <string name="core_tools_provider_tavily_desc">Căutare web cu un răspuns scurt. Necesită cheia ta Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX și alte modele deschise pe serverele Together.</string>
