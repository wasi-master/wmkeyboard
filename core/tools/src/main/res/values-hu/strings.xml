    <string name="core_tools_dictionary_source_dictionary_api">Ingyenes szótár API</string>
    <string name="core_tools_dictionary_source_dictionary_api_desc">Online, a dictionaryapi.dev webhelyről. Ez a szolgáltatás gyakran nem elérhető.</string>
    <string name="core_tools_dictionary_source_imported">Importált szótárak</string>
    <string name="core_tools_dictionary_source_imported_desc">Ezen az eszközön. Az általad importált Yomichan és Yomitan szótárak, bármilyen nyelven, olvasatokkal és hangsúlyjelöléssel.</string>
    <string name="core_tools_dictionary_source_offline_bengali">Bengáli–angol Wikiszótár</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">Letöltés után ezen az eszközön használható. Bengáli szavak angol jelentésükkel és a kiejtésükkel.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, offline</string>
    <string name="core_tools_dictionary_source_offline_wiktionary_desc">Ezen az eszközön, letöltés után. Gyakori angol szavak a Wikiszótárból, kiejtéssel.</string>
    <string name="core_tools_dictionary_source_offline_wordnet">Nyílt angol WordNet</string>
    <string name="core_tools_dictionary_source_offline_wordnet_desc">Ezen az eszközön, a letöltést követően. Minden angol szó a WordNetben, rövid definíciókkal.</string>
    <string name="core_tools_dictionary_source_vocab_packs">Szókincs-csomagok</string>
