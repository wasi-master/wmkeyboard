    <string name="core_tools_provider_transcription_server">Átíró szerver</string>
    <string name="core_tools_provider_transcription_server_desc">Egy szerver, amely az OpenAI hangátírási API-ját használja: speaches, whisper.cpp szerver, LocalAI, Groq vagy OpenAI. Minden klip elküldésre kerül, amikor abbahagyja a beszédet.</string>
    <string name="core_tools_provider_translate_server">A te fordítószervered</string>
    <string name="core_tools_provider_translate_server_desc">Egy kiszolgáló, amely válaszol az OpenAI csevegési kérésekre: llama.cpp, Ollama, LM Studio, vLLM vagy egy átjáró.</string>
    <string name="core_tools_provider_translite_desc">Translite szerver: egy ingyenes előtétprogram a Google Fordítóhoz.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life és Tuya Smart eszközök, szobák és jelenetek egy ingyenes, az alkalmazásfiókodhoz kapcsolt Tuya fejlesztői projekten keresztül. Az állapotok a panel megnyitásakor frissülnek.</string>
    <string name="core_tools_provider_unsplash_desc">Fotók az Unsplash-ről. API-kulcs szükséges hozzá, hacsak a build nem tartalmaz egyet.</string>
    <string name="core_tools_provider_vision_ocr">Saját látásmodell</string>
    <string name="core_tools_provider_vision_ocr_desc">Képeket olvasó modell, egy OpenAI csevegési kéréseket megválaszoló szerveren keresztül. Szükséges hozzá a cím és a modell neve.</string>
    <string name="core_tools_provider_whisper_desc">Az OpenAI Whisper modelljei, a telefonon futtatva. Számos nyelv; töltsön le egy modellt a Hangalapú gépelés oldalon.</string>
    <string name="core_tools_provider_whistle_desc">Egy kicsi, gyors modell, amely a telefonon fut. Töltse le a Hangalapú gépelés oldalon.</string>
    <string name="core_tools_provider_xai_desc">Grok modellek az xAI API-ján keresztül, saját kulccsal.</string>
