    <string name="core_tools_provider_acrcloud_desc">Zenefelismerő szolgáltatás kéthetes próbaidőszakkal, majd fizetős csomagokkal. Szükség van a console.acrcloud.com oldalon létrehozott projekt hosztjára, hozzáférési kulcsára és titkos kulcsára. Minden klipet elküldünk az ACRCloudnak.</string>
    <string name="core_tools_provider_ai_horde_desc">Ingyenes Stable Diffusion az önkéntesek számítógépein. Kulcs nélkül is működik, de sorban kell állni; az aihorde.net oldalon igényelhető ingyenes kulccsal előrébb kerülhet a sorban.</string>
    <string name="core_tools_provider_anthropic_desc">Claude modellek az Anthropic API-ján keresztül, saját kulccsal.</string>
    <string name="core_tools_provider_asr4all_desc">Angol diktálás a telefonon, a szavak megjelennek beszéd közben.</string>
    <string name="core_tools_provider_audd_desc">Felismerteti a legtöbb megjelent zenét néhány másodpercnyi hang alapján. Szüksége van egy tokenre a dashboard.audd.io oldalról; néhány száz felismerés ingyenes, utána fizetős. Minden klip elküldésre kerül az AudD-nek.</string>
    <string name="core_tools_provider_audiotag_desc">Egy kis felismerőszolgáltatás, amely az audiotag.info oldaltól kapott kulccsal személyes használatra ingyenes, ugyanakkor lassabb a többinél: néhány másodperc elteltével válaszol. Minden klip elküldésre kerül az AudioTag számára.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge vagy SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">A saját Stable Diffusion webes felületed, --api kapcsolóval indítva. Add meg a címét, például http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Eszközön (Firefox fordítások)</string>
    <string name="core_tools_provider_bergamot_desc">Fordítás a telefonon a Mozilla Bergamot motorjával és a Firefox fordítási modellekkel. Szabad szoftver, nincsenek Google-szolgáltatások, és a szöveg a telefonon marad. Minden irány (franciáról angolra, angolról franciára) egy külön 14–37 MB-os letöltés. 64 bites telefon szükséges Android 9 vagy újabb verzióval.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">A FLUX modellek az alkotóiktól. A bfl.ai-tól származó kulcs szükséges hozzá.</string>
    <string name="core_tools_provider_brave">Brave kereső</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">A Brave webes keresésén alapuló válaszok. Szükség van egy kulcsra a Válaszok csomaggal. Ha üresen hagyja, a rendszer a webes kereséshez megadott Brave Search kulcsot próbálja használni.</string>
    <string name="core_tools_provider_brave_desc">Webes és képkeresés. Brave Search API-kulcs szükséges hozzá, hacsak ez a build nem tartalmaz egyet.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX és Stable Diffusion a Cloudflare-en, ingyenes napi kerettel. API-token és fiókazonosító szükséges hozzá.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">A Cloudflare sebességteszt-kiszolgálói, a legközelebbi adatközpontjaik. Nem igényel fiókot, és megmutatja a kártyának, melyik hálózaton vagy, és melyik város válaszolt.</string>
    <string name="core_tools_provider_coinbase_desc">Pénznemek és érmék a Coinbase-től. Nincs szükség kulcsra.</string>
    <string name="core_tools_provider_coingecko_desc">Érmeárak a CoinGeckótól. Nincs szükség kulcsra.</string>
    <string name="core_tools_provider_comfyui_desc">Saját ComfyUI-szerver. Egyszerű szöveg-kép munkafolyamattal és az Ön által megnevezett ellenőrzőponttal (vagy az első elérhetővel) rajzol.</string>
    <string name="core_tools_provider_commons_desc">Ingyenes GIF-ek és fényképek a Wikimedia Commonsból vagy a saját MediaWikidből. Nincs szükség kulcsra. A GIF-ek többnyire oktató jellegűek.</string>
    <string name="core_tools_provider_currency_api_desc">Nyílt adatok a legtöbb valutához és számos kriptovalutához. Nincs szükség kulcsra.</string>
    <string name="core_tools_provider_deepl_desc">Szüksége van a DeepL API-kulcsodra, vagy egy olyan proxy címére, amely hozzáad egyet.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-modellek a DeepSeek API-ján keresztül, saját kulccsal.</string>
    <string name="core_tools_provider_er_api_desc">Napi árfolyamok a legtöbb pénznemhez. Nincs szükség kulcsra.</string>
    <string name="core_tools_provider_fal_desc">Gyors, hosztolt modellek: FLUX, Recraft, Ideogram, Qwen Image és mások. Adja meg a modell fal azonosítóját; üresen hagyva FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Európai Központi Bank árfolyamai a főbb valutákhoz. Ingyenes szoftver, nincs szükség kulcsra.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-modellek a Google API-ján keresztül, saját kulccsal az AI Studióból.</string>
    <string name="core_tools_provider_gemini_image">Gemini képek</string>
    <string name="core_tools_provider_gemini_image_desc">A Google Nano Banana képi modelljei. Az üres kulcs az AI-eszköz Gemini-kulcsát használja.</string>
    <string name="core_tools_provider_gifcities_desc">Régi GeoCities GIF-ek az Internet Archívumból. Nincs szükség kulcsra. Az eredmények nem rendelkeznek tartalomminősítéssel.</string>
    <string name="core_tools_provider_giphy_desc">GIF-ek és matricák. Mindig saját lapon: a GIPHY nem engedi, hogy az alkalmazások keverjék az eredményeit másokéval.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">A Google Home-ban lévő eszközök a Play-szolgáltatásokon keresztül. Egyszerre egy otthon; a Google saját képernyőjén választhatja ki, melyiket.</string>
    <string name="core_tools_provider_google_translate">Google Fordító</string>
    <string name="core_tools_provider_google_translate_desc">A Google ingyenes végpontja, vagy a Cloud Translation, ha kulcsot ad hozzá.</string>
    <string name="core_tools_provider_harper_desc">A billentyűzetbe beépített nyelvtani ellenőrző. Csak angol nyelvhez, és semmi, amit begépelsz, nem hagyja el a telefont.</string>
    <string name="core_tools_provider_home_assistant_desc">A saját Home Assistant szervered. Mindenféle dolog, élőben, az Assist segítségével.</string>
    <string name="core_tools_provider_hue">Philips Hue bridge</string>
    <string name="core_tools_provider_hue_desc">Lámpák, szobák, jelenetek és érzékelők közvetlenül a Wi-Fi-n lévő Hue bridge-ről. Semmi sem hagyja el a házat.</string>
    <string name="core_tools_provider_hugging_face_desc">Modellek a Hugging Face saját következtetési szerverein, ingyenes havi kerettel. Szükséges hozzá egy hozzáférési token az Inference Providers engedéllyel.</string>
    <string name="core_tools_provider_klipy_desc">GIF-ek és matricák. KLIPY API-kulcs szükséges, hacsak a build nem tartalmaz egyet.</string>
    <string name="core_tools_provider_languagetool_desc">Nyelvtan, helyesírás és stílus több mint 30 nyelven. A szövegedet elküldi egy LanguageTool szerverre ellenőrzés céljából: a nyilvánosra az api.languagetool.org címen, hacsak nem adod meg a sajátodat.</string>
    <string name="core_tools_provider_librespeed_desc">Egy LibreSpeed szerver: egy saját üzemeltetésű, vagy az önkéntesek nyilvános listájáról származó szerver, amelyet a sor saját képernyőjén, város szerint választhat ki.</string>
    <string name="core_tools_provider_libretranslate_desc">Egy LibreTranslate szerver: a sajátod vagy egy nyilvános. A nyilvános szerverekhez általában kulcs szükséges.</string>
    <string name="core_tools_provider_lingva_desc">Egy Lingva szerver: egy ingyenes kezelőfelület a Google Fordítóhoz.</string>
    <string name="core_tools_provider_lm_studio_desc">A számítógépeden az LM Studio által kiszolgált modellek. Adj hozzá egyet minden számítógéphez.</string>
    <string name="core_tools_provider_mlkit">Eszközön</string>
    <string name="core_tools_provider_mlkit_desc">Fordítás a telefonon az ML Kit segítségével. A szöveg a telefonon marad. Minden nyelvhez először le kell tölteni egy modellt.</string>
    <string name="core_tools_provider_mode_fallback">Egyszerre egy</string>
    <string name="core_tools_provider_mode_fallback_desc">Kérdezze meg az első szolgáltatót. Ha az sikertelen vagy nincs eredménye, kérdezze meg a következőt.</string>
    <string name="core_tools_provider_mode_mix">Vegyes</string>
    <string name="core_tools_provider_mode_mix_desc">Kérdezze le az összes szolgáltatót egyszerre, és keverje az eredményeiket egy rácsban.</string>
    <string name="core_tools_provider_mode_pick">Választás a panelen</string>
    <string name="core_tools_provider_mode_pick_desc">A panel megjeleníti az aktív szolgáltatókat. Válasszon egyet, és a rendszer csak azt kérdezi le.</string>
    <string name="core_tools_provider_mode_tabs">Lapok</string>
    <string name="core_tools_provider_mode_tabs_desc">Minden szolgáltató saját lapot kap. Koppints egy lapra az eredmények megtekintéséhez.</string>
    <string name="core_tools_provider_moonshine_desc">Egy apró, gyors angol nyelvű modell, amely a telefonon fut.</string>
    <string name="core_tools_provider_mozhi_desc">Egy Mozhi szerver: ingyenes felület a Google, DeepL, DuckDuckGo, Yandex és Reverso szolgáltatásokhoz. Válassza ki a motort. A DeepL és a Reverso forrásnyelvet igényel.</string>
    <string name="core_tools_provider_music_server">Saját felismerő szerver</string>
    <string name="core_tools_provider_music_server_desc">Egy általad futtatott szerver, amely az AudD-hez hasonlóan válaszol: a klipet fájlként töltöd fel, a dal pedig JSON formátumban érkezik vissza. Helyezz mögé egy ujjlenyomat-készítőt, például Panakót vagy Olafot.</string>
    <string name="core_tools_provider_nllb">Eszközön (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Fordítás a telefonon a Meta NLLB-200 modelljével, CTranslate2 alapon: 200 nyelv, bármelyik kettő között, olyan párokhoz, amelyeket más motorok nem tudnak. Egy 630 MB-os letöltés, és egy mondat fordítása néhány másodpercet vesz igénybe. A szöveg a telefonon marad. A modell csak nem kereskedelmi használatra licencelt (CC BY-NC 4.0). Legalább 6 GB memóriával rendelkező 64 bites telefon szükséges hozzá.</string>
    <string name="core_tools_provider_none_on">Nincs bekapcsolt szolgáltató. Kapcsolj be egyet az eszköz beállításaiban.</string>
    <string name="core_tools_provider_offline_gifs">Offline GIF-csomagok</string>
    <string name="core_tools_provider_offline_gifs_desc">Általad importált GIF-csomagok. Kapcsolat nélkül is működnek.</string>
    <string name="core_tools_provider_ollama_desc">Modellek egy Ollama-szerveren, amelyet Ön futtat a számítógépén vagy a hálózatán. Adjon hozzá egyet minden szerverhez.</string>
    <string name="core_tools_provider_omnilingual_desc">A Meta egyetlen modellje 1600 nyelvhez, amelyek közül több százhoz nincs más hangalapú gépelés a telefonon. Minden kifejezés a szünet után érkezik meg.</string>
    <string name="core_tools_provider_on_device_ai">Az eszközön</string>
    <string name="core_tools_provider_on_device_ai_desc">A telefonra letöltött modell. Semmi, amit ír, nem hagyja el a készüléket. Válassza ki és töltse le a modellt az AI oldalon.</string>
    <string name="core_tools_provider_on_device_image">Ezen a telefonon</string>
    <string name="core_tools_provider_on_device_image_desc">Erre a telefonra letöltött vagy importált modell. Amit beírsz, az nem hagyja el a készüléket. Válaszd ki a modellt a generátor képernyőjén.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-kompatibilis szolgáltatás</string>
    <string name="core_tools_provider_openai_compatible_desc">Bármely más szolgáltatás, amely rendelkezik az OpenAI chat API-jával: OpenRouter, Groq, Mistral, Together vagy saját átjáró. Add meg a címet a verzióig bezárólag, például https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-kompatibilis képek</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Bármely más szolgáltatás az OpenAI kép-API-jával: LocalAI, DeepInfra, Nebius vagy egy saját átjáró. Add meg a címet a verzióig, például: https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-modellek az OpenAI API-ján keresztül, saját kulccsal.</string>
    <string name="core_tools_provider_openai_image">OpenAI képek</string>
    <string name="core_tools_provider_openai_image_desc">GPT-kép, amely matricákat rajzol átlátszó háttérre. Képenként fizetendő. Az üres kulcs az AI-eszköz OpenAI-kulcsát használja.</string>
    <string name="core_tools_provider_openhab_desc">Egy openHAB-kiszolgáló: elemei, élőben, a szemantikai modell szobáival.</string>
    <string name="core_tools_provider_parakeet_desc">Egy nagy modell, amely a telefonon fut, és 25 európai nyelvet ért.</string>
    <string name="core_tools_provider_pexels_desc">Fotók a Pexelsről. API-kulcs szükséges, hacsak ez a build nem tartalmaz egyet.</string>
    <string name="core_tools_provider_pollinations_desc">Ingyenes, kulcs és fiók nélkül: a prompt a Pollinations rendszerébe kerül, amely kiválasztja a modellt. Az enter.pollinations.ai oldalról származó kulcs megnyitja az újabb API-t, és lehetővé teszi a modell elnevezését.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (nem hivatalos, RapidAPI-n keresztül)</string>
    <string name="core_tools_provider_rapid_shazam_desc">A Shazam katalógusa egy nem hivatalos RapidAPI-listán keresztül, RapidAPI-kulccsal. Nem Apple-szolgáltatás: a lista előzetes értesítés nélkül változhat vagy megszűnhet. Minden klipet elküldünk a RapidAPI-nak.</string>
    <string name="core_tools_provider_recraft_desc">Illusztrációk, ikonok és vektorgrafikus stílusú művészet. Kulcs szükséges a recraft.ai oldalról.</string>
    <string name="core_tools_provider_rens_desc">A Rens szerver: egy ingyenes előtér a Google Lenshez. A legtöbb írásrendszerben elolvassa helyetted a fényképen lévő szöveget.</string>
    <string name="core_tools_provider_rens_translate_desc">Egy Rens-kiszolgáló: ingyenes felület a Google Lenshez. Visszaadja a fényképet a lefordított szöveggel.</string>
    <string name="core_tools_provider_replicate_desc">Több ezer hosztolt modell. Nevezz meg bármilyen szöveg-kép modellt tulajdonos/név formátumban; üresen hagyva FLUX Schnell.</string>
    <string name="core_tools_provider_same_kind_fallback">Tartalékokként</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Az azonos típusú szolgáltatók egyként működnek. Az elsőt kérdezzük meg, a másodikat pedig csak akkor, ha az első sikertelen, például ha egy kulcs kvótája kimerült.</string>
    <string name="core_tools_provider_same_kind_separate">Külön</string>
    <string name="core_tools_provider_same_kind_separate_desc">Mindegyik saját szolgáltató: saját chip, saját választási lehetőség a panelen, saját rész egy vegyes rácsban.</string>
    <string name="core_tools_provider_searxng_desc">Egy SearXNG-példány, amely támogatja a JSON-eredményeket. A legtöbb nyilvános példány nem teszi ezt.</string>
    <string name="core_tools_provider_sherpa_desc">Streaming modellek 13 nyelvhez, köztük bengálihoz, amelyek gépelnek, miközben Ön beszél, a telefonon.</string>
    <string name="core_tools_provider_simplytranslate_desc">Egy SimplyTranslate szerver: ingyenes felület a Google és más keresők számára.</string>
    <string name="core_tools_provider_smartthings_desc">SmartThings-eszközei, szobái és jelenetei a Samsung felhőjén keresztül. Az állapotok frissülnek, amíg a panel nyitva van.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra és Stable Diffusion 3.5 a Stable Diffusion készítőitől. Kredittel fizetendő; kulcs szükséges a platform.stability.ai oldalról.</string>
    <string name="core_tools_provider_sticker_packs_desc">A telefonján lévő matricacsomagok.</string>
    <string name="core_tools_provider_switchbot_desc">SwitchBot-eszközei, infravörös távirányítói és jelenetei a SwitchBot felhőjén keresztül, az alkalmazásból származó tokennel. Az állapotok percenként frissülnek, amíg a panel nyitva van.</string>
    <string name="core_tools_provider_system_recognizer">A telefon felismerője</string>
    <string name="core_tools_provider_system_recognizer_desc">A telefonhoz tartozó beszédfelismerő, általában a Google-é. A szavak beszéd közben jelennek meg.</string>
    <string name="core_tools_provider_tavily_desc">Webes keresés rövid válasszal. Szükséges hozzá a Tavily-kulcsa.</string>
    <string name="core_tools_provider_together_desc">FLUX és más nyílt modellek a Together szerverein.</string>
