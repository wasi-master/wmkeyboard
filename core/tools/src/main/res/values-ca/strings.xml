    <string name="core_tools_provider_transcription_server">Servidor de transcripció</string>
    <string name="core_tools_provider_transcription_server_desc">Un servidor que utilitza l\'API de transcripció d\'àudio d\'OpenAI: speaches, el servidor de whisper.cpp, LocalAI, Groq o OpenAI. Cada clip s\'hi envia quan deixes de parlar.</string>
    <string name="core_tools_provider_translate_server">El teu servidor de traducció</string>
    <string name="core_tools_provider_translate_server_desc">Un servidor que respon a les sol·licituds de xat d\'OpenAI: llama.cpp, Ollama, LM Studio, vLLM o una passarel·la.</string>
    <string name="core_tools_provider_translite_desc">Un servidor Translite: una interfície gratuïta per a Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Dispositius, habitacions i escenes de Smart Life i Tuya Smart, mitjançant un projecte de desenvolupador de Tuya gratuït vinculat al vostre compte de l\'aplicació. Els estats s\'actualitzen mentre el tauler està obert.</string>
    <string name="core_tools_provider_unsplash_desc">Fotos d\'Unsplash. Requereix una clau d\'API, tret que aquesta compilació en tingui una.</string>
    <string name="core_tools_provider_vision_ocr">El teu model de visió</string>
    <string name="core_tools_provider_vision_ocr_desc">Un model que llegeix imatges, a través d\'un servidor que respon a les sol·licituds de xat d\'OpenAI. Necessita l\'adreça i el nom del model.</string>
    <string name="core_tools_provider_whisper_desc">Models Whisper d\'OpenAI, executats al telèfon. Molts idiomes; descarrega un model a la pàgina d\'escriptura per veu.</string>
    <string name="core_tools_provider_whistle_desc">Un model petit i ràpid que s\'executa al telèfon. Descarrega\'l a la pàgina d\'escriptura per veu.</string>
    <string name="core_tools_provider_xai_desc">Models Grok mitjançant l\'API de xAI, amb la teva pròpia clau.</string>
