    <string name="core_tools_provider_acrcloud_desc">Un servei de reconeixement de música amb una prova de dues setmanes, després plans de pagament. Necessita l\'amfitrió, la clau d\'accés i el secret d\'accés d\'un projecte de console.acrcloud.com. Cada clip s\'envia a ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion gratuït als ordinadors dels voluntaris. Funciona sense clau però espera en una cua; una clau gratuïta de aihorde.net et fa avançar.</string>
    <string name="core_tools_provider_anthropic_desc">Models Claude a través de l\'API d\'Anthropic, amb la teva pròpia clau.</string>
    <string name="core_tools_provider_asr4all_desc">Dictat en anglès al telèfon, amb les paraules apareixent mentre parles.</string>
    <string name="core_tools_provider_audd_desc">Reconeix la majoria de música publicada a partir d\'uns segons de so. Necessita un testimoni de dashboard.audd.io; uns quants centenars de reconeixements són gratuïts, després és de pagament. Cada clip s\'envia a AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Un petit servei de reconeixement, gratuït per a ús personal amb una clau d\'audiotag.info, i més lent que els altres: respon al cap d\'uns segons. Cada clip s\'envia a AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge o SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">La teva pròpia interfície web de Stable Diffusion, iniciada amb --api. Dona la seva adreça, com ara http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Al dispositiu (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Tradueix al telèfon amb el motor Bergamot de Mozilla i els models de traducció de Firefox. Programari lliure, sense serveis de Google, i el vostre text es queda al telèfon. Cada direcció (francès a anglès, anglès a francès) és una descàrrega pròpia de 14 a 37 MB. Requereix un telèfon de 64 bits amb Android 9 o posterior.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Els models FLUX de les persones que els van crear. Necessita una clau de bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Respostes basades en una cerca web de Brave. Requereix una clau amb el pla Answers. Si es deixa en blanc, s\'utilitzarà la clau de Brave Search que heu escrit per a la cerca web.</string>
    <string name="core_tools_provider_brave_desc">Cerca web i d\'imatges. Requereix una clau d\'API de Brave Search, tret que aquesta compilació en tingui una.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX i Stable Diffusion a Cloudflare, amb una assignació diària gratuïta. Necessita un testimoni d\'API i el teu identificador de compte.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Servidors de proves de velocitat de Cloudflare, el més proper dels seus centres de dades. No necessita compte i indica a la targeta en quina xarxa et trobes i quina ciutat ha respost.</string>
    <string name="core_tools_provider_coinbase_desc">Monedes i divises de Coinbase. Sense clau.</string>
    <string name="core_tools_provider_coingecko_desc">Preus de monedes de CoinGecko. Sense clau.</string>
    <string name="core_tools_provider_comfyui_desc">El teu propi servidor ComfyUI. Dibuixa amb un flux de treball de text a imatge senzill i el punt de control que indiquis, o el primer que tingui.</string>
    <string name="core_tools_provider_commons_desc">GIFs i fotos gratuïtes de Wikimedia Commons, o del teu propi MediaWiki. Sense clau. Els GIFs són majoritàriament educatius.</string>
    <string name="core_tools_provider_currency_api_desc">Dades obertes per a la majoria de divises i moltes monedes. Sense clau.</string>
    <string name="core_tools_provider_deepl_desc">Necessita la teva clau d\'API de DeepL, o l\'adreça d\'un servidor intermediari (proxy) que n\'afegeixi una.</string>
    <string name="core_tools_provider_deepseek_desc">Models de DeepSeek a través de l\'API de DeepSeek, amb la teva pròpia clau.</string>
    <string name="core_tools_provider_er_api_desc">Tipus de canvi diaris per a la majoria de monedes. Sense clau.</string>
    <string name="core_tools_provider_fal_desc">Models allotjats ràpids: FLUX, Recraft, Ideogram, Qwen Image i més. Posa el nom de l\'id fal del model; FLUX Schnell si es deixa en blanc.</string>
    <string name="core_tools_provider_frankfurter_desc">Tipus de canvi del Banc Central Europeu per a les principals divises. Programari lliure, sense clau.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Models Gemini a través de l\'API de Google, amb la teva pròpia clau d\'AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Imatges de Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Models d\'imatge Nano Banana de Google. Una clau en blanc utilitza la clau Gemini de l\'eina d\'IA.</string>
    <string name="core_tools_provider_gifcities_desc">GIF antics de GeoCities de l\'Internet Archive. Sense clau. Els resultats no tenen qualificació de contingut.</string>
    <string name="core_tools_provider_giphy_desc">GIFs i adhesius. Sempre en la seva pròpia pestanya: GIPHY no permet que les aplicacions barregin els seus resultats amb d\'altres.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Els dispositius de Google Home, a través dels serveis de Play. Una llar alhora; tries quina a la pantalla de Google.</string>
    <string name="core_tools_provider_google_translate">Google Translate</string>
    <string name="core_tools_provider_google_translate_desc">Punt final gratuït de Google, o Cloud Translation quan afegiu una clau.</string>
    <string name="core_tools_provider_harper_desc">El motor gramatical integrat al teclat. Només en anglès, i res del que escriguis surt del telèfon.</string>
    <string name="core_tools_provider_home_assistant_desc">El vostre propi servidor Home Assistant. Tota mena de coses, en directe, amb Assist.</string>
    <string name="core_tools_provider_hue">Pont Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Llums, habitacions, escenes i sensors directament des d\'un pont Hue a la vostra xarxa Wi-Fi. Res no surt de casa.</string>
    <string name="core_tools_provider_hugging_face_desc">Models als servidors d\'inferència propis d\'Hugging Face, amb una quota mensual gratuïta. Requereix un testimoni d\'accés amb permís d\'Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIFs i adhesius. Requereix una clau d\'API de KLIPY, tret que aquesta compilació en tingui una.</string>
    <string name="core_tools_provider_languagetool_desc">Gramàtica, ortografia i estil en més de 30 idiomes. El vostre text s\'envia a un servidor de LanguageTool per ser revisat: el públic a api.languagetool.org tret que n\'introduïu el vostre.</string>
    <string name="core_tools_provider_librespeed_desc">Un servidor LibreSpeed: un que executeu vosaltres mateixos, o un dels servidors dels voluntaris de la llista pública, escollit per ciutat a la pantalla de la fila.</string>
    <string name="core_tools_provider_libretranslate_desc">Un servidor LibreTranslate: el vostre propi o un de públic. Els servidors públics solen necessitar una clau.</string>
    <string name="core_tools_provider_lingva_desc">Un servidor Lingva: una interfície gratuïta per al Traductor de Google.</string>
    <string name="core_tools_provider_lm_studio_desc">Models servits per LM Studio al teu ordinador. Afegeix-ne un per a cada ordinador.</string>
    <string name="core_tools_provider_mlkit">Al dispositiu</string>
    <string name="core_tools_provider_mlkit_desc">Tradueix al telèfon amb ML Kit. El teu text es queda al telèfon. Cada idioma necessita primer una descàrrega del model.</string>
    <string name="core_tools_provider_mode_fallback">D\'un en un</string>
    <string name="core_tools_provider_mode_fallback_desc">Pregunta al primer proveïdor. Si falla o no té resultats, pregunta al següent.</string>
    <string name="core_tools_provider_mode_mix">Mixt</string>
    <string name="core_tools_provider_mode_mix_desc">Pregunta a tots els proveïdors alhora i barreja els seus resultats en una graella.</string>
    <string name="core_tools_provider_mode_pick">Tria al panell</string>
    <string name="core_tools_provider_mode_pick_desc">El tauler mostra els proveïdors que estan activats. Tria\'n un i només es consultarà aquell.</string>
    <string name="core_tools_provider_mode_tabs">Pestanyes</string>
    <string name="core_tools_provider_mode_tabs_desc">Cada proveïdor té la seva pròpia pestanya. Toqueu una pestanya per veure\'n els resultats.</string>
    <string name="core_tools_provider_moonshine_desc">Un model d\'anglès petit i ràpid que s\'executa al telèfon.</string>
    <string name="core_tools_provider_mozhi_desc">Un servidor Mozhi: una interfície gratuïta per a Google, DeepL, DuckDuckGo, Yandex i Reverso. Tria el motor. DeepL i Reverso necessiten un idioma d\'origen.</string>
    <string name="core_tools_provider_music_server">El teu propi servidor de reconeixement</string>
    <string name="core_tools_provider_music_server_desc">Un servidor que executes que respon com AudD: el clip es publica com un fitxer i la cançó torna en format JSON. Posa un processador d\'empremta digital musical com Panako o Olaf al darrere.</string>
    <string name="core_tools_provider_nllb">Al dispositiu (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Tradueix al telèfon amb el model NLLB-200 de Meta a CTranslate2: 200 idiomes, entre qualsevol parella, per a les combinacions que altres motors no poden fer. Una descàrrega de 630 MB, i una frase triga uns segons. El text es queda al telèfon. El model té llicència només per a ús no comercial (CC BY-NC 4.0). Requereix un telèfon de 64 bits amb 6 GB de memòria o més.</string>
    <string name="core_tools_provider_none_on">No hi ha cap proveïdor activat. Activeu-ne un a la configuració d\'aquesta eina.</string>
    <string name="core_tools_provider_offline_gifs">Paquets de GIF fora de línia</string>
    <string name="core_tools_provider_offline_gifs_desc">Paquets de GIF que heu importat. Funcionen sense connexió.</string>
    <string name="core_tools_provider_ollama_desc">Models en un servidor Ollama que executeu, a l\'ordinador o a la xarxa. Afegiu-ne un per a cada servidor.</string>
    <string name="core_tools_provider_omnilingual_desc">El model únic de Meta per a 1.600 llengües, centenars de les quals sense cap altra opció d\'escriptura per veu, al telèfon. Cada frase arriba a la pausa que hi ha al final.</string>
    <string name="core_tools_provider_on_device_ai">Al teu dispositiu</string>
    <string name="core_tools_provider_on_device_ai_desc">Un model descarregat en aquest telèfon. Res del que escrius en surt. Tria i descarrega el model a la pàgina d\'IA.</string>
    <string name="core_tools_provider_on_device_image">En aquest telèfon</string>
    <string name="core_tools_provider_on_device_image_desc">Un model descarregat en aquest telèfon, o un que heu importat. Res del que escriviu en surt. Trieu el model a la pantalla del generador.</string>
    <string name="core_tools_provider_openai_compatible">Servei compatible amb OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Qualsevol altre servei amb l\'API de xat d\'OpenAI: OpenRouter, Groq, Mistral, Together o una passarel·la pròpia. Introdueix l\'adreça fins a la versió, com ara https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Imatges compatibles amb OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Qualsevol altre servei amb l\'API d\'imatge d\'OpenAI: LocalAI, DeepInfra, Nebius o una passarel·la pròpia. Proporciona l\'adreça fins a la versió, com ara https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Models GPT a través de l\'API d\'OpenAI, amb la teva pròpia clau.</string>
    <string name="core_tools_provider_openai_image">Imatges d\'OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, que dibuixa adhesius sobre un fons transparent. Es paga per imatge. Una clau en blanc utilitza la clau d\'OpenAI de l\'eina d\'IA.</string>
    <string name="core_tools_provider_openhab_desc">Un servidor openHAB: els seus elements, en directe, amb habitacions del model semàntic.</string>
    <string name="core_tools_provider_parakeet_desc">Un model gran que s\'executa al telèfon i entén 25 idiomes europeus.</string>
    <string name="core_tools_provider_pexels_desc">Fotos de Pexels. Necessita una clau API, tret que aquesta compilació en tingui una.</string>
    <string name="core_tools_provider_pollinations_desc">Gratuït, sense clau ni compte: l\'indicació s\'envia a Pollinations, que tria el model. Una clau d\'enter.pollinations.ai obre el seu API més nou i et permet anomenar un model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (no oficial, via RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Catàleg de Shazam mitjançant un llistat no oficial a RapidAPI, amb una clau de RapidAPI. No és un servei d\'Apple: el llistat pot canviar o deixar de funcionar sense previ avís. Cada clip s\'envia a RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Il·lustracions, icones i art d\'estil vectorial. Necessita una clau de recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Un servidor Rens: un front-end gratuït per a Google Lens. Llegeix el text d\'una foto per a tu, en la majoria d\'escriptures.</string>
    <string name="core_tools_provider_rens_translate_desc">Un servidor Rens: una interfície gratuïta per a Google Lens. Retorna la foto amb el text traduït.</string>
    <string name="core_tools_provider_replicate_desc">Milers de models allotjats. Anomena qualsevol model de text a imatge com a propietari/nom; FLUX Schnell si es deixa en blanc.</string>
    <string name="core_tools_provider_same_kind_fallback">Com a còpies de seguretat</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Els proveïdors del mateix tipus actuen com un de sol. Es consulta el primer, i el següent només quan falla, per exemple quan una clau exhaureix la quota.</string>
    <string name="core_tools_provider_same_kind_separate">Per separat</string>
    <string name="core_tools_provider_same_kind_separate_desc">Cadascun és el seu propi proveïdor: el seu propi xip, la seva pròpia elecció al tauler, la seva pròpia part d\'una graella mixta.</string>
    <string name="core_tools_provider_searxng_desc">Una instància de SearXNG que permet resultats JSON. La majoria d\'instàncies públiques no ho fan.</string>
    <string name="core_tools_provider_sherpa_desc">Models de transmissió per a 13 idiomes, entre ells el bengalí, que escriuen mentre parleu, al telèfon.</string>
    <string name="core_tools_provider_simplytranslate_desc">Un servidor SimplyTranslate: una interfície gratuïta per a Google i altres motors.</string>
    <string name="core_tools_provider_smartthings_desc">Els teus dispositius, habitacions i escenes de SmartThings, a través del núvol de Samsung. Els estats s\'actualitzen mentre el panell està obert.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra i Stable Diffusion 3.5 dels creadors de Stable Diffusion. Es paga amb crèdits; necessita una clau de platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Els teus paquets d\'adhesius en aquest telèfon.</string>
    <string name="core_tools_provider_switchbot_desc">Els teus dispositius SwitchBot, comandaments infrarojos i escenes, a través del núvol de SwitchBot amb el testimoni de la seva aplicació. Els estats s\'actualitzen un cop per minut mentre el panell està obert.</string>
    <string name="core_tools_provider_system_recognizer">Reconeixedor del telèfon</string>
    <string name="core_tools_provider_system_recognizer_desc">El reconeixedor de veu que ve amb el telèfon, normalment el de Google. Les paraules apareixen a mesura que parleu.</string>
    <string name="core_tools_provider_tavily_desc">Cerca web amb una resposta curta. Necessita la teva clau de Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX i altres models oberts als servidors de Together.</string>
