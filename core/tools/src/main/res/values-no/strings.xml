    <string name="core_tools_provider_transcription_server_desc">En server som bruker OpenAIs lydtranskripsjons-API: speaches, whisper.cpp sin server, LocalAI, Groq eller OpenAI. Hvert klipp sendes til den når du slutter å snakke.</string>
    <string name="core_tools_provider_translate_server">Din oversettelsesserver</string>
    <string name="core_tools_provider_translate_server_desc">En tjener som svarer på OpenAI-chatforespørsler: llama.cpp, Ollama, LM Studio, vLLM eller en gateway.</string>
    <string name="core_tools_provider_translite_desc">En Translite-server: et gratis grensesnitt til Google Oversetter.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life- og Tuya Smart-enheter, rom og scener, gjennom et gratis Tuya-utviklerprosjekt koblet til appkontoen din. Tilstander oppdateres mens panelet er åpent.</string>
    <string name="core_tools_provider_unsplash_desc">Bilder fra Unsplash. Krever en API-nøkkel, med mindre denne versjonen har en.</string>
    <string name="core_tools_provider_vision_ocr">Din synsmodell</string>
    <string name="core_tools_provider_vision_ocr_desc">En modell som leser bilder, gjennom en server som svarer på OpenAI-chatforespørsler. Trenger adressen og modellnavnet.</string>
    <string name="core_tools_provider_whisper_desc">OpenAIs Whisper-modeller, kjørt på telefonen. Mange språk; last ned en modell på siden for stemmeskriving.</string>
    <string name="core_tools_provider_whistle_desc">En liten, rask modell som kjører på telefonen. Last den ned på siden for stemmeskriving.</string>
    <string name="core_tools_provider_xai_desc">Grok-modeller via xAIs API, med din egen nøkkel.</string>
