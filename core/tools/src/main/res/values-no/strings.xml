    <string name="core_tools_dictionary_source_imported_desc">På denne enheten. Yomichan- og Yomitan-ordbøkene du importerer, på hvilket som helst språk, med uttale og tonefall.</string>
    <string name="core_tools_dictionary_source_offline_bengali">Bengali-engelsk Wiktionary</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">På denne enheten, når den er lastet ned. Bengalske ord med deres engelske betydninger og hvordan de sies.</string>
