    <string name="core_tools_provider_acrcloud_desc">En musikkgjenkjenningstjeneste med en to-ukers prøveperiode, deretter betalte planer. Krever vert, tilgangsnøkkel og tilgangshemmelighet for et prosjekt fra console.acrcloud.com. Hvert klipp sendes til ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Gratis Stable Diffusion på frivilliges datamaskiner. Fungerer uten en nøkkel, men du må vente i en kø; en gratis nøkkel fra aihorde.net gjør at du rykker frem i køen.</string>
    <string name="core_tools_provider_anthropic_desc">Claude-modeller via Anthropic sitt API, med din egen nøkkel.</string>
    <string name="core_tools_provider_asr4all_desc">Engelsk diktering på telefonen, med ord som dukker opp mens du snakker.</string>
    <string name="core_tools_provider_audd_desc">Gjenkjenner det meste av utgitt musikk fra noen få sekunder med lyd. Krever et token fra dashboard.audd.io; noen hundre gjenkjenninger er gratis, deretter er det betalt. Hvert klipp sendes til AudD.</string>
    <string name="core_tools_provider_audiotag_desc">En liten gjenkjenningstjeneste, gratis for personlig bruk med en nøkkel fra audiotag.info, og tregere enn de andre: den svarer etter noen sekunder. Hvert klipp sendes til AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge eller SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Ditt eget Stable Diffusion-nettgrensesnitt, startet med --api. Oppgi adressen, for eksempel http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">På enheten (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Oversetter på telefonen med Mozillas Bergamot-motor og Firefox Translations-modeller. Fri programvare, ingen Google-tjenester, og teksten din forblir på telefonen. Hver retning (fransk til engelsk, engelsk til fransk) er sin egen nedlasting på 14 til 37 MB. Krever en 64-biters telefon med Android 9 eller nyere.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX-modellene fra menneskene som laget dem. Krever en nøkkel fra bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Svar basert på et Brave-websøk. Krever en nøkkel med Svar-planen. Hvis den står tom, prøves Brave Search-nøkkelen du skrev inn for websøk.</string>
    <string name="core_tools_provider_brave_desc">Web- og bildesøk. Krever en Brave Search API-nøkkel, med mindre denne versjonen har en.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX og Stable Diffusion på Cloudflare, med en gratis daglig kvote. Krever et API-token og din kontoid.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflares hastighetstestservere, de nærmeste datasentrene deres. Krever ingen konto, og forteller kortet hvilket nettverk du er på og hvilken by som svarte.</string>
    <string name="core_tools_provider_coinbase_desc">Valutaer og mynter fra Coinbase. Ingen nøkkel.</string>
    <string name="core_tools_provider_coingecko_desc">Myntpriser fra CoinGecko. Ingen nøkkel.</string>
    <string name="core_tools_provider_comfyui_desc">Din egen ComfyUI-tjener. Tegner med en enkel tekst-til-bilde-arbeidsflyt og sjekkpunktet du navngir, eller det første det har.</string>
    <string name="core_tools_provider_commons_desc">Gratis GIF-er og bilder fra Wikimedia Commons, eller fra din egen MediaWiki. Ingen nøkkel. GIF-ene er stort sett pedagogiske.</string>
    <string name="core_tools_provider_currency_api_desc">Åpne data for de fleste valutaer og mange mynter. Ingen nøkkel.</string>
    <string name="core_tools_provider_deepl_desc">Trenger din DeepL API-nøkkel, eller adressen til en proxy som legger til en.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-modeller via DeepSeeks API, med din egen nøkkel.</string>
    <string name="core_tools_provider_er_api_desc">Daglige kurser for de fleste valutaer. Ingen nøkkel.</string>
    <string name="core_tools_provider_fal_desc">Raske hostede modeller: FLUX, Recraft, Ideogram, Qwen Image og mer. Navngi modellens fal-id; FLUX Schnell når den er tom.</string>
    <string name="core_tools_provider_frankfurter_desc">Den europeiske sentralbankens kurser for hovedvalutaene. Fri programvare, ingen nøkkel.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-modeller via Googles API, med din egen nøkkel fra AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gemini-bilder</string>
    <string name="core_tools_provider_gemini_image_desc">Googles Nano Banana-bildemodeller. En tom tast bruker Gemini-nøkkelen fra AI-verktøyet.</string>
    <string name="core_tools_provider_gifcities_desc">Gamle GeoCities-GIF-er fra Internet Archive. Ingen nøkkel. Resultatene har ingen innholdsrangering.</string>
    <string name="core_tools_provider_giphy_desc">GIF-er og klistremerker. Alltid i sin egen fane: GIPHY lar ikke apper blande resultatene sine med andre.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Enhetene i ditt Google Home, via Play-tjenester. Ett hjem om gangen; du velger hvilket i Googles egen skjerm.</string>
    <string name="core_tools_provider_google_translate">Google Oversetter</string>
    <string name="core_tools_provider_google_translate_desc">Googles gratis endepunkt, eller Cloud Translation når du legger til en nøkkel.</string>
    <string name="core_tools_provider_harper_desc">Grammatikkmotoren innebygd i tastaturet. Kun engelsk, og ingenting du skriver forlater telefonen.</string>
    <string name="core_tools_provider_home_assistant_desc">Din egen Home Assistant-tjener. Alle typer ting, direkte, med Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue-bro</string>
    <string name="core_tools_provider_hue_desc">Lys, rom, scener og sensorer rett fra en Hue-bro på Wi-Fi-nettverket ditt. Ingenting forlater huset.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeller på Hugging Faces egne inferensservere, med en gratis månedlig kvote. Krever et tilgangstoken med tillatelse for inferensleverandører.</string>
    <string name="core_tools_provider_klipy_desc">GIF-er og klistremerker. Krever en KLIPY-API-nøkkel, med mindre denne versjonen har en.</string>
    <string name="core_tools_provider_languagetool_desc">Grammatikk, rettskriving og stil på mer enn 30 språk. Teksten din sendes til en LanguageTool-tjener for kontroll: den offentlige på api.languagetool.org med mindre du oppgir din egen.</string>
    <string name="core_tools_provider_librespeed_desc">En LibreSpeed-server: en du kjører selv, eller en av de frivilliges servere fra den offentlige listen, valgt etter by på radens egen skjerm.</string>
    <string name="core_tools_provider_libretranslate_desc">En LibreTranslate-tjener: din egen eller en offentlig en. Offentlige tjenere trenger vanligvis en nøkkel.</string>
    <string name="core_tools_provider_lingva_desc">En Lingva-tjener: et gratis grensesnitt til Google Oversetter.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeller levert av LM Studio på datamaskinen din. Legg til én for hver datamaskin.</string>
    <string name="core_tools_provider_mlkit">På enheten</string>
    <string name="core_tools_provider_mlkit_desc">Oversetter på telefonen med ML Kit. Teksten din forblir på telefonen. Hvert språk krever at en modell lastes ned først.</string>
    <string name="core_tools_provider_mode_fallback">Én om gangen</string>
    <string name="core_tools_provider_mode_fallback_desc">Spør den første leverandøren. Hvis den feiler eller ikke har resultater, spør den neste.</string>
    <string name="core_tools_provider_mode_mix">Blandet</string>
    <string name="core_tools_provider_mode_mix_desc">Spør alle leverandører samtidig og bland resultatene deres i ett rutenett.</string>
    <string name="core_tools_provider_mode_pick">Velg i panelet</string>
    <string name="core_tools_provider_mode_pick_desc">Panelet viser leverandørene som er på. Velg én der, og bare den blir spurt.</string>
    <string name="core_tools_provider_mode_tabs">Faner</string>
    <string name="core_tools_provider_mode_tabs_desc">Hver leverandør får sin egen brikke. Trykk på en brikke for å se resultatene.</string>
    <string name="core_tools_provider_moonshine_desc">En liten, rask engelsk modell som kjører på telefonen.</string>
    <string name="core_tools_provider_mozhi_desc">En Mozhi-tjener: et gratis grensesnitt til Google, DeepL, DuckDuckGo, Yandex og Reverso. Velg motor. DeepL og Reverso krever et kildespråk.</string>
    <string name="core_tools_provider_music_server">Din egen gjenkjenningsserver</string>
    <string name="core_tools_provider_music_server_desc">En tjener du kjører som svarer som AudD: klippet sendes som en fil og sangen kommer tilbake som JSON. Plasser en fingeravtrykk-tjeneste som Panako eller Olaf bak den.</string>
    <string name="core_tools_provider_nllb">På enheten (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Oversetter på telefonen med Metas NLLB-200-modell på CTranslate2: 200 språk, mellom hvilke som helst to av dem, for parene de andre motorene ikke kan håndtere. Én nedlasting på 630 MB, og en setning tar noen sekunder. Teksten din forblir på telefonen. Modellen er lisensiert kun for ikke-kommersiell bruk (CC BY-NC 4.0). Krever en 64-biters telefon med 6 GB minne eller mer.</string>
    <string name="core_tools_provider_none_on">Ingen leverandør er på. Slå på en i dette verktøyets innstillinger.</string>
    <string name="core_tools_provider_offline_gifs">Frakoblede GIF-pakker</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF-pakker du har importert. De fungerer uten internettforbindelse.</string>
    <string name="core_tools_provider_ollama_desc">Modeller på en Ollama-tjener du kjører, på datamaskinen din eller i nettverket ditt. Legg til én for hver tjener.</string>
    <string name="core_tools_provider_omnilingual_desc">Metas én modell for 1600 språk, hundrevis av dem uten annen stemmeskriving, på telefonen. Hver frase ankommer ved pausen etter den.</string>
    <string name="core_tools_provider_on_device_ai">På enheten din</string>
    <string name="core_tools_provider_on_device_ai_desc">En modell lastet ned til denne telefonen. Ingenting du skriver forlater den. Velg og last ned modellen på AI-siden.</string>
    <string name="core_tools_provider_on_device_image">På denne telefonen</string>
    <string name="core_tools_provider_on_device_image_desc">En modell lastet ned til denne telefonen, eller en du har importert. Ingenting du skriver forlater den. Velg modellen på generatorens skjerm.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-kompatibel tjeneste</string>
    <string name="core_tools_provider_openai_compatible_desc">Enhver annen tjeneste med OpenAIs chat-API: OpenRouter, Groq, Mistral, Together, eller en egen gateway. Oppgi adressen frem til versjonen, for eksempel https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-kompatible bilder</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Enhver annen tjeneste med OpenAIs bilde-API: LocalAI, DeepInfra, Nebius eller din egen gateway. Oppgi adressen frem til versjonen, for eksempel https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-modeller via OpenAIs API, med din egen nøkkel.</string>
    <string name="core_tools_provider_openai_image">OpenAI-bilder</string>
    <string name="core_tools_provider_openai_image_desc">GPT-bilde, som tegner klistremerker på en gjennomsiktig bakgrunn. Betales per bilde. En tom nøkkel bruker OpenAI-nøkkelen fra AI-verktøyet.</string>
    <string name="core_tools_provider_openhab_desc">En openHAB-tjener: dens elementer, live, med rom fra den semantiske modellen.</string>
    <string name="core_tools_provider_parakeet_desc">En stor modell som kjører på telefonen og forstår 25 europeiske språk.</string>
    <string name="core_tools_provider_pexels_desc">Bilder fra Pexels. Krever en API-nøkkel, med mindre denne versjonen allerede har en.</string>
    <string name="core_tools_provider_pollinations_desc">Gratis, uten nøkkel og uten konto: ledeteksten sendes til Pollinations, som velger modellen. En nøkkel fra enter.pollinations.ai åpner det nyere API-et og lar deg navngi en modell.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (uoffisiell, via RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazams katalog gjennom en uoffisiell liste på RapidAPI, med en RapidAPI-nøkkel. Ikke en Apple-tjeneste: listen kan endres eller stoppe uten varsel. Hvert klipp sendes til RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Illustrasjoner, ikoner og kunst i vektorstil. Krever en nøkkel fra recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">En Rens-tjener: et gratis grensesnitt til Google Lens. Den leser teksten i et bilde for deg, i de fleste skrifttyper.</string>
    <string name="core_tools_provider_rens_translate_desc">En Rens-tjener: et gratis grensesnitt til Google Lens. Den returnerer bildet med teksten oversatt.</string>
    <string name="core_tools_provider_replicate_desc">Tusenvis av hostede modeller. Navngi en hvilken som helst tekst-til-bilde-modell som eier/navn; FLUX Schnell hvis tom.</string>
    <string name="core_tools_provider_same_kind_fallback">Som sikkerhetskopier</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Leverandører av samme type fungerer som én. Den første blir spurt, og den neste bare når den feiler, for eksempel når en nøkkel går tom for kvote.</string>
    <string name="core_tools_provider_same_kind_separate">Separat</string>
    <string name="core_tools_provider_same_kind_separate_desc">Hver enkelt er sin egen leverandør: sin egen brikke, sitt eget valg i panelet, sin egen del av et blandet rutenett.</string>
    <string name="core_tools_provider_searxng_desc">En SearXNG-instans som tillater JSON-resultater. De fleste offentlige instanser gjør ikke det.</string>
    <string name="core_tools_provider_sherpa_desc">Strømmemodeller for 13 språk, inkludert bengali, som skriver mens du snakker, på telefonen.</string>
    <string name="core_tools_provider_simplytranslate_desc">En SimplyTranslate-tjener: et gratis grensesnitt til Google og andre søkemotorer.</string>
    <string name="core_tools_provider_smartthings_desc">Dine SmartThings-enheter, rom og scener, gjennom Samsungs sky. Tilstander oppdateres mens panelet er åpent.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra og Stable Diffusion 3.5 fra skaperne av Stable Diffusion. Betales med kreditter; krever en nøkkel fra platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Klistremerkepakkene dine på denne telefonen.</string>
    <string name="core_tools_provider_switchbot_desc">Dine SwitchBot-enheter, infrarøde fjernkontroller og scener, via SwitchBots sky med token fra appen. Tilstander oppdateres en gang i minuttet mens panelet er åpent.</string>
    <string name="core_tools_provider_system_recognizer">Telefonens gjenkjenner</string>
    <string name="core_tools_provider_system_recognizer_desc">Talegjenkjenningen som følger med telefonen, vanligvis Googles. Ord vises mens du snakker.</string>
    <string name="core_tools_provider_tavily_desc">Nettsøk med et kort svar. Krever din Tavily-nøkkel.</string>
    <string name="core_tools_provider_together_desc">FLUX og andre åpne modeller på Togethers servere.</string>
