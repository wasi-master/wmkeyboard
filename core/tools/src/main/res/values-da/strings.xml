    <string name="core_tools_provider_acrcloud_desc">En musikgenkendelsestjeneste med en to-ugers prøveperiode, derefter betalte planer. Kræver vært, adgangsnøgle og adgangshemmelighed for et projekt fra console.acrcloud.com. Hvert klip sendes til ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Gratis Stable Diffusion på frivilliges computere. Fungerer uden nøgle, men venter i en kø; en gratis nøgle fra aihorde.net rykker dig frem i køen.</string>
    <string name="core_tools_provider_anthropic_desc">Claude-modeller via Anthropics API, med din egen nøgle.</string>
    <string name="core_tools_provider_asr4all_desc">Engelsk diktering på telefonen, hvor ordene vises, mens du taler.</string>
    <string name="core_tools_provider_audd_desc">Genkender det meste udgivne musik fra få sekunders lyd. Kræver et token fra dashboard.audd.io; et par hundrede genkendelser er gratis, derefter er det betalt. Hvert klip sendes til AudD.</string>
    <string name="core_tools_provider_audiotag_desc">En lille genkendelsestjeneste, gratis til personlig brug med en nøgle fra audiotag.info, og langsommere end de andre: den svarer efter et par sekunder. Hvert klip sendes til AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge eller SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Din egen Stable Diffusion web-brugerflade, startet med --api. Indtast dens adresse, f.eks. http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">På enheden (Firefox Oversættelser)</string>
    <string name="core_tools_provider_bergamot_desc">Oversætter på telefonen med Mozillas Bergamot-motor og Firefox Translations-modellerne. Fri software, ingen Google-tjenester, og din tekst bliver på telefonen. Hver retning (fransk til engelsk, engelsk til fransk) er en separat download på 14 til 37 MB. Kræver en 64-bit telefon med Android 9 eller nyere.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX-modellerne fra folkene, der skabte dem. Kræver en nøgle fra bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Svar baseret på en Brave-websøgning. Kræver en nøgle med Answers-planen. Hvis den efterlades tom, forsøges Brave Search-nøglen, du indtastede til websøgning.</string>
    <string name="core_tools_provider_brave_desc">Web- og billedsøgning. Kræver en Brave Search API-nøgle, medmindre denne build har en.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX og Stable Diffusion på Cloudflare, med en gratis daglig kvote. Kræver et API-token og dit konto-id.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflares hastighedstestservere, nærmeste af deres datacentre. Kræver ingen konto, og fortæller kortet, hvilket netværk du er på, og hvilken by der svarede.</string>
    <string name="core_tools_provider_coinbase_desc">Valutaer og mønter fra Coinbase. Ingen nøgle.</string>
    <string name="core_tools_provider_coingecko_desc">Møntpriser fra CoinGecko. Ingen nøgle.</string>
    <string name="core_tools_provider_comfyui_desc">Din egen ComfyUI-server. Tegner med et simpelt tekst-til-billede-workflow og det checkpoint, du navngiver, eller det første, den har.</string>
    <string name="core_tools_provider_commons_desc">Gratis GIF\'er og fotos fra Wikimedia Commons eller fra din egen MediaWiki. Ingen nøgle. GIF\'erne er primært uddannelsesmæssige.</string>
    <string name="core_tools_provider_currency_api_desc">Åbne data for de fleste valutaer og mange mønter. Ingen nøgle.</string>
    <string name="core_tools_provider_deepl_desc">Kræver din DeepL API-nøgle eller adressen på en proxy, der tilføjer en.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-modeller via DeepSeeks API, med din egen nøgle.</string>
    <string name="core_tools_provider_er_api_desc">Daglige kurser for de fleste valutaer. Ingen nøgle.</string>
    <string name="core_tools_provider_fal_desc">Hurtige hostede modeller: FLUX, Recraft, Ideogram, Qwen Image og mere. Angiv modellens fal-id; FLUX Schnell når den er tom.</string>
    <string name="core_tools_provider_frankfurter_desc">Den Europæiske Centralbanks kurser for de vigtigste valutaer. Gratis software, ingen nøgle.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-modeller via Googles API, med din egen nøgle fra AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gemini-billeder</string>
    <string name="core_tools_provider_gemini_image_desc">Googles Nano Banana-billedmodeller. En tom nøgle bruger Gemini-nøglen fra AI-værktøjet.</string>
    <string name="core_tools_provider_gifcities_desc">Gamle GeoCities-GIF\'er fra Internet Archive. Ingen nøgle. Resultaterne har ingen indholdsvurdering.</string>
    <string name="core_tools_provider_giphy_desc">GIF\'er og klistermærker. Altid i sin egen fane: GIPHY tillader ikke apps at blande deres resultater med andre.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Enhederne i dit Google Home via Play-tjenester. Ét hjem ad gangen; du vælger hvilket i Googles egen skærm.</string>
    <string name="core_tools_provider_google_translate">Google Oversæt</string>
    <string name="core_tools_provider_google_translate_desc">Googles gratis endpoint, eller Cloud Translation når du tilføjer en nøgle.</string>
    <string name="core_tools_provider_harper_desc">Grammatikmotoren indbygget i tastaturet. Kun engelsk, og intet du skriver forlader telefonen.</string>
    <string name="core_tools_provider_home_assistant_desc">Din egen Home Assistant-server. Alt muligt, live, med Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue-bro</string>
    <string name="core_tools_provider_hue_desc">Lys, rum, scener og sensorer direkte fra en Hue-bro på dit Wi-Fi. Intet forlader huset.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeller på Hugging Faces egne inferensservere med en gratis månedlig kvote. Kræver et adgangstoken med tilladelse til inferensudbydere.</string>
    <string name="core_tools_provider_klipy_desc">GIF\'er og klistermærker. Kræver en KLIPY API-nøgle, medmindre denne build har en.</string>
    <string name="core_tools_provider_languagetool_desc">Grammatik, stavning og stil på mere end 30 sprog. Din tekst sendes til en LanguageTool-server for at blive tjekket: den offentlige på api.languagetool.org, medmindre du indtaster din egen.</string>
    <string name="core_tools_provider_librespeed_desc">En LibreSpeed-server: en du selv kører, eller en af de frivilliges servere fra den offentlige liste, valgt efter by på rækkens egen skærm.</string>
    <string name="core_tools_provider_libretranslate_desc">En LibreTranslate-server: din egen eller en offentlig. Offentlige servere kræver normalt en nøgle.</string>
    <string name="core_tools_provider_lingva_desc">En Lingva-server: en gratis frontend til Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeller leveret af LM Studio på din computer. Tilføj en for hver computer.</string>
    <string name="core_tools_provider_mlkit">På enheden</string>
    <string name="core_tools_provider_mlkit_desc">Oversætter på telefonen med ML Kit. Din tekst bliver på telefonen. Hvert sprog kræver først en modeldownload.</string>
    <string name="core_tools_provider_mode_fallback">Én ad gangen</string>
    <string name="core_tools_provider_mode_fallback_desc">Spørg den første udbyder. Hvis det fejler eller ikke giver resultater, så spørg den næste.</string>
    <string name="core_tools_provider_mode_mix">Blandet</string>
    <string name="core_tools_provider_mode_mix_desc">Spørg alle udbydere på samme tid og bland deres resultater i ét gitter.</string>
    <string name="core_tools_provider_mode_pick">Vælg i panelet</string>
    <string name="core_tools_provider_mode_pick_desc">Panelet viser de udbydere, der er tændt. Vælg én der, og kun den bliver spurgt.</string>
    <string name="core_tools_provider_mode_tabs">Faner</string>
    <string name="core_tools_provider_mode_tabs_desc">Hver udbyder får sin egen chip. Tryk på en chip for at se dens resultater.</string>
    <string name="core_tools_provider_moonshine_desc">En lille, hurtig engelsk model, der kører på telefonen.</string>
    <string name="core_tools_provider_mozhi_desc">En Mozhi-server: en gratis frontend til Google, DeepL, DuckDuckGo, Yandex og Reverso. Vælg maskinen. DeepL og Reverso kræver et kildesprog.</string>
    <string name="core_tools_provider_music_server">Din egen genkendelsesserver</string>
    <string name="core_tools_provider_music_server_desc">En server du kører, som svarer ligesom AudD: klippet postes som en fil, og sangen returneres som JSON. Placer en fingerprinter såsom Panako eller Olaf bag den.</string>
    <string name="core_tools_provider_nllb">På enheden (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Oversætter på telefonen med Metas NLLB-200-model på CTranslate2: 200 sprog, mellem alle to af dem, for de par, som de andre motorer ikke kan håndtere. Én download på 630 MB, og en sætning tager et par sekunder. Din tekst bliver på telefonen. Modellen er kun licenseret til ikke-kommerciel brug (CC BY-NC 4.0). Kræver en 64-bit telefon med 6 GB hukommelse eller mere.</string>
    <string name="core_tools_provider_none_on">Ingen udbyder er slået til. Slå en til i dette værktøjs indstillinger.</string>
    <string name="core_tools_provider_offline_gifs">Offline GIF-pakker</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF-pakker, som du har importeret. De virker uden forbindelse.</string>
    <string name="core_tools_provider_ollama_desc">Modeller på en Ollama-server, du kører på din computer eller dit netværk. Tilføj én for hver server.</string>
    <string name="core_tools_provider_omnilingual_desc">Metas émodellen til 1.600 sprog, hvoraf hundredvis ikke har nogen anden stemmeindtastning, direkte på telefonen. Hver sætning ankommer efter pausen.</string>
    <string name="core_tools_provider_on_device_ai">På din enhed</string>
    <string name="core_tools_provider_on_device_ai_desc">En model downloadet til denne telefon. Intet af det, du skriver, forlader den. Vælg og download modellen på AI-siden.</string>
    <string name="core_tools_provider_on_device_image">På denne telefon</string>
    <string name="core_tools_provider_on_device_image_desc">En model downloadet til denne telefon eller en, du har importeret. Intet, du skriver, forlader den. Vælg modellen på generatorens skærm.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-kompatibel tjeneste</string>
    <string name="core_tools_provider_openai_compatible_desc">Enhver anden tjeneste med OpenAIs chat-API: OpenRouter, Groq, Mistral, Together eller din egen gateway. Angiv adressen op til versionen, såsom https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-kompatible billeder</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Enhver anden tjeneste med OpenAIs billed-API: LocalAI, DeepInfra, Nebius eller din egen gateway. Angiv adressen op til versionen, såsom https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-modeller via OpenAI\'s API med din egen nøgle.</string>
    <string name="core_tools_provider_openai_image">OpenAI-billeder</string>
    <string name="core_tools_provider_openai_image_desc">GPT-billede, som tegner klistermærker på en gennemsigtig baggrund. Betales pr. billede. En tom nøgle bruger OpenAI-nøglen fra AI-værktøjet.</string>
    <string name="core_tools_provider_openhab_desc">En openHAB-server: dens elementer, live, med rum fra den semantiske model.</string>
    <string name="core_tools_provider_parakeet_desc">En stor model, der kører på telefonen og forstår 25 europæiske sprog.</string>
    <string name="core_tools_provider_pexels_desc">Billeder fra Pexels. Kræver en API-nøgle, medmindre denne build har en.</string>
    <string name="core_tools_provider_pollinations_desc">Gratis, uden nøgle og uden konto: prompten sendes til Pollinations, som vælger modellen. En nøgle fra enter.pollinations.ai åbner dens nyere API og lader dig navngive en model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (uofficiel, via RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazams katalog via en uofficiel liste på RapidAPI, med en RapidAPI-nøgle. Ikke en Apple-tjeneste: listen kan ændre sig eller stoppe uden varsel. Hvert klip sendes til RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Illustrationer, ikoner og vektorgrafik. Kræver en nøgle fra recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">En Rens-server: en gratis frontend til Google Lens. Den læser teksten på et billede for dig, i de fleste skrifttyper.</string>
    <string name="core_tools_provider_rens_translate_desc">En Rens-server: en gratis frontend til Google Lens. Den returnerer billedet med teksten oversat.</string>
    <string name="core_tools_provider_replicate_desc">Tusindvis af hostede modeller. Angiv enhver tekst-til-billede-model som ejer/navn; FLUX Schnell bruges, hvis feltet er tomt.</string>
    <string name="core_tools_provider_same_kind_fallback">Som sikkerhedskopier</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Udbydere af samme type fungerer som én. Den første bliver spurgt, og den næste kun hvis den fejler, for eksempel når en nøgle løber tør for kvote.</string>
    <string name="core_tools_provider_same_kind_separate">Separat</string>
    <string name="core_tools_provider_same_kind_separate_desc">Hver enkelt er sin egen udbyder: sin egen chip, sit eget valg i panelet, sin egen andel af et blandet gitter.</string>
    <string name="core_tools_provider_searxng_desc">En SearXNG-instans, der tillader JSON-resultater. De fleste offentlige instanser gør ikke.</string>
    <string name="core_tools_provider_sherpa_desc">Streamingmodeller til 13 sprog, herunder bengali, der skriver mens du taler på telefonen.</string>
    <string name="core_tools_provider_simplytranslate_desc">En SimplyTranslate-server: en gratis frontend til Google og andre søgemaskiner.</string>
    <string name="core_tools_provider_smartthings_desc">Dine SmartThings-enheder, rum og scener via Samsungs cloud. Status opdateres, mens panelet er åbent.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra og Stable Diffusion 3.5 fra skaberne af Stable Diffusion. Betales med credits; kræver en nøgle fra platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Dine klistermærkepakker på denne telefon.</string>
    <string name="core_tools_provider_switchbot_desc">Dine SwitchBot-enheder, infrarøde fjernbetjeninger og scener via SwitchBots cloud med token fra dens app. Status opdateres en gang i minuttet, mens panelet er åbent.</string>
    <string name="core_tools_provider_system_recognizer">Telefonens genkendelsesværktøj</string>
    <string name="core_tools_provider_system_recognizer_desc">Den talegenkendelse, der følger med telefonen, normalt Googles. Ord vises, mens du taler.</string>
    <string name="core_tools_provider_tavily_desc">Websøgning med et kort svar. Kræver din Tavily-nøgle.</string>
    <string name="core_tools_provider_together_desc">FLUX og andre åbne modeller på Togethers servere.</string>
