    <string name="core_tools_provider_transcription_server_desc">En server der taler OpenAIs lydtranskriptions-API: speaches, whisper.cpps server, LocalAI, Groq eller OpenAI. Hvert klip sendes dertil, når du stopper med at tale.</string>
    <string name="core_tools_provider_translate_server">Din oversættelsesserver</string>
    <string name="core_tools_provider_translate_server_desc">En server, der besvarer OpenAI-chatforespørgsler: llama.cpp, Ollama, LM Studio, vLLM eller en gateway.</string>
    <string name="core_tools_provider_translite_desc">En Translite-server: en gratis frontend til Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life- og Tuya Smart-enheder, rum og scener via et gratis Tuya-udviklerprojekt knyttet til din app-konto. Status opdateres, mens panelet er åbent.</string>
    <string name="core_tools_provider_unsplash_desc">Billeder fra Unsplash. Kræver en API-nøgle, medmindre denne build har en.</string>
    <string name="core_tools_provider_vision_ocr">Din visionsmodel</string>
    <string name="core_tools_provider_vision_ocr_desc">En model, der læser billeder via en server, som besvarer OpenAI-chatforespørgsler. Kræver adressen og modelnavnet.</string>
    <string name="core_tools_provider_whisper_desc">OpenAI\'s Whisper-modeller, der kører på telefonen. Mange sprog; download en model på siden Stemmeskrivning.</string>
    <string name="core_tools_provider_whistle_desc">En lille, hurtig model, der kører på telefonen. Download den på siden Stemmeskrivning.</string>
