    <string name="core_tools_dictionary_source_imported_desc">Na tym urządzeniu. Słowniki Yomichan i Yomitan, które importujesz, w dowolnym języku, wraz z odczytami i akcentem tonicznym.</string>
    <string name="core_tools_dictionary_source_offline_bengali">Bengalsko-angielski Wiktionary</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">Na tym urządzeniu, po pobraniu. Słowa bengalskie z ich angielskimi znaczeniami i wymową.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, offline</string>
    <string name="core_tools_dictionary_source_offline_wiktionary_desc">Na tym urządzeniu, po pobraniu. Popularne angielskie słowa z Wiktionary, z wymową.</string>
    <string name="core_tools_dictionary_source_offline_wordnet">Otwórz angielski WordNet</string>
