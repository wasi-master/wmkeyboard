    <string name="core_tools_provider_acrcloud_desc">Usługa rozpoznawania muzyki z dwutygodniowym okresem próbnym, a następnie płatnymi planami. Wymaga hosta, klucza dostępu i sekretu dostępu projektu z console.acrcloud.com. Każdy klip jest wysyłany do ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Darmowe Stable Diffusion na komputerach wolontariuszy. Działa bez klucza, ale wymaga czekania w kolejce; darmowy klucz z aihorde.net przesuwa Cię w niej do przodu.</string>
    <string name="core_tools_provider_anthropic_desc">Modele Claude przez API Anthropic z użyciem własnego klucza.</string>
    <string name="core_tools_provider_asr4all_desc">Dyktowanie w języku angielskim na telefonie, ze słowami pojawiającymi się w trakcie mówienia.</string>
    <string name="core_tools_provider_audd_desc">Rozpoznaje większość wydanej muzyki na podstawie kilku sekund dźwięku. Wymaga tokena z dashboard.audd.io; kilkaset rozpoznań jest darmowych, potem usługa jest płatna. Każdy klip jest wysyłany do AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Niewielka usługa rozpoznawania, darmowa do użytku osobistego z kluczem z audiotag.info, wolniejsza od innych: odpowiada po kilku sekundach. Każdy klip jest wysyłany do AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge lub SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Twój własny interfejs Stable Diffusion, uruchomiony z --api. Podaj jego adres, np. http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Na urządzeniu (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Tłumaczy na telefonie za pomocą silnika Bergamot firmy Mozilla i modeli Firefox Translations. Wolne oprogramowanie, brak usług Google, a Twój tekst pozostaje na telefonie. Każdy kierunek (z francuskiego na angielski, z angielskiego na francuski) to osobne pobranie o rozmiarze od 14 do 37 MB. Wymaga telefonu 64-bitowego z systemem Android 9 lub nowszym.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Modele FLUX od ich twórców. Wymaga klucza z bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Odpowiedzi oparte na wyszukiwarce Brave. Wymaga klucza z planem Answers. Jeśli pozostawisz puste, użyty zostanie klucz Brave Search wpisany dla wyszukiwania internetowego.</string>
    <string name="core_tools_provider_brave_desc">Wyszukiwanie w sieci i obrazów. Wymaga klucza API Brave Search, chyba że ta kompilacja go posiada.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX i Stable Diffusion w Cloudflare, z darmowym codziennym limitem. Wymaga tokena API oraz identyfikatora Twojego konta.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Serwery testu prędkości Cloudflare, najbliższe z ich centrów danych. Nie wymaga konta i informuje kartę, w jakiej sieci jesteś i które miasto odpowiedziało.</string>
    <string name="core_tools_provider_coinbase_desc">Waluty i monety z Coinbase. Brak klucza.</string>
    <string name="core_tools_provider_coingecko_desc">Ceny kryptowalut z CoinGecko. Brak klucza.</string>
    <string name="core_tools_provider_comfyui_desc">Twój własny serwer ComfyUI. Rysuje przy użyciu prostego przepływu pracy text-to-image oraz punktu kontrolnego o wskazanej nazwie lub pierwszego dostępnego.</string>
    <string name="core_tools_provider_commons_desc">Darmowe pliki GIF i zdjęcia z Wikimedia Commons lub z własnego MediaWiki. Brak klucza. Pliki GIF mają głównie charakter edukacyjny.</string>
    <string name="core_tools_provider_currency_api_desc">Otwarte dane dla większości walut i wielu kryptowalut. Bez klucza.</string>
    <string name="core_tools_provider_deepl_desc">Wymaga klucza API DeepL lub adresu serwera proxy, który go dodaje.</string>
    <string name="core_tools_provider_deepseek_desc">Modele DeepSeek przez API DeepSeek, przy użyciu własnego klucza.</string>
    <string name="core_tools_provider_er_api_desc">Dzienne kursy dla większości walut. Brak klucza.</string>
    <string name="core_tools_provider_fal_desc">Szybkie hostowane modele: FLUX, Recraft, Ideogram, Qwen Image i inne. Podaj identyfikator fal modelu; FLUX Schnell, jeśli puste.</string>
    <string name="core_tools_provider_frankfurter_desc">Kursy walut Europejskiego Banku Centralnego dla głównych walut. Wolne oprogramowanie, bez klucza.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modele Gemini przez API Google, z własnym kluczem z AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Obrazy Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modele obrazów Nano Banana od Google. Pusty klucz używa klucza Gemini z narzędzia AI.</string>
    <string name="core_tools_provider_gifcities_desc">Stare pliki GIF z GeoCities z Internet Archive. Brak klucza. Wyniki nie mają oceny treści.</string>
    <string name="core_tools_provider_giphy_desc">GIF-y i naklejki. Zawsze na własnej karcie: GIPHY nie pozwala aplikacjom mieszać swoich wyników z innymi.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Urządzenia w Twoim Google Home, poprzez usługi Play. Jeden dom na raz; wybierasz który na własnym ekranie Google.</string>
    <string name="core_tools_provider_google_translate">Tłumacz Google</string>
    <string name="core_tools_provider_google_translate_desc">Bezpłatny punkt końcowy Google lub Cloud Translation po dodaniu klucza.</string>
    <string name="core_tools_provider_harper_desc">Silnik gramatyczny wbudowany w klawiaturę. Tylko język angielski, nic, co wpisujesz, nie opuszcza telefonu.</string>
    <string name="core_tools_provider_home_assistant_desc">Twój własny serwer Home Assistant. Wszystko na żywo, dzięki Assist.</string>
    <string name="core_tools_provider_hue">Mostek Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Światła, pokoje, sceny i czujniki bezpośrednio z mostka Hue w Twojej sieci Wi-Fi. Nic nie opuszcza domu.</string>
    <string name="core_tools_provider_hugging_face_desc">Modele na własnych serwerach wnioskowania Hugging Face, z darmowym miesięcznym limitem. Wymaga tokena dostępu z uprawnieniem Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIF-y i naklejki. Wymaga klucza API KLIPY, chyba że ta kompilacja go posiada.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatyka, pisownia i styl w ponad 30 językach. Twój tekst jest wysyłany do serwera LanguageTool w celu sprawdzenia: publicznego pod adresem api.languagetool.org, chyba że wprowadzisz własny.</string>
    <string name="core_tools_provider_librespeed_desc">Serwer LibreSpeed: własny lub jeden z serwerów udostępnionych przez wolontariuszy z publicznej listy, wybrany według miasta na ekranie danego wiersza.</string>
    <string name="core_tools_provider_libretranslate_desc">Serwer LibreTranslate: własny lub publiczny. Serwery publiczne zazwyczaj wymagają klucza.</string>
    <string name="core_tools_provider_lingva_desc">Serwer Lingva: darmowy interfejs dla Tłumacza Google.</string>
    <string name="core_tools_provider_lm_studio_desc">Modele udostępniane przez LM Studio na Twoim komputerze. Dodaj jeden dla każdego komputera.</string>
    <string name="core_tools_provider_mlkit">Na urządzeniu</string>
    <string name="core_tools_provider_mlkit_desc">Tłumaczy na telefonie za pomocą ML Kit. Twój tekst pozostaje na telefonie. Każdy język wymaga najpierw pobrania modelu.</string>
    <string name="core_tools_provider_mode_fallback">Jeden po drugim</string>
    <string name="core_tools_provider_mode_fallback_desc">Zapytaj pierwszego dostawcę. Jeśli się nie uda lub nie będzie wyników, zapytaj następnego.</string>
    <string name="core_tools_provider_mode_mix">Mieszane</string>
    <string name="core_tools_provider_mode_mix_desc">Pytaj wszystkich dostawców jednocześnie i mieszaj ich wyniki w jednej siatce.</string>
    <string name="core_tools_provider_mode_pick">Wybierz w panelu</string>
    <string name="core_tools_provider_mode_pick_desc">Panel pokazuje włączonych dostawców. Wybierz jednego z nich, a zapytanie zostanie skierowane tylko do niego.</string>
    <string name="core_tools_provider_mode_tabs">Karty</string>
    <string name="core_tools_provider_mode_tabs_desc">Każdy dostawca ma własną kartę. Stuknij kartę, aby zobaczyć jej wyniki.</string>
    <string name="core_tools_provider_moonshine_desc">Mały, szybki model języka angielskiego, który działa na telefonie.</string>
    <string name="core_tools_provider_mozhi_desc">Serwer Mozhi: darmowy interfejs dla Google, DeepL, DuckDuckGo, Yandex i Reverso. Wybierz silnik. DeepL i Reverso wymagają języka źródłowego.</string>
    <string name="core_tools_provider_music_server">Twój własny serwer rozpoznawania</string>
    <string name="core_tools_provider_music_server_desc">Serwer, który uruchamiasz i który odpowiada jak AudD: klip jest wysyłany jako plik, a utwór wraca jako JSON. Umieść za nim narzędzie do rozpoznawania odcisków palców, takie jak Panako lub Olaf.</string>
    <string name="core_tools_provider_nllb">Na urządzeniu (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Tłumaczy na telefonie za pomocą modelu NLLB-200 firmy Meta na CTranslate2: 200 języków, między dowolną parą, dla par, których inne silniki nie obsługują. Jedno pobranie 630 MB, a zdanie zajmuje kilka sekund. Twój tekst pozostaje na telefonie. Model jest licencjonowany wyłącznie do użytku niekomercyjnego (CC BY-NC 4.0). Wymaga 64-bitowego telefonu z 6 GB pamięci lub więcej.</string>
    <string name="core_tools_provider_none_on">Żaden dostawca nie jest włączony. Włącz jednego w ustawieniach tego narzędzia.</string>
    <string name="core_tools_provider_offline_gifs">Pakiety GIF offline</string>
    <string name="core_tools_provider_offline_gifs_desc">Zaimportowane pakiety GIF. Działają bez połączenia z internetem.</string>
    <string name="core_tools_provider_ollama_desc">Modele na serwerze Ollama, który uruchamiasz na swoim komputerze lub w swojej sieci. Dodaj po jednym dla każdego serwera.</string>
    <string name="core_tools_provider_omnilingual_desc">Jeden model Meta obsługujący 1600 języków, z których setki nie mają innego sposobu wprowadzania głosowego, dostępny w telefonie. Każde wyrażenie kończy się pauzą.</string>
    <string name="core_tools_provider_on_device_ai">Na Twoim urządzeniu</string>
    <string name="core_tools_provider_on_device_ai_desc">Model pobrany na ten telefon. Nic, co napiszesz, nie opuszcza urządzenia. Wybierz i pobierz model na stronie AI.</string>
    <string name="core_tools_provider_on_device_image">Na tym telefonie</string>
    <string name="core_tools_provider_on_device_image_desc">Model pobrany na ten telefon lub zaimportowany przez Ciebie. Nic, co wpiszesz, nie opuszcza urządzenia. Wybierz model na ekranie generatora.</string>
    <string name="core_tools_provider_openai_compatible">Usługa zgodna z OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Każda inna usługa z API czatu OpenAI: OpenRouter, Groq, Mistral, Together lub własna bramka. Podaj adres aż do wersji, np. https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Obrazy kompatybilne z OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Każda inna usługa z API obrazów OpenAI: LocalAI, DeepInfra, Nebius lub własna bramka. Podaj adres aż do wersji, np. https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modele GPT przez API OpenAI, z własnym kluczem.</string>
    <string name="core_tools_provider_openai_image">Obrazy OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">Obraz GPT, który rysuje naklejki na przezroczystym tle. Płatne za obraz. Pusty klucz używa klucza OpenAI z narzędzia AI.</string>
    <string name="core_tools_provider_openhab_desc">Serwer openHAB: jego elementy, na żywo, z pomieszczeniami z modelu semantycznego.</string>
    <string name="core_tools_provider_parakeet_desc">Duży model działający na telefonie, który rozumie 25 języków europejskich.</string>
    <string name="core_tools_provider_pexels_desc">Zdjęcia z serwisu Pexels. Wymagany jest klucz API, chyba że ta wersja kompilacji go zawiera.</string>
    <string name="core_tools_provider_pollinations_desc">Bezpłatnie, bez klucza i bez konta: monit jest wysyłany do Pollinations, który wybiera model. Klucz z enter.pollinations.ai otwiera nowszy interfejs API i pozwala nazwać model.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (nieoficjalny, przez RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Katalog Shazam przez nieoficjalne zestawienie na RapidAPI, wymagający klucza RapidAPI. To nie jest usługa Apple: oferta może ulec zmianie lub zostać wycofana bez powiadomienia. Każdy klip jest wysyłany do RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustracje, ikony i grafika wektorowa. Wymaga klucza z recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Serwer Rens: darmowy interfejs dla Google Lens. Odczytuje dla Ciebie tekst ze zdjęcia w większości skryptów.</string>
    <string name="core_tools_provider_rens_translate_desc">Serwer Rens: darmowy interfejs do Google Lens. Zwraca zdjęcie z przetłumaczonym tekstem.</string>
    <string name="core_tools_provider_replicate_desc">Tysiące hostowanych modeli. Podaj dowolny model zamiany tekstu na obraz w formacie właściciel/nazwa; domyślnie FLUX Schnell, jeśli puste.</string>
    <string name="core_tools_provider_same_kind_fallback">Jako kopie zapasowe</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Dostawcy tego samego rodzaju działają jak jeden. Najpierw odpytywany jest pierwszy z nich, a kolejni tylko w przypadku jego awarii, na przykład gdy skończy się limit użycia klucza.</string>
    <string name="core_tools_provider_same_kind_separate">Osobno</string>
    <string name="core_tools_provider_same_kind_separate_desc">Każdy z nich jest własnym dostawcą: ma własny chip, własny wybór w panelu, własny udział w mieszanej siatce.</string>
    <string name="core_tools_provider_searxng_desc">Instancja SearXNG obsługująca wyniki JSON. Większość publicznych instancji tego nie robi.</string>
    <string name="core_tools_provider_sherpa_desc">Modele strumieniowe dla 13 języków, w tym bengalskiego, które piszą w trakcie mówienia bezpośrednio na telefonie.</string>
    <string name="core_tools_provider_simplytranslate_desc">Serwer SimplyTranslate: darmowy interfejs dla Google i innych wyszukiwarek.</string>
    <string name="core_tools_provider_smartthings_desc">Twoje urządzenia, pomieszczenia i sceny SmartThings przez chmurę Samsunga. Stany odświeżają się, gdy panel jest otwarty.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra i Stable Diffusion 3.5 od twórców Stable Diffusion. Płatne w kredytach; wymaga klucza z platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Twoje pakiety naklejek na tym telefonie.</string>
    <string name="core_tools_provider_switchbot_desc">Twoje urządzenia SwitchBot, piloty na podczerwień i sceny, poprzez chmurę SwitchBot z tokenem z jej aplikacji. Stany odświeżają się raz na minutę, gdy panel jest otwarty.</string>
    <string name="core_tools_provider_system_recognizer">Rozpoznawanie telefonu</string>
    <string name="core_tools_provider_system_recognizer_desc">Rozpoznawanie mowy dostarczone z telefonem, zazwyczaj od Google. Słowa pojawiają się w miarę mówienia.</string>
    <string name="core_tools_provider_tavily_desc">Wyszukiwanie w sieci z krótką odpowiedzią. Wymaga Twojego klucza Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX i inne otwarte modele na serwerach Together.</string>
