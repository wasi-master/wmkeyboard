    <string name="core_tools_provider_transcription_server_desc">Serwer obsługujący API transkrypcji audio OpenAI: speaches, serwer whisper.cpp, LocalAI, Groq lub OpenAI. Każde nagranie jest do niego wysyłane po zakończeniu mówienia.</string>
    <string name="core_tools_provider_translate_server">Twój serwer tłumaczeń</string>
    <string name="core_tools_provider_translate_server_desc">Serwer obsługujący żądania czatu OpenAI: llama.cpp, Ollama, LM Studio, vLLM lub brama.</string>
    <string name="core_tools_provider_translite_desc">Serwer Translite: darmowy interfejs dla Tłumacza Google.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Urządzenia, pokoje i sceny Smart Life oraz Tuya Smart, poprzez darmowy projekt deweloperski Tuya połączony z kontem aplikacji. Stany odświeżają się, gdy panel jest otwarty.</string>
    <string name="core_tools_provider_unsplash_desc">Zdjęcia z Unsplash. Wymaga klucza API, chyba że ta kompilacja go posiada.</string>
    <string name="core_tools_provider_vision_ocr">Twój model wizyjny</string>
    <string name="core_tools_provider_vision_ocr_desc">Model odczytujący obrazy za pośrednictwem serwera odpowiadającego na zapytania czatu OpenAI. Wymaga adresu i nazwy modelu.</string>
    <string name="core_tools_provider_whisper_desc">Modele Whisper od OpenAI działające na telefonie. Wiele języków; pobierz model na stronie Pisanie głosowe.</string>
    <string name="core_tools_provider_whistle_desc">Mały, szybki model działający na telefonie. Pobierz go na stronie pisania głosowego.</string>
    <string name="core_tools_provider_xai_desc">Modele Grok przez API xAI, z własnym kluczem.</string>
