    <string name="core_tools_provider_acrcloud_desc">Dịch vụ nhận dạng âm nhạc với bản dùng thử hai tuần, sau đó là các gói trả phí. Cần máy chủ, khóa truy cập và bí mật truy cập của một dự án từ console.acrcloud.com. Mỗi đoạn clip được gửi đến ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion miễn phí chạy trên máy tính của các tình nguyện viên. Hoạt động mà không cần khóa nhưng phải chờ trong hàng đợi; khóa miễn phí từ aihorde.net sẽ giúp bạn xếp hàng ưu tiên hơn.</string>
    <string name="core_tools_provider_anthropic_desc">Các mô hình Claude thông qua API của Anthropic, với khóa riêng của bạn.</string>
    <string name="core_tools_provider_asr4all_desc">Đọc chính tả tiếng Anh trên điện thoại, với các từ xuất hiện khi bạn nói.</string>
    <string name="core_tools_provider_audd_desc">Nhận dạng hầu hết các bản nhạc đã phát hành chỉ từ vài giây âm thanh. Cần có mã thông báo từ dashboard.audd.io; vài trăm lượt nhận dạng đầu tiên là miễn phí, sau đó sẽ tính phí. Mỗi đoạn clip được gửi đến AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Một dịch vụ nhận dạng nhỏ, miễn phí cho mục đích sử dụng cá nhân với khóa từ audiotag.info và chậm hơn các dịch vụ khác: nó phản hồi sau vài giây. Mỗi đoạn clip được gửi đến AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge hoặc SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Giao diện web Stable Diffusion của riêng bạn, được khởi chạy với --api. Hãy cung cấp địa chỉ của nó, ví dụ: http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Trên thiết bị (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Dịch trên điện thoại bằng công cụ Bergamot của Mozilla và các mô hình Firefox Translations. Phần mềm miễn phí, không có dịch vụ Google và văn bản của bạn vẫn nằm trên điện thoại. Mỗi hướng dịch (Pháp sang Anh, Anh sang Pháp) là một bản tải xuống riêng biệt từ 14 đến 37 MB. Yêu cầu điện thoại 64-bit chạy Android 9 trở lên.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Các mô hình FLUX từ chính những người tạo ra chúng. Cần khóa từ bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Câu trả lời dựa trên tìm kiếm web Brave. Cần một khóa với gói Answers. Nếu để trống, khóa Brave Search bạn đã nhập cho tìm kiếm web sẽ được thử.</string>
    <string name="core_tools_provider_brave_desc">Tìm kiếm web và hình ảnh. Cần có khóa API Brave Search, trừ khi bản dựng này đã có sẵn.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX và Stable Diffusion trên Cloudflare, với hạn mức hàng ngày miễn phí. Cần có mã thông báo API và id tài khoản của bạn.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Máy chủ kiểm tra tốc độ của Cloudflare, gần trung tâm dữ liệu nhất. Không cần tài khoản và cho thẻ biết bạn đang dùng mạng nào và thành phố nào phản hồi.</string>
    <string name="core_tools_provider_coinbase_desc">Các loại tiền tệ và tiền điện tử từ Coinbase. Không cần khóa.</string>
    <string name="core_tools_provider_coingecko_desc">Giá tiền điện tử từ CoinGecko. Không cần khóa.</string>
    <string name="core_tools_provider_comfyui_desc">Máy chủ ComfyUI của riêng bạn. Vẽ bằng quy trình chuyển văn bản thành hình ảnh đơn giản và checkpoint bạn đặt tên, hoặc checkpoint đầu tiên mà nó có.</string>
    <string name="core_tools_provider_commons_desc">Ảnh GIF và ảnh miễn phí từ Wikimedia Commons hoặc từ MediaWiki của riêng bạn. Không cần khóa. Các ảnh GIF chủ yếu mang tính giáo dục.</string>
    <string name="core_tools_provider_currency_api_desc">Dữ liệu mở cho hầu hết các loại tiền tệ và nhiều loại tiền điện tử. Không cần khóa.</string>
    <string name="core_tools_provider_deepl_desc">Cần khóa API DeepL của bạn, hoặc địa chỉ của một proxy có thêm khóa này.</string>
    <string name="core_tools_provider_deepseek_desc">Các mô hình DeepSeek thông qua API của DeepSeek, với khóa của riêng bạn.</string>
    <string name="core_tools_provider_er_api_desc">Tỷ giá hàng ngày cho hầu hết các loại tiền tệ. Không cần khóa.</string>
    <string name="core_tools_provider_fal_desc">Các mô hình lưu trữ nhanh: FLUX, Recraft, Ideogram, Qwen Image và nhiều mô hình khác. Hãy đặt tên fal id của mô hình; để trống nếu là FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Tỷ giá của Ngân hàng Trung ương Châu Âu cho các loại tiền tệ chính. Phần mềm miễn phí, không cần khóa.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Các mô hình Gemini thông qua API của Google, với khóa riêng của bạn từ AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Hình ảnh Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Các mô hình hình ảnh Nano Banana của Google. Khóa trống sử dụng khóa Gemini từ công cụ AI.</string>
    <string name="core_tools_provider_gifcities_desc">Các tệp GIF GeoCities cũ từ Internet Archive. Không cần khóa. Kết quả không có xếp hạng nội dung.</string>
    <string name="core_tools_provider_giphy_desc">GIF và nhãn dán. Luôn nằm trong tab riêng: GIPHY không cho phép các ứng dụng trộn kết quả của nó với các ứng dụng khác.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Các thiết bị trong Google Home của bạn, thông qua dịch vụ Play. Mỗi lần một ngôi nhà; bạn chọn ngôi nhà nào trong màn hình riêng của Google.</string>
    <string name="core_tools_provider_google_translate">Google Dịch</string>
    <string name="core_tools_provider_google_translate_desc">Điểm cuối miễn phí của Google, hoặc Cloud Translation khi bạn thêm khóa.</string>
    <string name="core_tools_provider_harper_desc">Công cụ ngữ pháp được tích hợp sẵn trong bàn phím. Chỉ dành cho tiếng Anh và không có gì bạn nhập rời khỏi điện thoại.</string>
    <string name="core_tools_provider_home_assistant_desc">Máy chủ Home Assistant của riêng bạn. Mọi loại thiết bị, trực tiếp, với Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue bridge</string>
    <string name="core_tools_provider_hue_desc">Đèn, phòng, cảnh và cảm biến trực tiếp từ cầu nối Hue trên Wi-Fi của bạn. Không có gì rời khỏi nhà.</string>
    <string name="core_tools_provider_hugging_face_desc">Các mô hình trên máy chủ suy luận của riêng Hugging Face, với hạn mức miễn phí hàng tháng. Cần có mã thông báo truy cập với quyền Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIF và nhãn dán. Cần có khóa API KLIPY, trừ khi bản dựng này đã có sẵn.</string>
    <string name="core_tools_provider_languagetool_desc">Ngữ pháp, chính tả và phong cách trong hơn 30 ngôn ngữ. Văn bản của bạn được gửi đến máy chủ LanguageTool để kiểm tra: máy chủ công cộng tại api.languagetool.org trừ khi bạn nhập máy chủ của riêng mình.</string>
    <string name="core_tools_provider_librespeed_desc">Máy chủ LibreSpeed: máy chủ do bạn tự chạy hoặc một trong các máy chủ của tình nguyện viên từ danh sách công khai, được chọn theo thành phố trên màn hình riêng của hàng đó.</string>
    <string name="core_tools_provider_libretranslate_desc">Máy chủ LibreTranslate: của riêng bạn hoặc máy chủ công cộng. Các máy chủ công cộng thường cần có khóa.</string>
    <string name="core_tools_provider_lingva_desc">Một máy chủ Lingva: giao diện miễn phí cho Google Dịch.</string>
    <string name="core_tools_provider_lm_studio_desc">Các mô hình được phục vụ bởi LM Studio trên máy tính của bạn. Thêm một mô hình cho mỗi máy tính.</string>
    <string name="core_tools_provider_mlkit">Trên thiết bị</string>
    <string name="core_tools_provider_mlkit_desc">Dịch trên điện thoại bằng ML Kit. Văn bản của bạn vẫn nằm trên điện thoại. Mỗi ngôn ngữ cần tải xuống mô hình trước.</string>
    <string name="core_tools_provider_mode_fallback">Từng cái một</string>
    <string name="core_tools_provider_mode_fallback_desc">Hỏi nhà cung cấp đầu tiên. Nếu thất bại hoặc không có kết quả, hãy hỏi nhà cung cấp tiếp theo.</string>
    <string name="core_tools_provider_mode_mix">Hỗn hợp</string>
    <string name="core_tools_provider_mode_mix_desc">Hỏi tất cả các nhà cung cấp cùng một lúc và trộn kết quả của họ vào một lưới.</string>
    <string name="core_tools_provider_mode_pick">Chọn trong bảng điều khiển</string>
    <string name="core_tools_provider_mode_pick_desc">Bảng điều khiển hiển thị các nhà cung cấp đang bật. Chọn một nhà cung cấp ở đó và chỉ nhà cung cấp đó mới được yêu cầu.</string>
    <string name="core_tools_provider_mode_tabs">Tab</string>
    <string name="core_tools_provider_mode_tabs_desc">Mỗi nhà cung cấp có một thẻ riêng. Nhấn vào một thẻ để xem kết quả của thẻ đó.</string>
    <string name="core_tools_provider_moonshine_desc">Một mô hình tiếng Anh nhỏ, nhanh chạy trên điện thoại.</string>
    <string name="core_tools_provider_mozhi_desc">Máy chủ Mozhi: một giao diện miễn phí cho Google, DeepL, DuckDuckGo, Yandex và Reverso. Chọn công cụ. DeepL và Reverso cần ngôn ngữ nguồn.</string>
    <string name="core_tools_provider_music_server">Máy chủ nhận dạng của riêng bạn</string>
    <string name="core_tools_provider_music_server_desc">Một máy chủ bạn chạy phản hồi giống như AudD: clip được đăng dưới dạng tệp và bài hát được trả về dưới dạng JSON. Đặt một trình nhận dạng dấu vân tay như Panako hoặc Olaf phía sau nó.</string>
    <string name="core_tools_provider_nllb">Trên thiết bị (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Dịch trên điện thoại bằng mô hình NLLB-200 của Meta trên CTranslate2: 200 ngôn ngữ, giữa bất kỳ cặp ngôn ngữ nào, dành cho các cặp mà các công cụ khác không thể thực hiện. Tải xuống một lần 630 MB và một câu mất vài giây để dịch. Văn bản của bạn vẫn nằm trên điện thoại. Mô hình chỉ được cấp phép cho mục đích phi thương mại (CC BY-NC 4.0). Cần điện thoại 64-bit với bộ nhớ 6 GB trở lên.</string>
    <string name="core_tools_provider_none_on">Không có nhà cung cấp nào được bật. Hãy bật một nhà cung cấp trong cài đặt của công cụ này.</string>
    <string name="core_tools_provider_offline_gifs">Gói GIF ngoại tuyến</string>
    <string name="core_tools_provider_offline_gifs_desc">Các gói GIF bạn đã nhập. Chúng hoạt động mà không cần kết nối.</string>
    <string name="core_tools_provider_ollama_desc">Các mô hình trên máy chủ Ollama mà bạn chạy, trên máy tính hoặc mạng của bạn. Thêm một mô hình cho mỗi máy chủ.</string>
    <string name="core_tools_provider_omnilingual_desc">Một mô hình của Meta cho 1.600 ngôn ngữ, hàng trăm ngôn ngữ trong số đó không có tính năng nhập liệu bằng giọng nói nào khác, trên điện thoại. Mỗi cụm từ sẽ đến sau khi tạm dừng.</string>
    <string name="core_tools_provider_on_device_ai">Trên thiết bị của bạn</string>
    <string name="core_tools_provider_on_device_ai_desc">Một mô hình được tải xuống điện thoại này. Không có gì bạn viết rời khỏi thiết bị. Chọn và tải xuống mô hình trên trang AI.</string>
    <string name="core_tools_provider_on_device_image">Trên điện thoại này</string>
    <string name="core_tools_provider_on_device_image_desc">Một mô hình được tải xuống điện thoại này, hoặc một mô hình bạn đã nhập. Không có gì bạn nhập rời khỏi thiết bị. Chọn mô hình trên màn hình của trình tạo.</string>
    <string name="core_tools_provider_openai_compatible">Dịch vụ tương thích với OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Bất kỳ dịch vụ nào khác có API trò chuyện của OpenAI: OpenRouter, Groq, Mistral, Together hoặc cổng kết nối của riêng bạn. Hãy cung cấp địa chỉ cho đến phần phiên bản, ví dụ như https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Hình ảnh tương thích với OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Bất kỳ dịch vụ nào khác có API hình ảnh của OpenAI: LocalAI, DeepInfra, Nebius hoặc cổng kết nối của riêng bạn. Cung cấp địa chỉ đến phiên bản, ví dụ như https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Các mô hình GPT thông qua API của OpenAI, với khóa riêng của bạn.</string>
    <string name="core_tools_provider_openai_image">Hình ảnh OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, vẽ nhãn dán trên nền trong suốt. Trả phí theo từng ảnh. Khóa trống sẽ sử dụng khóa OpenAI từ công cụ AI.</string>
    <string name="core_tools_provider_openhab_desc">Một máy chủ openHAB: các mục của nó, trực tiếp, với các phòng từ mô hình ngữ nghĩa.</string>
    <string name="core_tools_provider_parakeet_desc">Một mô hình lớn chạy trên điện thoại và hiểu 25 ngôn ngữ châu Âu.</string>
    <string name="core_tools_provider_pexels_desc">Ảnh từ Pexels. Cần có khóa API, trừ khi bản dựng này đã có sẵn.</string>
    <string name="core_tools_provider_pollinations_desc">Miễn phí, không cần khóa và không cần tài khoản: lời nhắc được gửi đến Pollinations, đơn vị sẽ chọn mô hình. Một khóa từ enter.pollinations.ai sẽ mở API mới hơn và cho phép bạn đặt tên cho mô hình.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (không chính thức, qua RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Danh mục của Shazam thông qua một danh sách không chính thức trên RapidAPI, với khóa RapidAPI. Không phải là dịch vụ của Apple: danh sách có thể thay đổi hoặc ngừng cung cấp mà không cần thông báo. Mỗi đoạn âm thanh đều được gửi đến RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Hình minh họa, biểu tượng và nghệ thuật phong cách vector. Cần có khóa từ recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Một máy chủ Rens: giao diện người dùng miễn phí cho Google Lens. Nó đọc văn bản trong ảnh cho bạn, bằng hầu hết các loại chữ viết.</string>
    <string name="core_tools_provider_rens_translate_desc">Máy chủ Rens: một giao diện miễn phí cho Google Lens. Nó trả về ảnh với văn bản đã được dịch.</string>
    <string name="core_tools_provider_replicate_desc">Hàng ngàn mô hình được lưu trữ. Đặt tên cho bất kỳ mô hình chuyển đổi văn bản thành hình ảnh nào dưới dạng chủ sở hữu/tên; FLUX Schnell nếu để trống.</string>
    <string name="core_tools_provider_same_kind_fallback">Dưới dạng bản sao lưu</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Các nhà cung cấp cùng loại hoạt động như một. Nhà cung cấp đầu tiên sẽ được hỏi, và nhà cung cấp tiếp theo chỉ được hỏi khi nhà cung cấp trước đó thất bại, ví dụ như khi một khóa hết hạn ngạch.</string>
    <string name="core_tools_provider_same_kind_separate">Riêng biệt</string>
    <string name="core_tools_provider_same_kind_separate_desc">Mỗi cái là một nhà cung cấp riêng: chip riêng, lựa chọn riêng trong bảng, phần chia sẻ riêng trong lưới hỗn hợp.</string>
    <string name="core_tools_provider_searxng_desc">Một phiên bản SearXNG cho phép kết quả JSON. Hầu hết các phiên bản công khai đều không cho phép.</string>
    <string name="core_tools_provider_sherpa_desc">Các mô hình phát trực tuyến cho 13 ngôn ngữ, trong đó có tiếng Bengal, giúp nhập liệu khi bạn nói trên điện thoại.</string>
    <string name="core_tools_provider_simplytranslate_desc">Máy chủ SimplyTranslate: một giao diện miễn phí cho Google và các công cụ tìm kiếm khác.</string>
    <string name="core_tools_provider_smartthings_desc">Các thiết bị, phòng và ngữ cảnh SmartThings của bạn, thông qua đám mây của Samsung. Trạng thái làm mới khi bảng điều khiển đang mở.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra và Stable Diffusion 3.5 từ những người tạo ra Stable Diffusion. Thanh toán bằng tín dụng; cần có khóa từ platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Các gói nhãn dán của bạn trên điện thoại này.</string>
    <string name="core_tools_provider_switchbot_desc">Các thiết bị SwitchBot, điều khiển từ xa hồng ngoại và cảnh của bạn, thông qua đám mây của SwitchBot với mã thông báo từ ứng dụng của nó. Trạng thái làm mới mỗi phút một lần khi bảng điều khiển đang mở.</string>
    <string name="core_tools_provider_system_recognizer">Bộ nhận diện của điện thoại</string>
    <string name="core_tools_provider_system_recognizer_desc">Trình nhận dạng giọng nói đi kèm với điện thoại, thường là của Google. Các từ xuất hiện khi bạn nói.</string>
    <string name="core_tools_provider_tavily_desc">Tìm kiếm web với câu trả lời ngắn gọn. Cần có khóa Tavily của bạn.</string>
    <string name="core_tools_provider_together_desc">FLUX và các mô hình mở khác trên máy chủ của Together.</string>
    <string name="core_tools_provider_tool_ai">AI</string>
    <string name="core_tools_provider_tool_currency_crypto">Giá tiền ảo</string>
    <string name="core_tools_provider_tool_currency_fiat">Tỷ giá tiền tệ</string>
    <string name="core_tools_provider_tool_dictionary">Từ điển</string>
    <string name="core_tools_provider_tool_gif">GIF</string>
    <string name="core_tools_provider_tool_grammar">Kiểm tra ngữ pháp</string>
    <string name="core_tools_provider_tool_image_gen">Trình tạo nhãn dán</string>
    <string name="core_tools_provider_tool_music">Công cụ nhận diện bài hát</string>
    <string name="core_tools_provider_tool_ocr">Đọc văn bản trực tuyến</string>
    <string name="core_tools_provider_tool_photo_translate">Dịch ảnh</string>
    <string name="core_tools_provider_tool_photos">Ảnh nền</string>
    <string name="core_tools_provider_tool_search">Tìm kiếm web và hình ảnh</string>
    <string name="core_tools_provider_tool_smart_home">Nhà thông minh</string>
    <string name="core_tools_provider_tool_speed_test">Máy chủ kiểm tra tốc độ</string>
    <string name="core_tools_provider_tool_sticker">Nhãn dán</string>
    <string name="core_tools_provider_tool_synonyms">Từ đồng nghĩa</string>
    <string name="core_tools_provider_tool_translate">Dịch</string>
    <string name="core_tools_provider_tool_vocab">Từ vựng</string>
    <string name="core_tools_provider_tool_voice">Nhập liệu bằng giọng nói</string>
    <string name="core_tools_provider_transcription_server">Máy chủ phiên âm</string>
    <string name="core_tools_provider_transcription_server_desc">Một máy chủ sử dụng API chuyển đổi âm thanh thành văn bản của OpenAI: speaches, máy chủ của whisper.cpp, LocalAI, Groq hoặc OpenAI. Mỗi đoạn clip sẽ được gửi đến máy chủ này khi bạn ngừng nói.</string>
    <string name="core_tools_provider_translate_server">Máy chủ dịch của bạn</string>
    <string name="core_tools_provider_translate_server_desc">Một máy chủ phản hồi các yêu cầu trò chuyện OpenAI: llama.cpp, Ollama, LM Studio, vLLM hoặc một cổng kết nối.</string>
    <string name="core_tools_provider_translite_desc">Máy chủ Translite: một giao diện miễn phí cho Google Dịch.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Các thiết bị, phòng và ngữ cảnh Smart Life và Tuya Smart, thông qua một dự án nhà phát triển Tuya miễn phí được liên kết với tài khoản ứng dụng của bạn. Trạng thái sẽ làm mới khi bảng điều khiển đang mở.</string>
    <string name="core_tools_provider_unsplash_desc">Ảnh từ Unsplash. Cần có khóa API, trừ khi bản dựng này đã có sẵn.</string>
    <string name="core_tools_provider_vision_ocr">Mô hình thị giác của bạn</string>
    <string name="core_tools_provider_vision_ocr_desc">Một mô hình đọc hình ảnh thông qua máy chủ phản hồi các yêu cầu trò chuyện của OpenAI. Cần có địa chỉ và tên mô hình.</string>
    <string name="core_tools_provider_whisper_desc">Các mô hình Whisper của OpenAI, chạy trên điện thoại. Nhiều ngôn ngữ; tải xuống mô hình trên trang Nhập liệu bằng giọng nói.</string>
    <string name="core_tools_provider_whistle_desc">Một mô hình nhỏ, nhanh chạy trên điện thoại. Tải xuống trên trang Nhập liệu bằng giọng nói.</string>
    <string name="core_tools_provider_xai_desc">Các mô hình Grok thông qua API của xAI, với khóa riêng của bạn.</string>
    <string name="core_tools_provider_xai_image">Grok Imagine</string>
    <string name="core_tools_provider_xai_image_desc">Mô hình hình ảnh của xAI. Khóa trống sẽ sử dụng khóa xAI từ công cụ AI.</string>
    <string name="core_tools_reply_tone_agree">Được thôi</string>
    <string name="core_tools_reply_tone_custom">Tùy chỉnh…</string>
    <string name="core_tools_reply_tone_decline">Nói không</string>
    <string name="core_tools_reply_tone_excited">Hào hứng</string>
    <string name="core_tools_reply_tone_flirty">Tán tỉnh</string>
