    <string name="core_tools_dictionary_source_offline_wordnet">Mở English WordNet</string>
    <string name="core_tools_dictionary_source_offline_wordnet_desc">Trên thiết bị này, sau khi tải xuống. Mọi từ tiếng Anh trong WordNet, kèm theo định nghĩa ngắn gọn.</string>
