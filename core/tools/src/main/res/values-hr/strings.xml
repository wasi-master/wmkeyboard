    <string name="core_tools_provider_acrcloud_desc">Usluga prepoznavanja glazbe s dvotjednim probnim razdobljem, nakon čega slijede plaćeni planovi. Potreban je host, pristupni ključ i pristupna tajna projekta s console.acrcloud.com. Svaki isječak se šalje na ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Besplatni Stable Diffusion na računalima volontera. Radi bez ključa, ali čeka u redu; besplatni ključ s aihorde.net pomiče vas naprijed u redu.</string>
    <string name="core_tools_provider_anthropic_desc">Claude modeli putem Anthropicovog API-ja, s vašim vlastitim ključem.</string>
    <string name="core_tools_provider_asr4all_desc">Diktiranje na engleskom na telefonu, s riječima koje se pojavljuju dok govorite.</string>
    <string name="core_tools_provider_audd_desc">Prepoznaje većinu objavljene glazbe iz nekoliko sekundi zvuka. Potreban je token s dashboard.audd.io; nekoliko stotina prepoznavanja je besplatno, nakon toga se plaća. Svaki isječak se šalje na AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Mala usluga prepoznavanja, besplatna za osobnu upotrebu s ključem s audiotag.info, i sporija od ostalih: odgovara nakon nekoliko sekundi. Svaki isječak se šalje na AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge ili SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Vaše vlastito Stable Diffusion web sučelje, pokrenuto s --api. Navedite njegovu adresu, kao što je http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Na uređaju (Firefox prijevodi)</string>
    <string name="core_tools_provider_bergamot_desc">Prevodi na telefonu pomoću Mozillinog Bergamot mehanizma i Firefoxovih modela za prevođenje. Besplatan softver, bez Google usluga, a vaš tekst ostaje na telefonu. Svaki smjer (francuski na engleski, engleski na francuski) je zasebno preuzimanje od 14 do 37 MB. Potreban je 64-bitni telefon s Androidom 9 ili novijim.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX modeli od autora koji su ih stvorili. Potreban je ključ s bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave pretraživanje</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Odgovori utemeljeni na Brave web pretraživanju. Potreban je ključ s planom Answers. Ako ostavite prazno, pokušat će se koristiti Brave Search ključ koji ste upisali za web pretraživanje.</string>
    <string name="core_tools_provider_brave_desc">Pretraživanje weba i slika. Potreban je Brave Search API ključ, osim ako ga ova verzija već ima.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX i Stable Diffusion na Cloudflareu, uz besplatnu dnevnu kvotu. Potreban je API token i vaš korisnički ID.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflareovi poslužitelji za testiranje brzine, najbliži njegovi podatkovni centri. Ne zahtijeva korisnički račun i kartici govori na kojoj se mreži nalazite i koji je grad odgovorio.</string>
    <string name="core_tools_provider_coinbase_desc">Valute i kovanice s Coinbasea. Nema ključa.</string>
    <string name="core_tools_provider_coingecko_desc">Cijene kovanica s CoinGecka. Nije potreban ključ.</string>
    <string name="core_tools_provider_comfyui_desc">Vaš vlastiti ComfyUI poslužitelj. Crta koristeći običan tijek rada od teksta do slike i kontrolnu točku koju navedete ili prvu koju posjeduje.</string>
    <string name="core_tools_provider_commons_desc">Besplatni GIF-ovi i fotografije s Wikimedia Commonsa ili s vašeg vlastitog MediaWikija. Nema ključa. GIF-ovi su uglavnom edukativni.</string>
    <string name="core_tools_provider_currency_api_desc">Otvoreni podaci za većinu valuta i mnoge kriptovalute. Nije potreban ključ.</string>
    <string name="core_tools_provider_deepl_desc">Potreban je vaš DeepL API ključ ili adresa proxyja koji ga dodaje.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek modeli putem DeepSeek API-ja, s vašim vlastitim ključem.</string>
    <string name="core_tools_provider_er_api_desc">Dnevni tečajevi za većinu valuta. Bez ključa.</string>
    <string name="core_tools_provider_fal_desc">Brzi hostani modeli: FLUX, Recraft, Ideogram, Qwen Image i još mnogo toga. Navedite fal ID modela; FLUX Schnell ako ostane prazno.</string>
    <string name="core_tools_provider_frankfurter_desc">Tečajevi Europske središnje banke za glavne valute. Besplatan softver, bez ključa.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini modeli putem Googleovog API-ja, s vašim vlastitim ključem iz AI Studija.</string>
    <string name="core_tools_provider_gemini_image">Gemini slike</string>
    <string name="core_tools_provider_gemini_image_desc">Googleovi Nano Banana modeli slika. Prazan ključ koristi Gemini ključ iz AI alata.</string>
    <string name="core_tools_provider_gifcities_desc">Stari GeoCities GIF-ovi iz Internet Archivea. Nema ključa. Rezultati nemaju ocjenu sadržaja.</string>
    <string name="core_tools_provider_giphy_desc">GIF-ovi i naljepnice. Uvijek u vlastitoj kartici: GIPHY ne dopušta aplikacijama miješanje rezultata s drugima.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Uređaji u vašem Google Homeu, putem Play usluga. Jedan dom odjednom; vi birate koji na Googleovom vlastitom zaslonu.</string>
    <string name="core_tools_provider_google_translate">Google prevoditelj</string>
    <string name="core_tools_provider_google_translate_desc">Googleova besplatna krajnja točka ili Cloud Translation kada dodate ključ.</string>
    <string name="core_tools_provider_harper_desc">Gramatički mehanizam ugrađen u tipkovnicu. Samo engleski jezik, i ništa što upišete ne napušta telefon.</string>
    <string name="core_tools_provider_home_assistant_desc">Vaš vlastiti Home Assistant poslužitelj. Svaka vrsta stvari, uživo, uz Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue most</string>
    <string name="core_tools_provider_hue_desc">Svjetla, sobe, scene i senzori izravno s Hue mosta na vašem Wi-Fi-ju. Ništa ne napušta kuću.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeli na vlastitim Hugging Face poslužiteljima za zaključivanje, uz besplatnu mjesečnu kvotu. Potreban je pristupni token s dozvolom Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIF-ovi i naljepnice. Potreban je KLIPY API ključ, osim ako ga ova verzija ima.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatika, pravopis i stil na više od 30 jezika. Vaš se tekst šalje na LanguageTool poslužitelj radi provjere: javni na api.languagetool.org osim ako ne unesete vlastiti.</string>
    <string name="core_tools_provider_librespeed_desc">LibreSpeed poslužitelj: onaj koji sami pokrećete ili jedan od poslužitelja volontera s javnog popisa, odabran prema gradu na zaslonu retka.</string>
    <string name="core_tools_provider_libretranslate_desc">LibreTranslate poslužitelj: vaš vlastiti ili javni. Javni poslužitelji obično trebaju ključ.</string>
    <string name="core_tools_provider_lingva_desc">Lingva poslužitelj: besplatno sučelje za Google prevoditelj.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeli koje poslužuje LM Studio na vašem računalu. Dodajte jedan za svako računalo.</string>
    <string name="core_tools_provider_mlkit">Na uređaju</string>
    <string name="core_tools_provider_mlkit_desc">Prevodi na telefonu pomoću ML Kit-a. Vaš tekst ostaje na telefonu. Za svaki jezik prvo je potrebno preuzeti model.</string>
    <string name="core_tools_provider_mode_fallback">Jedan po jedan</string>
    <string name="core_tools_provider_mode_fallback_desc">Pitaj prvog pružatelja. Ako ne uspije ili nema rezultata, pitaj sljedećeg.</string>
    <string name="core_tools_provider_mode_mix">Mješovito</string>
    <string name="core_tools_provider_mode_mix_desc">Pitajte sve pružatelje usluga u isto vrijeme i pomiješajte njihove rezultate u jednoj mreži.</string>
    <string name="core_tools_provider_mode_pick">Odaberite na ploči</string>
    <string name="core_tools_provider_mode_pick_desc">Ploča prikazuje uključene pružatelje usluga. Odaberite jednog i samo će se njemu slati upiti.</string>
    <string name="core_tools_provider_mode_tabs">Kartice</string>
    <string name="core_tools_provider_mode_tabs_desc">Svaki pružatelj usluga dobiva vlastitu karticu. Dodirnite karticu da biste vidjeli njezine rezultate.</string>
    <string name="core_tools_provider_moonshine_desc">Mali, brzi engleski model koji radi na telefonu.</string>
    <string name="core_tools_provider_mozhi_desc">Mozhi poslužitelj: besplatno sučelje za Google, DeepL, DuckDuckGo, Yandex i Reverso. Odaberite mehanizam. DeepL i Reverso trebaju izvorni jezik.</string>
    <string name="core_tools_provider_music_server">Vaš vlastiti poslužitelj za prepoznavanje</string>
    <string name="core_tools_provider_music_server_desc">Poslužitelj koji pokrećete, a koji odgovara poput AudD-a: isječak se šalje kao datoteka, a pjesma se vraća kao JSON. Postavite prepoznavatelj kao što je Panako ili Olaf iza njega.</string>
    <string name="core_tools_provider_nllb">Na uređaju (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Prevodi na telefonu pomoću Metinog modela NLLB-200 na CTranslate2: 200 jezika, između bilo koja dva od njih, za parove koje drugi mehanizmi ne mogu obraditi. Jedno preuzimanje od 630 MB, a rečenica traje nekoliko sekundi. Vaš tekst ostaje na telefonu. Model je licenciran samo za nekomercijalnu upotrebu (CC BY-NC 4.0). Potreban je 64-bitni telefon sa 6 GB memorije ili više.</string>
    <string name="core_tools_provider_none_on">Nijedan pružatelj usluga nije uključen. Uključite jednog u postavkama ovog alata.</string>
    <string name="core_tools_provider_offline_gifs">Izvanmrežni GIF paketi</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF paketi koje ste uvezli. Rade bez internetske veze.</string>
    <string name="core_tools_provider_ollama_desc">Modeli na Ollama poslužitelju koji pokrećete na svom računalu ili mreži. Dodajte jedan za svaki poslužitelj.</string>
    <string name="core_tools_provider_omnilingual_desc">Metin jedan model za 1600 jezika, od kojih stotine nemaju drugo glasovno tipkanje, na telefonu. Svaka fraza stiže na pauzu nakon nje.</string>
    <string name="core_tools_provider_on_device_ai">Na vašem uređaju</string>
    <string name="core_tools_provider_on_device_ai_desc">Model preuzet na ovaj telefon. Ništa što napišete ne napušta uređaj. Odaberite i preuzmite model na AI stranici.</string>
    <string name="core_tools_provider_on_device_image">Na ovom telefonu</string>
    <string name="core_tools_provider_on_device_image_desc">Model preuzet na ovaj telefon ili onaj koji ste uvezli. Ništa što napišete ne izlazi iz njega. Odaberite model na zaslonu generatora.</string>
    <string name="core_tools_provider_openai_compatible">Usluga kompatibilna s OpenAI-om</string>
    <string name="core_tools_provider_openai_compatible_desc">Bilo koja druga usluga s OpenAI chat API-jem: OpenRouter, Groq, Mistral, Together ili vlastiti pristupnik. Navedite adresu do verzije, kao što je https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Slike kompatibilne s OpenAI-om</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Bilo koja druga usluga s OpenAI-jevim API-jem za slike: LocalAI, DeepInfra, Nebius ili vaš vlastiti pristupnik. Unesite adresu do verzije, na primjer https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT modeli putem OpenAI API-ja, s vašim vlastitim ključem.</string>
    <string name="core_tools_provider_openai_image">OpenAI slike</string>
    <string name="core_tools_provider_openai_image_desc">GPT slika koja crta naljepnice na prozirnoj pozadini. Naplaćuje se po slici. Prazan ključ koristi OpenAI ključ iz AI alata.</string>
    <string name="core_tools_provider_openhab_desc">openHAB poslužitelj: njegove stavke, uživo, sa sobama iz semantičkog modela.</string>
    <string name="core_tools_provider_parakeet_desc">Veliki model koji radi na telefonu i razumije 25 europskih jezika.</string>
    <string name="core_tools_provider_pexels_desc">Fotografije s Pexelsa. Potreban je API ključ, osim ako ga ova verzija već ima.</string>
    <string name="core_tools_provider_pollinations_desc">Besplatno, bez ključa i bez računa: upit se šalje Pollinationsu, koji bira model. Ključ s enter.pollinations.ai otvara noviji API i omogućuje vam imenovanje modela.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neslužbeno, putem RapidAPI-ja)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazamov katalog putem neslužbenog popisa na RapidAPI-ju, s RapidAPI ključem. Nije Appleova usluga: popis se može promijeniti ili prestati raditi bez prethodne najave. Svaki isječak se šalje na RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustracije, ikone i umjetnost vektorskog stila. Potreban je ključ s recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Rens poslužitelj: besplatno sučelje za Google Lens. Čita tekst na fotografiji umjesto vas, u većini pisama.</string>
    <string name="core_tools_provider_rens_translate_desc">Rens poslužitelj: besplatno sučelje za Google Lens. Vraća fotografiju s prevedenim tekstom.</string>
    <string name="core_tools_provider_replicate_desc">Tisuće hostanih modela. Navedite bilo koji model za pretvorbu teksta u sliku kao vlasnik/ime; FLUX Schnell ako je prazno.</string>
    <string name="core_tools_provider_same_kind_fallback">Kao sigurnosne kopije</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Pružatelji iste vrste djeluju kao jedan. Prvi se pita, a sljedeći samo kada prvi ne uspije, na primjer kada ključu ponestane kvote.</string>
    <string name="core_tools_provider_same_kind_separate">Odvojeno</string>
    <string name="core_tools_provider_same_kind_separate_desc">Svaki je vlastiti pružatelj usluge: vlastiti čip, vlastiti odabir na ploči, vlastiti udio u mješovitoj mreži.</string>
    <string name="core_tools_provider_searxng_desc">SearXNG instanca koja omogućuje JSON rezultate. Većina javnih instanci to ne čini.</string>
    <string name="core_tools_provider_sherpa_desc">Streaming modeli za 13 jezika, među kojima i bengalski, koji tipkaju dok govorite, na telefonu.</string>
    <string name="core_tools_provider_simplytranslate_desc">SimplyTranslate poslužitelj: besplatno sučelje za Google i druge tražilice.</string>
    <string name="core_tools_provider_smartthings_desc">Vaši SmartThings uređaji, sobe i scene putem Samsungovog oblaka. Stanja se osvježavaju dok je ploča otvorena.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra i Stable Diffusion 3.5 od tvoraca modela Stable Diffusion. Plaćanje kreditima; potreban je ključ s platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Vaši paketi naljepnica na ovom telefonu.</string>
    <string name="core_tools_provider_switchbot_desc">Vaši SwitchBot uređaji, infracrveni daljinski upravljači i scene, putem SwitchBot oblaka s tokenom iz njegove aplikacije. Stanja se osvježavaju jednom u minuti dok je ploča otvorena.</string>
    <string name="core_tools_provider_system_recognizer">Prepoznavanje telefona</string>
    <string name="core_tools_provider_system_recognizer_desc">Prepoznavatelj govora koji dolazi s telefonom, obično Googleov. Riječi se pojavljuju dok govorite.</string>
    <string name="core_tools_provider_tavily_desc">Web pretraživanje s kratkim odgovorom. Potreban je vaš Tavily ključ.</string>
    <string name="core_tools_provider_together_desc">FLUX i drugi otvoreni modeli na poslužiteljima Together.</string>
