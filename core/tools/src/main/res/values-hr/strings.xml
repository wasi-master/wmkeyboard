    <string name="core_tools_provider_transcription_server">Poslužitelj za transkripciju</string>
    <string name="core_tools_provider_transcription_server_desc">Poslužitelj koji govori OpenAI-jev API za transkripciju zvuka: speaches, whisper.cpp poslužitelj, LocalAI, Groq ili OpenAI. Svaki isječak mu se šalje kada prestanete govoriti.</string>
    <string name="core_tools_provider_translate_server">Vaš poslužitelj za prijevode</string>
    <string name="core_tools_provider_translate_server_desc">Poslužitelj koji odgovara na OpenAI chat zahtjeve: llama.cpp, Ollama, LM Studio, vLLM ili pristupnik.</string>
    <string name="core_tools_provider_translite_desc">Translite poslužitelj: besplatno sučelje za Google Prevoditelj.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life i Tuya Smart uređaji, sobe i scene, putem besplatnog Tuya razvojnog projekta povezanog s vašim računom aplikacije. Stanja se osvježavaju dok je ploča otvorena.</string>
    <string name="core_tools_provider_unsplash_desc">Fotografije s Unsplasha. Potreban je API ključ, osim ako ga ova verzija već ima.</string>
    <string name="core_tools_provider_vision_ocr">Vaš vizualni model</string>
    <string name="core_tools_provider_vision_ocr_desc">Model koji čita slike putem poslužitelja koji odgovara na OpenAI chat zahtjeve. Potrebna je adresa i naziv modela.</string>
    <string name="core_tools_provider_whisper_desc">OpenAI-jevi Whisper modeli, pokrenuti na telefonu. Mnogi jezici; preuzmite model na stranici Glasovno tipkanje.</string>
    <string name="core_tools_provider_whistle_desc">Mali, brzi model koji se pokreće na telefonu. Preuzmite ga na stranici Glasovno tipkanje.</string>
    <string name="core_tools_provider_xai_desc">Grok modeli putem xAI API-ja, s vašim vlastitim ključem.</string>
