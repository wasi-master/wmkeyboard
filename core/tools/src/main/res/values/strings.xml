<?xml version="1.0" encoding="utf-8"?>
<!--
  Text the tool clients, the shortcut engine and the tool panels show.

  Referenced from other modules as
  com.wasimaster.wmkeyboard.tools.R.string.core_tools_ai_phase_preparing — the R
  classes are non-transitive, so the import has to name this module.

  Data stays in the Kotlin sources and never comes here: currency codes and
  currency names, language codes and language names, weather API field names,
  HTTP headers, endpoint URLs, unit symbols and the English typing-practice
  words and sentences.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ================================================================== -->
