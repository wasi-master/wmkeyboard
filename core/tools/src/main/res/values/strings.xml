    <!-- ================================================================== -->
    <!-- Physical keyboard: the tool picker and its cheat sheet.            -->
    <!-- ================================================================== -->

    <!--
      What arms the tool picker. %1$s is the name printed on the modifier key,
      such as Ctrl, Alt or Shift. Key names are not translated.
    -->
    <string name="core_tools_shortcut_leader_double_tap">Press <xliff:g id="modifier_key" example="Ctrl">%1$s</xliff:g> two times</string>
    <!-- Opens the toolbox, which lists every tool. -->
    <string name="core_tools_shortcut_cheat_all_tools">All tools</string>
    <string name="core_tools_shortcut_cheat_select_suggestion">Select a suggestion</string>
    <string name="core_tools_shortcut_cheat_language_switch">Change the language</string>
    <!--
      Hold Shift with a key to reach the second tier: the symbol and emoji rows,
      or the tools in the toolbox that have no letter of their own.
    -->
    <string name="core_tools_shortcut_cheat_second_tier">Hold Shift for the row and toolbox keys</string>
    <!-- Shows the cheat sheet the user is looking at. -->
    <string name="core_tools_shortcut_cheat_this_list">This list</string>

    <!-- ================================================================== -->
    <!-- Typing test: the settings one run used, on the results screen.     -->
    <!-- ================================================================== -->

    <!-- %1$d is the length of the run in seconds. -->
    <string name="core_tools_typing_config_seconds"><xliff:g id="seconds" example="30">%1$d</xliff:g>s</string>
    <!-- The run types one quotation, however long it is. -->
    <string name="core_tools_typing_config_quote">Quote</string>
    <!-- %1$d is how many words the run asks for. -->
    <plurals name="core_tools_typing_config_words">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>

    <!-- ================================================================== -->
    <!-- Calculator: what the display says in place of an answer.           -->
    <!-- ================================================================== -->

    <!-- %1$s is the part of the expression the calculator cannot read. -->
    <string name="core_tools_calc_error_unexpected">Unexpected “<xliff:g id="text">%1$s</xliff:g>”</string>
    <string name="core_tools_calc_error_undefined_result">Undefined result</string>
    <string name="core_tools_calc_error_too_large">The result is too large</string>
    <string name="core_tools_calc_error_division_by_zero">Division by zero</string>
    <string name="core_tools_calc_error_incomplete">The expression is incomplete</string>
    <!-- A bracket was opened and never closed. -->
    <string name="core_tools_calc_error_missing_bracket">Missing “)”</string>
    <!-- %1$s is the text the calculator tried to read as a number. -->
    <string name="core_tools_calc_error_bad_number">Bad number “<xliff:g id="text">%1$s</xliff:g>”</string>
    <!-- %1$s is the name the user typed, such as "sni". -->
    <string name="core_tools_calc_error_unknown_function">Unknown function “<xliff:g id="name" example="sin">%1$s</xliff:g>”</string>
    <!-- %1$s is a function name. The function has no value for that input. -->
    <string name="core_tools_calc_error_function_undefined"><xliff:g id="name" example="sqrt">%1$s</xliff:g> is undefined there</string>
    <!-- nPr and nCr count picks out of a set, as in "5p3". -->
    <string name="core_tools_calc_error_bad_counts">nPr and nCr need whole numbers, and r cannot be more than n</string>

    <!-- ================================================================== -->
    <!-- Network tools: what a failed request tells the user.               -->
    <!-- The plain connection failures reuse the :core:common messages.     -->
    <!-- ================================================================== -->

    <string name="core_tools_error_server_unreachable">The app cannot reach the server. Check your network and try again.</string>
    <!-- %1$d is the HTTP status code, kept so a report can name it. -->
    <string name="core_tools_error_http_bad_request">Bad request (HTTP <xliff:g id="status" example="400">%1$d</xliff:g>). Check the setup of the API key.</string>
    <!-- %1$d is the HTTP status code. -->
    <string name="core_tools_error_http_key_rejected">The API key was rejected (HTTP <xliff:g id="status" example="403">%1$d</xliff:g>)</string>
    <!-- %1$d is the HTTP status code. The user must wait before trying again. -->
    <string name="core_tools_error_http_rate_limit">The rate limit or the daily quota is used up (HTTP <xliff:g id="status" example="429">%1$d</xliff:g>)</string>
    <!-- %1$d is the HTTP status code. -->
    <string name="core_tools_error_http_failed">The request failed (HTTP <xliff:g id="status" example="500">%1$d</xliff:g>)</string>
    <string name="core_tools_error_file_too_large">The file is larger than the maximum size</string>

    <!-- ================================================================== -->
    <!-- Calendar tool: events read from the device calendar.               -->
    <!-- ================================================================== -->

    <!-- Stands in for an event the calendar stores with no title. -->
    <string name="core_tools_calendar_event_no_title">(No title)</string>

    <!-- Vocabulary packs: download failures and the list "Add to my list" fills. -->
    <string name="core_tools_vocab_error_http">The server answered <xliff:g id="status" example="404">%1$s</xliff:g></string>
    <string name="core_tools_vocab_error_empty">The pack has no words</string>
    <string name="core_tools_vocab_error_not_a_pack">Not a vocabulary pack</string>
    <string name="core_tools_vocab_error_too_large">The pack is too large</string>
    <string name="core_tools_vocab_error_save">Could not save the pack</string>
    <string name="core_tools_vocab_my_words">My words</string>

