    <string name="core_tools_provider_acrcloud_desc">Musiikintunnistuspalvelu, jossa on kahden viikon kokeilujakso, jonka jälkeen maksulliset tilaukset. Vaatii projektin isäntänimen, pääsyavaimen ja pääsysalaisuuden osoitteesta console.acrcloud.com. Jokainen leike lähetetään ACRCloudille.</string>
    <string name="core_tools_provider_ai_horde_desc">Ilmainen Stable Diffusion vapaaehtoisten tietokoneilla. Toimii ilman avainta, mutta jonottaa; ilmainen avain osoitteesta aihorde.net siirtää sinua jonossa eteenpäin.</string>
    <string name="core_tools_provider_anthropic_desc">Claude-mallit Anthropicin API:n kautta omalla avaimellasi.</string>
    <string name="core_tools_provider_asr4all_desc">Englanninkielinen sanelu puhelimella, sanat ilmestyvät puhuessasi.</string>
    <string name="core_tools_provider_audd_desc">Tunnistaa useimmat julkaistut kappaleet muutaman sekunnin ääninäytteestä. Vaatii tunnisteen osoitteesta dashboard.audd.io; muutama sata tunnistusta on ilmaisia, sen jälkeen se on maksullista. Jokainen leike lähetetään AudD:lle.</string>
    <string name="core_tools_provider_audiotag_desc">Pieni tunnistuspalvelu, ilmainen henkilökohtaiseen käyttöön audiotag.info-avaimella, ja hitaampi kuin muut: se vastaa muutaman sekunnin kuluttua. Jokainen leike lähetetään AudioTagille.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge tai SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Oma Stable Diffusion -verkkokäyttöliittymäsi, joka on käynnistetty --api-valinnalla. Anna sen osoite, kuten http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Laitteessa (Firefox-käännökset)</string>
    <string name="core_tools_provider_bergamot_desc">Kääntää puhelimessa Mozillan Bergamot-moottorilla ja Firefox Translations -malleilla. Vapaa ohjelmisto, ei Googlen palveluita, ja tekstisi pysyy puhelimessa. Jokainen suunta (ranskasta englanniksi, englannista ranskaksi) on oma 14–37 megatavun latauksensa. Vaatii 64-bittisen puhelimen, jossa on Android 9 tai uudempi.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX-mallit niiden kehittäjiltä. Vaatii avaimen bfl.ai-palvelusta.</string>
    <string name="core_tools_provider_brave">Brave-haku</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Vastaukset perustuvat Brave-verkkohakuun. Vaatii avaimen, jossa on Answers-paketti. Jos jätetään tyhjäksi, kokeillaan verkkohakuun syöttämääsi Brave Search -avainta.</string>
    <string name="core_tools_provider_brave_desc">Verkko- ja kuvahaku. Vaatii Brave Search API -avaimen, ellei tässä koontiversiossa ole sellaista.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX ja Stable Diffusion Cloudflaressa, ilmaisella päivittäisellä kiintiöllä. Vaatii API-tunnisteen ja tilisi tunnuksen.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflaren nopeustestipalvelimet, lähin heidän palvelinkeskuksistaan. Ei vaadi tiliä, ja ilmoittaa kortille, missä verkossa olet ja mikä kaupunki vastasi.</string>
    <string name="core_tools_provider_coinbase_desc">Valuutat ja kolikot Coinbasesta. Ei avainta.</string>
    <string name="core_tools_provider_coingecko_desc">Kolikoiden hinnat CoinGeckosta. Ei avainta.</string>
    <string name="core_tools_provider_comfyui_desc">Oma ComfyUI-palvelimesi. Piirtää tavallisella tekstistä kuvaksi -työnkululla ja nimeämälläsi tarkistuspisteellä tai ensimmäisellä saatavilla olevalla.</string>
    <string name="core_tools_provider_commons_desc">Ilmaisia GIF-kuvia ja valokuvia Wikimedia Commonsista tai omasta MediaWikistäsi. Ei avainta. GIF-kuvat ovat pääosin opettavaisia.</string>
    <string name="core_tools_provider_currency_api_desc">Avoimet tiedot useimmille valuutoille ja monille kolikoille. Ei avainta.</string>
    <string name="core_tools_provider_deepl_desc">Tarvitsee DeepL API-avaimesi tai välityspalvelimen osoitteen, joka lisää sellaisen.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-mallit DeepSeekin API:n kautta omalla avaimellasi.</string>
    <string name="core_tools_provider_er_api_desc">Päivittäiset valuuttakurssit useimmille valuutoille. Ei avainta.</string>
    <string name="core_tools_provider_fal_desc">Nopeat isännöidyt mallit: FLUX, Recraft, Ideogram, Qwen Image ja muut. Nimeä mallin fal-tunnus; FLUX Schnell, jos tyhjä.</string>
    <string name="core_tools_provider_frankfurter_desc">Euroopan keskuspankin valuuttakurssit. Vapaa ohjelmisto, ei avainta.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-mallit Googlen API:n kautta omalla AI Studion avaimellasi.</string>
    <string name="core_tools_provider_gemini_image">Gemini-kuvat</string>
    <string name="core_tools_provider_gemini_image_desc">Googlen Nano Banana -kuvamallit. Tyhjä avain käyttää tekoälytyökalun Gemini-avainta.</string>
    <string name="core_tools_provider_gifcities_desc">Vanhoja GeoCities-GIF-kuvia Internet Archivesta. Ei avainta. Tuloksilla ei ole sisältöluokitusta.</string>
    <string name="core_tools_provider_giphy_desc">GIF-kuvat ja tarrat. Aina omassa välilehdessään: GIPHY ei salli sovellusten sekoittaa tuloksiaan muiden kanssa.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Google Home -laitteesi Play-palveluiden kautta. Yksi koti kerrallaan; valitset kumman Googlen omassa näytössä.</string>
    <string name="core_tools_provider_google_translate">Google Kääntäjä</string>
    <string name="core_tools_provider_google_translate_desc">Googlen ilmainen päätepiste tai Cloud Translation, kun lisäät avaimen.</string>
    <string name="core_tools_provider_harper_desc">Näppäimistöön sisäänrakennettu kieliopin tarkistusmoottori. Vain englanti, eikä mikään kirjoittamasi poistu puhelimesta.</string>
    <string name="core_tools_provider_home_assistant_desc">Oma Home Assistant -palvelimesi. Kaikenlaista, livenä, Assistin avulla.</string>
    <string name="core_tools_provider_hue">Philips Hue -silta</string>
    <string name="core_tools_provider_hue_desc">Valot, huoneet, kohtaukset ja sensorit suoraan Wi-Fi-verkossasi olevasta Hue-sillasta. Mikään ei poistu talosta.</string>
    <string name="core_tools_provider_hugging_face_desc">Mallit Hugging Facen omilla päättelypalvelimilla, ilmaisella kuukausittaisella kiintiöllä. Vaatii pääsytunnisteen, jolla on Inference Providers -oikeus.</string>
    <string name="core_tools_provider_klipy_desc">GIF-kuvat ja tarrat. Vaatii KLIPY API-avaimen, ellei tässä koontiversiossa ole sellaista.</string>
    <string name="core_tools_provider_languagetool_desc">Kielioppi, oikeinkirjoitus ja tyyli yli 30 kielellä. Tekstisi lähetetään LanguageTool-palvelimelle tarkistettavaksi: julkinen palvelin api.languagetool.org, ellet syötä omaasi.</string>
    <string name="core_tools_provider_librespeed_desc">LibreSpeed-palvelin: joko itse ylläpitämäsi tai jokin vapaaehtoisten palvelimista julkiselta listalta, valittuna kaupungin mukaan rivin omassa näkymässä.</string>
    <string name="core_tools_provider_libretranslate_desc">LibreTranslate-palvelin: oma tai julkinen. Julkiset palvelimet vaativat yleensä avaimen.</string>
    <string name="core_tools_provider_lingva_desc">Lingva-palvelin: ilmainen käyttöliittymä Google Kääntäjälle.</string>
    <string name="core_tools_provider_lm_studio_desc">Tietokoneellasi LM Studion tarjoamat mallit. Lisää yksi kullekin tietokoneelle.</string>
    <string name="core_tools_provider_mlkit">Laitteessa</string>
    <string name="core_tools_provider_mlkit_desc">Kääntää puhelimessa ML Kitin avulla. Tekstisi pysyy puhelimessa. Jokainen kieli vaatii mallin lataamisen ensin.</string>
    <string name="core_tools_provider_mode_fallback">Yksi kerrallaan</string>
    <string name="core_tools_provider_mode_fallback_desc">Kysy ensimmäiseltä palveluntarjoajalta. Jos se epäonnistuu tai tuloksia ei löydy, kysy seuraavalta.</string>
    <string name="core_tools_provider_mode_mix">Sekoitettu</string>
    <string name="core_tools_provider_mode_mix_desc">Kysy kaikilta palveluntarjoajilta samanaikaisesti ja yhdistä tulokset yhteen ruudukkoon.</string>
    <string name="core_tools_provider_mode_pick">Valitse paneelista</string>
    <string name="core_tools_provider_mode_pick_desc">Paneeli näyttää käytössä olevat palveluntarjoajat. Valitse yksi, niin vain sitä käytetään.</string>
    <string name="core_tools_provider_mode_tabs">Välilehdet</string>
    <string name="core_tools_provider_mode_tabs_desc">Jokainen palveluntarjoaja saa oman välilehden. Napauta välilehteä nähdäksesi sen tulokset.</string>
    <string name="core_tools_provider_moonshine_desc">Pieni ja nopea englanninkielinen malli, joka toimii puhelimessa.</string>
    <string name="core_tools_provider_mozhi_desc">Mozhi-palvelin: ilmainen käyttöliittymä Googlelle, DeepL:lle, DuckDuckGolle, Yandexille ja Reversolle. Valitse moottori. DeepL ja Reverso vaativat lähdekielen.</string>
    <string name="core_tools_provider_music_server">Oma tunnistuspalvelimesi</string>
    <string name="core_tools_provider_music_server_desc">Palvelin, jota ajat ja joka vastaa kuten AudD: leike lähetetään tiedostona ja kappale palautuu JSON-muodossa. Aseta sen taakse sormenjälkityökalu, kuten Panako tai Olaf.</string>
    <string name="core_tools_provider_nllb">Laitteella (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Kääntää puhelimessa Metan NLLB-200-mallilla CTranslate2-ympäristössä: 200 kieltä ja käännökset minkä tahansa kieliparin välillä, myös sellaisten, joita muut moottorit eivät tue. Latauskoko 630 MB, lauseen kääntäminen kestää muutaman sekunnin. Teksti pysyy puhelimessa. Malli on lisensoitu vain ei-kaupalliseen käyttöön (CC BY-NC 4.0). Vaatii 64-bittisen puhelimen, jossa on vähintään 6 Gt muistia.</string>
    <string name="core_tools_provider_none_on">Yksikään palveluntarjoaja ei ole päällä. Kytke yksi päälle tämän työkalun asetuksista.</string>
    <string name="core_tools_provider_offline_gifs">Offline-GIF-paketit</string>
    <string name="core_tools_provider_offline_gifs_desc">Tuomasi GIF-paketit. Ne toimivat ilman yhteyttä.</string>
    <string name="core_tools_provider_ollama_desc">Mallit Ollama-palvelimella, jota ajat tietokoneellasi tai verkossasi. Lisää yksi jokaiselle palvelimelle.</string>
    <string name="core_tools_provider_omnilingual_desc">Metan yksi malli 1 600 kielelle, joista sadoille ei ole muuta puheentunnistusta, puhelimella. Jokainen lause saapuu tauon jälkeen.</string>
    <string name="core_tools_provider_on_device_ai">Laitteellasi</string>
    <string name="core_tools_provider_on_device_ai_desc">Puhelimeen ladattu malli. Mikään kirjoittamasi ei poistu täältä. Valitse ja lataa malli tekoälysivulla.</string>
    <string name="core_tools_provider_on_device_image">Tässä puhelimessa</string>
    <string name="core_tools_provider_on_device_image_desc">Tähän puhelimeen ladattu tai tuomasi malli. Mikään kirjoittamasi ei poistu laitteelta. Valitse malli generaattorin näytöltä.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-yhteensopiva palvelu</string>
    <string name="core_tools_provider_openai_compatible_desc">Mikä tahansa muu palvelu, jossa on OpenAI:n chat-rajapinta: OpenRouter, Groq, Mistral, Together tai oma yhdyskäytäväsi. Anna osoite versioon asti, kuten https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-yhteensopivat kuvat</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Mikä tahansa muu palvelu, jossa on OpenAI:n kuva-API: LocalAI, DeepInfra, Nebius tai oma yhdyskäytäväsi. Anna osoite versioon asti, kuten https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-mallit OpenAI:n API:n kautta omalla avaimellasi.</string>
    <string name="core_tools_provider_openai_image">OpenAI-kuvat</string>
    <string name="core_tools_provider_openai_image_desc">GPT-kuva, joka piirtää tarroja läpinäkyvälle taustalle. Maksullinen per kuva. Tyhjä avain käyttää tekoälytyökalun OpenAI-avainta.</string>
    <string name="core_tools_provider_openhab_desc">openHAB-palvelin: sen kohteet reaaliajassa, semanttisen mallin huoneiden mukaan.</string>
    <string name="core_tools_provider_parakeet_desc">Suuri malli, joka toimii puhelimessa ja ymmärtää 25 eurooppalaista kieltä.</string>
    <string name="core_tools_provider_pexels_desc">Kuvia Pexelsistä. Vaatii API-avaimen, ellei tässä versiossa ole sellaista.</string>
    <string name="core_tools_provider_pollinations_desc">Ilmainen, ilman avainta ja tiliä: kehotteet lähetetään Pollinationsille, joka valitsee mallin. Avain osoitteesta enter.pollinations.ai avaa uudemman API:n ja mahdollistaa mallin nimeämisen.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (epävirallinen, RapidAPI:n kautta)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazamin luettelo epävirallisen listauksen kautta RapidAPI:ssa, RapidAPI-avaimella. Tämä ei ole Applen palvelu: listaus voi muuttua tai lakata toimimasta ilman ennakkoilmoitusta. Jokainen leike lähetetään RapidAPI:lle.</string>
    <string name="core_tools_provider_recraft_desc">Kuvitukset, kuvakkeet ja vektorityylinen taide. Vaatii avaimen osoitteesta recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Rens-palvelin: ilmainen käyttöliittymä Google Lensille. Se lukee valokuvan tekstin puolestasi, useimmilla kirjoitusjärjestelmillä.</string>
    <string name="core_tools_provider_rens_translate_desc">Rens-palvelin: ilmainen käyttöliittymä Google Lensille. Se palauttaa valokuvan, jonka teksti on käännetty.</string>
    <string name="core_tools_provider_replicate_desc">Tuhansia isännöityjä malleja. Nimeä mikä tahansa tekstistä kuvaksi -malli muodossa omistaja/nimi; tyhjänä FLUX Schnell.</string>
    <string name="core_tools_provider_same_kind_fallback">Varmuuskopioina</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Saman tyyppiset palveluntarjoajat toimivat yhtenä. Ensimmäistä pyydetään, ja seuraavaa vain, jos se epäonnistuu, esimerkiksi kun avaimen kiintiö loppuu.</string>
    <string name="core_tools_provider_same_kind_separate">Erillisesti</string>
    <string name="core_tools_provider_same_kind_separate_desc">Jokainen on oma palveluntarjoajansa: oma siru, oma valinta paneelissa, oma osuus jaetussa ruudukossa.</string>
    <string name="core_tools_provider_searxng_desc">SearXNG-instanssi, joka sallii JSON-tulokset. Useimmat julkiset instanssit eivät salli sitä.</string>
    <string name="core_tools_provider_sherpa_desc">Suoratoistomallit 13 kielelle, mukaan lukien bengali, jotka kirjoittavat puheestasi puhelimella.</string>
    <string name="core_tools_provider_simplytranslate_desc">SimplyTranslate-palvelin: ilmainen käyttöliittymä Googlelle ja muille hakukoneille.</string>
    <string name="core_tools_provider_smartthings_desc">SmartThings-laitteesi, huoneesi ja skenaariosi Samsungin pilvipalvelun kautta. Tilat päivittyvät paneelin ollessa auki.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra ja Stable Diffusion 3.5 Stable Diffusionin tekijöiltä. Maksetaan krediiteillä; vaatii avaimen osoitteesta platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Tarrapakettisi tällä puhelimella.</string>
    <string name="core_tools_provider_switchbot_desc">SwitchBot-laitteesi, infrapunakaukosäätimet ja skenaariot SwitchBot-pilven kautta sovelluksen tunnisteella. Tilat päivittyvät kerran minuutissa paneelin ollessa auki.</string>
    <string name="core_tools_provider_system_recognizer">Puhelimen tunnistin</string>
    <string name="core_tools_provider_system_recognizer_desc">Puhelimen mukana tuleva puheentunnistin, yleensä Googlen. Sanat ilmestyvät puhuessasi.</string>
    <string name="core_tools_provider_tavily_desc">Verkkohaku lyhyellä vastauksella. Vaatii Tavily-avaimesi.</string>
    <string name="core_tools_provider_together_desc">FLUX ja muut avoimet mallit Togetherin palvelimilla.</string>
