    <string name="core_tools_provider_translite_desc">Translite-palvelin: ilmainen käyttöliittymä Google Kääntäjälle.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life- ja Tuya Smart -laitteet, huoneet ja skenaariot ilmaisen Tuya-kehittäjäprojektin kautta, joka on linkitetty sovellustiliisi. Tilat päivittyvät paneelin ollessa auki.</string>
    <string name="core_tools_provider_unsplash_desc">Kuvia Unsplashista. Vaatii API-avaimen, ellei tässä koontiversiossa ole sellaista.</string>
    <string name="core_tools_provider_vision_ocr">Visio-mallisi</string>
    <string name="core_tools_provider_vision_ocr_desc">Malli, joka lukee kuvia OpenAI-chat-pyyntöihin vastaavan palvelimen kautta. Vaatii osoitteen ja mallin nimen.</string>
    <string name="core_tools_provider_whisper_desc">OpenAI:n Whisper-mallit, jotka toimivat puhelimessa. Useita kieliä; lataa malli Puhekirjoitus-sivulta.</string>
