    <string name="core_tools_provider_acrcloud_desc">En musikigenkänningstjänst med en tvåveckors provperiod, därefter betalplaner. Kräver värd, åtkomstnyckel och åtkomsthemlighet för ett projekt från console.acrcloud.com. Varje klipp skickas till ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Gratis Stable Diffusion på volontärers datorer. Fungerar utan nyckel men väntar i en kö; en gratis nyckel från aihorde.net flyttar dig framåt i kön.</string>
    <string name="core_tools_provider_anthropic_desc">Claude-modeller via Anthropics API, med din egen nyckel.</string>
    <string name="core_tools_provider_asr4all_desc">Engelsk diktering på telefonen, där orden visas medan du talar.</string>
    <string name="core_tools_provider_audd_desc">Känner igen det mesta utgivna musik från några sekunders ljud. Kräver en token från dashboard.audd.io; några hundra igenkänningar är gratis, därefter kostar det. Varje klipp skickas till AudD.</string>
    <string name="core_tools_provider_audiotag_desc">En liten igenkänningstjänst, gratis för personligt bruk med en nyckel från audiotag.info, och långsammare än de andra: den svarar efter några sekunder. Varje klipp skickas till AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge eller SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Ditt eget Stable Diffusion-webbgränssnitt, startat med --api. Ange dess adress, till exempel http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">På enheten (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Översätter på telefonen med Mozillas Bergamot-motor och Firefox Translations-modeller. Fri programvara, inga Google-tjänster, och din text stannar på telefonen. Varje riktning (franska till engelska, engelska till franska) är en egen nedladdning på 14 till 37 MB. Kräver en 64-bitars telefon med Android 9 eller senare.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX-modellerna från personerna som skapade dem. Kräver en nyckel från bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Svar baserade på en Brave-webbsökning. Kräver en nyckel med Answers-planen. Om den lämnas tom används Brave Search-nyckeln du angav för webbsökning.</string>
    <string name="core_tools_provider_brave_desc">Webb- och bildsökning. Kräver en Brave Search API-nyckel, såvida inte denna version har en.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX och Stable Diffusion på Cloudflare, med en gratis daglig kvot. Kräver en API-token och ditt konto-id.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflares hastighetstestservrar, den närmaste av dess datacenter. Kräver inget konto och berättar för kortet vilket nätverk du är på och vilken stad som svarade.</string>
    <string name="core_tools_provider_coinbase_desc">Valutor och mynt från Coinbase. Ingen nyckel.</string>
    <string name="core_tools_provider_coingecko_desc">Myntpriser från CoinGecko. Ingen nyckel.</string>
    <string name="core_tools_provider_comfyui_desc">Din egen ComfyUI-server. Ritar med ett enkelt text-till-bild-arbetsflöde och den checkpoint du namnger, eller den första den har.</string>
    <string name="core_tools_provider_commons_desc">Gratis GIF-bilder och foton från Wikimedia Commons, eller från din egen MediaWiki. Ingen nyckel krävs. GIF-bilderna är främst utbildningsrelaterade.</string>
    <string name="core_tools_provider_currency_api_desc">Öppna data för de flesta valutor och många mynt. Ingen nyckel.</string>
    <string name="core_tools_provider_deepl_desc">Behöver din DeepL-API-nyckel, eller adressen till en proxy som lägger till en.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-modeller via DeepSeeks API, med din egen nyckel.</string>
    <string name="core_tools_provider_er_api_desc">Dagliga kurser för de flesta valutor. Ingen nyckel.</string>
    <string name="core_tools_provider_fal_desc">Snabba värdbaserade modeller: FLUX, Recraft, Ideogram, Qwen Image med flera. Ange modellens fal-id; FLUX Schnell om tomt.</string>
    <string name="core_tools_provider_frankfurter_desc">Europeiska centralbankens växelkurser för de viktigaste valutorna. Fri programvara, ingen nyckel krävs.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-modeller via Googles API, med din egen nyckel från AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gemini-bilder</string>
    <string name="core_tools_provider_gemini_image_desc">Googles Nano Banana-bildmodeller. En tom nyckel använder Gemini-nyckeln från AI-verktyget.</string>
    <string name="core_tools_provider_gifcities_desc">Gamla GeoCities-GIF:ar från Internet Archive. Ingen nyckel. Resultaten har ingen innehållsbedömning.</string>
    <string name="core_tools_provider_giphy_desc">GIF-bilder och klistermärken. Alltid på en egen flik: GIPHY tillåter inte appar att blanda dess resultat med andra.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Enheterna i ditt Google Home, via Play-tjänster. Ett hem i taget; du väljer vilket i Googles egen skärm.</string>
    <string name="core_tools_provider_google_translate">Google Översätt</string>
    <string name="core_tools_provider_google_translate_desc">Googles kostnadsfria slutpunkt, eller Cloud Translation när du lägger till en nyckel.</string>
    <string name="core_tools_provider_harper_desc">Grammatikmotorn inbyggd i tangentbordet. Endast engelska, och inget du skriver lämnar telefonen.</string>
    <string name="core_tools_provider_home_assistant_desc">Din egen Home Assistant-server. Alla typer av saker, live, med Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue-brygga</string>
    <string name="core_tools_provider_hue_desc">Lampor, rum, scener och sensorer direkt från en Hue-brygga på ditt Wi-Fi. Ingenting lämnar huset.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeller på Hugging Faces egna inferensservrar, med en kostnadsfri månatlig kvot. Kräver en åtkomsttoken med behörighet för inferensleverantörer.</string>
    <string name="core_tools_provider_klipy_desc">GIF-bilder och klistermärken. Kräver en KLIPY API-nyckel, såvida inte denna version har en.</string>
    <string name="core_tools_provider_languagetool_desc">Grammatik, stavning och stil på mer än 30 språk. Din text skickas till en LanguageTool-server för att kontrolleras: den publika på api.languagetool.org om du inte anger en egen.</string>
    <string name="core_tools_provider_librespeed_desc">En LibreSpeed-server: en du kör själv, eller en av volontärernas servrar från den offentliga listan, vald efter stad på radens egen skärm.</string>
    <string name="core_tools_provider_libretranslate_desc">En LibreTranslate-server: din egen eller en offentlig. Offentliga servrar behöver oftast en nyckel.</string>
    <string name="core_tools_provider_lingva_desc">En Lingva-server: ett fritt gränssnitt till Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeller som körs av LM Studio på din dator. Lägg till en för varje dator.</string>
    <string name="core_tools_provider_mlkit">På enheten</string>
    <string name="core_tools_provider_mlkit_desc">Översätter på telefonen med ML Kit. Din text stannar på telefonen. Varje språk kräver en modelldownload först.</string>
    <string name="core_tools_provider_mode_fallback">En i taget</string>
    <string name="core_tools_provider_mode_fallback_desc">Fråga den första leverantören. Om det misslyckas eller saknar resultat, fråga nästa.</string>
    <string name="core_tools_provider_mode_mix">Blandat</string>
    <string name="core_tools_provider_mode_mix_desc">Fråga alla leverantörer samtidigt och blanda deras resultat i ett rutnät.</string>
    <string name="core_tools_provider_mode_pick">Välj i panelen</string>
    <string name="core_tools_provider_mode_pick_desc">Panelen visar vilka leverantörer som är på. Välj en där, så är det bara den som tillfrågas.</string>
    <string name="core_tools_provider_mode_tabs">Flikar</string>
    <string name="core_tools_provider_mode_tabs_desc">Varje leverantör får sin egen flik. Tryck på en flik för att se dess resultat.</string>
    <string name="core_tools_provider_moonshine_desc">En liten, snabb engelsk modell som körs på telefonen.</string>
    <string name="core_tools_provider_mozhi_desc">En Mozhi-server: ett gratis gränssnitt till Google, DeepL, DuckDuckGo, Yandex och Reverso. Välj motor. DeepL och Reverso kräver ett källspråk.</string>
    <string name="core_tools_provider_music_server">Din egen igenkänningsserver</string>
    <string name="core_tools_provider_music_server_desc">En server du kör som svarar som AudD: klippet postas som en fil och låten kommer tillbaka som JSON. Placera en fingeravtrycksläsare som Panako eller Olaf bakom den.</string>
    <string name="core_tools_provider_nllb">På enheten (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Översätter på telefonen med Metas NLLB-200-modell på CTranslate2: 200 språk, mellan vilka två som helst, för de par som andra motorer inte klarar av. En nedladdning på 630 MB, och en mening tar några sekunder. Din text stannar på telefonen. Modellen är licensierad endast för icke-kommersiell användning (CC BY-NC 4.0). Kräver en 64-bitars telefon med 6 GB minne eller mer.</string>
    <string name="core_tools_provider_none_on">Ingen leverantör är påslagen. Slå på en i verktygets inställningar.</string>
    <string name="core_tools_provider_offline_gifs">Offline GIF-paket</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF-paket som du har importerat. De fungerar utan anslutning.</string>
    <string name="core_tools_provider_ollama_desc">Modeller på en Ollama-server som du kör, på din dator eller ditt nätverk. Lägg till en för varje server.</string>
    <string name="core_tools_provider_omnilingual_desc">Metas enhetliga modell för 1 600 språk, varav hundratals saknar annan röstinmatning, direkt på telefonen. Varje fras anländer vid pausen efter den.</string>
    <string name="core_tools_provider_on_device_ai">På din enhet</string>
    <string name="core_tools_provider_on_device_ai_desc">En modell nedladdad till denna telefon. Inget du skriver lämnar den. Välj och ladda ner modellen på AI-sidan.</string>
    <string name="core_tools_provider_on_device_image">På denna telefon</string>
    <string name="core_tools_provider_on_device_image_desc">En modell nedladdad till den här telefonen, eller en du importerat. Inget du skriver lämnar enheten. Välj modellen på generatorns skärm.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-kompatibel tjänst</string>
    <string name="core_tools_provider_openai_compatible_desc">Alla andra tjänster med OpenAIs chatt-API: OpenRouter, Groq, Mistral, Together eller en egen gateway. Ange adressen fram till versionen, till exempel https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-kompatibla bilder</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Alla andra tjänster med OpenAIs bild-API: LocalAI, DeepInfra, Nebius eller en egen gateway. Ange adressen fram till versionen, till exempel https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-modeller via OpenAI:s API, med din egen nyckel.</string>
    <string name="core_tools_provider_openai_image">OpenAI-bilder</string>
    <string name="core_tools_provider_openai_image_desc">GPT-bild, som ritar klistermärken på en transparent bakgrund. Betalas per bild. En tom nyckel använder OpenAI-nyckeln från AI-verktyget.</string>
    <string name="core_tools_provider_openhab_desc">En openHAB-server: dess objekt, live, med rum från den semantiska modellen.</string>
    <string name="core_tools_provider_parakeet_desc">En stor modell som körs på telefonen och förstår 25 europeiska språk.</string>
    <string name="core_tools_provider_pexels_desc">Foton från Pexels. Kräver en API-nyckel, såvida inte denna version har en.</string>
    <string name="core_tools_provider_pollinations_desc">Gratis, utan nyckel och utan konto: prompten skickas till Pollinations, som väljer modell. En nyckel från enter.pollinations.ai öppnar deras nyare API och låter dig namnge en modell.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (inofficiell, via RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazams katalog via en inofficiell lista på RapidAPI, med en RapidAPI-nyckel. Inte en Apple-tjänst: listan kan ändras eller upphöra utan förvarning. Varje klipp skickas till RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Illustrationer, ikoner och vektorbaserad konst. Kräver en nyckel från recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">En Rens-server: ett gratis gränssnitt för Google Lens. Den läser texten i ett foto åt dig, i de flesta skript.</string>
    <string name="core_tools_provider_rens_translate_desc">En Rens-server: ett gratis gränssnitt för Google Lens. Den returnerar fotot med dess text översatt.</string>
    <string name="core_tools_provider_replicate_desc">Tusentals värdade modeller. Namnge valfri text-till-bild-modell som ägare/namn; FLUX Schnell om tomt.</string>
    <string name="core_tools_provider_same_kind_fallback">Som säkerhetskopior</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Leverantörer av samma typ fungerar som en. Den första tillfrågas, och nästa endast när den misslyckas, till exempel när en nyckel får slut på kvot.</string>
    <string name="core_tools_provider_same_kind_separate">Separat</string>
    <string name="core_tools_provider_same_kind_separate_desc">Var och en är sin egen leverantör: sitt eget chip, sitt eget val i panelen, sin egen del av ett blandat rutnät.</string>
    <string name="core_tools_provider_searxng_desc">En SearXNG-instans som tillåter JSON-resultat. De flesta publika instanser gör inte det.</string>
    <string name="core_tools_provider_sherpa_desc">Streamingmodeller för 13 språk, inklusive bengali, som skriver medan du pratar, direkt på telefonen.</string>
    <string name="core_tools_provider_simplytranslate_desc">En SimplyTranslate-server: ett gratis gränssnitt till Google och andra sökmotorer.</string>
    <string name="core_tools_provider_smartthings_desc">Dina SmartThings-enheter, rum och scener via Samsungs moln. Status uppdateras medan panelen är öppen.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra och Stable Diffusion 3.5 från skaparna av Stable Diffusion. Betalas med krediter; kräver en nyckel från platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Dina klistermärkepaket på den här telefonen.</string>
    <string name="core_tools_provider_switchbot_desc">Dina SwitchBot-enheter, infraröda fjärrkontroller och scener, via SwitchBots moln med token från dess app. Status uppdateras en gång i minuten medan panelen är öppen.</string>
    <string name="core_tools_provider_system_recognizer">Telefonens igenkänning</string>
    <string name="core_tools_provider_system_recognizer_desc">Taligenkänningen som följer med telefonen, vanligtvis Googles. Ord visas medan du talar.</string>
    <string name="core_tools_provider_tavily_desc">Webbsökning med ett kort svar. Kräver din Tavily-nyckel.</string>
    <string name="core_tools_provider_together_desc">FLUX och andra öppna modeller på Togethers servrar.</string>
