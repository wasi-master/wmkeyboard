    <string name="core_tools_dictionary_source_offline_bengali">Bengali–Engelsk Wiktionary</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">På denna enhet, när den väl har laddats ner. Bengaliska ord med deras engelska betydelser och hur de uttalas.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, offline</string>
