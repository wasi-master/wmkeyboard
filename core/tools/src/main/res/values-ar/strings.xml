    <string name="core_tools_synonym_source_datamuse_desc">عبر الإنترنت. كلمات كثيرة، مرتبة حسب مدى ملاءمتها.</string>
    <string name="core_tools_synonym_source_dictionary_api">واجهة برمجة تطبيقات القاموس المجانية</string>
