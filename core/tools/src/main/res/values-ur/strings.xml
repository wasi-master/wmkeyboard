    <string name="core_tools_provider_brave_answers">Brave جوابات</string>
    <string name="core_tools_provider_brave_answers_desc">بریو ویب سرچ پر مبنی جوابات۔ جوابات کے پلان کے ساتھ ایک کلید درکار ہے۔ خالی چھوڑنے پر، ویب سرچ کے لیے آپ کی ٹائپ کردہ بریو سرچ کلید آزمائی جائے گی۔</string>
    <string name="core_tools_provider_brave_desc">ویب اور امیج سرچ۔ اس کے لیے Brave سرچ API کلید کی ضرورت ہے، سوائے اس کے کہ اگر اس بلڈ میں ایک موجود ہو۔</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">Cloudflare پر FLUX اور Stable Diffusion، مفت روزانہ الاؤنس کے ساتھ۔ API ٹوکن اور آپ کی اکاؤنٹ آئی ڈی درکار ہے۔</string>
    <string name="core_tools_provider_cloudflare_speed_desc">کلاؤڈ فلیر کے اسپیڈ ٹیسٹ سرورز، اس کے ڈیٹا سینٹرز میں سے قریب ترین۔ کسی اکاؤنٹ کی ضرورت نہیں، اور یہ کارڈ کو بتاتا ہے کہ آپ کس نیٹ ورک پر ہیں اور کس شہر نے جواب دیا۔</string>
    <string name="core_tools_provider_coinbase_desc">Coinbase سے کرنسیاں اور سکے، کوئی کلید نہیں۔</string>
    <string name="core_tools_provider_coingecko_desc">CoinGecko سے سکے کی قیمتیں۔ کوئی کلید نہیں۔</string>
    <string name="core_tools_provider_comfyui_desc">آپ کا اپنا ComfyUI سرور۔ سادہ ٹیکسٹ ٹو امیج ورک فلو اور آپ کے نامزد کردہ چیک پوائنٹ، یا اس کے پاس موجود پہلے چیک پوائنٹ کے ساتھ ڈرائنگ کرتا ہے۔</string>
    <string name="core_tools_provider_commons_desc">ویکی میڈیا کامنز یا آپ کے اپنے میڈیا وکی سے مفت GIFs اور تصاویر۔ کوئی کلید درکار نہیں۔ GIFs زیادہ تر تعلیمی نوعیت کے ہیں۔</string>
    <string name="core_tools_provider_currency_api_desc">زیادہ تر کرنسیوں اور بہت سے سکوں کے لیے اوپن ڈیٹا۔ کوئی کلید نہیں۔</string>
    <string name="core_tools_provider_deepl_desc">اسے آپ کی DeepL API کلید، یا کسی ایسے پراکسی کا پتہ درکار ہے جو اسے شامل کر سکے۔</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek ماڈلز DeepSeek کی API کے ذریعے، آپ کی اپنی کلید کے ساتھ۔</string>
    <string name="core_tools_provider_er_api_desc">زیادہ تر کرنسیوں کے لیے روزانہ کے ریٹس۔ کوئی کلید نہیں۔</string>
    <string name="core_tools_provider_fal_desc">تیز رفتار ہوسٹڈ ماڈلز: FLUX، Recraft، Ideogram، Qwen Image اور مزید۔ ماڈل کی fal آئی ڈی درج کریں؛ خالی چھوڑنے پر FLUX Schnell منتخب ہوگا۔</string>
    <string name="core_tools_provider_frankfurter_desc">اہم کرنسیوں کے لیے یورپی مرکزی بینک کی شرحیں۔ مفت سافٹ ویئر، کوئی کلید نہیں۔</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">گوگل کی API کے ذریعے جیمنی ماڈلز، AI اسٹوڈیو سے اپنی کلید کے ساتھ۔</string>
    <string name="core_tools_provider_gemini_image">Gemini تصاویر</string>
    <string name="core_tools_provider_gemini_image_desc">گوگل کے نینو بنانا امیج ماڈلز۔ ایک خالی کلید اے آئی ٹول سے جیمنی کلید استعمال کرتی ہے۔</string>
    <string name="core_tools_provider_gifcities_desc">انٹرنیٹ آرکائیو سے پرانے GeoCities GIFs۔ کوئی کلید درکار نہیں۔ نتائج کی کوئی مواد کی درجہ بندی نہیں ہے۔</string>
    <string name="core_tools_provider_giphy_desc">GIFs اور اسٹیکرز۔ ہمیشہ اپنے ٹیب میں: GIPHY ایپس کو اپنے نتائج دوسروں کے ساتھ ملانے کی اجازت نہیں دیتا۔</string>
    <string name="core_tools_provider_google_home">گوگل ہوم</string>
    <string name="core_tools_provider_google_home_desc">آپ کے گوگل ہوم میں موجود آلات، پلے سروسز کے ذریعے۔ ایک وقت میں ایک گھر؛ آپ گوگل کی اپنی اسکرین میں منتخب کرتے ہیں کہ کون سا۔</string>
    <string name="core_tools_provider_google_translate">گوگل ٹرانسلیٹ</string>
    <string name="core_tools_provider_google_translate_desc">گوگل کا مفت اینڈ پوائنٹ، یا جب آپ کلید شامل کرتے ہیں تو کلاؤڈ ٹرانسلیشن۔</string>
    <string name="core_tools_provider_harper_desc">کی بورڈ میں بنایا گیا گرامر انجن۔ صرف انگریزی، اور آپ جو کچھ ٹائپ کرتے ہیں وہ فون سے باہر نہیں جاتا۔</string>
    <string name="core_tools_provider_home_assistant_desc">آپ کا اپنا ہوم اسسٹنٹ سرور۔ ہر قسم کی چیز، لائیو، Assist کے ساتھ۔</string>
    <string name="core_tools_provider_hue">فلپس ہیو برج</string>
    <string name="core_tools_provider_hue_desc">آپ کے وائی فائی پر موجود ہیو برج سے براہ راست لائٹس، کمرے، مناظر اور سینسرز۔ کچھ بھی گھر سے باہر نہیں جاتا۔</string>
    <string name="core_tools_provider_hugging_face_desc">ہگنگ فیس (Hugging Face) کے اپنے انفرنس سرورز پر ماڈلز، ماہانہ مفت الاؤنس کے ساتھ۔ انفرنس پرووائیڈرز کی اجازت والا ایکسس ٹوکن درکار ہے۔</string>
    <string name="core_tools_provider_klipy_desc">GIFs اور اسٹیکرز۔ KLIPY API کلید کی ضرورت ہے، جب تک کہ اس بلڈ میں پہلے سے موجود نہ ہو۔</string>
    <string name="core_tools_provider_languagetool_desc">30 سے زائد زبانوں میں گرامر، ہجے اور انداز۔ آپ کا متن چیک کرنے کے لیے LanguageTool سرور پر بھیجا جاتا ہے: اگر آپ اپنا سرور درج نہیں کرتے تو api.languagetool.org پر عوامی سرور استعمال ہوتا ہے۔</string>
    <string name="core_tools_provider_librespeed_desc">ایک لیبرے اسپیڈ سرور: ایک جسے آپ خود چلاتے ہیں، یا عوامی فہرست سے رضاکاروں کے سرورز میں سے کوئی ایک، جسے قطار کی اپنی اسکرین پر شہر کے لحاظ سے منتخب کیا گیا ہے۔</string>
    <string name="core_tools_provider_libretranslate_desc">ایک LibreTranslate سرور: اپنا ذاتی یا کوئی عوامی سرور۔ عوامی سرورز کو عام طور پر ایک کلیدی (key) کی ضرورت ہوتی ہے۔</string>
    <string name="core_tools_provider_lingva_desc">ایک Lingva سرور: گوگل ٹرانسلیٹ کے لیے ایک مفت فرنٹ اینڈ۔</string>
    <string name="core_tools_provider_lm_studio_desc">آپ کے کمپیوٹر پر LM Studio کے ذریعے فراہم کردہ ماڈلز۔ ہر کمپیوٹر کے لیے ایک شامل کریں۔</string>
    <string name="core_tools_provider_mlkit">ڈیوائس پر</string>
    <string name="core_tools_provider_mlkit_desc">ML کٹ کے ساتھ فون پر ترجمہ کرتا ہے۔ آپ کا متن فون پر ہی رہتا ہے۔ ہر زبان کے لیے پہلے ماڈل ڈاؤن لوڈ کرنے کی ضرورت ہوتی ہے۔</string>
    <string name="core_tools_provider_mode_fallback">ایک وقت میں ایک</string>
    <string name="core_tools_provider_mode_fallback_desc">پہلے فراہم کنندہ سے پوچھیں۔ اگر وہ ناکام ہو جائے یا کوئی نتیجہ نہ دے، تو اگلے سے پوچھیں۔</string>
    <string name="core_tools_provider_mode_mix">مخلوط</string>
    <string name="core_tools_provider_mode_mix_desc">تمام فراہم کنندگان سے ایک ہی وقت میں پوچھیں اور ان کے نتائج کو ایک گرڈ میں مکس کریں۔</string>
    <string name="core_tools_provider_mode_pick">پینل میں منتخب کریں</string>
    <string name="core_tools_provider_mode_pick_desc">پینل ان فراہم کنندگان کو دکھاتا ہے جو آن ہیں۔ وہاں سے ایک کا انتخاب کریں، اور صرف اسی سے پوچھا جائے گا۔</string>
    <string name="core_tools_provider_mode_tabs">ٹیبز</string>
    <string name="core_tools_provider_mode_tabs_desc">ہر پرووائیڈر کو اپنی چپ ملتی ہے۔ نتائج دیکھنے کے لیے چپ پر ٹیپ کریں۔</string>
    <string name="core_tools_provider_moonshine_desc">ایک چھوٹا، تیز انگریزی ماڈل جو فون پر چلتا ہے۔</string>
    <string name="core_tools_provider_mozhi_desc">ایک Mozhi سرور: Google، DeepL، DuckDuckGo، Yandex اور Reverso کے لیے ایک مفت فرنٹ اینڈ۔ انجن کا انتخاب کریں۔ DeepL اور Reverso کو ماخذ زبان کی ضرورت ہوتی ہے۔</string>
    <string name="core_tools_provider_music_server">آپ کا اپنا شناخت کا سرور</string>
    <string name="core_tools_provider_music_server_desc">ایک سرور جسے آپ چلاتے ہیں جو AudD کی طرح جواب دیتا ہے: کلپ ایک فائل کے طور پر پوسٹ کیا جاتا ہے اور گانا JSON کے طور پر واپس آتا ہے۔ اس کے پیچھے Panako یا Olaf جیسا فنگر پرنٹر لگائیں۔</string>
    <string name="core_tools_provider_nllb">ڈیوائس پر (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">یہ Meta کے NLLB-200 ماڈل برائے CTranslate2 کے ساتھ فون پر ہی ترجمہ کرتا ہے: 200 زبانیں، ان کے درمیان کسی بھی دو کا، ان جوڑوں کے لیے جنہیں دوسرے انجن نہیں کر سکتے۔ 630 ایم بی کا ایک ڈاؤن لوڈ، اور ایک جملے میں چند سیکنڈ لگتے ہیں۔ آپ کا ٹیکسٹ فون پر ہی رہتا ہے۔ ماڈل صرف غیر تجارتی استعمال (CC BY-NC 4.0) کے لیے لائسنس یافتہ ہے۔ 6 جی بی یا اس سے زیادہ میموری والے 64 بٹ فون کی ضرورت ہے۔</string>
    <string name="core_tools_provider_none_on">کوئی پرووائیڈر آن نہیں ہے۔ اس ٹول کی سیٹنگز میں جا کر ایک آن کریں۔</string>
    <string name="core_tools_provider_offline_gifs">آف لائن GIF پیک</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF پیکس جو آپ نے درآمد کیے ہیں۔ یہ بغیر کنکشن کے کام کرتے ہیں۔</string>
    <string name="core_tools_provider_ollama_desc">آپ کے کمپیوٹر یا نیٹ ورک پر چلنے والے Ollama سرور پر موجود ماڈلز۔ ہر سرور کے لیے ایک شامل کریں۔</string>
    <string name="core_tools_provider_omnilingual_desc">میٹا کا 1600 زبانوں کے لیے ایک ماڈل، جن میں سے سیکڑوں کے لیے فون پر کوئی اور صوتی ٹائپنگ دستیاب نہیں۔ ہر فقرہ اس کے بعد توقف پر پہنچتا ہے۔</string>
    <string name="core_tools_provider_on_device_ai">آپ کے آلے پر</string>
    <string name="core_tools_provider_on_device_ai_desc">اس فون پر ڈاؤن لوڈ کیا گیا ایک ماڈل۔ آپ جو کچھ بھی لکھتے ہیں وہ اس سے باہر نہیں جاتا۔ AI صفحہ پر ماڈل منتخب کریں اور ڈاؤن لوڈ کریں۔</string>
    <string name="core_tools_provider_on_device_image">اس فون پر</string>
    <string name="core_tools_provider_on_device_image_desc">اس فون پر ڈاؤن لوڈ کردہ ماڈل، یا کوئی ایسا جسے آپ نے امپورٹ کیا ہو۔ آپ جو کچھ بھی ٹائپ کرتے ہیں وہ اس سے باہر نہیں جاتا۔ جنریٹر کی اسکرین پر ماڈل منتخب کریں۔</string>
    <string name="core_tools_provider_openai_compatible">OpenAI سے مطابقت رکھنے والی سروس</string>
    <string name="core_tools_provider_openai_compatible_desc">OpenAI کی چیٹ API کے ساتھ کوئی بھی دوسری سروس: OpenRouter، Groq، Mistral، Together، یا آپ کا اپنا گیٹ وے، ورژن تک کا پتہ دیں، جیسے https://openrouter.ai/api/v1۔</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI سے مطابقت رکھنے والی تصاویر</string>
    <string name="core_tools_provider_openai_compatible_image_desc">اوپن اے آئی کے امیج اے پی آئی کے ساتھ کوئی بھی دوسری سروس: LocalAI، DeepInfra، Nebius، یا آپ کا اپنا گیٹ وے۔ ورژن تک کا پتہ فراہم کریں، جیسے https://api.deepinfra.com/v1/openai۔</string>
    <string name="core_tools_provider_openai_desc">OpenAI کی API کے ذریعے GPT ماڈلز، آپ کی اپنی کلید کے ساتھ۔</string>
    <string name="core_tools_provider_openai_image">اوپن اے آئی تصاویر</string>
    <string name="core_tools_provider_openai_image_desc">GPT امیج، جو شفاف پس منظر پر اسٹیکرز بناتا ہے۔ فی تصویر معاوضہ ہے۔ خالی کلید اے آئی ٹول کی OpenAI کلید استعمال کرتی ہے۔</string>
    <string name="core_tools_provider_openhab_desc">ایک openHAB سرور: اس کے آئٹمز، لائیو، سیمنٹک ماڈل کے کمروں کے ساتھ۔</string>
    <string name="core_tools_provider_parakeet_desc">ایک بڑا ماڈل جو فون پر چلتا ہے اور 25 یورپی زبانیں سمجھتا ہے۔</string>
    <string name="core_tools_provider_pexels_desc">Pexels سے تصاویر۔ ایک API کلید کی ضرورت ہے، جب تک کہ اس بلڈ میں پہلے سے موجود نہ ہو۔</string>
    <string name="core_tools_provider_pollinations_desc">مفت، بغیر کسی کی اور بغیر اکاؤنٹ کے: پرامپٹ پولینیشنز (Pollinations) کو بھیجا جاتا ہے، جو ماڈل کا انتخاب کرتا ہے۔ enter.pollinations.ai سے حاصل کردہ ایک کی (key) اس کی نئی API کو کھولتی ہے اور آپ کو ماڈل کا نام منتخب کرنے کی سہولت دیتی ہے۔</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (غیر سرکاری، RapidAPI کے ذریعے)</string>
    <string name="core_tools_provider_rapid_shazam_desc">RapidAPI پر غیر سرکاری فہرست کے ذریعے Shazam کا کیٹلاگ، ایک RapidAPI کلید کے ساتھ۔ یہ ایپل کی سروس نہیں ہے: فہرست بغیر اطلاع کے تبدیل یا بند ہو سکتی ہے۔ ہر کلپ RapidAPI کو بھیجا جاتا ہے۔</string>
    <string name="core_tools_provider_recraft_desc">تمثیلیں، شبیہیں اور ویکٹر اسٹائل آرٹ۔ recraft.ai سے ایک کلید درکار ہے۔</string>
    <string name="core_tools_provider_rens_desc">ایک Rens سرور: Google Lens کے لیے ایک مفت فرنٹ اینڈ۔ یہ آپ کے لیے تصویر میں موجود متن کو زیادہ تر رسم الخط میں پڑھتا ہے۔</string>
    <string name="core_tools_provider_rens_translate_desc">ایک رینس سرور: گوگل لینس کا ایک مفت فرنٹ اینڈ۔ یہ تصویر کو اس کے ترجمہ شدہ متن کے ساتھ واپس دیتا ہے۔</string>
    <string name="core_tools_provider_replicate_desc">ہزاروں ہوسٹ کردہ ماڈلز۔ کسی بھی ٹیکسٹ ٹو امیج ماڈل کو بطور مالک/نام کے درج کریں؛ خالی چھوڑنے پر FLUX Schnell استعمال ہوگا۔</string>
    <string name="core_tools_provider_same_kind_fallback">بیک اپ کے طور پر</string>
    <string name="core_tools_provider_same_kind_fallback_desc">ایک ہی قسم کے فراہم کنندگان ایک کے طور پر کام کرتے ہیں۔ پہلے سے پوچھا جاتا ہے، اور اگلے سے صرف تب جب وہ ناکام ہو جائے، مثال کے طور پر جب کسی کلید کا کوٹہ ختم ہو جائے۔</string>
