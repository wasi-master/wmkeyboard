    <string name="core_tools_synonym_source_datamuse_desc">Онлайн. Много думи, подредени по това доколко добре си пасват.</string>
    <string name="core_tools_synonym_source_dictionary_api">Free Dictionary API</string>
    <string name="core_tools_synonym_source_dictionary_api_desc">Онлайн. Източникът, който използва инструментът за речник.</string>
    <string name="core_tools_synonym_source_similar_words">Подобни думи</string>
    <string name="core_tools_synonym_source_similar_words_desc">Онлайн, от Datamuse. Думи със сродно значение за думи, които нямат синоними.</string>
    <string name="core_tools_synonym_source_vocab_packs">Пакети с речников запас</string>
