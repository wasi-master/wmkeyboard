    <string name="core_tools_provider_transcription_server">Transkripcijas serveris</string>
    <string name="core_tools_provider_transcription_server_desc">Serveris, kas izmanto OpenAI audio transkripcijas API: speaches, whisper.cpp serveri, LocalAI, Groq vai OpenAI. Katrs ieraksts tiek nosūtīts uz to, kad beidzat runāt.</string>
    <string name="core_tools_provider_translate_server">Jūsu tulkošanas serveris</string>
    <string name="core_tools_provider_translate_server_desc">Serveris, kas atbild uz OpenAI tērzēšanas pieprasījumiem: llama.cpp, Ollama, LM Studio, vLLM vai vārteja.</string>
    <string name="core_tools_provider_translite_desc">Translite serveris: bezmaksas saskarne Google tulkotājam.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life un Tuya Smart ierīces, telpas un ainas, izmantojot bezmaksas Tuya izstrādātāja projektu, kas saistīts ar jūsu lietotnes kontu. Stāvokļi tiek atjaunināti, kamēr panelis ir atvērts.</string>
    <string name="core_tools_provider_unsplash_desc">Fotoattēli no Unsplash. Nepieciešama API atslēga, ja vien šajā versijā tāda nav iekļauta.</string>
    <string name="core_tools_provider_vision_ocr">Jūsu redzes modelis</string>
    <string name="core_tools_provider_vision_ocr_desc">Modelis, kas nolasa attēlus, izmantojot serveri, kas atbild uz OpenAI tērzēšanas pieprasījumiem. Nepieciešama adrese un modeļa nosaukums.</string>
    <string name="core_tools_provider_whisper_desc">OpenAI Whisper modeļi, kas darbojas tālrunī. Daudzas valodas; lejupielādējiet modeli balss ievades lapā.</string>
    <string name="core_tools_provider_whistle_desc">Mazs, ātrs modelis, kas darbojas tālrunī. Lejupielādējiet to balss ievades lapā.</string>
    <string name="core_tools_provider_xai_desc">Grok modeļi, izmantojot xAI API ar jūsu pašu atslēgu.</string>
    <string name="core_tools_provider_xai_image">Grok Imagine</string>
    <string name="core_tools_provider_xai_image_desc">xAI attēlu modelis. Tukša atslēga izmanto xAI atslēgu no AI rīka.</string>
