    <string name="core_tools_provider_acrcloud_desc">Mūzikas atpazīšanas pakalpojums ar divu nedēļu izmēģinājuma periodu, pēc tam maksas plāni. Nepieciešams resursdators, piekļuves atslēga un piekļuves slepenā atslēga no projekta vietnē console.acrcloud.com. Katrs klips tiek nosūtīts uz ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Bezmaksas Stable Diffusion uz brīvprātīgo datoriem. Darbojas bez atslēgas, bet jāgaida rindā; bezmaksas atslēga no aihorde.net ļauj virzīties uz priekšu.</string>
    <string name="core_tools_provider_anthropic_desc">Claude modeļi, izmantojot Anthropic API, ar jūsu pašu atslēgu.</string>
    <string name="core_tools_provider_asr4all_desc">Diktēšana angļu valodā tālrunī, vārdiem parādoties runāšanas laikā.</string>
    <string name="core_tools_provider_audd_desc">Atpazīst lielāko daļu izlaistās mūzikas no dažām skaņas sekundēm. Nepieciešams marķieris no dashboard.audd.io; daži simti atpazīšanas reižu ir bezmaksas, pēc tam tas ir maksas pakalpojums. Katrs klips tiek nosūtīts uz AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Neliels atpazīšanas pakalpojums, bezmaksas personiskai lietošanai ar atslēgu no audiotag.info, un lēnāks nekā citi: tas atbild pēc dažām sekundēm. Katrs klips tiek nosūtīts uz AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge vai SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Jūsu paša Stable Diffusion tīmekļa saskarne, kas sākta ar --api. Norādiet tās adresi, piemēram, http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Ierīcē (Firefox tulkojumi)</string>
    <string name="core_tools_provider_bergamot_desc">Tulko tālrunī, izmantojot Mozilla Bergamot dzinēju un Firefox tulkošanas modeļus. Brīvā programmatūra, bez Google pakalpojumiem, un jūsu teksts paliek tālrunī. Katrs virziens (franču uz angļu, angļu uz franču) ir atsevišķa 14 līdz 37 MB lejupielāde. Nepieciešams 64 bitu tālrunis ar Android 9 vai jaunāku versiju.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX modeļi no to izstrādātājiem. Nepieciešama atslēga no bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Atbildes, kas balstītas uz Brave tīmekļa meklēšanu. Nepieciešama atslēga ar Answers plānu. Ja atstāts tukšs, tiks mēģināts izmantot Brave Search atslēgu, ko ievadījāt tīmekļa meklēšanai.</string>
    <string name="core_tools_provider_brave_desc">Tīmekļa un attēlu meklēšana. Nepieciešama Brave Search API atslēga, ja vien šajā versijā tādas nav.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX un Stable Diffusion pakalpojumā Cloudflare ar bezmaksas ikdienas limitu. Nepieciešams API pilnvaras (token) un jūsu konta ID.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflare ātruma pārbaudes serveri – tuvākais no uzņēmuma datu centriem. Nav nepieciešams konts, parāda, kādā tīklā atrodaties un kura pilsēta atbildēja.</string>
    <string name="core_tools_provider_coinbase_desc">Valūtas un monētas no Coinbase. Nav atslēgas.</string>
    <string name="core_tools_provider_coingecko_desc">Monētu cenas no CoinGecko. Nav nepieciešama atslēga.</string>
    <string name="core_tools_provider_comfyui_desc">Jūsu pašu ComfyUI serveris. Zīmē ar vienkāršu teksta-uz-attēlu darbplūsmu un jūsu norādīto kontrolpunktu vai pirmo pieejamo.</string>
    <string name="core_tools_provider_commons_desc">Bezmaksas GIF un fotoattēli no Wikimedia Commons vai no jūsu paša MediaWiki. Nav nepieciešama atslēga. GIF attēli galvenokārt ir izglītojoši.</string>
    <string name="core_tools_provider_currency_api_desc">Atvērtie dati lielākajai daļai valūtu un daudzām monētām. Nav nepieciešama atslēga.</string>
    <string name="core_tools_provider_deepl_desc">Nepieciešama jūsu DeepL API atslēga vai starpniekservera adrese, kas to pievieno.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek modeļi, izmantojot DeepSeek API, ar jūsu pašu atslēgu.</string>
    <string name="core_tools_provider_er_api_desc">Dienas kursi lielākajai daļai valūtu. Nav nepieciešama atslēga.</string>
    <string name="core_tools_provider_fal_desc">Ātrie mitinātie modeļi: FLUX, Recraft, Ideogram, Qwen Image un citi. Norādiet modeļa fal id; ja tas ir tukšs, tiek izmantots FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Eiropas Centrālās bankas kursi galvenajām valūtām. Bezmaksas programmatūra, nav nepieciešama atslēga.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini modeļi, izmantojot Google API, ar jūsu pašu atslēgu no AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gemini attēli</string>
    <string name="core_tools_provider_gemini_image_desc">Google Nano Banana attēlu modeļi. Tukša atslēga izmanto Gemini atslēgu no AI rīka.</string>
    <string name="core_tools_provider_gifcities_desc">Veci GeoCities GIF no interneta arhīva. Nav atslēgas. Rezultātiem nav satura vērtējuma.</string>
    <string name="core_tools_provider_giphy_desc">GIF un uzlīmes. Vienmēr savā cilnē: GIPHY neļauj lietotnēm sajaukt savus rezultātus ar citiem.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Ierīces jūsu Google Home, izmantojot Play pakalpojumus. Vienlaikus viena māja; jūs izvēlaties, kura, Google savā ekrānā.</string>
    <string name="core_tools_provider_google_translate">Google tulkotājs</string>
    <string name="core_tools_provider_google_translate_desc">Google bezmaksas galapunkts vai Cloud Translation, kad pievienojat atslēgu.</string>
    <string name="core_tools_provider_harper_desc">Tastatūrā iebūvētais gramatikas dzinis. Tikai angļu valodā, un nekas no tā, ko rakstāt, nepamet tālruni.</string>
    <string name="core_tools_provider_home_assistant_desc">Jūsu pašu Home Assistant serveris. Jebkura veida lieta, tiešraidē, ar Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue tilts</string>
    <string name="core_tools_provider_hue_desc">Gaismas, telpas, ainas un sensori tieši no Hue tilta jūsu Wi-Fi tīklā. Nekas neatstāj māju.</string>
    <string name="core_tools_provider_hugging_face_desc">Modeļi Hugging Face pašu secinājumu serveros ar bezmaksas ikmēneša kvotu. Nepieciešama piekļuves pilnvara ar Inference Providers atļauju.</string>
    <string name="core_tools_provider_klipy_desc">GIF attēli un uzlīmes. Nepieciešama KLIPY API atslēga, ja vien šajā laidienā tādas nav.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatika, pareizrakstība un stils vairāk nekā 30 valodās. Jūsu teksts tiek nosūtīts uz LanguageTool serveri pārbaudei: publisko serveri api.languagetool.org, ja vien neievadāt savu.</string>
    <string name="core_tools_provider_librespeed_desc">LibreSpeed serveris: tāds, ko pārvaldāt pats, vai kāds no brīvprātīgo serveriem no publiskā saraksta, kas izvēlēts pēc pilsētas rindas ekrānā.</string>
    <string name="core_tools_provider_libretranslate_desc">LibreTranslate serveris: jūsu paša vai publisks. Publiskajiem serveriem parasti ir nepieciešama atslēga.</string>
    <string name="core_tools_provider_lingva_desc">Lingva serveris: bezmaksas saskarne Google tulkotājam.</string>
    <string name="core_tools_provider_lm_studio_desc">Modeļi, ko jūsu datorā nodrošina LM Studio. Pievienojiet pa vienam katram datoram.</string>
    <string name="core_tools_provider_mlkit">Ierīcē</string>
    <string name="core_tools_provider_mlkit_desc">Tulko tālrunī, izmantojot ML Kit. Jūsu teksts paliek tālrunī. Katrai valodai vispirms ir nepieciešams lejupielādēt modeli.</string>
    <string name="core_tools_provider_mode_fallback">Pa vienam</string>
    <string name="core_tools_provider_mode_fallback_desc">Vaicāt pirmajam nodrošinātājam. Ja tas neizdodas vai rezultātu nav, vaicāt nākamajam.</string>
    <string name="core_tools_provider_mode_mix">Jaukts</string>
    <string name="core_tools_provider_mode_mix_desc">Vaicājiet visiem pakalpojumu sniedzējiem vienlaikus un apvienojiet to rezultātus vienā režģī.</string>
    <string name="core_tools_provider_mode_pick">Izvēlēties panelī</string>
    <string name="core_tools_provider_mode_pick_desc">Panelī ir redzami ieslēgtie pakalpojumu sniedzēji. Izvēlieties vienu, un tiks vaicāts tikai tam.</string>
    <string name="core_tools_provider_mode_tabs">Cilnes</string>
    <string name="core_tools_provider_mode_tabs_desc">Katrs pakalpojumu sniedzējs iegūst savu cilni. Pieskarieties cilnei, lai redzētu tās rezultātus.</string>
    <string name="core_tools_provider_moonshine_desc">Mazs, ātrs angļu valodas modelis, kas darbojas tālrunī.</string>
    <string name="core_tools_provider_mozhi_desc">Mozhi serveris: bezmaksas saskarne Google, DeepL, DuckDuckGo, Yandex un Reverso. Izvēlieties dzinēju. DeepL un Reverso nepieciešama avota valoda.</string>
    <string name="core_tools_provider_music_server">Jūsu pašu atpazīšanas serveris</string>
    <string name="core_tools_provider_music_server_desc">Serveris, kuru jūs darbināt un kas atbild kā AudD: klips tiek publicēts kā fails, un dziesma atgriežas kā JSON. Ievietojiet aiz tā pirkstu nospiedumu atpazīšanas rīku, piemēram, Panako vai Olaf.</string>
    <string name="core_tools_provider_nllb">Ierīcē (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Tulko tālrunī, izmantojot Meta NLLB-200 modeli uz CTranslate2: 200 valodas, starp jebkurām divām no tām, pāriem, kurus citi dzinēji nevar veikt. Viena 630 MB lejupielāde, un teikums aizņem dažas sekundes. Jūsu teksts paliek tālrunī. Modelis ir licencēts tikai nekomerciālai lietošanai (CC BY-NC 4.0). Nepieciešams 64 bitu tālrunis ar 6 GB vai vairāk atmiņas.</string>
    <string name="core_tools_provider_none_on">Nav ieslēgts neviens pakalpojumu sniedzējs. Ieslēdziet kādu no tiem šī rīka iestatījumos.</string>
    <string name="core_tools_provider_offline_gifs">Bezsaistes GIF pakas</string>
    <string name="core_tools_provider_offline_gifs_desc">Importētās GIF pakotnes. Tās darbojas bez savienojuma.</string>
    <string name="core_tools_provider_ollama_desc">Modeļi Ollama serverī, kuru jūs darbināt savā datorā vai tīklā. Pievienojiet pa vienam katram serverim.</string>
    <string name="core_tools_provider_omnilingual_desc">Meta viens modelis 1600 valodām, simtiem no tām bez citas balss ievades, tālrunī. Katra frāze nonāk pēc pauzes.</string>
    <string name="core_tools_provider_on_device_ai">Jūsu ierīcē</string>
    <string name="core_tools_provider_on_device_ai_desc">Modelis, kas lejupielādēts šajā tālrunī. Nekas, ko rakstāt, to neatstāj. Izvēlieties un lejupielādējiet modeli AI lapā.</string>
    <string name="core_tools_provider_on_device_image">Šajā tālrunī</string>
    <string name="core_tools_provider_on_device_image_desc">Šajā tālrunī lejupielādēts modelis vai jūsu importēts modelis. Nekas no tā, ko ievadāt, to neatstāj. Izvēlieties modeli ģeneratora ekrānā.</string>
    <string name="core_tools_provider_openai_compatible">Ar OpenAI saderīgs pakalpojums</string>
    <string name="core_tools_provider_openai_compatible_desc">Jebkurš cits pakalpojums ar OpenAI tērzēšanas API: OpenRouter, Groq, Mistral, Together vai jūsu pašu vārteja. Norādiet adresi līdz versijai, piemēram, https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Ar OpenAI saderīgi attēli</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Jebkurš cits pakalpojums ar OpenAI attēlu API: LocalAI, DeepInfra, Nebius vai jūsu pašu vārteja. Norādiet adresi līdz versijai, piemēram, https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT modeļi, izmantojot OpenAI API, ar jūsu pašu atslēgu.</string>
    <string name="core_tools_provider_openai_image">OpenAI attēli</string>
    <string name="core_tools_provider_openai_image_desc">GPT attēls, kas zīmē uzlīmes uz caurspīdīga fona. Maksas par attēlu. Tukša atslēga izmanto OpenAI atslēgu no AI rīka.</string>
    <string name="core_tools_provider_openhab_desc">openHAB serveris: tā vienumi, tiešraidē, ar telpām no semantiskā modeļa.</string>
    <string name="core_tools_provider_parakeet_desc">Liels modelis, kas darbojas tālrunī un saprot 25 Eiropas valodas.</string>
    <string name="core_tools_provider_pexels_desc">Fotoattēli no Pexels. Nepieciešama API atslēga, ja vien šajā versijā tāda nav iekļauta.</string>
    <string name="core_tools_provider_pollinations_desc">Bezmaksas, bez atslēgas un konta: uzvedne tiek nosūtīta uz Pollinations, kas izvēlas modeli. Atslēga no enter.pollinations.ai atver jaunāku API un ļauj nosaukt modeli.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neoficiāls, izmantojot RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Shazam katalogs, izmantojot neoficiālu sarakstu vietnē RapidAPI ar RapidAPI atslēgu. Tas nav Apple pakalpojums: saraksts var mainīties vai tikt pārtraukts bez brīdinājuma. Katrs klips tiek nosūtīts uz RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrācijas, ikonas un vektorgrafikas stila māksla. Nepieciešama atslēga no recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Rens serveris: bezmaksas saskarne Google Lens. Tas nolasa tekstu fotoattēlā jūsu vietā, lielākajā daļā rakstību.</string>
    <string name="core_tools_provider_rens_translate_desc">Rens serveris: bezmaksas saskarne Google Lens. Tas atgriež fotoattēlu ar tulkotu tekstu.</string>
    <string name="core_tools_provider_replicate_desc">Tūkstošiem mitinātu modeļu. Nosauciet jebkuru teksta-uz-attēlu modeli kā īpašnieks/nosaukums; FLUX Schnell, ja tukšs.</string>
    <string name="core_tools_provider_same_kind_fallback">Kā rezerves kopijas</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Vienāda veida pakalpojumu sniedzēji darbojas kā viens. Vispirms tiek vaicāts pirmais, un nākamais tikai tad, ja tas neizdodas, piemēram, kad atslēgai beidzas kvota.</string>
    <string name="core_tools_provider_same_kind_separate">Atsevišķi</string>
    <string name="core_tools_provider_same_kind_separate_desc">Katrs no tiem ir savs nodrošinātājs: sava mikroshēma, sava izvēle panelī, sava daļa jauktā režģī.</string>
    <string name="core_tools_provider_searxng_desc">SearXNG instance, kas atļauj JSON rezultātus. Lielākā daļa publisko instanču to neatļauj.</string>
    <string name="core_tools_provider_sherpa_desc">Straumēšanas modeļi 13 valodām, tostarp bengāļu, kas raksta, kamēr runājat pa tālruni.</string>
    <string name="core_tools_provider_simplytranslate_desc">SimplyTranslate serveris: bezmaksas saskarne Google un citiem dzinējiem.</string>
    <string name="core_tools_provider_smartthings_desc">Jūsu SmartThings ierīces, telpas un ainas, izmantojot Samsung mākoni. Statuss tiek atjaunināts, kamēr panelis ir atvērts.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra un Stable Diffusion 3.5 no Stable Diffusion veidotājiem. Maksājums kredītos; nepieciešama atslēga no platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Jūsu uzlīmju pakas šajā tālrunī.</string>
    <string name="core_tools_provider_switchbot_desc">Jūsu SwitchBot ierīces, infrasarkanās tālvadības pultis un ainas, izmantojot SwitchBot mākoni ar marķieri no tā lietotnes. Stāvokļi tiek atjaunināti reizi minūtē, kamēr panelis ir atvērts.</string>
    <string name="core_tools_provider_system_recognizer">Tālruņa atpazīšanas rīks</string>
    <string name="core_tools_provider_system_recognizer_desc">Runas atpazīšanas rīks, kas ir iebūvēts tālrunī, parasti Google. Vārdi parādās, tiklīdz jūs runājat.</string>
    <string name="core_tools_provider_tavily_desc">Meklēšana tīmeklī ar īsu atbildi. Nepieciešama jūsu Tavily atslēga.</string>
    <string name="core_tools_provider_together_desc">FLUX un citi atvērtie modeļi Together serveros.</string>
