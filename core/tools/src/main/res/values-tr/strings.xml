    <string name="core_tools_provider_acrcloud_desc">İki haftalık deneme süresi olan, ardından ücretli planlara geçen bir müzik tanıma hizmeti. console.acrcloud.com adresinden bir projenin ana bilgisayarına, erişim anahtarına ve erişim gizli anahtarına ihtiyaç duyar. Her klip ACRCloud\'a gönderilir.</string>
    <string name="core_tools_provider_ai_horde_desc">Gönüllülerin bilgisayarlarında ücretsiz Stable Diffusion. Anahtar olmadan çalışır ancak kuyrukta bekler; aihorde.net\'ten alınan ücretsiz bir anahtar sizi kuyrukta öne geçirir.</string>
    <string name="core_tools_provider_anthropic_desc">Kendi anahtarınızla, Anthropic\'in API\'si üzerinden Claude modelleri.</string>
    <string name="core_tools_provider_asr4all_desc">Telefonda İngilizce dikte, siz konuştukça kelimeler belirir.</string>
    <string name="core_tools_provider_audd_desc">Yayınlanmış çoğu müziği birkaç saniyelik ses kaydından tanır. dashboard.audd.io adresinden bir jeton gerektirir; birkaç yüz tanıma ücretsizdir, sonrasında ücretlidir. Her klip AudD\'ye gönderilir.</string>
    <string name="core_tools_provider_audiotag_desc">Kişisel kullanım için audiotag.info\'dan bir anahtarla ücretsiz olan ve diğerlerinden daha yavaş çalışan küçük bir tanıma hizmeti: birkaç saniye sonra yanıt verir. Her klip AudioTag\'e gönderilir.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge veya SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">--api ile başlatılan kendi Stable Diffusion web arayüzünüz. http://192.168.1.10:7860 gibi adresini girin.</string>
    <string name="core_tools_provider_bergamot">Cihaz üzerinde (Firefox Çevirileri)</string>
    <string name="core_tools_provider_bergamot_desc">Mozilla\'nın Bergamot motoru ve Firefox Çeviri modelleri ile telefonda çeviri yapar. Özgür yazılımdır, Google hizmetleri içermez ve metniniz telefonda kalır. Her yön (Fransızcadan İngilizceye, İngilizceden Fransızcaya) 14 ila 37 MB arasında ayrı bir indirme gerektirir. Android 9 veya sonraki sürümlere sahip 64 bit bir telefon gerektirir.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX modelleri, onları yapanlardan. bfl.ai adresinden bir anahtar gerektirir.</string>
    <string name="core_tools_provider_brave">Brave Arama</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Brave web aramasından elde edilen yanıtlar. Answers planına sahip bir anahtar gerektirir. Boş bırakılırsa, web araması için yazdığınız Brave Arama anahtarı denenir.</string>
    <string name="core_tools_provider_brave_desc">Web ve görsel arama. Bu sürümde bir tane yoksa, bir Brave Arama API anahtarı gerekir.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">Cloudflare üzerinde FLUX ve Stable Diffusion, ücretsiz günlük kullanım hakkı ile. Bir API anahtarı ve hesap kimliğiniz gerekir.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Cloudflare\'in hız testi sunucuları, veri merkezlerinin en yakını. Hesap gerektirmez ve karta hangi ağda olduğunuzu ve hangi şehrin yanıt verdiğini söyler.</string>
    <string name="core_tools_provider_coinbase_desc">Coinbase\'den para birimleri ve coinler. Anahtar yok.</string>
    <string name="core_tools_provider_coingecko_desc">CoinGecko\'dan coin fiyatları. Anahtar gerektirmez.</string>
    <string name="core_tools_provider_comfyui_desc">Kendi ComfyUI sunucunuz. Düz bir metinden görüntüye iş akışıyla ve adlandırdığınız kontrol noktasıyla veya sahip olduğu ilk kontrol noktasıyla çizim yapar.</string>
    <string name="core_tools_provider_commons_desc">Wikimedia Commons\'tan veya kendi MediaWiki\'nizden ücretsiz GIF\'ler ve fotoğraflar. Anahtar gerekmez. GIF\'ler çoğunlukla eğiticidir.</string>
    <string name="core_tools_provider_currency_api_desc">Çoğu para birimi ve birçok kripto para için açık veriler. Anahtar gerektirmez.</string>
    <string name="core_tools_provider_deepl_desc">DeepL API anahtarınıza veya anahtar ekleyen bir proxy\'nin adresine ihtiyaç duyar.</string>
    <string name="core_tools_provider_deepseek_desc">Kendi anahtarınızla DeepSeek API üzerinden DeepSeek modelleri.</string>
    <string name="core_tools_provider_er_api_desc">Çoğu para birimi için günlük kurlar. Anahtar gerekmez.</string>
    <string name="core_tools_provider_fal_desc">Hızlı barındırılan modeller: FLUX, Recraft, Ideogram, Qwen Image ve daha fazlası. Modelin fal kimliğini belirtin; boş bırakılırsa FLUX Schnell kullanılır.</string>
    <string name="core_tools_provider_frankfurter_desc">Ana para birimleri için Avrupa Merkez Bankası kurları. Ücretsiz yazılım, anahtar gerektirmez.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">AI Studio\'dan alacağınız kendi anahtarınızla, Google\'ın API\'si aracılığıyla Gemini modelleri.</string>
    <string name="core_tools_provider_gemini_image">Gemini Görselleri</string>
    <string name="core_tools_provider_gemini_image_desc">Google\'ın Nano Banana görsel modelleri. Boş anahtar, yapay zeka aracındaki Gemini anahtarını kullanır.</string>
    <string name="core_tools_provider_gifcities_desc">Internet Archive\'dan eski GeoCities GIF\'leri. Anahtar yok. Sonuçların içerik derecelendirmesi yoktur.</string>
    <string name="core_tools_provider_giphy_desc">GIF\'ler ve çıkartmalar. Her zaman kendi sekmesinde: GIPHY, uygulamaların sonuçlarını başkalarıyla karıştırmasına izin vermez.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Play hizmetleri aracılığıyla Google Home\'daki cihazlar. Her seferinde bir ev; hangisini seçeceğinize Google\'ın kendi ekranından karar verirsiniz.</string>
    <string name="core_tools_provider_google_translate">Google Çeviri</string>
    <string name="core_tools_provider_google_translate_desc">Google\'ın ücretsiz uç noktası veya bir anahtar eklediğinizde Bulut Çevirisi.</string>
    <string name="core_tools_provider_harper_desc">Klavyeye yerleşik dil bilgisi motoru. Sadece İngilizce içindir ve yazdığınız hiçbir şey telefondan çıkmaz.</string>
    <string name="core_tools_provider_home_assistant_desc">Kendi Home Assistant sunucunuz. Assist ile her şey canlı ve elinizin altında.</string>
    <string name="core_tools_provider_hue">Philips Hue köprüsü</string>
    <string name="core_tools_provider_hue_desc">Wi-Fi ağınızdaki bir Hue köprüsünden doğrudan ışıklar, odalar, sahneler ve sensörler. Hiçbir veri evden çıkmaz.</string>
    <string name="core_tools_provider_hugging_face_desc">Hugging Face\'in kendi çıkarım sunucularındaki modeller, ücretsiz aylık ödenek ile. Inference Providers iznine sahip bir erişim belirteci gerekir.</string>
    <string name="core_tools_provider_klipy_desc">GIF\'ler ve çıkartmalar. Bu derlemede yoksa bir KLIPY API anahtarı gerekir.</string>
    <string name="core_tools_provider_languagetool_desc">30\'dan fazla dilde dil bilgisi, imla ve üslup. Metniniz denetlenmesi için bir LanguageTool sunucusuna gönderilir: kendinizinkini girmediğiniz sürece api.languagetool.org adresindeki genel sunucu kullanılır.</string>
    <string name="core_tools_provider_librespeed_desc">Bir LibreSpeed sunucusu: Kendiniz çalıştırdığınız bir sunucu veya satırın kendi ekranında şehre göre seçilen, gönüllülerin herkese açık listedeki sunucularından biri.</string>
    <string name="core_tools_provider_libretranslate_desc">Bir LibreTranslate sunucusu: kendinizinki veya herkese açık bir sunucu. Herkese açık sunucular genellikle bir anahtar gerektirir.</string>
    <string name="core_tools_provider_lingva_desc">Bir Lingva sunucusu: Google Çeviri için ücretsiz bir arayüz.</string>
    <string name="core_tools_provider_lm_studio_desc">Bilgisayarınızda LM Studio tarafından sunulan modeller. Her bilgisayar için bir tane ekleyin.</string>
    <string name="core_tools_provider_mlkit">Cihaz üzerinde</string>
    <string name="core_tools_provider_mlkit_desc">ML Kit ile telefonda çeviri yapar. Metniniz telefonda kalır. Her dilin önce bir model indirmesi gerekir.</string>
    <string name="core_tools_provider_mode_fallback">Tek seferde bir tane</string>
    <string name="core_tools_provider_mode_fallback_desc">İlk sağlayıcıya sor. Başarısız olursa veya sonuç yoksa, sonrakine sor.</string>
    <string name="core_tools_provider_mode_mix">Karışık</string>
    <string name="core_tools_provider_mode_mix_desc">Tüm sağlayıcılara aynı anda sorun ve sonuçlarını tek bir ızgarada karıştırın.</string>
    <string name="core_tools_provider_mode_pick">Panelden seç</string>
    <string name="core_tools_provider_mode_pick_desc">Panel, açık olan sağlayıcıları gösterir. Oradan birini seçin, sadece o sorgulanacaktır.</string>
    <string name="core_tools_provider_mode_tabs">Sekmeler</string>
    <string name="core_tools_provider_mode_tabs_desc">Her sağlayıcının kendi çipi vardır. Sonuçlarını görmek için bir çipe dokunun.</string>
    <string name="core_tools_provider_moonshine_desc">Telefonda çalışan küçük ve hızlı bir İngilizce modeli.</string>
    <string name="core_tools_provider_mozhi_desc">Bir Mozhi sunucusu: Google, DeepL, DuckDuckGo, Yandex ve Reverso için ücretsiz bir arayüz. Motoru seçin. DeepL ve Reverso kaynak dili gerektirir.</string>
    <string name="core_tools_provider_music_server">Kendi tanıma sunucunuz</string>
    <string name="core_tools_provider_music_server_desc">AudD gibi yanıt veren, çalıştırdığınız bir sunucu: klip dosya olarak gönderilir ve şarkı JSON olarak geri döner. Arkasına Panako veya Olaf gibi bir parmak izi okuyucu yerleştirin.</string>
    <string name="core_tools_provider_nllb">Cihaz üzerinde (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Meta\'nın CTranslate2 üzerindeki NLLB-200 modeli ile telefonda çeviri yapar: Diğer motorların yapamadığı çiftler için 200 dil arasında çeviri. 630 MB\'lık tek bir indirme ile bir cümle birkaç saniyede çevrilir. Metniniz telefonda kalır. Model yalnızca ticari olmayan kullanım için lisanslanmıştır (CC BY-NC 4.0). 6 GB veya daha fazla belleğe sahip 64 bit bir telefon gerektirir.</string>
    <string name="core_tools_provider_none_on">Hiçbir sağlayıcı açık değil. Bu aracın ayarlarından birini açın.</string>
    <string name="core_tools_provider_offline_gifs">Çevrimdışı GIF paketleri</string>
    <string name="core_tools_provider_offline_gifs_desc">İçe aktardığınız GIF paketleri. Bağlantı olmadan çalışırlar.</string>
    <string name="core_tools_provider_ollama_desc">Bilgisayarınızda veya ağınızda çalıştırdığınız bir Ollama sunucusundaki modeller. Her sunucu için bir tane ekleyin.</string>
    <string name="core_tools_provider_omnilingual_desc">Meta\'nın 1.600 dil için tek modeli, yüzlercesi başka sesle yazma desteği olmadan, telefonda. Her ifade, kendisinden sonraki duraklamada ulaşır.</string>
    <string name="core_tools_provider_on_device_ai">Cihazınızda</string>
    <string name="core_tools_provider_on_device_ai_desc">Bu telefona indirilmiş bir model. Yazdığınız hiçbir şey cihazdan çıkmaz. Modeli AI sayfasından seçip indirin.</string>
    <string name="core_tools_provider_on_device_image">Bu telefonda</string>
    <string name="core_tools_provider_on_device_image_desc">Bu telefona indirilmiş veya içe aktardığınız bir model. Yazdığınız hiçbir şey cihazdan çıkmaz. Oluşturucu ekranından modeli seçin.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI uyumlu hizmet</string>
    <string name="core_tools_provider_openai_compatible_desc">OpenAI sohbet API\'sini destekleyen diğer tüm hizmetler: OpenRouter, Groq, Mistral, Together veya kendi ağ geçidiniz. Adresi sürüm kısmına kadar yazın; örneğin: https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI uyumlu görseller</string>
    <string name="core_tools_provider_openai_compatible_image_desc">OpenAI\'ın görsel API\'sini kullanan diğer tüm hizmetler: LocalAI, DeepInfra, Nebius veya kendi ağ geçidiniz. Adresi sürüm kısmına kadar girin, örneğin: https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Kendi anahtarınızla OpenAI API\'si üzerinden GPT modelleri.</string>
    <string name="core_tools_provider_openai_image">OpenAI Görselleri</string>
    <string name="core_tools_provider_openai_image_desc">Şeffaf bir arka plan üzerinde çıkartmalar çizen GPT Görsel. Resim başına ücretlendirilir. Boş bir anahtar, AI aracındaki OpenAI anahtarını kullanır.</string>
    <string name="core_tools_provider_openhab_desc">Bir openHAB sunucusu: öğeleri, canlı olarak, anlamsal modeldeki odalarla birlikte.</string>
    <string name="core_tools_provider_parakeet_desc">Telefonda çalışan ve 25 Avrupa dilini anlayan büyük bir model.</string>
    <string name="core_tools_provider_pexels_desc">Pexels\'ten fotoğraflar. Bu derlemede bir tane yoksa, bir API anahtarı gerekir.</string>
    <string name="core_tools_provider_pollinations_desc">Ücretsiz, anahtarsız ve hesapsız: istem, modeli seçen Pollinations\'a gönderilir. enter.pollinations.ai adresinden alınan bir anahtar, daha yeni API\'sini açar ve bir model ismi girmenize izin verir.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (resmi değil, RapidAPI aracılığıyla)</string>
    <string name="core_tools_provider_rapid_shazam_desc">RapidAPI anahtarı ile RapidAPI üzerindeki resmi olmayan bir liste aracılığıyla Shazam kataloğu. Apple hizmeti değildir: liste haber verilmeksizin değişebilir veya durabilir. Her klip RapidAPI\'ye gönderilir.</string>
    <string name="core_tools_provider_recraft_desc">İllüstrasyonlar, simgeler ve vektör tarzı sanat. recraft.ai\'den bir anahtar gerekir.</string>
    <string name="core_tools_provider_rens_desc">Bir Rens sunucusu: Google Lens için ücretsiz bir ön uç. Çoğu yazı sisteminde, fotoğraftaki metni sizin için okur.</string>
    <string name="core_tools_provider_rens_translate_desc">Bir Rens sunucusu: Google Lens için ücretsiz bir arayüz. Fotoğrafı metni çevrilmiş şekilde geri verir.</string>
    <string name="core_tools_provider_replicate_desc">Binlerce barındırılan model. Herhangi bir metinden görüntüye modelini sahip/ad olarak adlandırın; boş olduğunda FLUX Schnell kullanılır.</string>
    <string name="core_tools_provider_same_kind_fallback">Yedek olarak</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Aynı türdeki sağlayıcılar tek bir birim gibi hareket eder. Önce ilkine sorulur, ancak başarısız olduğunda (örneğin kota dolduğunda) diğerine geçilir.</string>
    <string name="core_tools_provider_same_kind_separate">Ayrı ayrı</string>
    <string name="core_tools_provider_same_kind_separate_desc">Her biri kendi sağlayıcısıdır: kendi çipi, paneldeki kendi seçeneği, karma bir ızgaradaki kendi payı.</string>
    <string name="core_tools_provider_searxng_desc">JSON sonuçlarına izin veren bir SearXNG örneği. Çoğu genel örnek buna izin vermez.</string>
    <string name="core_tools_provider_sherpa_desc">Bangla dahil 13 dil için, telefonda siz konuşurken yazan akış modelleri.</string>
    <string name="core_tools_provider_simplytranslate_desc">Bir SimplyTranslate sunucusu: Google ve diğer motorlar için ücretsiz bir arayüz.</string>
    <string name="core_tools_provider_smartthings_desc">Samsung bulutu aracılığıyla SmartThings cihazlarınız, odalarınız ve sahneleriniz. Panel açıkken durumlar yenilenir.</string>
    <string name="core_tools_provider_stability_desc">Stable Diffusion\'ın yapımcılarından Stable Image Core, Ultra ve Stable Diffusion 3.5. Kredi ile ödenir; platform.stability.ai adresinden bir anahtar gerektirir.</string>
    <string name="core_tools_provider_sticker_packs_desc">Bu telefondaki çıkartma paketleriniz.</string>
    <string name="core_tools_provider_switchbot_desc">SwitchBot cihazlarınız, kızılötesi uzaktan kumandalarınız ve sahneleriniz, uygulamasından alınan belirteç ile SwitchBot bulutu üzerinden yönetilir. Panel açıkken durumlar dakikada bir yenilenir.</string>
    <string name="core_tools_provider_system_recognizer">Telefonun tanıyıcısı</string>
    <string name="core_tools_provider_system_recognizer_desc">Telefonla birlikte gelen, genellikle Google\'ın ses tanıma aracı. Siz konuştukça kelimeler görünür.</string>
    <string name="core_tools_provider_tavily_desc">Kısa cevaplı web araması. Tavily anahtarınız gerekir.</string>
    <string name="core_tools_provider_together_desc">Together sunucularında FLUX ve diğer açık modeller.</string>
