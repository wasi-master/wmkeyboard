    <string name="core_tools_provider_acrcloud_desc">Služba na rozpoznávanie hudby s dvojtýždňovou skúšobnou dobou, po ktorej nasledujú platené programy. Vyžaduje hostiteľa, prístupový kľúč a prístupový tajný kľúč k projektu zo stránky console.acrcloud.com. Každý klip sa odosiela do ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Bezplatná služba Stable Diffusion na počítačoch dobrovoľníkov. Funguje bez kľúča, ale čaká sa v rade; bezplatný kľúč z aihorde.net vás v rade posunie dopredu.</string>
    <string name="core_tools_provider_anthropic_desc">Modely Claude cez API Anthropic s vaším vlastným kľúčom.</string>
    <string name="core_tools_provider_asr4all_desc">Anglické diktovanie v telefóne, so slovami, ktoré sa objavujú počas rozprávania.</string>
    <string name="core_tools_provider_audd_desc">Rozpozná väčšinu vydanej hudby z niekoľkých sekúnd zvuku. Vyžaduje token z dashboard.audd.io; niekoľko stoviek rozpoznaní je zadarmo, potom je služba platená. Každý klip sa odošle do AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Malá rozpoznávacia služba, bezplatná na osobné použitie s kľúčom z audiotag.info, pomalšia ako ostatné: odpovedá po niekoľkých sekundách. Každý klip sa odosiela do AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge alebo SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Vaše vlastné používateľské rozhranie Stable Diffusion, spustené s príkazom --api. Zadajte jeho adresu, napríklad http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">V zariadení (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Prekladá v telefóne pomocou nástroja Mozilla Bergamot a modelov Firefox Translations. Slobodný softvér, žiadne služby Google a váš text zostáva v telefóne. Každý smer (z francúzštiny do angličtiny, z angličtiny do francúzštiny) vyžaduje stiahnutie ďalších 14 až 37 MB. Vyžaduje 64-bitový telefón s Androidom 9 alebo novším.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">Modely FLUX od ľudí, ktorí ich vytvorili. Vyžaduje kľúč z bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Odpovede podložené webovým vyhľadávaním Brave. Vyžaduje kľúč s plánom Answers. Ak zostane prázdny, použije sa kľúč Brave Search, ktorý ste zadali pre webové vyhľadávanie.</string>
    <string name="core_tools_provider_brave_desc">Vyhľadávanie na webe a obrázkov. Vyžaduje kľúč Brave Search API, pokiaľ ho táto verzia nemá.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX a Stable Diffusion na Cloudflare, s bezplatným denným limitom. Vyžaduje API token a vaše ID účtu.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Testovacie servery rýchlosti Cloudflare, najbližšie z ich dátových centier. Nevyžaduje účet a povie karte, v akej sieti sa nachádzate a ktoré mesto odpovedalo.</string>
    <string name="core_tools_provider_coinbase_desc">Meny a mince z Coinbase. Bez kľúča.</string>
    <string name="core_tools_provider_coingecko_desc">Ceny mincí z CoinGecko. Bez kľúča.</string>
    <string name="core_tools_provider_comfyui_desc">Váš vlastný ComfyUI server. Kreslí pomocou pracovného postupu text-to-image a checkpointu, ktorý pomenujete, alebo prvého, ktorý je k dispozícii.</string>
    <string name="core_tools_provider_commons_desc">Bezplatné GIFy a fotografie z Wikimedia Commons alebo z vašej vlastnej MediaWiki. Žiadny kľúč. GIFy sú väčšinou vzdelávacie.</string>
    <string name="core_tools_provider_currency_api_desc">Otvorené dáta pre väčšinu mien a mnohé mince. Bez kľúča.</string>
    <string name="core_tools_provider_deepl_desc">Vyžaduje váš kľúč DeepL API alebo adresu proxy servera, ktorý ho pridáva.</string>
    <string name="core_tools_provider_deepseek_desc">Modely DeepSeek prostredníctvom API DeepSeek s vaším vlastným kľúčom.</string>
    <string name="core_tools_provider_er_api_desc">Denné kurzy pre väčšinu mien. Žiadny kľúč.</string>
    <string name="core_tools_provider_fal_desc">Rýchle hostované modely: FLUX, Recraft, Ideogram, Qwen Image a ďalšie. Zadajte fal id modelu; ak je prázdne, použije sa FLUX Schnell.</string>
    <string name="core_tools_provider_frankfurter_desc">Kurzy Európskej centrálnej banky pre hlavné meny. Slobodný softvér, bez kľúča.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modely Gemini cez API spoločnosti Google s vaším vlastným kľúčom z AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Obrázky Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modely obrázkov Nano Banana od Googlu. Prázdny kľúč použije kľúč Gemini z nástroja AI.</string>
    <string name="core_tools_provider_gifcities_desc">Staré GIFy z GeoCities z Internet Archive. Žiadny kľúč. Výsledky nemajú hodnotenie obsahu.</string>
    <string name="core_tools_provider_giphy_desc">GIFy a nálepky. Vždy na vlastnej karte: GIPHY nedovoľuje aplikáciám miešať svoje výsledky s inými.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Zariadenia vo vašom Google Home prostredníctvom služieb Play. Vždy jedna domácnosť; ktorú si vyberiete, určíte na vlastnej obrazovke Google.</string>
    <string name="core_tools_provider_google_translate">Prekladač Google</string>
    <string name="core_tools_provider_google_translate_desc">Bezplatný koncový bod od Googlu alebo Cloud Translation, ak pridáte kľúč.</string>
    <string name="core_tools_provider_harper_desc">Gramatický modul zabudovaný v klávesnici. Len v angličtine a nič, čo napíšete, neopustí telefón.</string>
    <string name="core_tools_provider_home_assistant_desc">Váš vlastný server Home Assistant. Všetky druhy vecí, naživo, s Assist.</string>
    <string name="core_tools_provider_hue">Mostík Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Svetlá, miestnosti, scény a senzory priamo z mostíka Hue vo vašej Wi-Fi sieti. Nič neopustí dom.</string>
    <string name="core_tools_provider_hugging_face_desc">Modely na vlastných inferenčných serveroch Hugging Face s bezplatným mesačným príspevkom. Vyžaduje prístupový token s povolením Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIFy a nálepky. Vyžaduje kľúč KLIPY API, pokiaľ ho táto verzia nemá.</string>
    <string name="core_tools_provider_languagetool_desc">Gramatika, pravopis a štýl vo viac ako 30 jazykoch. Váš text sa odosiela na server LanguageTool na kontrolu: na verejný server api.languagetool.org, pokiaľ nezadáte vlastný.</string>
    <string name="core_tools_provider_librespeed_desc">Server LibreSpeed: taký, ktorý prevádzkujete sami, alebo jeden zo serverov dobrovoľníkov z verejného zoznamu, vybraný podľa mesta na vlastnej obrazovke daného riadku.</string>
    <string name="core_tools_provider_libretranslate_desc">Server LibreTranslate: váš vlastný alebo verejný. Verejné servery zvyčajne vyžadujú kľúč.</string>
    <string name="core_tools_provider_lingva_desc">Server Lingva: bezplatné rozhranie pre Prekladač Google.</string>
    <string name="core_tools_provider_lm_studio_desc">Modely poskytované LM Studio vo vašom počítači. Pridajte jeden pre každý počítač.</string>
    <string name="core_tools_provider_mlkit">V zariadení</string>
    <string name="core_tools_provider_mlkit_desc">Prekladá v telefóne pomocou ML Kit. Váš text zostáva v telefóne. Pre každý jazyk je najprv potrebné stiahnuť model.</string>
    <string name="core_tools_provider_mode_fallback">Jeden po druhom</string>
    <string name="core_tools_provider_mode_fallback_desc">Opýtajte sa prvého poskytovateľa. Ak zlyhá alebo nemá žiadne výsledky, opýtajte sa ďalšieho.</string>
    <string name="core_tools_provider_mode_mix">Zmiešané</string>
    <string name="core_tools_provider_mode_mix_desc">Požiadajte všetkých poskytovateľov súčasne a zmiešajte ich výsledky do jednej mriežky.</string>
    <string name="core_tools_provider_mode_pick">Vybrať na paneli</string>
    <string name="core_tools_provider_mode_pick_desc">Panel zobrazuje poskytovateľov, ktorí sú zapnutí. Vyberte jedného z nich a dopyt bude smerovaný len na neho.</string>
    <string name="core_tools_provider_mode_tabs">Karty</string>
    <string name="core_tools_provider_mode_tabs_desc">Každý poskytovateľ má svoju vlastnú kartu. Klepnutím na kartu zobrazíte jej výsledky.</string>
    <string name="core_tools_provider_moonshine_desc">Malý, rýchly anglický model, ktorý beží v telefóne.</string>
    <string name="core_tools_provider_mozhi_desc">Server Mozhi: bezplatné rozhranie pre Google, DeepL, DuckDuckGo, Yandex a Reverso. Vyberte si engine. DeepL a Reverso vyžadujú zdrojový jazyk.</string>
    <string name="core_tools_provider_music_server">Váš vlastný server na rozpoznávanie</string>
    <string name="core_tools_provider_music_server_desc">Server, ktorý prevádzkujete a odpovedá ako AudD: klip sa odošle ako súbor a skladba sa vráti ako JSON. Vložte zaň nástroj na tvorbu odtlačkov, ako je Panako alebo Olaf.</string>
    <string name="core_tools_provider_nllb">V zariadení (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Prekladá priamo v telefóne pomocou modelu NLLB-200 od spoločnosti Meta na platforme CTranslate2: 200 jazykov, medzi akýmikoľvek dvoma z nich, pre páry, ktoré iné nástroje nezvládnu. Jedno stiahnutie s veľkosťou 630 MB, veta trvá niekoľko sekúnd. Váš text zostáva v telefóne. Model je licencovaný len na nekomerčné použitie (CC BY-NC 4.0). Vyžaduje 64-bitový telefón so 6 GB pamäte alebo viac.</string>
    <string name="core_tools_provider_none_on">Žiadny poskytovateľ nie je zapnutý. Zapnite jedného v nastaveniach tohto nástroja.</string>
    <string name="core_tools_provider_offline_gifs">Offline balíky GIFov</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF balíčky, ktoré ste importovali. Fungujú bez pripojenia.</string>
    <string name="core_tools_provider_ollama_desc">Modely na serveri Ollama, ktorý prevádzkujete vo svojom počítači alebo sieti. Pridajte jeden pre každý server.</string>
    <string name="core_tools_provider_omnilingual_desc">Jeden model od spoločnosti Meta pre 1600 jazykov, stovky z nich bez iného hlasového písania, priamo v telefóne. Každá fráza príde až po prestávke.</string>
    <string name="core_tools_provider_on_device_ai">Vo vašom zariadení</string>
    <string name="core_tools_provider_on_device_ai_desc">Model stiahnutý do tohto telefónu. Nič, čo napíšete, ho neopustí. Vyberte a stiahnite model na stránke AI.</string>
    <string name="core_tools_provider_on_device_image">V tomto telefóne</string>
    <string name="core_tools_provider_on_device_image_desc">Model stiahnutý do tohto telefónu alebo model, ktorý ste importovali. Nič, čo napíšete, z neho neopustí zariadenie. Vyberte model na obrazovke generátora.</string>
    <string name="core_tools_provider_openai_compatible">Služba kompatibilná s OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Akákoľvek iná služba s rozhraním OpenAI chat API: OpenRouter, Groq, Mistral, Together alebo vaša vlastná brána. Zadajte adresu až po verziu, napríklad https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Obrázky kompatibilné s OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Akákoľvek iná služba s obrazovým API OpenAI: LocalAI, DeepInfra, Nebius alebo vaša vlastná brána. Zadajte adresu až po verziu, napríklad https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modely GPT cez API spoločnosti OpenAI s vaším vlastným kľúčom.</string>
    <string name="core_tools_provider_openai_image">Obrázky OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, ktorý kreslí nálepky na priehľadnom pozadí. Platí sa za obrázok. Prázdny kľúč použije kľúč OpenAI z nástroja AI.</string>
    <string name="core_tools_provider_openhab_desc">Server openHAB: jeho položky, naživo, s miestnosťami zo sémantického modelu.</string>
    <string name="core_tools_provider_parakeet_desc">Veľký model, ktorý beží v telefóne a rozumie 25 európskym jazykom.</string>
    <string name="core_tools_provider_pexels_desc">Fotografie z Pexels. Vyžaduje kľúč API, pokiaľ ho toto zostavenie nemá.</string>
    <string name="core_tools_provider_pollinations_desc">Zadarmo, bez kľúča a bez účtu: výzva sa odošle do služby Pollinations, ktorá vyberie model. Kľúč zo stránky enter.pollinations.ai sprístupní novšie API a umožní vám zadať názov modelu.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (neoficiálny, cez RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Katalóg Shazam prostredníctvom neoficiálneho zoznamu na RapidAPI, s kľúčom RapidAPI. Nejde o službu Apple: zoznam sa môže zmeniť alebo prestať fungovať bez upozornenia. Každý klip sa odosiela do RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Ilustrácie, ikony a umenie vo vektorovom štýle. Vyžaduje kľúč z recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Server Rens: bezplatné rozhranie pre Google Lens. Prečíta za vás text na fotografii vo väčšine písiem.</string>
    <string name="core_tools_provider_rens_translate_desc">Server Rens: bezplatné rozhranie pre Google Lens. Vráti fotografiu s preloženým textom.</string>
    <string name="core_tools_provider_replicate_desc">Tisíce hostovaných modelov. Pomenujte akýkoľvek model prevodu textu na obrázok ako vlastník/názov; FLUX Schnell, ak je prázdne.</string>
    <string name="core_tools_provider_same_kind_fallback">Ako zálohy</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Poskytovatelia rovnakého druhu fungujú ako jeden. Najprv sa osloví prvý a ďalší až vtedy, keď prvý zlyhá, napríklad keď kľúču dôjde kvóta.</string>
    <string name="core_tools_provider_same_kind_separate">Samostatne</string>
    <string name="core_tools_provider_same_kind_separate_desc">Každý je vlastným poskytovateľom: vlastný čip, vlastná voľba v paneli, vlastný podiel v zmiešanej mriežke.</string>
    <string name="core_tools_provider_searxng_desc">Inštancia SearXNG, ktorá umožňuje výsledky vo formáte JSON. Väčšina verejných inštancií to neumožňuje.</string>
    <string name="core_tools_provider_sherpa_desc">Streamovacie modely pre 13 jazykov vrátane bengálčiny, ktoré píšu počas rozprávania priamo v telefóne.</string>
    <string name="core_tools_provider_simplytranslate_desc">Server SimplyTranslate: bezplatné rozhranie pre Google a iné vyhľadávače.</string>
    <string name="core_tools_provider_smartthings_desc">Vaše zariadenia, miestnosti a scény SmartThings prostredníctvom cloudu spoločnosti Samsung. Stavy sa obnovujú, kým je panel otvorený.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra a Stable Diffusion 3.5 od tvorcov Stable Diffusion. Platené kreditmi; vyžaduje kľúč z platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Vaše balíky nálepiek v tomto telefóne.</string>
    <string name="core_tools_provider_switchbot_desc">Vaše zariadenia SwitchBot, infračervené ovládače a scény prostredníctvom cloudu SwitchBot s tokenom z jeho aplikácie. Stavy sa obnovujú raz za minútu, kým je panel otvorený.</string>
    <string name="core_tools_provider_system_recognizer">Rozpoznávač telefónu</string>
    <string name="core_tools_provider_system_recognizer_desc">Rozpoznávač reči, ktorý je súčasťou telefónu, zvyčajne od Googlu. Slová sa zobrazujú počas rozprávania.</string>
    <string name="core_tools_provider_tavily_desc">Vyhľadávanie na webe s krátkou odpoveďou. Vyžaduje váš kľúč Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX a ďalšie otvorené modely na serveroch Together.</string>
