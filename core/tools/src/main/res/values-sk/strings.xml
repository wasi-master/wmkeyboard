    <string name="core_tools_dictionary_source_imported">Importované slovníky</string>
    <string name="core_tools_dictionary_source_imported_desc">V tomto zariadení. Slovníky Yomichan a Yomitan, ktoré importujete v akomkoľvek jazyku, s výslovnosťou a prízvukom.</string>
    <string name="core_tools_dictionary_source_offline_bengali">Bengálsko-anglický Wiktionary</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">V tomto zariadení po stiahnutí. Bengálske slová s ich anglickými významami a výslovnosťou.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, offline</string>
    <string name="core_tools_dictionary_source_offline_wiktionary_desc">V tomto zariadení, po stiahnutí. Bežné anglické slová z Wiktionary, s výslovnosťou.</string>
    <string name="core_tools_dictionary_source_offline_wordnet">Open English WordNet</string>
    <string name="core_tools_dictionary_source_offline_wordnet_desc">V tomto zariadení, po stiahnutí. Každé anglické slovo vo WordNet, s krátkymi definíciami.</string>
    <string name="core_tools_dictionary_source_vocab_packs">Balíky slovnej zásoby</string>
