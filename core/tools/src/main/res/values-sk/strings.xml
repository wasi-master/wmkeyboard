    <string name="core_tools_provider_transcription_server">Server na prepis</string>
    <string name="core_tools_provider_transcription_server_desc">Server, ktorý využíva API pre prepis zvuku od OpenAI: speaches, server whisper.cpp, LocalAI, Groq alebo OpenAI. Každý klip sa naň odošle, keď prestanete hovoriť.</string>
    <string name="core_tools_provider_translate_server">Váš prekladový server</string>
    <string name="core_tools_provider_translate_server_desc">Server, ktorý odpovedá na chatovacie požiadavky OpenAI: llama.cpp, Ollama, LM Studio, vLLM alebo brána.</string>
    <string name="core_tools_provider_translite_desc">Server Translite: bezplatné front-end rozhranie pre Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Zariadenia, miestnosti a scény Smart Life a Tuya Smart prostredníctvom bezplatného projektu pre vývojárov Tuya prepojeného s vaším účtom aplikácie. Stavy sa obnovujú, kým je panel otvorený.</string>
    <string name="core_tools_provider_unsplash_desc">Fotografie z Unsplash. Vyžaduje kľúč API, pokiaľ ho táto verzia nemá.</string>
    <string name="core_tools_provider_vision_ocr">Váš model videnia</string>
    <string name="core_tools_provider_vision_ocr_desc">Model, ktorý číta obrázky prostredníctvom servera, ktorý odpovedá na požiadavky OpenAI chatu. Vyžaduje adresu a názov modelu.</string>
    <string name="core_tools_provider_whisper_desc">Modely Whisper od OpenAI spustené v telefóne. Mnoho jazykov; stiahnite si model na stránke Hlasové písanie.</string>
    <string name="core_tools_provider_whistle_desc">Malý, rýchly model, ktorý beží v telefóne. Stiahnite si ho na stránke Hlasové písanie.</string>
    <string name="core_tools_provider_xai_desc">Modely Grok cez API xAI s vaším vlastným kľúčom.</string>
    <string name="core_tools_provider_xai_image">Grok Imagine</string>
    <string name="core_tools_provider_xai_image_desc">Model obrázkov od xAI. Prázdny kľúč použije kľúč xAI z nástroja AI.</string>
