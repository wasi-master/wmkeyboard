    <string name="core_tools_provider_acrcloud_desc">Tónlistarþjónusta með tveggja vikna prufutímabili og síðan greiddum áskriftarleiðum. Þarfnast hýsis, aðgangslykils og aðgangslykilorðs fyrir verkefni af console.acrcloud.com. Hvert brot er sent til ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Ókeypis Stable Diffusion á tölvum sjálfboðaliða. Virkar án lykils en bíður í biðröð; ókeypis lykill frá aihorde.net færir þig framar í röðina.</string>
    <string name="core_tools_provider_anthropic_desc">Claude-líkön í gegnum API Anthropic, með þínum eigin lykli.</string>
    <string name="core_tools_provider_asr4all_desc">Ensk talsetning í símanum, þar sem orð birtast eftir því sem þú talar.</string>
    <string name="core_tools_provider_audd_desc">Þekkir flest útgefin lög út frá nokkurra sekúndna hljóði. Þarf auðkenni frá dashboard.audd.io; nokkur hundruð þekkingar eru ókeypis, eftir það er greitt fyrir þær. Hver bútur er sendur til AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Lítil auðkenningarþjónusta, ókeypis til einkanota með lykli frá audiotag.info, og hægari en hinar: hún svarar eftir nokkrar sekúndur. Hvert brot er sent til AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge eða SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">Þitt eigið Stable Diffusion vefviðmót, ræst með --api. Gefðu upp vistfang þess, til dæmis http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Í tæki (Firefox þýðingar)</string>
    <string name="core_tools_provider_bergamot_desc">Þýðir í símanum með Bergamot-vél Mozilla og Firefox-þýðingalíkönunum. Frjáls hugbúnaður, engin Google-þjónusta og textinn þinn helst í símanum. Hver stefna (franska yfir á ensku, enska yfir á frönsku) er sér niðurhal upp á 14 til 37 MB. Krefst 64-bita síma með Android 9 eða nýrra.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">FLUX-líkönin frá fólkinu sem bjó þau til. Þarfnast lykils frá bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave leit</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Svör byggð á Brave vefleit. Krefst lykils með Answers-áskrift. Ef skilið eftir autt er reynt að nota Brave Search-lykilinn sem þú slóst inn fyrir vefleit.</string>
    <string name="core_tools_provider_brave_desc">Vef- og myndleit. Þarfnast Brave Search API-lykils, nema þessi útgáfa sé með einn.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX og Stable Diffusion á Cloudflare, með ókeypis daglegum kvóta. Þarfnast API-lykils og auðkennis reikningsins þíns.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Hraðaprófunarþjónar Cloudflare, næstu gagnaver þeirra. Þarfnast ekki reiknings og segir kortinu hvaða neti þú ert á og hvaða borg svaraði.</string>
    <string name="core_tools_provider_coinbase_desc">Gjaldmiðlar og myntir frá Coinbase. Enginn lykill.</string>
    <string name="core_tools_provider_coingecko_desc">Myntverð frá CoinGecko. Enginn lykill.</string>
    <string name="core_tools_provider_comfyui_desc">Þinn eigin ComfyUI netþjónn. Teiknar með einföldu texta-í-mynd vinnuflæði og eftirlitsstöðinni sem þú nefnir, eða þeirri fyrstu sem hann hefur.</string>
    <string name="core_tools_provider_commons_desc">Ókeypis GIF-myndir og ljósmyndir frá Wikimedia Commons, eða frá þínu eigin MediaWiki. Enginn lykill. GIF-myndirnar eru að mestu fræðandi.</string>
    <string name="core_tools_provider_currency_api_desc">Opin gögn fyrir flesta gjaldmiðla og marga myntir. Enginn lykill.</string>
    <string name="core_tools_provider_deepl_desc">Þarfnast DeepL API lykilsins þíns, eða vistfangs á proxy sem bætir honum við.</string>
    <string name="core_tools_provider_deepseek_desc">DeepSeek-líkön í gegnum API frá DeepSeek, með þínum eigin lykli.</string>
    <string name="core_tools_provider_er_api_desc">Daglegt gengi flestra gjaldmiðla. Enginn lykill.</string>
    <string name="core_tools_provider_fal_desc">Hýst líkön: FLUX, Recraft, Ideogram, Qwen Image og fleira. Nefndu fal-auðkenni líkansins; FLUX Schnell þegar autt.</string>
    <string name="core_tools_provider_frankfurter_desc">Gengi Evrópska seðlabankans fyrir helstu gjaldmiðla. Frjáls hugbúnaður, enginn lykill.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Gemini-líkön í gegnum API Google, með þínum eigin lykli frá AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Gemini myndir</string>
    <string name="core_tools_provider_gemini_image_desc">Nano Banana myndlíkön Google. Auður lykill notar Gemini-lykilinn úr AI-tólinu.</string>
    <string name="core_tools_provider_gifcities_desc">Gömul GeoCities GIF-myndir frá Internet Archive. Enginn lykill. Niðurstöðurnar hafa enga efnisflokkun.</string>
    <string name="core_tools_provider_giphy_desc">GIF-myndir og límmiðar. Alltaf í eigin flipa: GIPHY leyfir ekki öppum að blanda niðurstöðum sínum við aðrar.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">Tækin í Google Home, í gegnum Play-þjónustur. Eitt heimili í einu; þú velur hvaða heimili í eigin skjá Google.</string>
    <string name="core_tools_provider_google_translate">Google Translate</string>
    <string name="core_tools_provider_google_translate_desc">Ókeypis endapunktur Google, eða Cloud Translation þegar þú bætir við lykli.</string>
    <string name="core_tools_provider_harper_desc">Málfræðivélin sem er innbyggð í lyklaborðið. Aðeins enska og ekkert af því sem þú slærð inn yfirgefur símann.</string>
    <string name="core_tools_provider_home_assistant_desc">Þinn eigin Home Assistant netþjónn. Alls konar hlutir, í beinni, með Assist.</string>
    <string name="core_tools_provider_hue">Philips Hue brú</string>
    <string name="core_tools_provider_hue_desc">Ljós, herbergi, senur og skynjarar beint frá Hue-brú á Wi-Fi netinu þínu. Ekkert fer út úr húsinu.</string>
    <string name="core_tools_provider_hugging_face_desc">Líkön á eigin ályktunarþjónum Hugging Face, með ókeypis mánaðarlegum kvóta. Þarfnast aðgangstákn með Inference Providers heimild.</string>
    <string name="core_tools_provider_klipy_desc">GIF-myndir og límmiðar. Þarfnast KLIPY API-lykils, nema þessi útgáfa sé með einn.</string>
    <string name="core_tools_provider_languagetool_desc">Málfar, stafsetning og stíll á yfir 30 tungumálum. Textinn þinn er sendur á LanguageTool-þjón til yfirferðar: þann opinbera á api.languagetool.org nema þú tilgreinir eigin þjón.</string>
    <string name="core_tools_provider_librespeed_desc">LibreSpeed-þjónn: einn sem þú rekur sjálfur, eða einn af þjónum sjálfboðaliða af opinbera listanum, valinn eftir borg á eigin skjá raðarinnar.</string>
    <string name="core_tools_provider_libretranslate_desc">LibreTranslate-þjónn: þinn eigin eða opinber. Opinberir þjónar þurfa yfirleitt lykil.</string>
    <string name="core_tools_provider_lingva_desc">Lingva-þjónn: ókeypis viðmót fyrir Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">Líkön sem LM Studio á tölvunni þinni þjónar. Bættu við einu fyrir hverja tölvu.</string>
    <string name="core_tools_provider_mlkit">Í tæki</string>
    <string name="core_tools_provider_mlkit_desc">Þýðir í símanum með ML Kit. Textinn þinn helst í símanum. Hvert tungumál þarf að hlaða niður líkani fyrst.</string>
    <string name="core_tools_provider_mode_fallback">Einn í einu</string>
    <string name="core_tools_provider_mode_fallback_desc">Spyrja fyrsta veituna. Ef hún mistekst eða hefur engar niðurstöður, spyrja þá næstu.</string>
    <string name="core_tools_provider_mode_mix">Blandað</string>
    <string name="core_tools_provider_mode_mix_desc">Spyrðu alla veitendur á sama tíma og blandaðu niðurstöðum þeirra í eitt net.</string>
    <string name="core_tools_provider_mode_pick">Velja í spjaldinu</string>
    <string name="core_tools_provider_mode_pick_desc">Spjaldið sýnir hvaða veitendur eru virkir. Veldu einn af þeim og aðeins verður leitað til hans.</string>
    <string name="core_tools_provider_mode_tabs">Flipar</string>
    <string name="core_tools_provider_mode_tabs_desc">Hver veita fær sinn eigin flís. Bankaðu á flís til að sjá niðurstöður hennar.</string>
    <string name="core_tools_provider_moonshine_desc">Lítið og fljótvirkt enskumælandi líkan sem keyrir á símanum.</string>
    <string name="core_tools_provider_mozhi_desc">Mozhi-þjónn: ókeypis viðmót fyrir Google, DeepL, DuckDuckGo, Yandex og Reverso. Veldu vélina. DeepL og Reverso þurfa upprunamál.</string>
    <string name="core_tools_provider_music_server">Þinn eigin auðkenningarþjónn</string>
    <string name="core_tools_provider_music_server_desc">Miðlari sem þú keyrir sem svarar eins og AudD: klippan er send sem skrá og lagið kemur til baka sem JSON. Settu fingrafaralesara eins og Panako eða Olaf á bak við hann.</string>
    <string name="core_tools_provider_nllb">Í tæki (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Þýðir í símanum með NLLB-200 líkani Meta á CTranslate2: 200 tungumál, á milli hvaða tveggja sem er, fyrir pörin sem aðrar vélar geta ekki gert. Eitt niðurhal upp á 630 MB, og setning tekur nokkrar sekúndur. Textinn þinn helst í símanum. Líkanið er aðeins leyft til notkunar sem ekki er í viðskiptaskyni (CC BY-NC 4.0). Þarf 64-bita síma með 6 GB af minni eða meira.</string>
    <string name="core_tools_provider_none_on">Engin veita er virk. Virkjaðu eina í stillingum þessa tóls.</string>
    <string name="core_tools_provider_offline_gifs">Ótengdir GIF pakkar</string>
    <string name="core_tools_provider_offline_gifs_desc">GIF-pakkar sem þú fluttir inn. Þeir virka án nettengingar.</string>
    <string name="core_tools_provider_ollama_desc">Módel á Ollama-þjóni sem þú keyrir, á tölvunni þinni eða netinu þínu. Bættu við einum fyrir hvern þjón.</string>
    <string name="core_tools_provider_omnilingual_desc">Eitt líkan frá Meta fyrir 1.600 tungumál, hundruð þeirra án annars raddinnsláttar, í símanum. Hver setning berst við hléið á eftir henni.</string>
    <string name="core_tools_provider_on_device_ai">Í tækinu þínu</string>
    <string name="core_tools_provider_on_device_ai_desc">Líkan sem hlaðið er niður í þennan síma. Ekkert sem þú skrifar fer út úr honum. Veldu og halaðu niður líkaninu á AI-síðunni.</string>
    <string name="core_tools_provider_on_device_image">Í þessum síma</string>
    <string name="core_tools_provider_on_device_image_desc">Líkan hlaðið niður í þennan síma, eða eitt sem þú fluttir inn. Ekkert sem þú skrifar fer út úr því. Veldu líkanið á skjá rafallins.</string>
    <string name="core_tools_provider_openai_compatible">OpenAI-samhæfð þjónusta</string>
    <string name="core_tools_provider_openai_compatible_desc">Önnur þjónusta með spjall-API frá OpenAI: OpenRouter, Groq, Mistral, Together, eða þín eigin gátt. Gefðu upp vistfangið að útgáfunni, svo sem https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">OpenAI-samhæfðar myndir</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Öll önnur þjónusta með myndaviðmóti OpenAI: LocalAI, DeepInfra, Nebius eða þín eigin gátt. Gefðu upp slóðina að útgáfunni, svo sem https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">GPT-gerðir í gegnum API OpenAI, með þínum eigin lykli.</string>
    <string name="core_tools_provider_openai_image">OpenAI myndir</string>
    <string name="core_tools_provider_openai_image_desc">GPT mynd, sem teiknar límmiða á gagnsæjan bakgrunn. Greitt fyrir hverja mynd. Tómur lykill notar OpenAI lykilinn úr gervigreindarverkfærinu.</string>
    <string name="core_tools_provider_openhab_desc">openHAB-miðlari: hlutir hans, í beinni, með herbergjum úr merkingarfræðilega líkaninu.</string>
    <string name="core_tools_provider_parakeet_desc">Stórt líkan sem keyrir í símanum og skilur 25 evrópsk tungumál.</string>
    <string name="core_tools_provider_pexels_desc">Myndir frá Pexels. Þarfnast API-lykils, nema þessi útgáfa sé með einn.</string>
    <string name="core_tools_provider_pollinations_desc">Ókeypis, án lykils og án reiknings: leiðbeiningin er send til Pollinations, sem velur módelið. Lykill frá enter.pollinations.ai opnar fyrir nýrra viðmót (API) þess og gerir þér kleift að tilgreina módelið.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (óopinbert, í gegnum RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Vörulisti Shazam í gegnum óopinbera skráningu á RapidAPI, með RapidAPI-lykli. Ekki Apple-þjónusta: skráningin gæti breyst eða hætt án fyrirvara. Hvert brot er sent til RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Myndskreytingar, táknmyndir og list í vigurstíl. Þarf lykil frá recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Rens-þjónn: ókeypis viðmót fyrir Google Lens. Hann les textann á mynd fyrir þig, á flestum ritkerfum.</string>
    <string name="core_tools_provider_rens_translate_desc">Rens-þjónn: ókeypis viðmót fyrir Google Lens. Hann skilar myndinni með þýddum texta.</string>
    <string name="core_tools_provider_replicate_desc">Þúsundir hýstra líkana. Nefndu hvaða texta-í-mynd líkan sem er sem eigandi/nafn; FLUX Schnell þegar eyðurnar eru tómar.</string>
    <string name="core_tools_provider_same_kind_fallback">Sem varahlutir</string>
    <string name="core_tools_provider_same_kind_fallback_desc">Veitendur af sömu tegund virka sem einn. Sá fyrsti er spurður, og sá næsti aðeins þegar sá fyrri bregst, til dæmis þegar lykill klárar kvóta.</string>
    <string name="core_tools_provider_same_kind_separate">Sérstaklega</string>
    <string name="core_tools_provider_same_kind_separate_desc">Hver og ein er sín eigin veita: sinn eigin flís, sitt eigið val á spjaldinu, sinn eigin hlut í blönduðu neti.</string>
    <string name="core_tools_provider_searxng_desc">SearXNG-tilvik sem leyfir JSON-niðurstöður. Flest opinber tilvik gera það ekki.</string>
    <string name="core_tools_provider_sherpa_desc">Straumspilunarlíkön fyrir 13 tungumál, þar á meðal bengalska, sem skrifa á meðan þú talar, í símanum.</string>
    <string name="core_tools_provider_simplytranslate_desc">SimplyTranslate-þjónn: ókeypis viðmót fyrir Google og aðrar vélar.</string>
    <string name="core_tools_provider_smartthings_desc">SmartThings-tækin þín, herbergi og senur, í gegnum ský Samsung. Staða uppfærist á meðan spjaldið er opið.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra og Stable Diffusion 3.5 frá framleiðendum Stable Diffusion. Greitt með einingum; þarf lykil frá platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">Límmiðapakkar þínir í þessum síma.</string>
    <string name="core_tools_provider_switchbot_desc">SwitchBot-tækin þín, innrauðar fjarstýringar og senur, í gegnum ský SwitchBot með auðkenni úr appinu þeirra. Staða uppfærist einu sinni á mínútu á meðan spjaldið er opið.</string>
    <string name="core_tools_provider_system_recognizer">Talgreining símans</string>
    <string name="core_tools_provider_system_recognizer_desc">Talgreiningin sem fylgir símanum, venjulega frá Google. Orð birtast eftir því sem þú talar.</string>
    <string name="core_tools_provider_tavily_desc">Vefleit með stuttu svari. Þarfnast Tavily-lykilsins þíns.</string>
    <string name="core_tools_provider_together_desc">FLUX og önnur opin líkön á netþjónum Together.</string>
