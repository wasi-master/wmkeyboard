    <string name="core_tools_provider_transcription_server">Umritunarþjónn</string>
    <string name="core_tools_provider_transcription_server_desc">Þjónn sem talar OpenAI hljóðritunar-API: speaches, whisper.cpp þjónn, LocalAI, Groq eða OpenAI. Hverju bút er sent til hans þegar þú hættir að tala.</string>
    <string name="core_tools_provider_translate_server">Þýðingarþjónninn þinn</string>
    <string name="core_tools_provider_translate_server_desc">Miðlari sem svarar OpenAI spjallbeiðnum: llama.cpp, Ollama, LM Studio, vLLM eða gátt.</string>
    <string name="core_tools_provider_translite_desc">Translite-þjónn: ókeypis viðmót fyrir Google Translate.</string>
    <string name="core_tools_provider_tuya">Smart Life / Tuya</string>
    <string name="core_tools_provider_tuya_desc">Smart Life og Tuya Smart tæki, herbergi og senur, í gegnum ókeypis Tuya verktakaverkefni sem er tengt við app-reikninginn þinn. Staða uppfærist á meðan spjaldið er opið.</string>
    <string name="core_tools_provider_unsplash_desc">Myndir frá Unsplash. Þarfnast API-lykils, nema þessi útgáfa sé með einn.</string>
    <string name="core_tools_provider_vision_ocr">Sjónlíkanið þitt</string>
    <string name="core_tools_provider_vision_ocr_desc">Líkan sem les myndir, í gegnum þjón sem svarar OpenAI spjallbeiðnum. Þarf vistfang og nafn líkansins.</string>
    <string name="core_tools_provider_whisper_desc">Whisper-líkön frá OpenAI, keyrð í símanum. Mörg tungumál; sæktu líkan á síðunni fyrir raddinnslátt.</string>
    <string name="core_tools_provider_whistle_desc">Lítið og hraðvirkt líkan sem keyrir í símanum. Sæktu það á síðunni fyrir raddinnslátt.</string>
    <string name="core_tools_provider_xai_desc">Grok-líkön í gegnum API xAI, með þínum eigin lykli.</string>
