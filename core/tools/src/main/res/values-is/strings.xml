    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, án nettengingar</string>
    <string name="core_tools_dictionary_source_offline_wiktionary_desc">Á þessu tæki, þegar búið er að hlaða niður. Algeng ensk orð úr Wiktionary, með framburði.</string>
    <string name="core_tools_dictionary_source_offline_wordnet">Opna enskan WordNet</string>
    <string name="core_tools_dictionary_source_offline_wordnet_desc">Á þessu tæki, þegar búið er að sækja. Hvert enskt orð í WordNet, með stuttum skilgreiningum.</string>
