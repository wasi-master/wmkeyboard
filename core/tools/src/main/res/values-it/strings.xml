    <string name="core_tools_dictionary_source_imported">Dizionari importati</string>
    <string name="core_tools_dictionary_source_imported_desc">Su questo dispositivo. I dizionari Yomichan e Yomitan che importi, in qualsiasi lingua, con letture e accento tonale.</string>
    <string name="core_tools_dictionary_source_offline_bengali">Wiktionary bengalese-inglese</string>
    <string name="core_tools_dictionary_source_offline_bengali_desc">Su questo dispositivo, una volta scaricato. Parole bengalesi con i loro significati in inglese e come vengono pronunciate.</string>
    <string name="core_tools_dictionary_source_offline_wiktionary">Wiktionary, offline</string>
