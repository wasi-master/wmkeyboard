    <string name="core_tools_provider_acrcloud_desc">Un servizio di riconoscimento musicale con una prova di due settimane, seguita da piani a pagamento. Richiede l\'host, la chiave di accesso e il segreto di accesso di un progetto da console.acrcloud.com. Ogni clip viene inviata ad ACRCloud.</string>
    <string name="core_tools_provider_ai_horde_desc">Stable Diffusion gratuito sui computer dei volontari. Funziona senza chiave ma attende in coda; una chiave gratuita da aihorde.net ti fa avanzare.</string>
    <string name="core_tools_provider_anthropic_desc">Modelli Claude tramite l\'API di Anthropic, con la tua chiave personale.</string>
    <string name="core_tools_provider_asr4all_desc">Dettatura in inglese sul telefono, con le parole che appaiono mentre parli.</string>
    <string name="core_tools_provider_audd_desc">Riconosce la maggior parte della musica pubblicata da pochi secondi di audio. Richiede un token da dashboard.audd.io; alcune centinaia di riconoscimenti sono gratuiti, poi è a pagamento. Ogni clip viene inviata ad AudD.</string>
    <string name="core_tools_provider_audiotag_desc">Un piccolo servizio di riconoscimento, gratuito per uso personale con una chiave da audiotag.info, e più lento degli altri: risponde dopo alcuni secondi. Ogni clip viene inviata ad AudioTag.</string>
    <string name="core_tools_provider_automatic1111">Automatic1111, Forge o SD.Next</string>
    <string name="core_tools_provider_automatic1111_desc">La tua interfaccia web Stable Diffusion, avviata con --api. Fornisci il suo indirizzo, come http://192.168.1.10:7860.</string>
    <string name="core_tools_provider_bergamot">Sul dispositivo (Firefox Translations)</string>
    <string name="core_tools_provider_bergamot_desc">Traduce sul telefono con il motore Bergamot di Mozilla e i modelli di Firefox Translations. Software libero, senza servizi Google, e il tuo testo rimane sul telefono. Ogni direzione (dal francese all\'inglese, dall\'inglese al francese) è un download separato da 14 a 37 MB. Richiede un telefono a 64 bit con Android 9 o versioni successive.</string>
    <string name="core_tools_provider_bfl">Black Forest Labs (FLUX)</string>
    <string name="core_tools_provider_bfl_desc">I modelli FLUX dai loro creatori. Richiede una chiave da bfl.ai.</string>
    <string name="core_tools_provider_brave">Brave Search</string>
    <string name="core_tools_provider_brave_answers">Brave Answers</string>
    <string name="core_tools_provider_brave_answers_desc">Risposte basate su una ricerca web Brave. Richiede una chiave con il piano Answers. Se lasciata vuota, verrà utilizzata la chiave Brave Search inserita per la ricerca web.</string>
    <string name="core_tools_provider_brave_desc">Ricerca web e immagini. Necessita di una chiave API di Brave Search, a meno che questa build non ne abbia una.</string>
    <string name="core_tools_provider_cloudflare_ai">Cloudflare Workers AI</string>
    <string name="core_tools_provider_cloudflare_ai_desc">FLUX e Stable Diffusion su Cloudflare, con una quota giornaliera gratuita. Richiede un token API e il tuo ID account.</string>
    <string name="core_tools_provider_cloudflare_speed_desc">Server di test della velocità di Cloudflare, il più vicino tra i suoi data center. Non richiede account e comunica alla scheda su quale rete ti trovi e quale città ha risposto.</string>
    <string name="core_tools_provider_coinbase_desc">Valute e monete da Coinbase. Nessuna chiave.</string>
    <string name="core_tools_provider_coingecko_desc">Prezzi delle monete da CoinGecko. Nessuna chiave necessaria.</string>
    <string name="core_tools_provider_comfyui_desc">Il tuo server ComfyUI. Disegna con un flusso di lavoro testo-immagine semplice e il checkpoint che nomini, o il primo disponibile.</string>
    <string name="core_tools_provider_commons_desc">GIF e foto gratuite da Wikimedia Commons, o dal tuo MediaWiki. Nessuna chiave. Le GIF sono per lo più educative.</string>
    <string name="core_tools_provider_currency_api_desc">Dati aperti per la maggior parte delle valute e molte monete. Nessuna chiave.</string>
    <string name="core_tools_provider_deepl_desc">Richiede la tua chiave API DeepL o l\'indirizzo di un proxy che ne aggiunga una.</string>
    <string name="core_tools_provider_deepseek_desc">Modelli DeepSeek tramite l\'API di DeepSeek, con la tua chiave personale.</string>
    <string name="core_tools_provider_er_api_desc">Tassi di cambio giornalieri per la maggior parte delle valute. Nessuna chiave.</string>
    <string name="core_tools_provider_fal_desc">Modelli ospitati veloci: FLUX, Recraft, Ideogram, Qwen Image e altri. Inserisci l\'id fal del modello; FLUX Schnell se vuoto.</string>
    <string name="core_tools_provider_frankfurter_desc">Tassi della Banca Centrale Europea per le principali valute. Software gratuito, nessuna chiave.</string>
    <string name="core_tools_provider_allratestoday_desc">European Central Bank reference rates, plus official rates from 120 central banks. No key.</string>
    <string name="core_tools_provider_gemini_desc">Modelli Gemini tramite l\'API di Google, con la tua chiave personale da AI Studio.</string>
    <string name="core_tools_provider_gemini_image">Immagini Gemini</string>
    <string name="core_tools_provider_gemini_image_desc">Modelli di immagine Nano Banana di Google. Una chiave vuota utilizza la chiave Gemini dello strumento AI.</string>
    <string name="core_tools_provider_gifcities_desc">Vecchie GIF di GeoCities dall\'Internet Archive. Nessuna chiave. I risultati non hanno una classificazione dei contenuti.</string>
    <string name="core_tools_provider_giphy_desc">GIF e adesivi. Sempre nella sua scheda: GIPHY non consente alle app di mescolare i suoi risultati con altri.</string>
    <string name="core_tools_provider_google_home">Google Home</string>
    <string name="core_tools_provider_google_home_desc">I dispositivi nella tua Google Home, tramite i servizi Play. Una casa alla volta; scegli quale nella schermata di Google.</string>
    <string name="core_tools_provider_google_translate">Google Traduttore</string>
    <string name="core_tools_provider_google_translate_desc">Endpoint gratuito di Google, o Cloud Translation quando aggiungi una chiave.</string>
    <string name="core_tools_provider_harper_desc">Il motore grammaticale integrato nella tastiera. Solo inglese, e nulla di ciò che scrivi lascia il telefono.</string>
    <string name="core_tools_provider_home_assistant_desc">Il tuo server Home Assistant personale. Ogni tipo di cosa, dal vivo, con Assist.</string>
    <string name="core_tools_provider_hue">Bridge Philips Hue</string>
    <string name="core_tools_provider_hue_desc">Luci, stanze, scene e sensori direttamente da un bridge Hue sul tuo Wi-Fi. Nulla lascia la casa.</string>
    <string name="core_tools_provider_hugging_face_desc">Modelli sui server di inferenza di Hugging Face, con un\'indennità mensile gratuita. Richiede un token di accesso con autorizzazione Inference Providers.</string>
    <string name="core_tools_provider_klipy_desc">GIF e adesivi. Richiede una chiave API KLIPY, a meno che questa build non ne abbia una.</string>
    <string name="core_tools_provider_languagetool_desc">Grammatica, ortografia e stile in oltre 30 lingue. Il tuo testo viene inviato a un server LanguageTool per essere controllato: quello pubblico su api.languagetool.org, a meno che tu non ne inserisca uno tuo.</string>
    <string name="core_tools_provider_librespeed_desc">Un server LibreSpeed: uno che gestisci tu stesso, o uno dei server dei volontari dalla lista pubblica, scelto per città nella schermata della riga.</string>
    <string name="core_tools_provider_libretranslate_desc">Un server LibreTranslate: il tuo o uno pubblico. I server pubblici solitamente richiedono una chiave.</string>
    <string name="core_tools_provider_lingva_desc">Un server Lingva: un front-end gratuito per Google Translate.</string>
    <string name="core_tools_provider_lm_studio_desc">Modelli forniti da LM Studio sul tuo computer. Aggiungine uno per ogni computer.</string>
    <string name="core_tools_provider_mlkit">Sul dispositivo</string>
    <string name="core_tools_provider_mlkit_desc">Traduce sul telefono con ML Kit. Il testo rimane sul telefono. Ogni lingua richiede prima il download di un modello.</string>
    <string name="core_tools_provider_mode_fallback">Uno alla volta</string>
    <string name="core_tools_provider_mode_fallback_desc">Chiedi al primo fornitore. Se fallisce o non ha risultati, chiedi al successivo.</string>
    <string name="core_tools_provider_mode_mix">Misto</string>
    <string name="core_tools_provider_mode_mix_desc">Interroga tutti i provider contemporaneamente e mescola i loro risultati in una griglia.</string>
    <string name="core_tools_provider_mode_pick">Scegli nel pannello</string>
    <string name="core_tools_provider_mode_pick_desc">Il pannello mostra i provider attivi. Scegline uno lì e verrà interrogato solo quello.</string>
    <string name="core_tools_provider_mode_tabs">Schede</string>
    <string name="core_tools_provider_mode_tabs_desc">Ogni provider ha la sua scheda. Tocca una scheda per vedere i risultati.</string>
    <string name="core_tools_provider_moonshine_desc">Un modello inglese piccolo e veloce che viene eseguito sul telefono.</string>
    <string name="core_tools_provider_mozhi_desc">Un server Mozhi: un front-end gratuito per Google, DeepL, DuckDuckGo, Yandex e Reverso. Scegli il motore. DeepL e Reverso necessitano di una lingua di origine.</string>
    <string name="core_tools_provider_music_server">Il tuo server di riconoscimento</string>
    <string name="core_tools_provider_music_server_desc">Un server che gestisci tu e che risponde come AudD: la clip viene pubblicata come file e la canzone torna come JSON. Mettici dietro un fingerprint come Panako o Olaf.</string>
    <string name="core_tools_provider_nllb">Sul dispositivo (NLLB-200)</string>
    <string name="core_tools_provider_nllb_desc">Traduce sul telefono con il modello NLLB-200 di Meta su CTranslate2: 200 lingue, tra una coppia qualsiasi di esse, per le combinazioni che gli altri motori non possono gestire. Un download di 630 MB, e una frase richiede pochi secondi. Il tuo testo rimane sul telefono. Il modello è concesso in licenza solo per uso non commerciale (CC BY-NC 4.0). Richiede un telefono a 64 bit con 6 GB di memoria o più.</string>
    <string name="core_tools_provider_none_on">Nessun provider è attivo. Attivane uno nelle impostazioni di questo strumento.</string>
    <string name="core_tools_provider_offline_gifs">Pacchetti GIF offline</string>
    <string name="core_tools_provider_offline_gifs_desc">Pacchetti GIF che hai importato. Funzionano senza connessione.</string>
    <string name="core_tools_provider_ollama_desc">Modelli su un server Ollama che esegui sul tuo computer o sulla tua rete. Aggiungine uno per ogni server.</string>
    <string name="core_tools_provider_omnilingual_desc">Il modello unico di Meta per 1.600 lingue, centinaia delle quali senza altra digitazione vocale, sul telefono. Ogni frase arriva alla pausa successiva.</string>
    <string name="core_tools_provider_on_device_ai">Sul tuo dispositivo</string>
    <string name="core_tools_provider_on_device_ai_desc">Un modello scaricato su questo telefono. Nulla di ciò che scrivi lascia il dispositivo. Scegli e scarica il modello nella pagina AI.</string>
    <string name="core_tools_provider_on_device_image">Su questo telefono</string>
    <string name="core_tools_provider_on_device_image_desc">Un modello scaricato su questo telefono, o uno importato da te. Nulla di ciò che digiti lascia il dispositivo. Scegli il modello nella schermata del generatore.</string>
    <string name="core_tools_provider_openai_compatible">Servizio compatibile con OpenAI</string>
    <string name="core_tools_provider_openai_compatible_desc">Qualsiasi altro servizio con API di chat OpenAI: OpenRouter, Groq, Mistral, Together o un tuo gateway. Inserisci l\'indirizzo fino alla versione, come https://openrouter.ai/api/v1.</string>
    <string name="core_tools_provider_openai_compatible_image">Immagini compatibili con OpenAI</string>
    <string name="core_tools_provider_openai_compatible_image_desc">Qualsiasi altro servizio con l\'API immagini di OpenAI: LocalAI, DeepInfra, Nebius o un tuo gateway. Fornisci l\'indirizzo fino alla versione, come https://api.deepinfra.com/v1/openai.</string>
    <string name="core_tools_provider_openai_desc">Modelli GPT tramite l\'API di OpenAI, con la tua chiave personale.</string>
    <string name="core_tools_provider_openai_image">Immagini OpenAI</string>
    <string name="core_tools_provider_openai_image_desc">GPT Image, che disegna adesivi su uno sfondo trasparente. Pagato per immagine. Una chiave vuota utilizza la chiave OpenAI dallo strumento AI.</string>
    <string name="core_tools_provider_openhab_desc">Un server openHAB: i suoi elementi, in tempo reale, con le stanze del modello semantico.</string>
    <string name="core_tools_provider_parakeet_desc">Un modello di grandi dimensioni che viene eseguito sul telefono e comprende 25 lingue europee.</string>
    <string name="core_tools_provider_pexels_desc">Foto da Pexels. Richiede una chiave API, a meno che questa build non ne abbia già una.</string>
    <string name="core_tools_provider_pollinations_desc">Gratuito, senza chiave e senza account: il prompt viene inviato a Pollinations, che sceglie il modello. Una chiave da enter.pollinations.ai apre la sua API più recente e ti permette di nominare un modello.</string>
    <string name="core_tools_provider_rapid_shazam">Shazam (non ufficiale, tramite RapidAPI)</string>
    <string name="core_tools_provider_rapid_shazam_desc">Catalogo di Shazam tramite un elenco non ufficiale su RapidAPI, con una chiave RapidAPI. Non è un servizio Apple: l\'elenco potrebbe cambiare o interrompersi senza preavviso. Ogni clip viene inviata a RapidAPI.</string>
    <string name="core_tools_provider_recraft_desc">Illustrazioni, icone e arte in stile vettoriale. Richiede una chiave da recraft.ai.</string>
    <string name="core_tools_provider_rens_desc">Un server Rens: un front-end gratuito per Google Lens. Legge per te il testo in una foto, nella maggior parte degli script.</string>
    <string name="core_tools_provider_rens_translate_desc">Un server Rens: un front-end gratuito per Google Lens. Restituisce la foto con il testo tradotto.</string>
    <string name="core_tools_provider_replicate_desc">Migliaia di modelli ospitati. Assegna un nome a qualsiasi modello text-to-image come proprietario/nome; FLUX Schnell se lasciato vuoto.</string>
    <string name="core_tools_provider_same_kind_fallback">Come backup</string>
    <string name="core_tools_provider_same_kind_fallback_desc">I fornitori dello stesso tipo agiscono come uno solo. Viene interrogato il primo, e il successivo solo quando fallisce, ad esempio quando una chiave esaurisce la quota.</string>
    <string name="core_tools_provider_same_kind_separate">Separatamente</string>
    <string name="core_tools_provider_same_kind_separate_desc">Ognuno è un provider a sé stante: il proprio chip, la propria scelta nel pannello, la propria quota in una griglia mista.</string>
    <string name="core_tools_provider_searxng_desc">Un\'istanza SearXNG che consente risultati JSON. La maggior parte delle istanze pubbliche non lo fa.</string>
    <string name="core_tools_provider_sherpa_desc">Modelli di streaming per 13 lingue, tra cui il bengalese, che digitano mentre parli, sul telefono.</string>
    <string name="core_tools_provider_simplytranslate_desc">Un server SimplyTranslate: un front-end gratuito per Google e altri motori.</string>
    <string name="core_tools_provider_smartthings_desc">I tuoi dispositivi, stanze e scene SmartThings, tramite il cloud di Samsung. Gli stati si aggiornano mentre il pannello è aperto.</string>
    <string name="core_tools_provider_stability_desc">Stable Image Core, Ultra e Stable Diffusion 3.5 dai creatori di Stable Diffusion. Pagamento in crediti; richiede una chiave da platform.stability.ai.</string>
    <string name="core_tools_provider_sticker_packs_desc">I tuoi pacchetti di adesivi su questo telefono.</string>
    <string name="core_tools_provider_switchbot_desc">I tuoi dispositivi SwitchBot, telecomandi a infrarossi e scene, tramite il cloud di SwitchBot con il token della sua app. Gli stati si aggiornano una volta al minuto mentre il pannello è aperto.</string>
    <string name="core_tools_provider_system_recognizer">Riconoscitore del telefono</string>
    <string name="core_tools_provider_system_recognizer_desc">Il riconoscitore vocale fornito con il telefono, solitamente quello di Google. Le parole appaiono mentre parli.</string>
    <string name="core_tools_provider_tavily_desc">Ricerca web con una risposta breve. Richiede la tua chiave Tavily.</string>
    <string name="core_tools_provider_together_desc">FLUX e altri modelli aperti sui server di Together.</string>
