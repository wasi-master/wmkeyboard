    <string name="core_tools_dictionary_source_offline_wordnet">Apri WordNet inglese</string>
    <string name="core_tools_dictionary_source_offline_wordnet_desc">Su questo dispositivo, una volta scaricato. Ogni parola inglese in WordNet, con brevi definizioni.</string>
    <string name="core_tools_dictionary_source_vocab_packs">Pacchetti vocabolario</string>
