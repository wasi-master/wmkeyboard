    <string name="core_tools_synonym_source_datamuse">Тезаурус Datamuse</string>
    <string name="core_tools_synonym_source_datamuse_desc">Онлайн. Багато слів, відсортованих за релевантністю.</string>
    <string name="core_tools_synonym_source_dictionary_api">Free Dictionary API</string>
    <string name="core_tools_synonym_source_dictionary_api_desc">Онлайн. Джерело, яке використовує інструмент Словник.</string>
    <string name="core_tools_synonym_source_similar_words">Схожі слова</string>
    <string name="core_tools_synonym_source_similar_words_desc">Онлайн, від Datamuse. Слова зі схожим значенням для слів, що не мають синонімів.</string>
    <string name="core_tools_synonym_source_vocab_packs">Словникові пакети</string>
