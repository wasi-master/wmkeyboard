    <string name="core_tools_provider_tool_music">Розпізнавачі пісень</string>
    <string name="core_tools_provider_tool_ocr">Зчитування тексту онлайн</string>
    <string name="core_tools_provider_tool_photo_translate">Переклад фото</string>
    <string name="core_tools_provider_tool_photos">Фонові фотографії</string>
    <string name="core_tools_provider_tool_search">Пошук в інтернеті та за зображеннями</string>
    <string name="core_tools_provider_tool_smart_home">Розумний дім</string>
    <string name="core_tools_provider_tool_speed_test">Сервери тестування швидкості</string>
