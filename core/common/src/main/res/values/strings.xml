<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared UI vocabulary.

  Every module depends on :core:common, so these are the words a screen can
  reuse instead of defining its own copy. A word belongs here only when more
  than one module says it and says it in exactly the same sense. Anything with a
  screen-specific meaning stays in the module that shows it.

  Referenced from other modules as
  com.wasimaster.wmkeyboard.common.R.string.common_cancel — the R classes are
  non-transitive, so the import has to name this module.
-->
<resources>

    <!-- ================================================================== -->
    <!-- Actions. Button and menu labels, sentence case, no trailing stop.  -->
    <!-- ================================================================== -->

    <string name="common_ok">OK</string>
    <string name="common_cancel">Cancel</string>
    <string name="common_save">Save</string>
    <string name="common_done">Done</string>
