<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared UI vocabulary.

  Every module depends on :core:common, so these are the words a screen can
  reuse instead of defining its own copy. A word belongs here only when more
  than one module says it and says it in exactly the same sense. Anything with a
  screen-specific meaning stays in the module that shows it.

  Referenced from other modules as
  com.wasimaster.wmkeyboard.common.R.string.common_cancel — the R classes are
  non-transitive, so the import has to name this module.
-->
<resources>

    <!-- ================================================================== -->
    <!-- Actions. Button and menu labels, sentence case, no trailing stop.  -->
    <!-- ================================================================== -->

    <string name="common_ok">OK</string>
    <string name="common_cancel">Cancel</string>
    <string name="common_save">Save</string>
    <string name="common_done">Done</string>
    <string name="common_close">Close</string>
    <string name="common_delete">Delete</string>
    <string name="common_remove">Remove</string>
    <string name="common_edit">Edit</string>
    <string name="common_undo">Undo</string>
    <string name="common_add">Add</string>
    <string name="common_copy">Copy</string>
    <string name="common_cut">Cut</string>
    <string name="common_paste">Paste</string>
    <string name="common_share">Share</string>
    <string name="common_import">Import</string>
    <string name="common_export">Export</string>
    <string name="common_reset">Reset</string>
    <string name="common_retry">Try again</string>
    <string name="common_back">Back</string>
    <string name="common_next">Next</string>
    <string name="common_skip">Skip</string>
    <!-- Under the reason a greyed-out control gives on a long press: opens the
         settings screen holding the switch that unblocks it. -->
    <string name="common_disabled_open_setting">Open the setting</string>
    <string name="common_continue">Continue</string>
    <string name="common_search">Search</string>
    <string name="common_clear">Clear</string>
    <string name="common_select_all">Select all</string>
    <string name="common_enable">Turn on</string>
    <string name="common_disable">Turn off</string>
    <string name="common_download">Download</string>
    <string name="common_more">More</string>
    <string name="common_install">Install</string>
    <string name="common_uninstall">Uninstall</string>
    <string name="common_update">Update</string>
    <string name="common_settings">Settings</string>
    <string name="common_open_system_settings">Open system settings</string>
    <string name="common_reset_defaults">Reset to defaults</string>
    <!-- Content description of the per-setting reset control. %1$s is the setting's own name. -->
    <string name="common_reset_setting_desc">Reset %1$s to its default</string>
    <!-- Content descriptions of the two buttons of a number stepper. %1$s is the setting's own name. -->
    <string name="common_decrease_setting_desc">Decrease %1$s</string>
    <string name="common_increase_setting_desc">Increase %1$s</string>
    <!-- Click label of a slider's value, which opens a field to type the value in. %1$s is the setting's own name. -->
    <string name="common_type_setting_value_desc">Type a value for %1$s</string>
    <!-- Under the field that takes a slider's value. %1$s and %2$s are the slider's two ends as it shows them, for example "100 ms". -->
    <string name="common_value_range">From %1$s to %2$s</string>
    <string name="common_value_range_error">Type a number from %1$s to %2$s</string>

    <!-- ================================================================== -->
    <!-- States and values.                                                 -->
    <!-- ================================================================== -->

    <string name="common_on">On</string>
    <string name="common_off">Off</string>
    <string name="common_none">None</string>
    <string name="common_default">Default</string>
    <string name="common_custom">Custom</string>
    <string name="common_auto">Automatic</string>

    <!-- ================================================================== -->
    <!-- Progress. The ellipsis is the single character, not three stops.   -->
    <!-- ================================================================== -->

    <string name="common_loading">Loading…</string>
    <string name="common_downloading">Downloading…</string>
    <string name="common_installing">Installing…</string>

    <!-- ================================================================== -->
    <!-- Messages.                                                          -->
    <!-- ================================================================== -->

    <string name="common_error_generic">Something did not work. Try again.</string>
    <string name="common_error_network">No connection. Check your network and try again.</string>
    <!-- The offline build (no internet permission) refusing an online service or a connection. "Standard build" is the name the Version row and the docs use. -->
    <string name="common_error_no_internet_permission">This is the offline build. It cannot connect to the internet or your network, so this does not work here. To use it, install the standard build from the same release page over this one. Your settings and learned words stay.</string>
    <!-- The offline build refusing to download a file, model or word list. -->
    <string name="common_offline_build_download">This is the offline build, so it cannot download this. Get the file on another device and import it: Settings › About › Storage › Import downloaded files takes it, or this screen\'s own Import row where it has one. Or install the standard build from the same release page over this one, and it downloads by itself. Your settings and learned words stay.</string>
    <!-- The offline build refusing to download a feature library (native code). -->
    <string name="common_offline_build_library">This is the offline build, so it cannot download the library this needs. Get its file on another device and import it in Settings › Privacy › Feature libraries, which lists the exact file. Or install the standard build from the same release page over this one, and it downloads by itself. Your settings and learned words stay.</string>
    <string name="common_error_timeout">The request took too long. Try again.</string>
    <!-- A download that stopped because data saving holds downloads on the connection it moved to. What arrived is kept. -->
    <string name="common_error_download_held">Paused: data saving holds downloads on this connection. It continues where it stopped.</string>

</resources>
