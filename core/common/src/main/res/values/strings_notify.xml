<?xml version="1.0" encoding="utf-8"?>
<!--
   Notification channels and the words the shade shows. The channel names and
   descriptions are read in Android's own settings, where they sit next to
   every other app's, so they say what arrives rather than which feature sends
   it.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="common_notify_channel_downloads_title">Downloads</string>
    <string name="common_notify_channel_downloads_body">Progress for dictionaries, voice models, add-ons and other files the keyboard fetches, and a line when one finishes or fails.</string>

    <string name="common_notify_channel_updates_title">App updates</string>
    <string name="common_notify_channel_updates_body">A new version to install, an update waiting for you to press install, and confirmation once one is installed.</string>

    <string name="common_notify_channel_backup_title">Backup problems</string>
    <string name="common_notify_channel_backup_body">Only when an automatic backup fails. Successful backups are silent.</string>

    <string name="common_notify_channel_connect_title">Paired computers</string>
    <string name="common_notify_channel_connect_body">A computer paired over KDE Connect asked to pair, sent a file, or pinged while the keyboard was hidden.</string>
    <string name="common_notify_channel_clock_title">Timers and stopwatch</string>
    <string name="common_notify_channel_send_title">Sending and receiving files</string>
    <string name="common_notify_channel_send_body">An upload or a download the Send files tool finished while the keyboard was hidden, with the link to copy, and a file a device nearby sent.</string>
    <string name="common_notify_channel_clock_body">Timers and the stopwatch while they run, with buttons to pause, add a minute or stop them.</string>
    <string name="common_notify_channel_keyboard_title">Keyboard controls</string>
    <string name="common_notify_channel_keyboard_body">A permanent entry in the shade for showing the keyboard and unpinning it. Only while you turn it on.</string>

    <!-- %1$s is the bytes downloaded, %2$s the total, both already formatted. -->
    <string name="common_notify_download_progress">
        <xliff:g id="downloaded" example="12 MB">%1$s</xliff:g> of <xliff:g id="total" example="30 MB">%2$s</xliff:g>
    </string>
    <string name="common_notify_download_done">Ready to use</string>
    <!-- A download that brings a feature's engine library before its model. %1$s is the byte count, e.g. "3.1 MB of 6.9 MB". -->
    <string name="common_notify_download_step_library">Step 1 of 2, the engine library: <xliff:g id="readout" example="3.1 MB of 6.9 MB">%1$s</xliff:g></string>
    <string name="common_notify_download_step_model">Step 2 of 2, the model: <xliff:g id="readout" example="8.4 MB of 25.8 MB">%1$s</xliff:g></string>
    <!-- Names for the two downloads both the settings app and the keyboard can
         start, so one wording serves both. %1$s is a language name. -->
    <string name="common_notify_download_handwriting"><xliff:g id="language" example="Bangla">%1$s</xliff:g> handwriting</string>
    <string name="common_notify_download_translate"><xliff:g id="language" example="Bangla">%1$s</xliff:g> offline translation</string>
    <string name="common_notify_download_voice"><xliff:g id="language" example="Bangla">%1$s</xliff:g> offline voice</string>
    <!-- %1$s is what was being downloaded, e.g. "Bangla dictionary". -->
    <string name="common_notify_download_failed">
        <xliff:g id="name" example="Bangla dictionary">%1$s</xliff:g> could not be downloaded
    </string>

    <string name="common_permission_notifications_title">Show notifications</string>
    <string name="common_permission_notifications_body">The keyboard uses notifications to tell you about things that finish while you are somewhere else: a dictionary or voice model that has downloaded, an update waiting to be installed, an automatic backup that failed. It sends nothing else — no tips, no suggestions, no advertising — and every kind can be switched off separately in Settings › Notifications. Refusing changes nothing about how the keyboard types.</string>

</resources>
